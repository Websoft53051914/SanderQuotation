@{
}
<div class="col-lg-12">
    <div class="card" id="invoiceList">
        <div class="card-header border-0">
            <div class="d-flex align-items-center">
                <h5 class="card-title mb-0 flex-grow-1"></h5>
                <div class="flex-shrink-0">
                    <div class="d-flex gap-2 flex-wrap">
                        <a id="btnShowModal" href="@Url.Action("Create")" class="btn btn-danger add-btn"><i class="ri-add-line align-bottom me-1"></i>新増</a>
                        <button class="btn btn-soft-danger" id="remove-actions" onClick="deleteMultiple()"><i class="ri-delete-bin-2-line"></i></button>
                    </div>
                </div>
            </div>
        </div>
        <div class="card-body bg-light-subtle border border-dashed border-start-0 border-end-0">
            <form>
                <div class="row g-3">
                    <div class="col-xxl-3 col-sm-12">
                        <div class="search-box">
                            <input type="text" class="form-control search bg-light border-light" placeholder="輸入圖表資料名稱、描述或Tableau連結" id="Keyword1">
                            <i class="ri-search-line search-icon"></i>
                        </div>
                    </div>
                    <!--end col-->
                    <div class="col-xxl-1 col-sm-4">
                        <button type="button" class="btn btn-primary w-100" onclick="SearchData();">
                            <i class="ri-equalizer-fill me-1 align-bottom"></i>
                            篩選
                        </button>
                    </div>
                    <!--end col-->
                </div>
            </form>
        </div>
        <div class="card-body">
            <div class="table-responsive table-card mb-4">
                <table class="table align-middle table-nowrap mb-0" id="dataTable">
                    <thead>
                        <tr>
                            <th scope="col" style="width: 40px;">
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox" id="checkAll" value="option">
                                </div>
                            </th>
                            <th>Action</th>@* 功能名稱 *@
                            @* *** 顯示欄位 *@
                            @* <th class="sort" data-sort="id">ID</th> *@
                            <th>項次</th> @* 功能名稱 *@
                            <th class="sort" data-sort="Name">圖表資料名稱</th>
                            <th class="sort" data-sort="Description">描述</th>
                            <th class="sort" data-sort="TableauUrl">Tableau連結</th>
                            <th class="sort" data-sort="UpdateTime">修改時間</th>
                        </tr>
                    </thead>
                    <tbody class="list" id="data-list-data">
                        <tr>
                        </tr>
                    </tbody>
                </table>
                <div class="noresult" style="display: none">
                    <div class="text-center">
                        <lord-icon src="@Url.Content("~/assets/json/lord-icon/msoeawqm.json")" trigger="loop" colors="primary:#121331,secondary:#08a88a" style="width:75px;height:75px"></lord-icon>
                        <h5 class="mt-2">查無資料</h5>
                        @* <p class="text-muted mb-0">We've searched more than 150+ Datas We did not find any Datas for you search.</p> *@
                    </div>
                </div>
            </div>
            <div class="d-flex justify-content-end mt-2">
                <div class="pagination-wrap hstack gap-2">
                    <a class="page-item pagination-prev disabled" href="#">
                        上一頁
                    </a>
                    <ul class="pagination listjs-pagination mb-0"></ul>
                    <a class="page-item pagination-next" href="#">
                        下一頁
                    </a>
                </div>
            </div>
        </div>
    </div>

</div>
<script>
      // ⭐ 全域查詢狀態（完全由前端控制）
     let queryState = {
         page: 1,
         pageSize: 40,
         sortField: "Id", //*** 頁面預設排序欄位，必須是TABLE內欄位
         sortDir: "asc",

         //*** 篩選條件
         Keyword: "",
     };
     const data = [
         {'No':1,'Id':1,'Name':'名稱1','Description':'描述1','UpdateTime':'2026/04/27 16:00:00','TableauUrl':'https://public.tableau.com/views/RegionalSampleWorkbook/College'},
         {'No':2,'Id':2,'Name':'名稱2','Description':'描述2','UpdateTime':'2026/04/27 15:58:00','TableauUrl':'https://public.tableau.com/views/RegionalSampleWorkbook/Stocks'},
     ]
     function loadDatas() {
          renderTable(data);
          renderPagination(data.length);
    }

             // ⭐ 表格渲染
             function renderTable(rows) {
                 const tbody = $('#data-list-data');
                 tbody.empty();

                 if (!rows || rows.length === 0) {
                     $('.noresult').show();
                     return;
                 }
                 $('.noresult').hide();


                 // 產生每筆 row 的 HTML
                 rows.forEach(data => {
                         const name = data.Name
                         const description = data.Description;
                         const updateTime = data.UpdateTime;
                     tbody.append(`
                                                 <tr data-id="${data.Id}">
                                                   <th scope="row">
                                                     <div class="form-check">
                                                         <input class="form-check-input row-check" type="checkbox" data-id="${data.Id}" value=option1>
                                                     </div>
                                                   </th>
                                                     <td>
                                                         <div class="dropdown">
                                                             <button class="btn btn-soft-secondary btn-sm dropdown" type="button" data-bs-toggle="dropdown">
                                                                 <i class="ri-more-fill align-middle"></i>
                                                             </button>
                                                             <ul class="dropdown-menu dropdown-menu-end">
                                                                  <li><a class="dropdown-item edit-item-btn"  href="@Url.Action("Edit")""><i class="ri-pencil-fill align-bottom me-2 text-muted"></i>編輯</a></li>
                                                                  <li><a class="dropdown-item remove-item-btn" href="#"><i class="ri-delete-bin-fill align-bottom me-2 text-muted"></i>刪除</a></li>
                                                                  
                                                             </ul>
                                                         </div>
                                                     </td>
                                                     <td>${data.No}</td>
                                                     <td>${name}</td>
                                                     <td>${(description)}</td>
                                                     <td><a href="${data.TableauUrl}" class="link-secondary link-offset-2 text-decoration-underline link-underline-opacity-25 link-underline-opacity-100-hover" target="_blank">${data.TableauUrl}</a></td>
                                                     <td>${(updateTime)}</td>
                                                 </tr>
                                             `);
                 });
                 initDynamicDropdowns();
             }

             // ⭐ 分頁渲染
             function renderPagination(total) {
                 const totalPages = Math.ceil(total / queryState.pageSize);
                 const ul = $('.listjs-pagination');
                 ul.empty();

                 if (totalPages <= 1) return;

                 const maxPages = 5;

                 let startPage = Math.max(1, queryState.page - Math.floor(maxPages / 2));
                 let endPage = startPage + maxPages - 1;

                 if (endPage > totalPages) {
                     endPage = totalPages;
                     startPage = Math.max(1, endPage - maxPages + 1);
                 }

                 // ⭐ 前面有隱藏 → 第一頁 …
                 if (startPage > 1) {
                     ul.append(`
                                                                 <li class="page-item">
                                                                     <a class="page-link" href="javascript:void(0)" onclick="gotoPage(1)">@(config.GetMessage("First_Page").ToHtmlString())</a>
                                                                 </li>
                                                             `);

                     ul.append(`
                                                                 <li class="page-item disabled">
                                                                     <span class="page-link">...</span>
                                                                 </li>
                                                             `);
                 }

                 // ⭐ 中間連續頁碼（最多5頁）
                 for (let i = startPage; i <= endPage; i++) {
                     ul.append(`
                                                                 <li class="page-item ${i === queryState.page ? 'active' : ''}">
                                                                     <a class="page-link" href="javascript:void(0)" onclick="gotoPage(${i})">${i}</a>
                                                                 </li>
                                                             `);
                 }

                 // ⭐ 後面有隱藏 → … 最後一頁
                 if (endPage < totalPages) {
                     ul.append(`
                                                                 <li class="page-item disabled">
                                                                     <span class="page-link">...</span>
                                                                 </li>
                                                             `);

                     ul.append(`
                                                                 <li class="page-item">
                                                                     <a class="page-link" href="javascript:void(0)" onclick="gotoPage(${totalPages})">@(config.GetMessage("Last_Page").ToHtmlString())</a>
                                                                 </li>
                                                             `);
                 }

                 // ⭐ 上一頁 / 下一頁狀態
                 $('.pagination-prev').toggleClass('disabled', queryState.page === 1);
                 $('.pagination-next').toggleClass('disabled', queryState.page === totalPages);

                 // ⭐ 上一頁
                 $('.pagination-prev').off('click').on('click', function (e) {
                     e.preventDefault();
                     if (queryState.page > 1) {
                         queryState.page--;
                         $('#globalSearchInput').val('');
                         loadDatas();
                     }
                 });

                 // ⭐ 下一頁
                 $('.pagination-next').off('click').on('click', function (e) {
                     e.preventDefault();
                     if (queryState.page < totalPages) {
                         queryState.page++;
                         $('#globalSearchInput').val('');
                         loadDatas();
                     }
                 });
             }

             function gotoPage(page) {
                 queryState.page = page;
                 $('#globalSearchInput').val('');
                 loadDatas();
             }

             // ⭐ 搜尋 + 篩選
             function SearchData() {

                 //*** 篩選條件
                 queryState.Keyword1 = $('#Keyword1').val();
                 queryState.Keyword2 = $('#Keyword2').val();

                 queryState.page = 1;
                 $('#globalSearchInput').val('');
                 loadDatas();
             }
               // 顯示 / 隱藏刪除區塊
          function toggleRemoveActions() {
              if ($('.row-check:checked').length > 0)
                  $('#remove-actions').show();
              else
                  $('#remove-actions').hide();
          }
     $(document).ready(function(){
         loadDatas();
          // ⭐ 單筆勾選
          $(document).on('change', '.row-check', function () {

              const total = $('.row-check').length;
              const checked = $('.row-check:checked').length;

              // header checkbox 狀態同步
              $('#checkAll').prop('checked', total === checked);

              toggleRemoveActions();
          });

          // ⭐ 全選 / 取消全選
          $('#checkAll').on('change', function () {
              $('.row-check').prop('checked', this.checked);
              toggleRemoveActions();
          });
     })
</script>