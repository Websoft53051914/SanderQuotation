    <script>
    (function () {
        var $toggle  = $('#aiChatToggle');
        var $panel   = $('#aiChatPanel');
        var $close   = $('#aiChatClose');
        var $input   = $('#aiChatInput');
        var $send    = $('#aiChatSend');
        var $msgs    = $('#aiChatMessages');

                function openPanel()  { $panel.addClass('open'); $toggle.addClass('hidden'); $input.focus();  // 初始化時間
                $('#aiInitTime').text(formatTime(new Date()));}
        function closePanel() { $panel.removeClass('open'); $toggle.removeClass('hidden'); }

        $toggle.on('click', function () {
            $panel.hasClass('open') ? closePanel() : openPanel();
        });
        $close.on('click', closePanel);

       

        function formatTime(d) {
            var h = d.getHours(), m = d.getMinutes();
            var ampm = h >= 12 ? '下午' : '上午';
            h = h % 12 || 12;
            return ampm + ' ' + h + ':' + (m < 10 ? '0' : '') + m;
        }

        function appendMsg(text, role) {
            var time = formatTime(new Date());
            var $m = $('<div class="ai-msg ' + role + '">' +
                '<div class="bubble">' + $('<div>').text(text).html() + '</div>' +
                '<div class="msg-time">' + time + '</div>' +
                '</div>');
            $msgs.append($m);
            $msgs.scrollTop($msgs[0].scrollHeight);
        }

        function sendMessage() {
            var text = $input.val().trim();
            if (!text) return;
            appendMsg(text, 'user');
            $input.val('');

            // 顯示思考中
            var $thinking = $('<div class="ai-msg bot"><div class="bubble" id="aiThinking">思考中…</div></div>');
            $msgs.append($thinking);
            $msgs.scrollTop($msgs[0].scrollHeight);

            $.ajax({
                url: '/api/AiChat/Chat',
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify({ message: text }),
                success: function (resp) {
                    $('#aiThinking').closest('.ai-msg').remove();
                    appendMsg((resp && resp.reply) ? resp.reply : '（無回應）', 'bot');
                },
                error: function () {
                    $('#aiThinking').closest('.ai-msg').remove();
                    appendMsg('連線失敗，請稍後再試。', 'bot');
                }
            });
        }

        $send.on('click', sendMessage);
        $input.on('keydown', function (e) {
            if (e.key === 'Enter' && !e.shiftKey) { e.preventDefault(); sendMessage(); }
        });
    })();
    </script>
</body>
</html>