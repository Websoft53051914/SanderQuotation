                items.push({
                    role: $m.hasClass('user') ? 'user' : 'bot',
                    bubbleHtml: $m.find('.bubble').html(),
                    time: $m.find('.msg-time').text()
                });
            });
            sessionStorage.setItem(_msgsStorageKey, JSON.stringify(items));
        }

        function restoreMsgs() {
            var raw = sessionStorage.getItem(_msgsStorageKey);
            if (!raw) return;
            try {
                $msgs.empty();
                var items = JSON.parse(raw);
                if (!items || !items.length) return;
                items.forEach(function (item) {
                    var $m = $('<div class="ai-msg ' + item.role + '">' +
                        '<div class="bubble">' + item.bubbleHtml + '</div>' +
                        '<div class="msg-time">' + item.time + '</div>' +
                        '</div>');
                    $msgs.append($m);
                });
            } catch (e) { /* ignore */ }
        }

        // ── 開關面板 ──
        function openPanel() {
            // 首次開啟（無 sessionId 且無訊息）才顯示歡迎訊息
            if (!_sessionId && $msgs.children().length === 0) {
                appendBotMsg('您好！我是 AI 智慧助理，有什麼需要幫忙的嗎?');
                $('#aiInitTime').text(formatTime(new Date()));
            }
            $panel.addClass('open');
            $toggle.addClass('hidden');
            $input.focus();
            scrollBottom();  // 面板顯示後才能正確捲到底
        }
        function closePanel() {
            $panel.removeClass('open');
            $toggle.removeClass('hidden');
        }
        $toggle.on('click', function () { $panel.hasClass('open') ? closePanel() : openPanel(); });
        $close.on('click', closePanel);

        // 頁面載入時還原聊天紀錄
        restoreMsgs();

        // ── 時間格式 ──
        function formatTime(d) {
            var h = d.getHours(), m = d.getMinutes();
            var ampm = h >= 12 ? '下午' : '上午';
            h = h % 12 || 12;
            return ampm + ' ' + h + ':' + (m < 10 ? '0' : '') + m;
        }

        // ── 加入使用者訊息 ──
        function appendUserMsg(text) {
            var $m = $('<div class="ai-msg user">' +
                '<div class="bubble">' + $('<span>').text(text).html() + '</div>' +
                '<div class="msg-time">' + formatTime(new Date()) + '</div>' +
                '</div>');
            $msgs.append($m);
            scrollBottom();
            saveMsgs();
        }

        // ── 加入 AI 訊息──
        function appendBotMsg(text) {
            // 將文字分段：普通文字 escape，[DOWNLOAD_BUTTON] 段落直接轉為 HTML
            var html = '';
            var regex = /\[DOWNLOAD_BUTTON\](.*?)\[\/DOWNLOAD_BUTTON\]/g;
            var lastIndex = 0;
            var match;
            while ((match = regex.exec(text)) !== null) {
                if (match.index > lastIndex) {
                    html += $('<span>').text(text.substring(lastIndex, match.index)).html().replace(/\n/g, '<br>');
                }
                html += parseDownloadButtons('[DOWNLOAD_BUTTON]' + match[1] + '[/DOWNLOAD_BUTTON]');
                lastIndex = regex.lastIndex;
            }
            if (lastIndex < text.length) {
                html += $('<span>').text(text.substring(lastIndex)).html().replace(/\n/g, '<br>');
            }

            var $m = $('<div class="ai-msg bot">' +
                '<div class="bubble">' + html + '</div>' +
                '<div class="msg-time">' + formatTime(new Date()) + '</div>' +
                '</div>');
            $msgs.append($m);
            scrollBottom();
            saveMsgs();
        }

        /**
         * 解析訊息中的下載按鈕標記並轉換為 HTML
         */
        function parseDownloadButtons(message) {
            if (!message) return message;

            // 使用正則表達式找出所有 [DOWNLOAD_BUTTON]...[/DOWNLOAD_BUTTON] 標記
            const regex = /\[DOWNLOAD_BUTTON\](.*?)\[\/DOWNLOAD_BUTTON\]/g;

            return message.replace(regex, function (match, jsonStr) {
                try {
                    // 解析 JSON
                    const data = JSON.parse(jsonStr);

                    // 生成下載按鈕 HTML
                    const buttonHtml = `
                    <a href="${data.url}" 
                       class="ai-download-btn" 
                       download="${data.fileName}"
                       target="_blank">
                      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                        <polyline points="7 10 12 15 17 10"></polyline>
                        <line x1="12" y1="15" x2="12" y2="3"></line>
                      </svg>
                      <span>下載 ${data.fileName}</span>
                    </a>
                  `;

                    return buttonHtml;
                } catch (e) {
                    console.error('解析下載按鈕失敗:', e);
                    return match; // 解析失敗就返回原始文字
                }
            });
        }

        // ── SQL 展開/收合（事件委派）──
        $msgs.on('click', '.ai-sql-toggle', function () {
            var $code  = $('#' + $(this).data('target'));
            var isOpen = $code.hasClass('show');
            $code.toggleClass('show', !isOpen);
            $(this).html(isOpen
                ? '<i class="ri-code-s-slash-line"></i> 查看執行 SQL'
                : '<i class="ri-code-s-slash-line"></i> 收合 SQL');
        });

        function scrollBottom() { $msgs.scrollTop($msgs[0].scrollHeight); }

        // ── 送出訊息 ──
        function sendMessage() {
            var text = $input.val().trim();
            if (!text) return;

            appendUserMsg(text);
            $input.val('');

            // 停用輸入 + 顯示思考泡泡
            $panel.addClass('ai-sending');
            var $thinking = $('<div class="ai-msg bot" id="aiThinkingRow">' +
                '<div class="bubble" style="color:rgba(255,255,255,.55);font-style:italic;">' +
                    '<i class="ri-loader-4-line ai-spin" style="margin-right:5px;"></i>思考中…' +
                '</div></div>');
            $msgs.append($thinking);
            scrollBottom();

            $.ajax({
                url: _apiBase + '/api/AIChat/Chat',
                type: 'POST',
                contentType: 'application/json',
                xhrFields: { withCredentials: true },
                data: JSON.stringify({
                    SessionId:   _sessionId,   // 第一輪 null，後續帶 sessionId
                    UserMessage: text
                }),
                success: function (resp) {
                    $('#aiThinkingRow').remove();
                    $panel.removeClass('ai-sending');

                    if (resp && resp.Success) {
                        _sessionId = resp.SessionId;
                        sessionStorage.setItem(_storageKey, _sessionId);  // 同步存入 sessionStorage
                        appendBotMsg(resp.Answer);
                    } else {
                        appendBotMsg((resp && resp.Answer) ? resp.Answer : '發生未知錯誤，請稍後再試。');
                    }
                },
                error: function (xhr) {
                    $('#aiThinkingRow').remove();
                    $panel.removeClass('ai-sending');
                    if (xhr.status === 401 || xhr.status === 403) {
                        appendBotMsg('⚠️ 您沒有使用此功能的權限。');
                    } else {
                        appendBotMsg('連線失敗（HTTP ' + xhr.status + '），請稍後再試。');
                    }
                }
            });
        }

        $send.on('click', sendMessage);
        $input.on('keydown', function (e) {
            if (e.key === 'Enter' && !e.shiftKey) { e.preventDefault(); sendMessage(); }
        });

    })();
    </script>
</body>
</html>