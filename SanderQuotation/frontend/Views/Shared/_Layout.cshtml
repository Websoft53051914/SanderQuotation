    <script>


        function SetGridInfoCookieForEdit(name) {
            var cookieObj = JSON.parse(Cookies.get(name) ?? JSON.stringify({}));
            cookieObj.FromEdit = true;
            Cookies.set(name, JSON.stringify(cookieObj), { expires: 1 });
        }

        function GetEditData(url,successCallBack = ()=>{} , errorCallBack= ()=>{}) {
            $.ajax({
                url: url,
                type: "GET",
                success: function (data) {
                    successCallBack(data);
                },
                error: function (jqXHR, textStatus, errorThrown) {
                    const statusCode = jqXHR.status;
                    let errorMsg = "";
                    let icon = 'error';
                    if(statusCode == 404){
                        errorMsg = '@(config.GetMessage("Data_Not_Found").ToHtmlString())';
                        icon = 'info';
                    } else {
                        errorMsg = '@(config.GetMessage("System_Error").ToHtmlString())';
                    }

                    Swal.fire({
                        icon: icon,
                        title: errorMsg,
                        confirmButtonText: '@(config.GetMessage("Confirm").ToHtmlString())',
                    }).then(() => {
                        errorCallBack();
                    });
                }
            });
        }

        /**
         * Call Common Controller 
         */
        async function GetCommon(method){
            try {
                const result = await $.ajax({
                    url: `@(Configuration["BackendURL"])/api/Common/${method}`,
                    type: "GET",
                });
                return result; 
            } catch (error) {
                console.error("請求出錯了：", error);
                throw error; 
            }
        }

        /**
         * Call Common Controller for Multiple Methods
         */
        async function GetCommonMultiple(methods) {
            // 1. 將 method 陣列轉換成多個 AJAX 請求（Promise 陣列）
            const requests = methods.map(method => {
                return $.ajax({
                    url: `@(Configuration["BackendURL"])/api/Common/${method}`,
                    type: "GET",
                });
            });

            // 2. 使用 Promise.all 等待所有請求完成
            try {
                const results = await Promise.all(requests);
                return results; 
            } catch (error) {
                console.error("請求出錯了：", error);
                throw error; 
            }
        }

        /**
         * 渲染 Select Option
         */
        function RenderOptions(id, list) {
            const $select = $(`#${id}`);
    
            // 先清空現有的選項（保留第一個可能是「請選擇」的選項，如果有的話）
            // $select.empty(); // 如果要全清空用這個
            $select.find('option:not([value=""])').remove(); 

            // 建立 DocumentFragment 效能較好
            const items = list.map(item => {
                const text = item.Text;
                const value = item.Value;
                const type = item.Type ?? '';

                return `<option value="${value}" data-type="${type}" >${text}</option>`;
            });

            $select.append(items.join(''));
        }

        if("@(CultureInfo.CurrentUICulture.Name?.ToLower().ToHtmlString())" === "zh-tw"){
            flatpickr.localize(flatpickr.l10ns.zh_tw);
        }


        const pageSizeWrapper = $('<div>', { class: 'page-size-wrapper' }).append(
            $('<label>', {
                for: 'pageSize',
