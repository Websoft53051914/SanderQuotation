<script>
    (function () {
        const $btn = $('#btnToggleFmRight');
        const $right = $('.fm-right');
        const $center = $('.fm-center');

        const $chevron = $btn.find('.toggle-chevron');

        $btn.on('click', function () {
            const isHidden = $right.is(':hidden');
            if (isHidden) {
                $right.show();
                $center.removeClass('fm-center-expanded');
                $chevron.removeClass('ri-arrow-left-s-line').addClass('ri-arrow-right-s-line');
            } else {
                $right.hide();
                $center.addClass('fm-center-expanded');
                $chevron.removeClass('ri-arrow-right-s-line').addClass('ri-arrow-left-s-line');
            }
        });
    })();
</script>


