        width: 350px;
        display: none;
    }

        #uploadProgressContainer .card {
            box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
        }

    .fm-container {
        display: flex;
        flex-wrap: nowrap;
        width: calc(100% + var(--vz-grid-gutter-width));
        margin-left: calc(var(--vz-grid-gutter-width) * -0.5);
        margin-right: calc(var(--vz-grid-gutter-width) * -0.5);
        min-width: 0;
        min-height: calc(100vh - 80px);
        background-color: #f0f2f5;
        gap: 0;
