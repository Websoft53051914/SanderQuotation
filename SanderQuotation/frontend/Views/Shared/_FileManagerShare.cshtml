<style>
     /*樹狀結構 排列*/

       
     .file-manager-menu {
         padding: 0px 24px 0px;
         display: flex;
         flex-direction: column;
         flex: 1 1 auto;
         min-height: 0;
         height: 100%;
     }

     .file-manager-menu > li {
         display: flex;
         flex-direction: column;
         flex: 1 1 auto;
         min-height: 0;
     }

  #folderTreeWrapper {
    display: flex;
    flex-direction: column;
}
#subFolder {
    flex: 1 1 auto;
    min-height: 0;
    overflow-y: auto;   /* ⭐ 滾動只放這裡 */
}

    #subFolder,
    #subFolder ul {
        padding-left: 0;
        margin-bottom: 0;
         
    }

        #subFolder li {
            list-style: none;
            margin: 2px 0;
        }

            /*
             * 讓 li.tree-item 使用 flex 布局：
             *   - 使主題 .sub-menu li::before 偽元素（小點）與 tree-node 垂直置中對齊
             *   - .tree-node  → flex: 1  填滿 ::before 以外的橫向空間
             *   - .tree-children → flex: 0 0 100% 換行後佔滿完整寬度
             * 最小修改：僅針對 .tree-item，不影響其他 sub-menu li
             */
            #subFolder li.tree-item {
                display: flex;
                align-items: center;
                flex-wrap: wrap;
                position: relative;
            }

            #subFolder li.tree-item > .tree-node {
                flex: 1 1 0%;
                min-width: 0;
                flex-wrap: nowrap;
            }

              
                #subFolder li.tree-item::before {
                    position: static !important;
                    top: unset !important;
                    left: unset !important;
                    transform: none !important;
                    align-self: center;
                    flex-shrink: 0;
                }

                /* tree-children 換行後佔滿完整寬度，避免與 tree-node 並排 */
                #subFolder li.tree-item > .tree-children {
                    flex: 0 0 100%;
                    width: 100%;
                }

    .tree-node {
        display: flex;
        align-items: center;
        gap: 6px;
        padding: 2px 3px;
        border-radius: 6px;
        cursor: pointer;
        user-select: none;
        flex-wrap: nowrap;
        overflow: hidden;
    }

        .tree-node:hover {
            background-color: #f5f6f8;
        }

        /* [調整 Apps UI 風格] active 節點補上主題 primary 文字色 */
        .tree-node.active {
            background-color: #e9f2ff;
            color: #405189;
        }


    .tree-label {
        flex: 1 1 auto;
        min-width: 0;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        font-size: 13px;
    }

    .tree-children {
        display: none;
    }

    .tree-loading,
    .tree-empty,
    .tree-error {
        padding: 4px 6px 4px 24px;
        font-size: 13px;
    }

    .tree-loading {
        color: #888;
    }

    .tree-empty {
        color: #999;
    }

    .tree-error {
        color: #dc3545;
    }
</style>

