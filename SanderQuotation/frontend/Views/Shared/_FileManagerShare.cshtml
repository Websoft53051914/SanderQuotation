@model NasFileManagerScriptOptions
@{
    var mapUrl = new
    {
        NasList = $"{Configuration["BackendURL"]}/api/nas/list",
        NasDownload = $"{Configuration["BackendURL"]}/api/nas/download",
        NasDelete = $"{Configuration["BackendURL"]}/api/nas/delete",
        NasCreateFolder = $"{Configuration["BackendURL"]}/api/nas/create_folder",
        NasUpload = $"{Configuration["BackendURL"]}/api/nas/upload",
        NasCancelUpload = $"{Configuration["BackendURL"]}/api/nas/cancel_upload",
        ReName = $"{Configuration["BackendURL"]}/api/nas/rename",
        Root = $"{Configuration["BackendURL"]}/api/nas/root",
        Children = $"{Configuration["BackendURL"]}/api/nas/children",
        DirSizeStart = $"{Configuration["BackendURL"]}/api/nas/start",
        DirSizeStatus = $"{Configuration["BackendURL"]}/api/nas/status",
        DirSizeStop = $"{Configuration["BackendURL"]}/api/nas/stop"
    };

    var mapText = new
    {
        Text_Uploading = (config.GetMessage("Uploading").ToHtmlString()),
        Text_UploadingToNAS = (config.GetMessage("UploadingToNAS").ToHtmlString()),
        Text_UploadCancelled = (config.GetMessage("UploadCancelled").ToHtmlString()),
    };

  
    var reqTypeUrl = Model?.ReqTypeUrl ?? "";
    var extraCode = Model?.ExtraCode ?? "";
    var projectId = Model?.ProjectId ?? "";


    string BuildUrl(string baseUrl, string reqType, string? extra = null)
    {
        if (string.IsNullOrWhiteSpace(extra))
        {
            return $"{baseUrl}{reqType}";
        }
        return $"{baseUrl}{reqType}?extraCode={extra}";
    }

    var rootUrl = BuildUrl(mapUrl.Root, reqTypeUrl, extraCode);
    var childrenUrl = BuildUrl(mapUrl.Children, reqTypeUrl, extraCode);

    var listUrl = BuildUrl(mapUrl.NasList, reqTypeUrl, extraCode);
    var downloadUrl = BuildUrl(mapUrl.NasDownload, reqTypeUrl, extraCode);
    var deleteUrl = BuildUrl(mapUrl.NasDelete, reqTypeUrl, extraCode);
    var createFolderUrl = BuildUrl(mapUrl.NasCreateFolder, reqTypeUrl, extraCode);
    var uploadUrl = BuildUrl(mapUrl.NasUpload, reqTypeUrl, extraCode);
    var cancelUploadUrl = BuildUrl(mapUrl.NasCancelUpload, reqTypeUrl, extraCode);

    var renameUrl = $"{mapUrl.ReName}{reqTypeUrl}";
    var dirSizeStartUrl = $"{mapUrl.DirSizeStart}{reqTypeUrl}";
    var dirSizeStatusUrl = $"{mapUrl.DirSizeStatus}{reqTypeUrl}";
    var dirSizeStopUrl = $"{mapUrl.DirSizeStop}{reqTypeUrl}";
}

<style>
    #uploadProgressContainer {
        position: fixed;
        top: 80px;
        right: 20px;
