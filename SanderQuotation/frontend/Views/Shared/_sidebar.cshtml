@using System.Net.Http.Headers
@using System.Text
@using System.Text.Json
@using Microsoft.AspNetCore.WebUtilities;
@inject IHttpClientFactory HttpClientFactory
@inject IConfiguration Configuration
@{
    // 定義遞迴函式
    void RenderMenu(List<DispatcherData_Menu> menus, int level = 1)
    {
        if (menus == null || !menus.Any()) return;

        foreach (var item in menus)
        {
            if (item.IsVisible != true) continue;

            bool hasSubMenu = item.SubMenu != null && item.SubMenu.Count > 0;
            string collapseId = $"sidebar-{item.MenuCode}";

            if (!hasSubMenu)
            {
                // --- 葉子節點 (沒有子選單) ---
                string url = string.IsNullOrEmpty(item.Url) ? "#" : (item.Url.StartsWith("/") ? item.Url : "/" + item.Url);
                var queryParams = new Dictionary<string, string>
{
    // { "systemCode", item.SystemCode },
    { "moduleCode", item.ModuleCode },
    { "breadcrumb", item.Breadcrumb },
    { "menuCode", item.MenuCode }
};
                url = QueryHelpers.AddQueryString(url, queryParams);

                <li class="nav-item">
                    <a class="nav-link" href="@url" data-menu="@item.MenuCode">
                        @if (level == 1)
                        {
                            <i class="@item.Icon"></i>
                        }
                        <span data-key="t-@item.MenuCode">@item.MenuName</span>
                    </a>
                </li>
            }
            else
            {
                // --- 父節點 (有子選單) ---
                <li class="nav-item">
                    @* 第一層需要 menu-link，第二層以後通常不需要或有特定 class *@
                    <a class="nav-link @(level == 1 ? "menu-link" : "")"
                       href="#@collapseId"
                       data-bs-toggle="collapse"
                       role="button"
                       aria-expanded="false"
                       aria-controls="@collapseId">
                        @if (level == 1)
                        {
                            <i class="@item.Icon"></i>
                        }
                        <span data-key="t-@item.MenuCode">@item.MenuName</span>
                    </a>

                    <div class="collapse menu-dropdown" id="@collapseId">
                        <ul class="nav nav-sm flex-column">
                            @{
                                // 遞迴呼叫，層級 +1
                                RenderMenu(item.SubMenu, level + 1);
                            }
                        </ul>
                    </div>
                </li>
            }
        }
    }
    var isDebug = false;
    // #if DEBUG
    isDebug = false;
    // #endif

    // 初始化 model
    DispatcherResponse_Menu_Shell menuModel_Shell = new();
    DispatcherResponse_Menu menuModel = new DispatcherResponse_Menu() { Data = new List<DispatcherData_Menu>() };
    var apiUrl = Configuration.GetValue<string>("BackendUrl") + "/api/Menu/GetMAIN";

    try
    {
        var client = HttpClientFactory.CreateClient();

        // 帶 JWT Cookie
        if (Context.Request.Cookies.ContainsKey(Const.Value.JWT_TokenName))
        {
            var jwt = Context.Request.Cookies[Const.Value.JWT_TokenName];
            client.DefaultRequestHeaders.Add("Cookie", $"{Const.Value.JWT_TokenName}={jwt}");
        }

        // POST JSON
        var requestContent = new StringContent("{}", Encoding.UTF8, "application/json");

        var responseTask = client.PostAsync(apiUrl, requestContent);
        responseTask.Wait(); // Razor 須同步等待
        var response = responseTask.Result;

        if (response.IsSuccessStatusCode)
        {
            var jsonStringTask = response.Content.ReadAsStringAsync();
            jsonStringTask.Wait();
            var jsonString = jsonStringTask.Result;

            // JSON 反序列化成動態物件
            menuModel_Shell = JsonSerializer.Deserialize<DispatcherResponse_Menu_Shell>(jsonString, new JsonSerializerOptions { PropertyNameCaseInsensitive = true });

            if (menuModel_Shell != null && menuModel_Shell.Success == true)
            {
                menuModel = menuModel_Shell.Data;
            }
        }
    }
    catch (Exception ex)
    {

    }
}
