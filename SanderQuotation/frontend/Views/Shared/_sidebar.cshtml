        //if (true) { //先全展開

            // 只展開有 menu-link 類別的第一層父選單項目
            $('#navbar-nav a.nav-link.menu-link[data-bs-toggle="collapse"]').each(function () {
                var $this = $(this);
                var targetId = $this.attr('href');
                if (targetId && targetId.startsWith('#')) {
                    var $collapseDiv = $(targetId);
                    if ($collapseDiv.length > 0) {
                        $collapseDiv.addClass('show');
                        $this.attr('aria-expanded', 'true');
                    }
                }
            });
        }
    });
        </script>