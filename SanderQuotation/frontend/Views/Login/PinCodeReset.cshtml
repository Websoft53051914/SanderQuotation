@{
    ViewBag.Title = (config.GetMessage("Forgot_Pin_Code").ToHtmlString());
    Layout = null;
}


<!doctype html>
<html lang="en" data-layout="vertical" data-topbar="light" data-sidebar="ladylip" data-sidebar-size="lg">
<head>
    @Html.Partial("~/Views/Shared/_title_meta.cshtml")
    @Html.Partial("~/Views/Shared/_head_css.cshtml")
    <link href="~/assets/libs/sweetalert2/sweetalert2.min.css" rel="stylesheet" type="text/css" />

</head>
<body >

    <div class="auth-page-wrapper pt-5">
        <!-- auth page bg -->
        <div class="auth-one-bg-position auth-one-bg" id="auth-particles">
            <div></div>
             <div class="bg-overlay"></div> 

             <div class="shape">
                <svg xmlns="http://www.w3.org/2000/svg" version="1.1" xmlns:xlink="http://www.w3.org/1999/xlink" viewBox="0 0 1440 120">
                    <path d="M 0,36 C 144,53.6 432,123.2 720,124 C 1008,124.8 1296,56.8 1440,40L1440 140L0 140z"></path>
                </svg>
            </div> 
        </div>

        <!-- auth page content -->
        <div class="auth-page-content">
            <div class="container">
                <div class="row">
                    <div class="col-lg-12">
                        <div class="text-center mt-sm-5 mb-4 text-white-50">
                            <div>
                                <img src="~/assets/images/logo.svg" alt="" style="filter: brightness(0) invert(1);">
@*                                 <a href="@Url.Action("Index", "Dashboard")" class="d-inline-block auth-logo">
                                    <img src="~/assets/images/logo-light.png" alt="" height="20">
                                </a> *@
                            </div>
                            @* <p class="mt-3 fs-16 fw-semibold">Premium Admin & Dashboard Template</p> *@
                        </div>
                    </div>
                </div>
                <!-- end row -->

                <div class="row justify-content-center">
                    <div class="col-md-8 col-lg-6 col-xl-5">
                        <div class="card mt-4  card-bg-fill">

                            <div class="card-body p-4">
                                <div class="text-center mt-2">
                                    <h5 class="text-primary">
                                        @(config.GetMessage("Forgot_Pin_Code").ToHtmlString())？
                                    </h5>
                                    @* <p class="text-muted">Reset password with velzon</p> *@

                                    <lord-icon src="https://cdn.lordicon.com/rhvddzym.json"
                                               trigger="loop"
                                               colors="primary:#0ab39c"
                                               class="avatar-xl">
                                    </lord-icon>

                                </div>

                                <div class="alert border-0 alert-warning text-center mb-2 mx-2" role="alert">
                                    @(config.GetMessage("Please_enter_your_email_address,_we_will_send_you_instructions!").ToHtmlString())
                                </div>
                                <div class="p-2">
                                    <form>
                                        <div class="mb-4">
                                            <label class="form-label">
                                                @(config.GetMessage("Email").ToHtmlString())
                                            </label>
                                            <input type="email" class="form-control focusinput" id="email" placeholder="@(config.GetMessage("Please_enter_email").ToHtmlString())">
                                        </div>

                                        <div class="text-center mt-4">
                                            <button class="btn btn-success w-100" type="button" id="custom-sa-email-verify">
                                                @(config.GetMessage("Send_Reset_Link").ToHtmlString())
                                            </button>
                                        </div>
                                    </form><!-- end form -->
                                </div>
                            </div>
                            <!-- end card body -->
                        </div>
                        <!-- end card -->

                        <div class="mt-4 text-center">
                            <p class="mb-0">
                                @(config.GetMessage("Wait,_I_remembered_my_pin_code...").ToHtmlString())
                                <a href="@Url.Action("TwoStepVerificationBasic", "Login")" class="fw-semibold text-primary text-decoration-underline">
                                    @(config.GetMessage("Click_here").ToHtmlString())
                                </a>
                            </p>
                        </div>
                    </div>
                </div>
                <!-- end row -->
            </div>
            <!-- end container -->
        </div>
        <!-- end auth page content -->
        <!-- footer -->
        <footer class="footer">
            <div class="container">
                <div class="row">
                    <div class="col-lg-12">
                        <div class="text-center">
                        </div>
                    </div>
                </div>
            </div>
        </footer>
        <!-- end Footer -->
    </div>
    <!-- end auth-page-wrapper -->
    @Html.Partial("~/Views/Shared/_vendor_scripts.cshtml")

    <!-- particles js -->
    <script src="~/assets/libs/particles.js/particles.js"></script>

    <!-- particles app js -->
    <script src="~/assets/js/pages/particles.app.js"></script>

    <script src="~/assets/libs/sweetalert2/sweetalert2.min.js"></script>
    <script>
        //Custom Email varification
        if (document.getElementById("custom-sa-email-verify"))
            document.getElementById("custom-sa-email-verify").addEventListener("click", function () {
                var tempEmail=document.getElementById("email").value;
                if(document.getElementById("email").value==''){
                    Swal.fire({
                                title: '@(config.GetMessage("Please_enter_email").ToHtmlString())',
                        customClass: {
                            confirmButton: 'btn btn-primary w-xs mt-2',
                        },
                        buttonsStyling: false,
                        confirmButtonText: '@(config.GetMessage("Confirm").ToHtmlString())',
                        showCloseButton: true
                    });
                    return;
                }

                Swal.fire({
                    html: '<div class="mt-3">' +
                        '<div class="avatar-lg mx-auto">' +
                        '<div class="avatar-title bg-light text-success display-5 rounded-circle">' +
                        '<i class="ri-mail-send-fill"></i>' +
                        '</div>' +
                        '</div>' +
                        '<div class="mt-4 pt-2 fs-15">' +
                        '<p class="text-muted mb-0 mt-3 fs-13">@(config.GetMessage("We_have_sent_a_verification_email_to...").ToHtmlString())<span class="fw-medium text-dark">'+tempEmail+'</span>, <br/> @(config.GetMessage("Please_check").ToHtmlString())。</p>' +
                        '</div>' +
                        '</div>',
                    showCancelButton: false,
                    customClass: {
                        confirmButton: 'btn btn-primary mb-1',
                    },
                    confirmButtonText: '@(config.GetMessage("Confirm").ToHtmlString())',
                    buttonsStyling: false,
                    // footer: '<p class="fs-14 text-muted mb-0">Didn\'t receive an email ? <a href="#" class="fw-semibold text-decoration-underline">Resend</a></p>',
                    showCloseButton: true
                }).then((result) => {
                    location.href = '@Url.Action("Index", "Login")';
                });
            });

    </script>
    <script src="~/js/common.js"></script>
</body>
</html>
