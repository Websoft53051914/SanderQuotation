@{
    ViewBag.Title = config.GetMessage("Login").ToHtmlString();
    Layout = null;

    var password = "";
    var _autoLogin = frontend.Common.Method.GetAppSettingsDataByName("AutoLogin");
    if (!string.IsNullOrEmpty(_autoLogin))
    {
        password = "temp";
    }
}
<!doctype html>
<html lang="en" data-layout="vertical" data-topbar="light" data-sidebar="ladylip" data-sidebar-size="lg">
<head>

    <!-- gridjs css -->








    @Html.Partial("~/Views/Shared/_title_meta.cshtml")
    @Html.Partial("~/Views/Shared/_head_css.cshtml")
    <link href="~/assets/libs/sweetalert2/sweetalert2.min.css" rel="stylesheet" type="text/css" />
    <link href="/lib/select2/select2.min.css" rel="stylesheet" />

    <link rel="stylesheet" href="~/assets/css/app.css" />


    <script src="/lib/jquery/dist/jquery.min.js"></script>
    <script src="/lib/select2/select2.min.js"></script>
    <style>
        .mlr-20 {
            margin: 0px 20px 0px 20px;
        }

        .auth-one-bg{
            background-image: none;
        }
    </style>
</head>
<body>
    <partial name="_Loader">

        <div class="auth-page-wrapper pt-5" id="loginShell">
            <!-- auth page bg -->
            <div class="auth-one-bg-position auth-one-bg" id="auth-particles">
                <div class="bg-overlay"></div>
                <div></div>
                <div class="shape">
                    <svg xmlns="http://www.w3.org/2000/svg" version="1.1" xmlns:xlink="http://www.w3.org/1999/xlink" viewBox="0 0 1440 120">
                        <path d="M 0,36 C 144,53.6 432,123.2 720,124 C 1008,124.8 1296,56.8 1440,40L1440 140L0 140z"></path>
                    </svg>
                </div>
            </div>
            <!-- auth page content -->
            <div class="auth-page-content">
                <div class="container">
                    <div class="row">
                        <div class="col-lg-12">
                            <div class="text-center mt-sm-5 mb-4 text-white-50">
                                <div>
                                    <img src="~/assets/images/logo.png" alt="" style="width:40%;">
                                    @*          <a href="@Url.Action("TwoStepVerificationBasic", "Login")" class="d-inline-block auth-logo">
                                </a> *@
                                </div>
                                @* <p class="mt-3 fs-15 fw-semibold">Premium Admin & Dashboard Template</p> *@
                            </div>
                        </div>
                    </div>
                    <!-- end row -->
                    <div class="row justify-content-center">
                        <div class="col-md-8 col-lg-6 col-xl-5">
                            <div class="card mt-4 card-bg-fill">
                                <div class="card-body p-4">
                                    <div class="text-center mt-2">
                                        @* <h5 class="text-primary">@config.GetMessage("WelcomeBack").ToHtmlString() </h5> *@
                                    </div>
                                    <div class="p-2 mt-2">
                                        <form action="@Url.Action("TwoStepVerificationBasic", "Login")">
                                            <div class="mb-3">
                                                <label for="username" class="form-label">帳號</label>
                                                <input type="text" class="form-control focusinput" id="username" placeholder="請輸入帳號">
                                            </div>
                                            <div class="mb-3">
                                                <label class="form-label" for="password-input">密碼</label>
                                                <div class="position-relative auth-pass-inputgroup mb-3">
                                                    <input type="password" class="form-control pe-5 password-input" placeholder="請輸入密碼" id="password-input" value="@password">
                                                    <button class="btn btn-link position-absolute end-0 top-0 text-decoration-none text-muted password-addon material-shadow-none" type="button" id="password-addon"><i class="ri-eye-fill align-middle"></i></button>
                                                </div>
                                            </div>
                                            <div class="form-check">
                                                <input class="form-check-input" type="checkbox" value="" id="auth-remember-check">
                                                <label class="form-check-label" for="auth-remember-check">記住帳號</label>
                                            </div>
                                            <div class="mt-4">
                                                <button class="btn btn-success w-100" type="submit" id="btnSubmit">登入</button>
                                            </div>
                                        </form>
                                    </div>
                                </div>
                                <!-- end card body -->
                            </div>
                            <!-- end card -->
                        </div>
                    </div>
                    <!-- end row -->
                </div>
                <!-- end container -->
            </div>
            <!-- end auth page content -->
            <!-- footer -->
            <footer class="footer">
                <div class="container">
                    <div class="row">
                        <div class="col-lg-12">
                            <div class="text-center">
                            </div>
                        </div>
                    </div>
                </div>
            </footer>
            <!-- end Footer -->
        </div>
        <div class="auth-page-wrapper pt-5" id="twoStepShell_PinCode" style="display:none;">
            <!-- auth page bg -->
            <div class="auth-one-bg-position auth-one-bg" id="auth-particles">
                <div></div>
                <div class="bg-overlay"></div>
                <div class="shape">
                    <svg xmlns="http://www.w3.org/2000/svg" version="1.1" xmlns:xlink="http://www.w3.org/1999/xlink" viewBox="0 0 1440 120">
                        <path d="M 0,36 C 144,53.6 432,123.2 720,124 C 1008,124.8 1296,56.8 1440,40L1440 140L0 140z"></path>
                    </svg>
                </div>
            </div>
            <!-- auth page content -->
            <div class="auth-page-content">
                <div class="container">
                    <div class="row">
                        <div class="col-lg-12">
                            <div class="text-center mt-sm-5 mb-4 text-white-50">
                                <div>
                                    <img src="~/assets/images/logo.svg" alt="" style="filter: brightness(0) invert(1);">
                                </div>
                            </div>
                        </div>
                    </div>
                    <!-- end row -->
                    <div class="row justify-content-center">
                        <div class="col-md-8 col-lg-6 col-xl-5">
                            <div class="card mt-4 card-bg-fill">
                                <div class="card-body p-4">
                                    <div class="mb-4">
                                        <div class="avatar-lg mx-auto PinCode" style="display:none;">
                                            <div class="avatar-title bg-light text-primary display-5 rounded-circle">
                                                <img id="myImg" src="~/assets/images/users/user-dummy-img.jpg" class="rounded-circle img-thumbnail avatar-lg material-shadow" alt="thumbnail" />
                                            </div>
                                        </div>
                                        <div class="avatar-lg mx-auto VerifyCode" style="display:none;">
                                            <div class="avatar-title bg-light text-primary display-5 rounded-circle">
                                                <i class="ri-key-fill"></i>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="p-2 mt-4">
                                        <div class="text-muted text-center mb-4 mx-lg-3">
                                            <h4 class="PinCode" style="display:none;">
                                                請輸入您的 PIN 碼
                                            </h4>
                                            <h4 class="VerifyCode" style="display:none;">
                                                請輸入您的驗證碼
                                            </h4>
                                        </div>
                                        <form autocomplete="off">
                                            <div class="row">
                                                <div class="col-3">
                                                    <div class="mb-3 mlr-20">
                                                        <label for="digit1-input" class="visually-hidden">Digit 1</label>
                                                        <input type="password" class="form-control form-control-lg bg-light border-light text-center focusinput" onkeyup="moveToNext(1, event)" maxLength="1" id="digit1-input">
                                                    </div>
                                                </div><!-- end col -->
                                                <div class="col-3">
                                                    <div class="mb-3 mlr-20">
                                                        <label for="digit2-input" class="visually-hidden">Digit 2</label>
                                                        <input type="password" class="form-control form-control-lg bg-light border-light text-center" onkeyup="moveToNext(2, event)" maxLength="1" id="digit2-input">
                                                    </div>
                                                </div><!-- end col -->
                                                <div class="col-3">
                                                    <div class="mb-3 mlr-20">
                                                        <label for="digit3-input" class="visually-hidden">Digit 3</label>
                                                        <input type="password" class="form-control form-control-lg bg-light border-light text-center" onkeyup="moveToNext(3, event)" maxLength="1" id="digit3-input">
                                                    </div>
                                                </div><!-- end col -->
                                                <div class="col-3">
                                                    <div class="mb-3 mlr-20">
                                                        <label for="digit4-input" class="visually-hidden">Digit 4</label>
                                                        <input type="password" class="form-control form-control-lg bg-light border-light text-center" maxLength="1" id="digit4-input">
                                                    </div>
                                                </div><!-- end col -->
                                            </div>
                                            <div class="float-end PinCode" style="display:none;">
                                                <a href="javascript:void(0);" id="PinCodeReset" class="text-muted">
                                                    忘記 PIN 碼?
                                                </a>
                                            </div>
                                            <div class="float-end VerifyCode" style="display:none;">
                                                <a href="javascript:void(0);" id="ReSentVerifyCode" class="text-muted">
                                                    重新發送驗證碼
                                                </a>
                                            </div>
                                            <div class="mt-3">
                                                <button type="submit" class="btn btn-success w-100" id="btnPinCode">
                                                    確認
                                                </button>
                                            </div>
                                        </form><!-- end form -->
                                    </div>
                                </div>
                                <!-- end card body -->
                            </div>
                            <!-- end card -->
                        </div>
                    </div>
                    <!-- end row -->
                </div>
                <!-- end container -->
            </div>
            <!-- end auth page content -->
            <!-- footer -->
            <footer class="footer">
                <div class="container">
                    <div class="row">
                        <div class="col-lg-12">
                        </div>
                    </div>
                </div>
            </footer>
            <!-- end Footer -->
        </div>
        <!-- end auth-page-wrapper -->
        @Html.Partial("~/Views/Shared/_vendor_scripts.cshtml")
        <!-- particles js -->
        <script src="~/assets/libs/particles.js/particles.js"></script>
        <!-- particles app js -->
        <script src="~/assets/js/pages/particles.app.js"></script>
        <!-- password-addon init -->
        <script src="~/assets/js/pages/password-addon.init.js"></script>
        <script src="~/assets/libs/sweetalert2/sweetalert2.min.js"></script>
        <script>             
            var companyArr = [];
            var loadToken = "";
            var tempToken = "";
            var companySelect2 = null;   // 使用 select2 變數
            if (document.getElementById("btnSubmit"))
              document.getElementById("btnSubmit").addEventListener("click", function(e) {
                e.preventDefault();
                if (document.getElementById("username").value.length == 0 || document.getElementById("password-input").value.length == 0) {
                  Swal.fire({
                    title: '請輸入帳號密碼',
                    customClass: {
                      confirmButton: 'btn btn-primary w-xs mt-2',
                    },
                    buttonsStyling: false,
                    confirmButtonText: '確認',
                    showCloseButton: true
                  });
                  return;
                }
                var username = $('#username').val();
                var password = $('#password-input').val();
                showLoader();

                $.ajax({
                  url: '@(config.GetBackendUrl() + "/api" + Url.Action("AuthDoPost", "Auth"))',
                  xhrFields: {
                    withCredentials: true // 🔴 沒這行，Cookie 不會存
                  },
                  type: 'POST',
                  contentType: 'application/json', // ⭐ 必須
                  data: JSON.stringify({
                    UserName: username,
                    Password: password,
                  }),
                  success: function(res) {
                       hideLoader();
                    var msg = res.Success ? res.Data : res.Message;
                    var alertType1 = res.Success ? "success" : "error";
                    if (res.Success) {
                        if ($('#auth-remember-check').is(':checked')) {
                            localStorage.setItem("login_username", $('#username').val());
                            localStorage.setItem("remember_account", "1");
                        } else {
                            localStorage.removeItem("login_username");
                            localStorage.removeItem("remember_account");
                        }
                        // 登入時清除上一位使用者的 AI 聊天紀錄
                        sessionStorage.removeItem('aiChatSessionId');
                        sessionStorage.removeItem('aiChatMessages');
                      location.href = '@Url.Action("Index", "Home")';
                      
                    } else {

                       Swal.fire({
                            icon:alertType1,
                            title:msg,
                            confirmButtonText: '確認',
                        });

                    }
                  },
                  error: function(xhr) {
                    hideLoader();
                    Swal.fire({
                            icon:'error',
                            title:'登入錯誤',
                            confirmButtonText: '確認',
                        });
                  }
                });
              });
            // 簡寫形式
            $(function() { 
                if (localStorage.getItem("remember_account") == "1") {
                    $('#auth-remember-check').prop('checked', true);
                    $('#username').val(localStorage.getItem("login_username"));
                }
            });
        </script>
        <script src="~/js/common.js"></script>
        <script src="~/assets/js/pages/two-step-verification.init.js"></script>
</body>
</html>