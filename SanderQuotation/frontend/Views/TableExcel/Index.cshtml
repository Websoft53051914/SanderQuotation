                sheets[activeSheetIndex]._excelHeaders = [];
                renderMappingTable(collectMappingRows(), $('#tableName').val());
                return;
            }
            loadExcelColumns(filePath, function (headers) {
                sheets[activeSheetIndex]._excelHeaders = headers;
