        function loadExcelColumns(filePath, callback) {
            $.ajax({
                url: pageUrls.GetExcelColumns,
                type: 'GET',
                data: { filePath: filePath },
                success: function (res) {
                    if (res.Success) {
                        if (callback) callback(res.Data || []);
                    } else {
                        if (callback) callback([]);
                    }
                },
                error: function () {
                    if (callback) callback([]);
                }
            });
        }

        // ========================================
        // filePath 變更 → 載入 Excel 欄位
        // ========================================
        $('#filePath').on('change', function () {
