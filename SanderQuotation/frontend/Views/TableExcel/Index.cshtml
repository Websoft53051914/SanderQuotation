        function uploadExcel(file) {
            var $status = $('#excelUploadStatus');
            $status.removeClass('text-danger text-success').text(tableExcelMsg.uploading).show();
            var formData = new FormData();
            formData.append('file', file);
            $.ajax({
                url: pageUrls.UploadExcel,
                type: 'POST',
                data: formData,
                processData: false,
                contentType: false,
                success: function (res) {
                    if (res.Success) {
                        uploadedFilePath = res.Data.filePath || res.Data.FilePath || '';
                        parsedSheets = (res.Data.sheets || res.Data.Sheets || []).map(function (s) {
                            return {
                                name: s.name || s.Name || s.SheetName || '',
                                columnCount: s.columnCount || s.ColumnCount || 0,
                                columns: s.columns || s.Columns || []
                            };
                        });
                        var fileNameWithoutExt = file.name.replace(/\.[^/.]+$/, '');
                        var fileExt = (file.name.match(/\.([^.]+)$/) || [])[1] || '';
                        $('#exampleFileName').val(fileNameWithoutExt);
                        $('#exampleFileType').val(fileExt);
                        $status.addClass('text-success').text(tableExcelMsg.uploadSuccess);
                        renderSheetCheckList();
                        $('#excelParseResult').show();
                    } else {
                        $status.addClass('text-danger').text(tableExcelMsg.uploadFailed + (res.Message || tableExcelMsg.parseFailed));
                    }
                },
                error: function () {
                    $status.addClass('text-danger').text(tableExcelMsg.uploadFailedFormat);
                }
            });
        }

