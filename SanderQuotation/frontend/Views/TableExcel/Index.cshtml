            e.stopPropagation();
            $(this).removeClass('drag-over');
        }).on('drop', function (e) {
            e.preventDefault();
            e.stopPropagation();
            $(this).removeClass('drag-over');
            var files = e.originalEvent.dataTransfer.files;
            if (files.length > 0) {
                uploadExcel(files[0]);
