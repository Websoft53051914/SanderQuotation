        // ========================================
        // Excel 上傳解析（Step 1）
        // ========================================
        function initUploadStep() {
            isEditMode = false;
            editData = null;
            uploadedFilePath = '';
            parsedSheets = [];
            $('#excelFileInput').val('');
            $('#excelParseResult').hide();
            $('#excelDropZone').show().removeClass('drag-over');
            $('#excelUploadStatus').hide().text('');
            $('#description').val('');
            $('#exampleFileType').val('');
            $('#transferMappingCode').val('').prop('readonly', false);
