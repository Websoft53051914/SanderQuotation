        });

        $(document).on('blur', '.sheet-header-row', function () {
            this.value = this.value.replace(/[^0-9]/g, '');
            if (this.value === '' || parseInt(this.value) < 1) {
                this.value = 1;
            }
        });

        $('#btnNextStep').on('click', function () {
            var selected = [];
            $('.sheet-check:checked').each(function () {
                var idx = parseInt($(this).val());
                var headerRowIndex = parseInt($('#sheetHeaderRow' + idx).val()) || 1;
                if (headerRowIndex < 1) headerRowIndex = 1;
                selected.push({ idx: idx, headerRowIndex: headerRowIndex });
            });
            if (selected.length === 0) {
                Swal.fire({ icon: 'warning', title: tableExcelMsg.selectAtLeastOneSheet, confirmButtonText: pageConfig.messages.confirm });
                return;
            }

            sheets = selected.map(function (item) {
                var s = parsedSheets[item.idx];
                return {
                    sheetName: s.name,
                    filePath: uploadedFilePath,
                    dbName: '',
                    tableName: '',
                    mappings: [],
                    headerRowIndex: item.headerRowIndex,
                    _sheetIndex: item.idx,
                    _excelHeaders: []
                };
            });

            var $btn = $(this).prop('disabled', true).text(tableExcelMsg.loading);
            var apiCalls = sheets.map(function (sheet, i) {
                return $.ajax({
                    url: pageUrls.GetSheetColumns,
                    type: 'GET',
                    data: {
                        filePath: uploadedFilePath,
                        sheetIndex: sheet._sheetIndex,
                        headerRowIndex: sheet.headerRowIndex
                    }
                }).then(function (res) {
                    if (res.Success) sheets[i]._excelHeaders = res.Data || [];
                });
            });

            $.when.apply($, apiCalls).always(function () {
                $btn.prop('disabled', false).html(tableExcelMsg.nextStep + ' <i class="ri-arrow-right-line align-bottom"></i>');

                var noHeaderSheets = sheets.filter(function (s) { return !s._excelHeaders || s._excelHeaders.length === 0; });

                if (noHeaderSheets.length > 0) {
                    var msgs = noHeaderSheets.map(function (s) { return s.sheetName + tableExcelMsg.noColumnData; }).join('<br>');
                    Swal.fire({
                        icon: 'error',
                        title: tableExcelMsg.cannotProceed,
                        html: '<div style="text-align:center">' + msgs + '</div>',
                        confirmButtonText: pageConfig.messages.confirm
                    });
                    return;
                }

                activeSheetIndex = 0;
                $('#filePath').val(uploadedFilePath);
                renderSheetTabs();
                showStep2(function () {
                    if (isEditMode) {
                        applyEditDataToStep2();
                    } else {
                        loadSheetToUI(sheets[0]);
                    }
                });
            });
        });

        // ========================================
        // 驗證
        // ========================================
        function validateAllSheets() {
            saveCurrentSheetData();
            var errors = [];

            if (sheets.length === 0) {
                errors.push(tableExcelMsg.minOneSheet);
                return errors;
            }

            sheets.forEach(function (sheet, idx) {
                var prefix = ' [' + sheet.sheetName + ']: ';

                if (!sheet.tableName) {
                    errors.push(prefix + tableExcelMsg.selectTargetTable);
                }

                if (!sheet.mappings || sheet.mappings.length === 0) {
                    errors.push(prefix + tableExcelMsg.minOneMapping);
                    return;
                }

                var excelCols = [];
                var dbCols = [];

                sheet.mappings.forEach(function (m, ri) {
                    var rowLabel = prefix + tableExcelMsg.rowLabel.replace('{0}', ri + 1) + ': ';

                    if (!m.excelColumn) {
                        errors.push(rowLabel + tableExcelMsg.selectExcelColumn);
                    }

                    if (!m.dbColumn) {
                        errors.push(rowLabel + tableExcelMsg.selectDbColumn);
                    }

                    if (m.excelColumn) {
                        if (excelCols.includes(m.excelColumn)) {
                            errors.push(
                                prefix + tableExcelMsg.excelColDuplicate.replace('{0}', m.excelColumn)
                            );
                        } else {
                            excelCols.push(m.excelColumn);
                        }
                    }

                    if (m.dbColumn) {
                        if (dbCols.includes(m.dbColumn)) {
                            errors.push(
                                prefix + tableExcelMsg.dbColDuplicate.replace('{0}', m.dbColumn)
                            );
                        } else {
                            dbCols.push(m.dbColumn);
                        }
                    }

                });

                var primaryKeyCount = sheet.mappings.filter(function (m) { return m.isPrimaryKey; }).length;
                if (primaryKeyCount > 1) {
                    errors.push(prefix + tableExcelMsg.onlyOnePrimaryKey);
                }
            });

            return errors;
        }

        function beforeSubmitValidation() {
            var errors = validateAllSheets();
            if (errors.length > 0) {
                Swal.fire({
                    icon: 'warning',                   
                    html: '<div style="text-align:center">' + errors.join('<br>') + '</div>',
                    confirmButtonText: pageConfig.messages.confirm
                });
                return false;
            }
            return true;
        }

        // ========================================
        // 送出資料準備
        // ========================================
        function prepareSubmitData($form) {
            saveCurrentSheetData();

            var submitSheets = sheets.map(function (s) {
                return {
                    SrcSheetName: s.sheetName,
                    SrcSheetIndex: s._sheetIndex || 0,
                    HeaderRowIndex: s.headerRowIndex || 1,
                    DBName: s.dbName || '',
                    TargetTableName: s.tableName,
                    FilterCondition: s.filterCondition || null,
                    FilterMode: s.filterMode || 'builder',
                    Mappings: s.mappings.map(function (m) {
                        return { SrcFileColumnName: m.excelColumn, TargetTableColumnName: m.dbColumn, IsPrimaryKey: m.isPrimaryKey || false, IsEncrypt: m.isEncrypt || false, DefaultValue: m.defaultValue || null };
                    })
                };
            });

            var data = {
                RowGuid: currentId,
                ExampleFileName: $('#exampleFileName').val() || '',
                SrcNasFilePath: $('#nasfilePath').val() || '',
                Description: $('#description').val() || '',
                UploadedFilePath: uploadedFilePath || '',
                ExampleFileType: $('#exampleFileType').val() || '',
                TransferMappingCode: $('#transferMappingCode').val() || '',
                DBName: $('#DBName').val() || '',

                Sheets: submitSheets
            };

            return {
                data: JSON.stringify(data),
                contentType: 'application/json; charset=utf-8',
                dataType: 'json'
            };
        }

        // ========================================
        // 新增 / 編輯回呼
        // ========================================
        function onBeforeCreate() {
            initUploadStep();
        }

        function onAfterEditFill(data) {
            initUploadStep();
            editData = data;
            isEditMode = true;
            $('#excelDropZone').hide();
            $('#exampleFileName').val(data.ExampleFileName || data.exampleFileName || '');
            $('#exampleFileType').val((data.ExampleFileType || data.exampleFileType || '').replace(/^\./, ''));
            $('#transferMappingCode').val(data.TransferMappingCode || data.transferMappingCode || '').prop('readonly', true);

            var rowGuid = data.RowGuid || data.rowGuid;
            var $status = $('#excelUploadStatus');
            $status
                .removeClass('text-danger text-success')
                .text(tableExcelMsg.loadingTemplate)
                .show();

            $.ajax({
                url: pageUrls.GetExampleFile + '?id=' + rowGuid,
                type: 'GET',
                xhrFields: { responseType: 'blob' },
                success: function (blob) {
                    var fileExt = (data.ExampleFileType || data.exampleFileType || '').replace(/^\./, '');
                    var fileName = (data.ExampleFileName || data.exampleFileName || 'file');
                    var fullName = fileExt ? (fileName + '.' + fileExt) : fileName;
                    var file = new File([blob], fullName, { type: blob.type });

                    var formData = new FormData();
                    formData.append('file', file);

                    $.ajax({
                        url: pageUrls.UploadExcel,
                        type: 'POST',
                        data: formData,
                        processData: false,
                        contentType: false,
                        success: function (res) {
                            if (!res.Success) {
                                    $status             
                                    .addClass('text-danger')
                                    .text(tableExcelMsg.loadFailed +'：' +(res.Message || tableExcelMsg.parseFailed)      
                                );
                                return;
                            }
                            uploadedFilePath = res.Data.filePath || res.Data.FilePath || '';
                            parsedSheets = (res.Data.sheets || res.Data.Sheets || []).map(function (s) {
                                return {
                                    name: s.name || s.Name || s.SheetName || '',
                                    columnCount: s.columnCount || s.ColumnCount || 0,
                                    columns: s.columns || s.Columns || []
                                };
                            });
                            $status
                            .addClass('text-success')
                            .text(tableExcelMsg.templateLoaded);
                            renderSheetCheckListForEdit();
                            $('#excelParseResult').show();
                        },
                        error: function () {
                            $status.addClass('text-danger').text(tableExcelMsg.loadFailedServer);

                        }
                    });
                },
                error: function () {
                    $status.addClass('text-danger').text(tableExcelMsg.loadFailedNoFile);
                }
            });
        }

        function renderSheetCheckListForEdit() {
            var $list = $('#sheetCheckList');
            $list.empty();
            var existingSheets = editData ? (editData.Sheets || editData.sheets || []) : [];

            parsedSheets.forEach(function (s, i) {
                var existingSheet = existingSheets.find(function (es) {
                    return (es.SrcSheetIndex === i || es.srcSheetIndex === i);
                });
                var isChecked = !!existingSheet;
                var headerRowIndex = existingSheet
                    ? (existingSheet.HeaderRowIndex || existingSheet.headerRowIndex || 1)
                    : 1;

                $list.append(
                    '<div class="sheet-item d-flex align-items-center gap-3">' +
                    '<div class="form-check mb-0 flex-grow-1">' +
                    '<input class="form-check-input sheet-check" type="checkbox" id="sheetCheck' + i + '" value="' + i + '" ' + (isChecked ? 'checked' : '') + '>' +
                    '<label class="form-check-label" for="sheetCheck' + i + '">' +
                    '<i class="ri-checkbox-circle-line text-success me-1"></i>' +
                    s.name +
                    '</label>' +
                    '</div>' +
                    '<div class="d-flex align-items-center gap-2 flex-shrink-0">' +
                    '<label class="form-label mb-0 small text-nowrap" for="sheetHeaderRow' + i + '">' + tableExcelMsg.headerRowIndex+'</label>' +
                    '<input maxlength="4" type="text" class="form-control form-control-sm sheet-header-row" id="sheetHeaderRow' + i + '" value="' + headerRowIndex + '" style="width:70px;">' +
                    '</div>' +
                    '</div>'
                );
            });
        }

        function applyEditDataToStep2() {
            if (!editData) {
                loadSheetToUI(sheets[0]);
                return;
            }
            $('#exampleFileName').val(editData.ExampleFileName || editData.exampleFileName || '');
            $('#exampleFileType').val((editData.ExampleFileType || editData.exampleFileType || '').replace(/^\./, ''));
            $('#nasfilePath').val(editData.SrcNasFilePath || editData.srcNasFilePath || '');
            $('#description').val(editData.Description || editData.description || '');

            var existingSheets = editData.Sheets || editData.sheets || [];
            sheets.forEach(function (sheet) {
                var match = existingSheets.find(function (es) {
                    return (es.SrcSheetIndex === sheet._sheetIndex || es.srcSheetIndex === sheet._sheetIndex);
                });
                if (match) {
                    sheet.dbName = match.DBName || match.dbName || '';
                    sheet.tableName = match.TargetTableName || match.targetTableName || '';
                    sheet.filterCondition = match.FilterCondition || match.filterCondition || null;
                    sheet.filterMode = match.FilterMode || match.filterMode || 'builder';
                    sheet.mappings = (match.Mappings || match.mappings || []).map(function (m) {
                        return {
                            excelColumn: m.SrcFileColumnName || m.srcFileColumnName || '',
                            dbColumn: m.TargetTableColumnName || m.targetTableColumnName || '',
                            isPrimaryKey: m.IsPrimaryKey || m.isPrimaryKey || false,
                            isEncrypt: m.IsEncrypt || m.isEncrypt || false,
                            defaultValue: m.DefaultValue || m.defaultValue || ''
                        };
                    });
                }
            });

            var sheetsWithTable = sheets.filter(function (s) { return s.tableName; });
            if (sheetsWithTable.length === 0) {
                loadSheetToUI(sheets[0]);
                return;
            }

            var pending = sheetsWithTable.length;
            sheetsWithTable.forEach(function (sheet) {
                loadDbColumns(sheet.tableName, function () {
                    pending--;
                    if (pending === 0) {
                        loadSheetToUI(sheets[0]);
                    }
                });
            });
        }

        // ========================================
        // 列表頁
        // ========================================
        function renderTableTextBadges(tablesStr) {
            if (!tablesStr) return '';
            return tablesStr.split(',').filter(Boolean).map(function (t) {
                return '<span class="badge bg-primary me-1">' + t.trim() + '</span>';
            }).join('');
        }

       
        function renderTable(rows) {
            const tbody = $('#data-list-data');
            tbody.empty();

            if (!rows || rows.length === 0) {
                $('.noresult').show();
                return;
            }
            $('.noresult').hide();

            rows.forEach(data => {
                var rowGuid = data.RowGuid || data.rowGuid || '';
                var no = data.No || data.no || '';
                var transferMappingCode = data.TransferMappingCode || data.transferMappingCode || '';                                
                var exampleFileName = data.ExampleFileName || data.exampleFileName || '';

                var exampleFileTypeText = data.ExampleFileTypeText || data.exampleFileTypeText || '';
                var srcNasFilePath = data.SrcNasFilePath || data.srcNasFilePath || '';
                var description = data.Description || data.description || '';
                var mappingTables = data.MappingTables || data.mappingTables || '';
                var status = data.Status || data.status || '';

                tbody.append(`
                    <tr data-id="${rowGuid}">
                        <th scope="row">
                            <div class="form-check">
                                <input class="form-check-input row-check" type="checkbox" data-id="${rowGuid}" value="option1">
                            </div>
                        </th>
                        <td>
                            <div class="dropdown">
                                <button class="btn btn-soft-secondary btn-sm dropdown" type="button" data-bs-toggle="dropdown">
                                    <i class="ri-more-fill align-middle"></i>
                                </button>
                                <ul class="dropdown-menu dropdown-menu-end">
                                    <li><a class="dropdown-item edit-item-btn" href="#showModal" data-bs-toggle="modal"><i class="ri-pencil-fill align-bottom me-2 text-muted"></i> 編輯</a></li>
                                    <li><a class="dropdown-item remove-item-btn" data-bs-toggle="modal" href="#deleteOrder"><i class="ri-delete-bin-fill align-bottom me-2 text-muted"></i> 刪除</a></li>
                                </ul>
                            </div>
                        </td>
                        <td class="No">${no}</td>
                        <td class="TransferMappingCode">${transferMappingCode}</td>
                        <td class="ExampleFileName">${exampleFileName}</td>
                        <td class="ExampleFileTypeText">${exampleFileTypeText}</td>
                        <td class="SrcNasFilePath">${srcNasFilePath}</td>
                        <td class="Description">${description}</td>
                        <td class="MappingTables">${renderTableTextBadges(mappingTables)}</td>
                    </tr>
                `);
            });

            initDynamicDropdowns();
        }

        async function initDropdownList() {
        }

        function onSearchData() {
            queryState.Keyword1 = $('#Keyword1').val() || '';
        }

        // ========================================
        // Global Search
        // ========================================
        $('#globalSearchInput').on('input', function () {
            var keyword = $(this).val().toLowerCase().trim();
            var $rows = $('#data-list-data tr');
            var visibleCount = 0;
            $rows.each(function () {
                var text = $(this).text().toLowerCase();
                if (!keyword || text.indexOf(keyword) >= 0) {
                    $(this).show();
                    visibleCount++;
                } else {
                    $(this).hide();
                }
            });
            if (visibleCount === 0 && $rows.length > 0) {
                $('.noresult').show();
            } else {
                $('.noresult').hide();
            }
        });

        // ========================================
        // Filter Condition
        // ========================================
        const FILTER_OPERATORS = [
            { value: '=',           label: '等於 (=)' },
            { value: '!=',          label: '不等於 (!=)' },
            { value: '>',           label: '大於 (>)' },
            { value: '>=',          label: '大於等於 (>=)' },
            { value: '<',           label: '小於 (<)' },
            { value: '<=',          label: '小於等於 (<=)' },
            { value: 'LIKE',        label: '包含 (LIKE)' },
            { value: 'NOT LIKE',    label: '不包含 (NOT LIKE)' },
            { value: 'IS NULL',     label: '為空 (IS NULL)' },
            { value: 'IS NOT NULL', label: '不為空 (IS NOT NULL)' },
        ];

        $(document).on('change', 'input[name="filterMode"]', function () {
            var isManual = $(this).val() === 'manual';
            if (isManual) {
                $('#filterBuilderArea').hide();
                $('#btnAddFilterRow').hide();
                $('#filterManualArea').show();
            } else {
                $('#filterBuilderArea').show();
                $('#btnAddFilterRow').show();
                $('#filterManualArea').hide();
            }
        });

        $('#btnAddFilterRow').on('click', function () {
            addFilterRow('AND', '', '=', '');
        });

        function addFilterRow(logic, column, operator_, value) {
            var isFirst = $('#filterRows tr').length === 0;
            var tableName = $('#tableName').val() || (sheets && sheets[activeSheetIndex] && sheets[activeSheetIndex].tableName) || '';
            var dbCols = dbColumnCache[tableName] || [];
            var colOptions = dbCols.map(function (c) {
                return '<option value="' + c + '" ' + (c === column ? 'selected' : '') + '>' + c + '</option>';
            }).join('');
            if (column && dbCols.indexOf(column) < 0) {
                colOptions = '<option value="' + column + '" selected>' + column + '</option>' + colOptions;
            }
            var opOptions = FILTER_OPERATORS.map(function (o) {
                return '<option value="' + o.value + '" ' + (o.value === operator_ ? 'selected' : '') + '>' + o.label + '</option>';
            }).join('');
            var noValueOps = ['IS NULL', 'IS NOT NULL'];
            var hideVal = noValueOps.indexOf(operator_) >= 0;

            var $tr = $('<tr>' +
                '<td class="align-middle">' +
                (isFirst
                    ? '<span class="text-muted ps-1">WHERE</span>'
                    : '<select class="form-select form-select-sm filter-logic">' +
                      '<option value="AND" ' + (logic === 'AND' ? 'selected' : '') + '>AND</option>' +
                      '<option value="OR" '  + (logic === 'OR'  ? 'selected' : '') + '>OR</option>' +
                      '</select>') +
                '</td>' +
                '<td><select class="form-select form-select-sm filter-col">' +
                '<option value="">-- 請選擇 --</option>' +
                colOptions + '</select></td>' +
                '<td><select class="form-select form-select-sm filter-op">' + opOptions + '</select></td>' +
                '<td><input type="text" class="form-control filter-val" value="' + escFilterHtml(value) + '" ' + (hideVal ? 'style="display:none"' : '') + '></td>' +
                '<td class="text-center"><button type="button" class="btn btn-sm btn-soft-danger btn-remove-filter"><i class="ri-delete-bin-line"></i></button></td>' +
                '</tr>');

            $('#filterRows').append($tr);
            if (!isFirst) {
                $tr.find('.filter-logic').select2({ minimumResultsForSearch: Infinity, width: '100%', dropdownParent: $('#showModal') });
                $tr.find('.filter-logic').val(logic).trigger('change');
            }
            $tr.find('.filter-col').select2({ placeholder: '-- 請選擇 --', allowClear: true, width: '100%', dropdownParent: $('#showModal') });
            if (column) $tr.find('.filter-col').val(column).trigger('change');
            $tr.find('.filter-op').select2({ minimumResultsForSearch: Infinity, width: '100%', dropdownParent: $('#showModal') });
            $tr.find('.filter-op').val(operator_).trigger('change');
            updateFilterEmpty();
        }

        $(document).on('change', '.filter-op', function () {
            var noVal = ['IS NULL', 'IS NOT NULL'].indexOf($(this).val()) >= 0;
            $(this).closest('tr').find('.filter-val').toggle(!noVal);
        });

        $(document).on('click', '.btn-remove-filter', function () {
            var $tr = $(this).closest('tr');
            $tr.find('.filter-col, .filter-op, .filter-logic').each(function () {
                if ($(this).hasClass('select2-hidden-accessible')) $(this).select2('destroy');
            });
            $tr.remove();
            updateFilterEmpty();
        });

        function updateFilterEmpty() {
            var hasRows = $('#filterRows tr').length > 0;
            $('#filterEmpty').toggle(!hasRows);
        }

        function collectFilterData() {
            var mode = $('input[name="filterMode"]:checked').val();
            if (mode === 'manual') {
                return { mode: 'manual', sql: $('#FilterConditionManual').val().trim(), rows: [] };
            }
            var rows = [];
            $('#filterRows tr').each(function (i) {
                var $logicSel = $(this).find('.filter-logic');
                var logic = $logicSel.length ? $logicSel.val() : '';
                var col = $(this).find('.filter-col').val();
                var op  = $(this).find('.filter-op').val();
                var val = $(this).find('.filter-val').val();
                if (col) rows.push({ logic: i === 0 ? '' : logic, col: col, op: op, val: val });
            });
            return { mode: 'builder', sql: '', rows: rows };
        }

        function loadFilterCondition(filterCondition, filterMode) {
            $('#filterRows .filter-col, #filterRows .filter-op, #filterRows .filter-logic').each(function () {
                if ($(this).hasClass('select2-hidden-accessible')) $(this).select2('destroy');
            });
            $('#filterRows').empty();
            $('#FilterConditionManual').val('');

            if (!filterCondition) { updateFilterEmpty(); return; }

            try {
                var fc = JSON.parse(filterCondition);
                var mode = filterMode || fc.mode || 'builder';

                if (mode === 'manual') {
                    $('input[name="filterMode"][value="manual"]').prop('checked', true);
                    $('#filterBuilderArea').hide();
                    $('#btnAddFilterRow').hide();
                    $('#filterManualArea').show();
                    $('#FilterConditionManual').val(fc.sql || filterCondition);
                } else {
                    $('input[name="filterMode"][value="builder"]').prop('checked', true);
                    $('#filterBuilderArea').show();
                    $('#btnAddFilterRow').show();
                    $('#filterManualArea').hide();
                    $.each(fc.rows || [], function (i, r) {
                        addFilterRow(i === 0 ? 'AND' : r.logic, r.col, r.op, r.val);
                    });
                }
            } catch (e) {
                $('input[name="filterMode"][value="manual"]').prop('checked', true);
                $('#filterBuilderArea').hide();
                $('#btnAddFilterRow').hide();
                $('#filterManualArea').show();
                $('#FilterConditionManual').val(filterCondition);
            }
            updateFilterEmpty();
        }

        function resetFilterCondition() {
            $('#filterRows .filter-col, #filterRows .filter-op, #filterRows .filter-logic').each(function () {
                if ($(this).hasClass('select2-hidden-accessible')) $(this).select2('destroy');
            });
            $('#filterRows').empty();
            $('#FilterConditionManual').val('');
            $('input[name="filterMode"][value="builder"]').prop('checked', true);
            $('#filterBuilderArea').show();
            $('#btnAddFilterRow').show();
            $('#filterManualArea').hide();
            updateFilterEmpty();
        }

        function escFilterHtml(str) {
            return (str || '').replace(/&/g, '&amp;').replace(/"/g, '&quot;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
        }

        function initPageChoices() {
            ['DBName', 'tableName'].forEach(function (id) {
                var $sel = $('#' + id);
                if ($sel.length && !$sel.hasClass('select2-hidden-accessible')) {
                    $sel.select2({
                        placeholder: tableExcelMsg.pleaseSelect,
                        allowClear: true,
                        width: '100%',
                        dropdownParent: $('#showModal')
                    });
                    $sel.on('change', function () {
                        $(this).removeClass('is-invalid');
                    });
                }
            });
        }
    </script>
    @await Html.PartialAsync("_CrudCommonScripts")
}
