    $.ajax({
        url: pageUrls.GetDbTransferList,
        type: 'GET',
        success: function (res) {
            if (res.Success) {
                var list = res.Data || [];
                var $sel = $('#DBName');
                resetChoicesSelect('DBName');
                initSingleChoices('DBName');
                $sel.find('option:not(:first)').remove();
