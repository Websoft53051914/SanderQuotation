        function loadTableList(dbTransferGuid, selectedValue) {
            var params = {};
            if (dbTransferGuid) params.dbTransferGuid = dbTransferGuid;
            $.ajax({
                url: pageUrls.GetTargetTables,
                type: 'GET',
                data: params,
                success: function (res) {
                    if (res.Success) {
                        dbTableList = res.Data || [];
                        var $sel = $('#tableName');
                        $sel.find('option:not(:first)').remove();
                        dbTableList.forEach(function (t) {
                            $sel.append('<option value="' + t + '">' + t + '</option>');
                        });
                        if (selectedValue) {
                            $sel.val(selectedValue).trigger('change');
                        }
                    }
                }
            });
