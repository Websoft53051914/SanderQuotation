@{
    ViewBag.Title = (config.GetMessage("Home").ToHtmlString());
    ViewBag.pTitle = (config.GetMessage("Home").ToHtmlString());
    ViewBag.pageTitle = (config.GetMessage("Home").ToHtmlString());

    ViewData["Title"] = (config.GetMessage("Home").ToHtmlString());
}
<style>

</style>
<div class="row">
    <div class="col-12">
        <div class="">
            <div class="">
                <!-- Toolbar -->
                <div class="d-flex align-items-center justify-content-end gap-2 mb-2">
                    <button type="button" class="btn btn-success w-sm" id="btn-save-layout" onclick="saveDashboardLayout()">
                        <i class="ri-save-line me-1"></i>儲存此 Dashboard 版型
                    </button>
                </div>
                <!-- Nav tabs -->
                <ul class="nav nav-tabs nav-tabs-custom nav-success mb-3" role="tablist" id="dashboard-tabs"></ul>
                <!-- Tab panes (shared single canvas) -->
                <div class="tab-content" id="dashboard-tab-content">
                    <div class="tab-pane active" id="shared-tab-pane" role="tabpanel">
                        <div id="shared-canvas" class="grid-stack dashboard-canvas"></div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<link href="~/css/dashboard.css?20260429" rel="stylesheet" />
<link href="~/lib/gridstack/dist/gridstack.css" rel="stylesheet" />
<script src="~/lib/gridstack/dist/gridstack-all.js"></script>
<script type="module">
    import { TableauEventType,TableauDialogType } from "@Url.Content("~/lib/tableau/tableau.embedding.3.latest.min.js")";
    var dashboardData = {
        1: {
            Name: 'Dashboard1',
            SheetData: [{ id: 1, Name: '圖表1' }, { id: 2, Name: '圖表2' }, { id: 3, Name: '圖表3' }]
        },
        2: {
            Name: 'Dashboard2',
            SheetData: [{ id: 4, Name: '圖表4' }, { id: 5, Name: '圖表5' }, { id: 6, Name: '圖表6' }]
        },
        3: {
            Name: 'Dashboard3',
            SheetData: [{ id: 7, Name: '圖表7' }, { id: 8, Name: '圖表8' }, { id: 9, Name: '圖表9' }]
        },
    };

    // 目前載入的 GridStack 實例
    var currentGrid = null;
    var currentDashboardId = null;

    GridStack.renderCB = function (el, w) {
        el.innerHTML = w.content;
    };


    function toggleIconPanel(btn) {
        var content = btn.closest('.grid-stack-item-content');
        var panel = content.querySelector('.grid-icon-panel');
        if (!panel) return;
        var isOpen = panel.classList.contains('open');
        // close all other open panels first
        document.querySelectorAll('.grid-icon-panel.open').forEach(function (p) {
            p.classList.remove('open');
        });
        if (!isOpen) {
            panel.classList.add('open');
        }
    }

    window.toggleIconPanel = toggleIconPanel;

    // clicking outside closes panels
    document.addEventListener('click', function (e) {
        if (!e.target.closest('.grid-icon-panel') && !e.target.classList.contains('grid-info-btn')) {
            document.querySelectorAll('.grid-icon-panel.open').forEach(function (p) {
                p.classList.remove('open');
            });
        }
    });

    $(document).ready(function () {
       function initDashboardGrid(dashboardId) {
           if (currentDashboardId === dashboardId) return; // 已載入同一個則跳過

           // 銷毀舊的 GridStack
           if (currentGrid) {
               currentGrid.destroy(false);
               currentGrid = null;
           }
           // 清空共用 canvas
           var canvas = document.getElementById('shared-canvas');
           canvas.innerHTML = '';

           currentDashboardId = dashboardId;
           var data = dashboardData[dashboardId];

        // 將每個圖表轉成 gridstack widget 設定，自動排列（每行 4 欄）
        var widgets = data.SheetData.map(function (sheet, idx) {
            return {
                w: 3,
                h: 2,
                minW: 3,
                minH: 2,
                content: `
                    <div class="grid-drag-handle">
                        <i class="ri-drag-move-2-line"></i>
                        <span>按我拖曳</span>
                    </div>
                    <div style="position:relative; flex:1 1 0; min-height:0;">
                        <button class="grid-info-btn" title="資訊" onclick="toggleIconPanel(this)">i</button>
                        <div class="grid-icon-panel" id='grid-item-${dashboardId}-${sheet.id}'>
                            <button class="panel-icon" title="匯出 Excel"><i class="ri-file-excel-line"></i></button>
                            <button class="panel-icon" title="匯出 Csv"><i class="ri-file-text-line"></i></button>
                            <button class="panel-icon export-pdf" title="匯出 PDF"><i class="ri-file-pdf-line"></i></button>
                            <button class="panel-icon view-data" title="顯示圖表原始資料"><i class="ri-eye-line"></i></button>
                            <button class="panel-icon update-data" title="更新圖表最新資料"><i class="ri-refresh-line"></i></button>
                            <button class="panel-icon" title="設定自動更新圖表資料"><i class="ri-time-line"></i></button>
                            <button class="panel-icon export-url" title="匯出圖表URL"><i class="ri-links-line"></i></button>
                        </div>
                        <div class="w-100 h-100">

                        </div>
                    </div>
                    `
            };
        });

        var grid = GridStack.init({
            cellHeight: '150px',
            margin: '8px',
            handle: '.grid-drag-handle',
            resizable: {
                handles: 'se,s,e'
            },
            columnOpts: {
                breakpointForWindow: true,
                breakpoints: [{ w: 950, c: 3 }, { w: 1280, c: 6 }]
            },
        }, '#shared-canvas');

        grid.load(widgets);
        grid.float(true)
        currentGrid = grid;

        // grid load 完成後，將 tableau-viz 注入每個 widget
        document.querySelectorAll('#shared-canvas .grid-stack-item-content .w-100.h-100').forEach(function (container, idx) {
            var sheet = data.SheetData[idx];
            if (!sheet) return;
            var viz = document.createElement('tableau-viz');
            viz.id = 'tableauViz-' + dashboardId + '-' + sheet.id;
            viz.setAttribute('src', 'https://public.tableau.com/views/RegionalSampleWorkbook/Stocks');
            viz.setAttribute('hide-tabs', '');
            container.appendChild(viz);
            viz.addEventListener(TableauEventType.FirstInteractive, ()=>{
                $('body').on('click','#grid-item-'+dashboardId+'-'+ sheet.id+' .export-pdf',async function(){
                   showLoader();
                   try{
                        await viz.exportPDFAsync()
                   }
                   catch{

                   }
                   finally{
                       hideLoader();
                   }
                })
                $('body').on('click','#grid-item-'+dashboardId+'-'+ sheet.id+' .update-data',async function(){
                   showLoader();
                   try{
                        await viz.refreshDataAsync()
                   }
                   catch{

                   }
                   finally{
                       hideLoader();
                   }
                })
                $('body').on('click','#grid-item-'+dashboardId+'-'+ sheet.id+' .export-url',async function(){

                })
            });
        });
        // 拖曳 / resize 開始時，對所有 tableau-viz 套用 pointer-events:none，
        // 讓滑鼠事件不進入任何 iframe，避免 mouseup 被吞掉導致卡住
        function disableVizPointerEvents() {
            document.querySelectorAll('#shared-canvas tableau-viz').forEach(function (viz) {
                viz.style.pointerEvents = 'none';
            });
        }
        function enableVizPointerEvents() {
            document.querySelectorAll('#shared-canvas tableau-viz').forEach(function (viz) {
                viz.style.pointerEvents = '';
            });
        }

        grid.on('dragstart', disableVizPointerEvents);
        grid.on('dragstop',  enableVizPointerEvents);
        grid.on('resizestart', disableVizPointerEvents);
        // resize 結束時，還原 pointer-events 並通知 tableau-viz 重新適應尺寸
        grid.on('resizestop', function (event, el) {
            enableVizPointerEvents();
            var viz = el.querySelector('tableau-viz');
            if (viz) {
                viz.resize();
            }
        });
    }
        var ids = Object.keys(dashboardData);

        // 動態產生 tab 按鈕（共用同一個 tab-pane）
        ids.forEach(function (id, idx) {
            var data = dashboardData[id];
            var isFirst = idx === 0;

            $('#dashboard-tabs').append(`
                <li class="nav-item">
                    <a class="nav-link fs-3 ${isFirst ? 'active' : ''}"
                       data-bs-toggle="tab"
                       href="#shared-tab-pane"
                       role="tab"
                       data-dashboard-id="${id}"
                       aria-selected="${isFirst}">
                        ${data.Name}
                    </a>
                </li>`);
        });

        // 初始化第一個 dashboard
        initDashboardGrid(ids[0]);

        // 切換 tab 時才初始化對應 GridStack（lazy init）
        $('a[data-bs-toggle="tab"]').on('shown.bs.tab', function (e) {
            var dashboardId = $(e.target).data('dashboard-id');
            initDashboardGrid(dashboardId);
        });
    });

    window.saveDashboardLayout = saveDashboardLayout;

    function saveDashboardLayout() {
        var dashboardId = currentDashboardId;
        var grid = currentGrid;
        if (!grid || !dashboardId) return;

        var layout = grid.save(false); // 儲存位置與大小，不含 content
        console.log('Dashboard ' + dashboardId + ' 版型：', JSON.stringify(layout));

        // TODO: 呼叫後端 API 儲存版型
        // $.post('/Home/SaveLayout', { dashboardId: dashboardId, layout: JSON.stringify(layout) });

        alert('Dashboard「' + dashboardData[dashboardId].Name + '」版型已儲存！');
    }
</script>