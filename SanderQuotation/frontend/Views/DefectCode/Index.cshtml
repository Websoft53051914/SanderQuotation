@{
    ViewBag.Title = "不良代碼清單";
    ViewBag.pTitle = "不良代碼清單";
    ViewBag.pageTitle = "System Management";
}

<style>
    #datasList .table-card {
        overflow: visible;
    }

    #datasList .dropdown-menu {
        z-index: 1080;
    }
</style>

<div class="row">
    <div class="col-lg-12">
        <div class="card" id="datasList">
            <div class="card-header border-0">
                <div class="d-flex align-items-center">
                    <h5 class="card-title mb-0 flex-grow-1">不良代碼清單</h5>
                    <div class="flex-shrink-0">
                        <div class="d-flex flex-wrap gap-2">
                            <button id="addDefectCodeBtn" type="button" class="btn btn-danger add-btn" data-bs-toggle="modal" data-bs-target="#defectCodeModal">
                                <i class="ri-add-line align-bottom me-1"></i> 新增
                            </button>
                            <button class="btn btn-soft-danger" id="defect-remove-actions" type="button" onclick="deleteSelectedRows()" style="display:none;">
                                <i class="ri-delete-bin-2-line"></i>
                            </button>
                        </div>
                    </div>
                </div>
            </div>

            <div class="card-body border border-dashed border-end-0 border-start-0">
                <form>
                    <div class="row g-3">
                        <div class="col-xxl-3 col-sm-12">
                            <div class="search-box">
                                <input type="text" id="defectCodeSearch" class="form-control search bg-light border-light" placeholder="搜尋表格內容">
                                <i class="ri-search-line search-icon"></i>
                            </div>
                        </div>
                        <div class="col-xxl-1 col-sm-4">
                            <button type="button" class="btn btn-primary w-100" onclick="filterDefectCodeTable()">
                                <i class="ri-equalizer-fill me-1 align-bottom"></i>篩選
                            </button>
                        </div>
                    </div>
                </form>
            </div>

            <div class="card-body">
                <div class="table-responsive table-card mb-0">
                    <table class="table align-middle table-nowrap mb-0" id="dataTable">
                        <thead>
                            <tr>
                                <th scope="col" style="width: 40px;">
                                    <div class="form-check">
                                        <input class="form-check-input" type="checkbox" id="defectCheckAll" value="option">
                                    </div>
                                </th>
                                <th style="width:100px;">Action</th>
                                <th style="width:60px;">項次</th>
                                <th>Code</th>
                                <th>名稱</th>
                                <th>分類</th>
                                <th>製程</th>
                                <th>等級</th>
                                
                                <th>狀態</th>
                                <th>版本</th>
                                <th>更新時間</th>
                            </tr>
                        </thead>
                        <tbody class="form-check-all">
                            <tr>
                                <td>
                                    <div class="form-check">
                                        <input class="form-check-input row-check" type="checkbox" value="D001">
                                    </div>
                                </td>
                                <td>
                                    <div class="dropdown">
                                        <button class="btn btn-soft-secondary btn-sm dropdown" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                            <i class="ri-more-fill align-middle"></i>
                                        </button>
                                        <ul class="dropdown-menu dropdown-menu-end">
                                            <li>
                                                <button type="button" class="dropdown-item" data-bs-toggle="modal" data-bs-target="#defectCodeModal">
                                                    <i class="ri-pencil-fill align-bottom me-2 text-muted"></i>編輯
                                                </button>
                                            </li>
                                            <li>
                                                <button type="button" class="dropdown-item">
                                                    <i class="ri-delete-bin-fill align-bottom me-2 text-muted"></i>刪除
                                                </button>
                                            </li>
                                        </ul>
                                    </div>
                                </td>
                                <td>1</td>
                                <td>D001</td>
                                <td>Scratch</td>
                                <td>外觀/刮傷</td>
                                <td>CMP</td>
                                <td>Critical</td>
                               
                                <td>啟用</td>
                                <td>V2</td>
                                <td>2026-04-30</td>
                            </tr>
                             <tr>
                                <td>
                                    <div class="form-check">
                                        <input class="form-check-input row-check" type="checkbox" value="D002">
                                    </div>
                                </td>
                                <td>
                                    <div class="dropdown">
                                        <button class="btn btn-soft-secondary btn-sm dropdown" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                            <i class="ri-more-fill align-middle"></i>
                                        </button>
                                        <ul class="dropdown-menu dropdown-menu-end">
                                            <li>
                                                <button type="button" class="dropdown-item" data-bs-toggle="modal" data-bs-target="#defectCodeModal">
                                                    <i class="ri-pencil-fill align-bottom me-2 text-muted"></i>編輯
                                                </button>
                                            </li>
                                            <li>
                                                <button type="button" class="dropdown-item text-danger">
                                                    <i class="ri-delete-bin-fill align-bottom me-2 text-muted"></i>刪除
                                                </button>
                                            </li>
                                        </ul>
                                    </div>
                                </td>
                                <td>2</td>
                                <td>D002</td>
                                <td>Contam</td>
                                <td>污染</td>
                                <td>Etch</td>
                                <td>Major</td>
                               
                                <td>啟用</td>
                                <td>V1</td>
                                <td>2026-04-25</td>
                            </tr> 
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="defectCodeModal" tabindex="-1" aria-hidden="true" data-bs-backdrop="static" data-bs-keyboard="false">
    <div class="modal-dialog modal-dialog-centered modal-xl">
        <div class="modal-content border-0">
            <div class="modal-header p-3 bg-info-subtle">
                <h5 class="modal-title">不良代碼設定（Defect Code Setup）</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <form class="needs-validation" novalidate>
                <div class="modal-body">
                    <div class="card border mb-3">
                        <div class="card-header"><strong>基本資料</strong></div>
                        <div class="card-body">
                            <div class="row g-3">
                                <div class="col-lg-6">
                                    <label class="form-label required">不良代碼</label>
                                    <input type="text" class="form-control" value="D001" required />
                                </div>
                                <div class="col-lg-6">
                                    <label class="form-label required">不良名稱</label>
                                    <input type="text" class="form-control" value="Scratch" required />
                                </div>
                                <div class="col-lg-12">
                                    <label class="form-label">不良描述</label>
                                    <input type="text" class="form-control" />
                                </div>
                                <div class="col-lg-4">
                                    <label class="form-label">版本</label>
                                    <input type="text" class="form-control" value="V1.0" />
                                </div>
                                <div class="col-lg-4">
                                    <label class="form-label">狀態</label>
                                    <select id="f_Status" class="form-select">
                                        <option selected>啟用</option>
                                        <option>停用</option>
                                    </select>
                                </div>
                                <div class="col-lg-4">
                                    <label class="form-label required">嚴重等級</label>
                                    <select id="f_Severity" class="form-select" required>
                                        <option selected>Critical</option>
                                        <option>Major</option>
                                        <option>Minor</option>
                                    </select>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="card border mb-3">
                        <div class="card-header"><strong>分類設定</strong></div>
                        <div class="card-body">
                            <div class="row g-3">
                                <div class="col-lg-6">
                                    <label class="form-label required">不良大類</label>
                                    <select id="f_MainCategory" class="form-select" required>
                                        <option selected>外觀</option>
                                        <option>電性</option>
                                        <option>製程</option>
                                    </select>
                                </div>
                                <div class="col-lg-6">
                                    <label class="form-label required">不良子類</label>
                                    <select id="f_SubCategory" class="form-select" required>
                                        <option selected>刮傷</option>
                                        <option>污染</option>
                                        <option>崩邊</option>
                                    </select>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="card border mb-3">
                        <div class="card-header"><strong>適用範圍</strong></div>
                        <div class="card-body">
                            <div class="row g-3">
                                <div class="col-lg-4">
                                    <label class="form-label required">製程站點</label>
                                    <select id="f_ProcessSite" class="form-select" required>
                                        <option>Litho</option>
                                        <option>Etch</option>
                                        <option selected>CMP</option>
                                        <option>Test</option>
                                    </select>
                                </div>
                                <div class="col-lg-4">
                                    <label class="form-label">適用機台</label>
                                    <select id="f_Equipments" class="form-select" multiple>
                                        <option value="EQP-001" selected>EQP-001</option>
                                        <option value="EQP-002" selected>EQP-002</option>
                                        <option value="EQP-003">EQP-003</option>
                                    </select>
                                </div>
                                <div class="col-lg-4">
                                    <label class="form-label">適用產品</label>
                                    <select id="f_Products" class="form-select" multiple>
                                        <option value="Product A" selected>Product A</option>
                                        <option value="Product B" selected>Product B</option>
                                        <option value="Product C">Product C</option>
                                    </select>
                                </div>
                               
                            </div>
                        </div>
                    </div>
                </div>

                <div class="modal-footer">                   
                    <button type="button" class="btn btn-light" data-bs-dismiss="modal">取消</button>
                    <button type="button" class="btn btn-success">儲存</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section scripts {
    <script>
        var modalParent = $('#defectCodeModal');
        $('#f_Status').select2({ width: '100%', dropdownParent: modalParent });
        $('#f_Severity').select2({ width: '100%', dropdownParent: modalParent });
        $('#f_MainCategory').select2({ width: '100%', dropdownParent: modalParent });
        $('#f_SubCategory').select2({ width: '100%', dropdownParent: modalParent });
        $('#f_ProcessSite').select2({ width: '100%', dropdownParent: modalParent });
        $('#f_Equipments').select2({ width: '100%', dropdownParent: modalParent });
        $('#f_Products').select2({ width: '100%', dropdownParent: modalParent });

        function filterDefectCodeTable() {
            var keyword = document.getElementById('defectCodeSearch').value.trim().toLowerCase();
            var rows = document.querySelectorAll('#dataTable tbody tr');

            rows.forEach(function (row) {
                var text = row.innerText.toLowerCase();
                row.style.display = text.indexOf(keyword) > -1 ? '' : 'none';
            });
        }

        function updateDeleteButtonVisibility() {
            var hasChecked = document.querySelectorAll('.row-check:checked').length > 0;
            document.getElementById('defect-remove-actions').style.display = hasChecked ? '' : 'none';
        }

        function deleteSelectedRows() {
            document.querySelectorAll('.row-check:checked').forEach(function (checkbox) {
                checkbox.closest('tr').remove();
            });
            document.getElementById('defectCheckAll').checked = false;
            updateDeleteButtonVisibility();
        }

        document.getElementById('defectCodeSearch').addEventListener('input', filterDefectCodeTable);

        document.getElementById('defectCheckAll').addEventListener('change', function () {
            var checked = this.checked;
            document.querySelectorAll('.row-check').forEach(function (checkbox) {
                checkbox.checked = checked;
            });
            updateDeleteButtonVisibility();
        });

        document.addEventListener('change', function (e) {
            if (e.target.classList.contains('row-check')) {
                var all = document.querySelectorAll('.row-check');
                var checked = document.querySelectorAll('.row-check:checked');
                document.getElementById('defectCheckAll').checked = all.length > 0 && all.length === checked.length;
                updateDeleteButtonVisibility();
            }
        });

        updateDeleteButtonVisibility();

        document.getElementById('addDefectCodeBtn').addEventListener('click', function () {
            var form = document.querySelector('#defectCodeModal form');
            form.querySelectorAll('input[type="text"]').forEach(function (input) {
                input.value = '';
            });

            $('#f_Status').val('啟用').trigger('change');
            $('#f_Severity').val('Critical').trigger('change');
            $('#f_MainCategory').val('外觀').trigger('change');
            $('#f_SubCategory').val('刮傷').trigger('change');
            $('#f_ProcessSite').val('Litho').trigger('change');
            $('#f_Equipments').val([]).trigger('change');
            $('#f_Products').val([]).trigger('change');
        });
    </script>
}
