        // ========================================
        // 週期類型切換
        // ========================================
        var blockDefaults = {
            'SECOND': function() {
                $('#SecondInterval').val(1);
            },
            'MINUTE': function() {
                $('#MinuteInterval').val(1);
                $('#MinuteAtSecond').val(0);
            },
            'HOUR': function() {
                $('#HourInterval').val(1);
                $('#HourAtMinute').val(0);
                $('#HourAtSecond').val(0);
            },
            'DAY': function() {
                $('#DayInterval').val(1);
                $('#DayAtTime').val('08:00');
            },
            'WEEK': function() {
