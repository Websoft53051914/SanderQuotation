@{
    ViewBag.Title = "排程設定";
    ViewBag.pTitle = "排程設定";
    ViewBag.pageTitle = config.GetMessage("SystemManagementModule").ToHtmlString();

    var otherTransferSettingSelectList = ViewData["OtherTransferSettingSelectList"] as List<SelectListItem>;
}

<div class="row">
    <div class="col-lg-12">
        <div class="card" id="datasList">
            <div class="card-header border-0">
                <div class="d-flex align-items-center">
                    <h5 class="card-title mb-0 flex-grow-1"></h5>
                    <div class="flex-shrink-0">
                        <div class="d-flex flex-wrap gap-2">
                            <button id="btnShowModal" class="btn btn-danger add-btn" data-bs-toggle="modal" data-bs-target="#showModal"><i class="ri-add-line align-bottom me-1"></i> 新增</button>
                            <button class="btn btn-soft-danger" id="remove-actions" onClick="deleteMultiple()"><i class="ri-delete-bin-2-line"></i></button>
                        </div>
                    </div>
                </div>
            </div>

            <div class="card-body border border-dashed border-end-0 border-start-0">
                <form>
                    <div class="row g-3">
                        <div class="col-xxl-3 col-sm-12">
                            <div class="search-box">
                                <input type="text"
                                       id="globalSearchInput"
                                       class="form-control search bg-light border-light"
                                       placeholder="搜尋表格內容">
                                <i class="ri-search-line search-icon"></i>
                            </div>
                        </div>
                        <div class="col-xxl-2 col-sm-12">
                            <input type="text" class="form-control bg-light border-light" placeholder="請輸入週期代碼或週期名稱" id="Keyword" name="Keyword">
                        </div>
                        <div class="col-xxl-1 col-sm-4">
                            <button type="button" class="btn btn-primary w-100" onclick="SearchData();">
                                <i class="ri-equalizer-fill me-1 align-bottom"></i>
                                篩選
                            </button>
                        </div>
                    </div>
                </form>
            </div>

            <div class="card-body">
                <div class="table-responsive table-card mb-4">
                    <table class="table align-middle table-nowrap mb-0" id="dataTable">
                        <thead>
                            <tr>
                                <th scope="col" style="width: 40px;">
                                    <div class="form-check">
                                        <input class="form-check-input" type="checkbox" id="checkAll" value="option">
                                    </div>
                                </th>
                                <th>Action</th>
                                <th>項次</th>
                                <th class="sort" data-sort="ScheduleCycleCode">週期代碼</th>
                                <th class="sort" data-sort="CycleName">週期名稱</th>
                                <th>執行狀態</th>
                                <th>執行週期</th>
                                <th class="sort" data-sort="Status">啟用</th>
                                <th data-sort="DBTransferSettings">資料庫轉檔設定</th>
                                <th data-sort="OtherTaskSettings">其他任務設定</th>
                                <th data-sort="FileTransferSettings">Excel轉入資料表對應設定</th>
                            </tr>
                        </thead>
                        <tbody class="list form-check-all" id="data-list-data">
                            <tr>
                                <th scope="row">
                                    <div class="form-check">
                                        <input class="form-check-input" type="checkbox" name="checkAll" value="option1">
                                    </div>
                                </th>
                            </tr>
                        </tbody>
                    </table>
                    <div class="noresult" style="display: none">
                        <div class="text-center">
                            <lord-icon src="@Url.Content("~/assets/json/lord-icon/msoeawqm.json")" trigger="loop" colors="primary:#121331,secondary:#08a88a" style="width:75px;height:75px"></lord-icon>
                            <h5 class="mt-2">查無資料</h5>
                        </div>
                    </div>
                </div>
                <div class="d-flex justify-content-end mt-2">
                    <div class="pagination-wrap hstack gap-2">
                        <a class="page-item pagination-prev disabled" href="#">
                            上一頁
                        </a>
                        <ul class="pagination listjs-pagination mb-0"></ul>
                        <a class="page-item pagination-next" href="#">
                            下一頁
                        </a>
                    </div>
                </div>

                <!-- Modal -->
                <div class="modal fade flip" id="deleteOrder" tabindex="-1" aria-hidden="true">
                    <div class="modal-dialog modal-dialog-centered">
                        <div class="modal-content">
                            <div class="modal-body p-5 text-center">
                                <lord-icon src="@Url.Content("~/assets/json/lord-icon/gsqxdxog.json")" trigger="loop" colors="primary:#405189,secondary:#f06548" style="width:90px;height:90px"></lord-icon>
                                <div class="mt-4 text-center">
                                    <h4>
                                        您確定要刪除此項目嗎？
                                    </h4>

                                    <div class="hstack gap-2 justify-content-center remove">
                                        <button class="btn btn-link link-success fw-medium text-decoration-none" id="deleteRecord-close" data-bs-dismiss="modal">
                                            <i class="ri-close-line me-1 align-middle"></i>
                                            關閉
                                        </button>
                                        <button class="btn btn-danger" id="delete-record">是的，刪除它！</button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="modal fade flip" id="confirmModal" tabindex="-1" aria-hidden="true">
                    <div class="modal-dialog modal-dialog-centered">
                        <div class="modal-content">
                            <div class="modal-body p-5 text-center">
                                <lord-icon src="https://cdn.lordicon.com/uukerzzv.json" trigger="loop" colors="primary:#405189,secondary:#08a88a" style="width:90px;height:90px"></lord-icon>
                                <div class="mt-4 text-center">
                                    <h4>確認立即執行</h4>
                                    <p class="text-muted">確定要立即執行此排程嗎？</p>
                                    <div class="hstack gap-2 justify-content-center">
                                        <button class="btn btn-link link-danger fw-medium text-decoration-none" id="executeNow-close" data-bs-dismiss="modal">
                                            <i class="ri-close-line me-1 align-middle"></i>
                                            關閉
                                        </button>
                                        <button class="btn btn-primary" id="executeNow-confirm">
                                            <i class="ri-play-circle-line me-1 align-middle"></i>
                                            立即執行
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- 執行紀錄 Modal -->
<div class="modal fade" id="logModal" tabindex="-1" aria-labelledby="logModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-xl modal-dialog-scrollable">
        <div class="modal-content border-0">
            <div class="modal-header p-3 bg-light">
                <h5 class="modal-title" id="logModalLabel"><i class="ri-history-line me-2"></i>執行時間軸</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body" style="min-height:300px;">
                <!-- 篩選標籤列 -->
                <div id="logFilterBar" class="d-flex flex-wrap gap-2 mb-3"></div>
                <!-- 時間軸容器 -->
                <div id="logTimelineContainer" style="max-height:65vh; overflow-y:auto;"></div>
            </div>
        </div>
    </div>
</div>

<!-- 錯誤詳情 Modal -->
<div class="modal fade" id="logErrorModal" tabindex="-1" aria-labelledby="logErrorModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg modal-dialog-scrollable">
        <div class="modal-content border-0">
            <div class="modal-header bg-danger-subtle">
                <h5 class="modal-title text-danger" id="logErrorModalLabel"><i class="ri-alert-line me-2"></i>錯誤詳情</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body" id="logErrorModalBody"></div>
        </div>
    </div>
</div>

<!-- 新增 / 編輯 Modal -->
<div class="modal fade zoomIn" id="showModal" tabindex="-1" aria-labelledby="showModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg modal-dialog-scrollable">
        <div class="modal-content border-0">
            <div class="modal-header p-3 bg-info-subtle">
                <h5 class="modal-title" id="exampleModalLabel_Create" style="display:none;">新增</h5>
                <h5 class="modal-title" id="exampleModalLabel_Edit" style="display:none;">編輯</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close" id="close-modal"></button>
            </div>
            <div class="modal-body">
                <form class="needs-validation" novalidate="" method="post" id="submitForm">
                    <div class="row g-3">

                        <!-- ── 區塊一：基本資訊 ── -->
                        <div class="col-lg-6">
                            <label class="col-form-label required pt-0">週期代碼</label>
                            <input type="text" name="ScheduleCycleCode" id="ScheduleCycleCode" class="form-control" maxlength="50" required />
                            <div class="invalid-feedback">請輸入週期代碼</div>
                        </div>
                        <div class="col-lg-6">
                            <label class="col-form-label required pt-0">週期名稱</label>
                            <input type="text" name="CycleName" id="CycleName" class="form-control" maxlength="100"
                                   placeholder="週期名稱" required />
                            <div class="invalid-feedback">請輸入週期名稱</div>
                        </div>
                        <div class="col-lg-6">
                            <label class="col-form-label pt-0">資料庫轉檔設定</label>
                            <select class="form-control" id="DBTransferSettings" name="DBTransferSettings" multiple>
                            </select>
                        </div>
                        <div class="col-lg-6">
                            <label class="col-form-label pt-0">其他任務</label>
                            <select class="form-control" id="OtherTransferSettings" name="OtherTransferSettings" multiple>
                                @foreach (var item in otherTransferSettingSelectList)
                                {
                                    <option value="@item.Value">@item.Text.ToHtmlString()</option>
                                }
                                )
                            </select>
                        </div>
                        <div class="col-lg-6">
                            <label class="col-form-label pt-0">Excel轉入資料表對應設定</label>
                            <select class="form-control" id="FileTransferSettings" name="FileTransferSettings" multiple>
                            </select>
                        </div>
                        <div class="col-lg-6">
                            <label class="col-form-label pt-0 d-block">&nbsp;</label>
                            <div class="form-check mt-2">
                                <input type="checkbox" class="form-check-input" id="IsEnabled" name="IsEnabled" checked>
                                <label class="form-check-label" for="IsEnabled">啟用</label>
                            </div>
                        </div>
                        <div class="col-lg-12">
                            <label class="col-form-label pt-0">說明</label>
                            <textarea name="Description" id="Description" class="form-control" maxlength="500"
                                      placeholder="說明" rows="2"></textarea>
                        </div>

                        <!-- ── 分隔線 ── -->
                        <div class="col-12"><hr class="my-1"></div>
                        <div class="col-12"><small class="text-muted">週期類型設定</small></div>

                        <!-- ── 區塊二：週期類型選擇 ── -->
                        <div class="col-lg-6">
                            <label class="col-form-label required pt-0">週期類型</label>
                            <select name="CycleType" id="CycleType" class="form-control" required>
                                <option value="">請選擇</option>
                                <option value="SECOND">每秒</option>
                                <option value="MINUTE">每分鐘</option>
                                <option value="HOUR">每小時</option>
                                <option value="DAY">每日</option>
                                <option value="WEEK">每週</option>
                                <option value="MONTH">每月</option>
                            </select>
                            <div class="invalid-feedback">請選擇週期類型</div>
                        </div>

                        <!-- ── 每秒 ── -->
                        <div class="col-lg-12 cycle-block" id="block-SECOND" style="display:none;">
                            <div class="card border mb-0">
                                <div class="card-body pb-2">
                                    <div class="row g-2 align-items-center">
                                        <div class="col-auto"><label class="col-form-label">每隔</label></div>
                                        <div class="col-lg-2">
                                            <input type="number" id="SecondInterval" name="SecondInterval"
                                                   class="form-control" min="1" max="59" value="1" placeholder="每秒">
                                        </div>
                                        <div class="col-auto"><label class="col-form-label">秒執行一次</label></div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- ── 每分鐘 ── -->
                        <div class="col-lg-12 cycle-block" id="block-MINUTE" style="display:none;">
                            <div class="card border mb-0">
                                <div class="card-body pb-2">
                                    <div class="row g-2 align-items-center">
                                        <div class="col-auto"><label class="col-form-label">每隔</label></div>
                                        <div class="col-lg-2">
                                            <input type="number" id="MinuteInterval" name="MinuteInterval"
                                                   class="form-control" min="1" max="59" value="1" placeholder="每分鐘">
                                        </div>
                                        <div class="col-auto"><label class="col-form-label">分鐘，第</label></div>
                                        <div class="col-lg-2">
                                            <input type="number" id="MinuteAtSecond" name="MinuteAtSecond"
                                                   class="form-control" min="0" max="59" value="0" placeholder="每秒">
                                        </div>
                                        <div class="col-auto"><label class="col-form-label">秒時執行</label></div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- ── 每小時 ── -->
                        <div class="col-lg-12 cycle-block" id="block-HOUR" style="display:none;">
                            <div class="card border mb-0">
                                <div class="card-body pb-2">
                                    <div class="row g-2 align-items-center">
                                        <div class="col-auto"><label class="col-form-label">每隔</label></div>
                                        <div class="col-lg-2">
                                            <input type="number" id="HourInterval" name="HourInterval"
                                                   class="form-control" min="1" max="23" value="1" placeholder="每小時">
                                        </div>
                                        <div class="col-auto"><label class="col-form-label">小時，於</label></div>
                                        <div class="col-lg-2">
                                            <input type="number" id="HourAtMinute" name="HourAtMinute"
                                                   class="form-control" min="0" max="59" value="0" placeholder="分">
                                        </div>
                                        <div class="col-auto"><label class="col-form-label">分</label></div>
                                        <div class="col-lg-2">
                                            <input type="number" id="HourAtSecond" name="HourAtSecond"
                                                   class="form-control" min="0" max="59" value="0" placeholder="每秒">
                                        </div>
                                        <div class="col-auto"><label class="col-form-label">秒時執行</label></div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- ── 每日 ── -->
                        <div class="col-lg-12 cycle-block" id="block-DAY" style="display:none;">
                            <div class="card border mb-0">
                                <div class="card-body pb-2">
                                    <div class="row g-2 align-items-center">
                                        <div class="col-auto"><label class="col-form-label">每隔</label></div>
                                        <div class="col-lg-2">
                                            <input type="number" id="DayInterval" name="DayInterval"
                                                   class="form-control" min="1" max="31" value="1" placeholder="每日">
                                        </div>
                                        <div class="col-auto"><label class="col-form-label">天，於</label></div>
                                        <div class="col-lg-3">
                                            <input type="time" id="DayAtTime" name="DayAtTime"
                                                   class="form-control" value="08:00">
                                        </div>
                                        <div class="col-auto"><label class="col-form-label">執行</label></div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- ── 每週 ── -->
                        <div class="col-lg-12 cycle-block" id="block-WEEK" style="display:none;">
                            <div class="card border mb-0">
                                <div class="card-body pb-2">
                                    <div class="row g-2">
                                        <div class="col-12">
                                            <label class="col-form-label">星期幾執行</label>
                                            <div class="d-flex flex-wrap gap-3 mt-1">
                                                <div class="form-check form-check-inline">
                                                    <input class="form-check-input" type="checkbox" id="wdSun" value="0">
                                                    <label class="form-check-label" for="wdSun">日</label>
                                                </div>
                                                <div class="form-check form-check-inline">
                                                    <input class="form-check-input" type="checkbox" id="wdMon" value="1">
                                                    <label class="form-check-label" for="wdMon">一</label>
                                                </div>
                                                <div class="form-check form-check-inline">
                                                    <input class="form-check-input" type="checkbox" id="wdTue" value="2">
                                                    <label class="form-check-label" for="wdTue">二</label>
                                                </div>
                                                <div class="form-check form-check-inline">
                                                    <input class="form-check-input" type="checkbox" id="wdWed" value="3">
                                                    <label class="form-check-label" for="wdWed">三</label>
                                                </div>
                                                <div class="form-check form-check-inline">
                                                    <input class="form-check-input" type="checkbox" id="wdThu" value="4">
                                                    <label class="form-check-label" for="wdThu">四</label>
                                                </div>
                                                <div class="form-check form-check-inline">
                                                    <input class="form-check-input" type="checkbox" id="wdFri" value="5">
                                                    <label class="form-check-label" for="wdFri">五</label>
                                                </div>
                                                <div class="form-check form-check-inline">
                                                    <input class="form-check-input" type="checkbox" id="wdSat" value="6">
                                                    <label class="form-check-label" for="wdSat">六</label>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-12">
                                            <div class="row g-2 align-items-center">
                                                <div class="col-auto"><label class="col-form-label">執行時間</label></div>
                                                <div class="col-lg-3">
                                                    <input type="time" id="WeekAtTime" name="WeekAtTime"
                                                           class="form-control" value="08:00">
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- ── 每月 ── -->
                        <div class="col-lg-12 cycle-block" id="block-MONTH" style="display:none;">
                            <div class="card border mb-0">
                                <div class="card-body pb-2">
                                    <div class="row g-2">
                                        <div class="col-12">
                                            <label class="col-form-label">選擇每月執行日期（可多選）</label>
                                            <div class="d-flex flex-wrap gap-1 mt-1">
                                                @for (int d = 1; d <= 31; d++)
                                                {
                                                    <div class="form-check" style="min-width:3rem;">
                                                        <input class="form-check-input" type="checkbox"
                                                               id="md@(d)" value="@d">
                                                        <label class="form-check-label" for="md@(d)">@d</label>
                                                    </div>
                                                }
                                            </div>
                                        </div>
                                        <div class="col-12">
                                            <div class="row g-2 align-items-center">
                                                <div class="col-auto"><label class="col-form-label">執行時間</label></div>
                                                <div class="col-lg-3">
                                                    <input type="time" id="MonthAtTime" name="MonthAtTime"
                                                           class="form-control" value="08:00">
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Cron 預覽 -->
                        <div class="col-12">
                            <label class="col-form-label pt-0">Cron 表達式預覽</label>
                            <div class="input-group">
                                <input type="text" id="CronExpression" name="CronExpression"
                                       class="form-control font-monospace" readonly placeholder="請先選擇週期類型">
                                <button type="button" class="btn btn-outline-secondary" onclick="buildCron()" title="重新產生">
                                    <i class="ri-refresh-line"></i>
                                </button>
                            </div>
                            <div id="cronDescription" class="form-text text-muted mt-1"></div>
                        </div>

                    </div>
                </form>

            </div>
            <div class="modal-footer">
                <div class="hstack gap-2 justify-content-end">
                    <button type="button" class="btn btn-light" data-bs-dismiss="modal">關閉</button>
                    <button type="submit" class="btn btn-success" id="add-btn" form="submitForm">儲存</button>
                </div>
            </div>

        </div>
    </div>
</div>
@await Html.PartialAsync("_CrudCommonScripts")
@section scripts {
    <script src="~/assets/libs/list.js/list.min.js"></script>
    <script src="~/assets/libs/list.pagination.js/list.pagination.min.js"></script>
    <script>
        // ========================================
        // 頁面專屬設定
        // ========================================
        var pageUrls = {
            GetPageList:    '@(Configuration["BackendURL"])/api/cycle-settings/GetPageList',
            Create:         '@(Configuration["BackendURL"])/api/cycle-settings/Create',
            Edit:           '@(Configuration["BackendURL"])/api/cycle-settings/Edit',
            Delete:         '@(Configuration["BackendURL"])/api/cycle-settings/Delete',
            Get:            '@(Configuration["BackendURL"])/api/cycle-settings/Get',
            GetSelectList:  '@(Configuration["BackendURL"])/api/cycle-settings/GetSelectList',
            ExecuteNow:     '@(Configuration["BackendURL"])/api/cycle-settings/ExecuteNow',
        };

        var queryState = {
            page: 1,
            pageSize: 40,
            sortField: 'ScheduleCycleCode',
            sortDir: 'asc',
            Keyword: '',
        };

        // 讓 _CrudCommonScripts 呼叫，避免重複初始化
        function initPageChoices() {
            $('#CycleType').select2({
                minimumResultsForSearch: Infinity,
                width: '100%',
                dropdownParent: $('#showModal')
            });
            ['#DBTransferSettings', '#OtherTaskSettings', '#FileTransferSettings', '#OtherTransferSettings'].forEach(function(id) {
                $(id).select2({
                    placeholder: '請選擇',
                    allowClear: true,
                    width: '100%',
                    dropdownParent: $('#showModal')
                });
            });
            loadSelectOptions();
        }

        // ========================================
        // 標籤清單渲染輔助（由 API 動態載入）
        // ========================================
        var dbTransferLabelMap = {};
        var dbCsvTransferLabelMap = {};
        var fileTransferLabelMap = {};

        function loadSelectOptions(callback) {
            $.getJSON(pageUrls.GetSelectList, function(resp) {
                if (!resp || !resp.Data) return;
                var data = resp.Data;
                // 建立 label map
                dbTransferLabelMap = {};
                dbCsvTransferLabelMap = {};
                fileTransferLabelMap = {};

                // 填充 DBTransferSettings
                var dbEl = document.getElementById('DBTransferSettings');
                if (dbEl) {
                    var $dbSel = $('#DBTransferSettings');
                    $dbSel.find('option').remove();
                    (data.dbSelectList || []).forEach(function(item) {
                        dbTransferLabelMap[item.Value] = item.Text;
                        $dbSel.append('<option value="' + item.Value + '">' + item.Text + '</option>');
                    });
                    $dbSel.trigger('change');
                }

                // 填充 FileTransferSettings
                var fileEl = document.getElementById('FileTransferSettings');
                if (fileEl) {
                    var $fileSel = $('#FileTransferSettings');
                    $fileSel.find('option').remove();
                    (data.fileSelectList || []).forEach(function(item) {
                        fileTransferLabelMap[item.Value] = item.Text;
