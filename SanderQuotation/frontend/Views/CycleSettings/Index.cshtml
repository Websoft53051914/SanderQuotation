        // ========================================
        // 讀取週/月已勾選值（用 ID 精確讀取，不用 class selector）
        // ========================================
        function getCheckedWeekDays() {
            var days = [];
            ['wdSun','wdMon','wdTue','wdWed','wdThu','wdFri','wdSat'].forEach(function(id) {
                var el = document.getElementById(id);
                if (el && $(el).is(':checked')) days.push(parseInt(el.value));

            });
            days.sort(function(a,b){ return a-b; });
            return days;
        }

        function getCheckedMonthDays() {
            var days = [];
            for (var d = 1; d <= 31; d++) {
                var el = document.getElementById('md' + d);
                if (el && el.checked) days.push(d);
            }
            // 已是升序，不需排序
            return days;
        }

        // ========================================
        // Cron 表達式產生  格式：秒 分 時 日 月 星期
        // ========================================
        function buildCron() {
            var type = $('#CycleType').val();
            var cron = '', desc = '';

            switch (type) {
                case 'SECOND': {
                    var n = parseInt($('#SecondInterval').val()) || 1;
                    cron = (n === 1) ? '* * * * * *' : '*/' + n + ' * * * * *';
                    desc = '每 ' + n + ' 秒執行一次';
                    break;
                }
                case 'MINUTE': {
                    var n = parseInt($('#MinuteInterval').val()) || 1;
                    var s = parseInt($('#MinuteAtSecond').val()) || 0;
                    cron = s + ' */' + n + ' * * * *';
                    desc = '每 ' + n + ' 分鐘，第 ' + s + ' 秒時執行';
                    break;
                }
                case 'HOUR': {
                    var n = parseInt($('#HourInterval').val()) || 1;
                    var mi = parseInt($('#HourAtMinute').val()) || 0;
                    var s  = parseInt($('#HourAtSecond').val()) || 0;
                    cron = s + ' ' + mi + ' */' + n + ' * * *';
                    desc = '每 ' + n + ' 小時，於 ' + pad(mi) + ' 分 ' + pad(s) + ' 秒執行';
                    break;
                }
                case 'DAY': {
                    var n = parseInt($('#DayInterval').val()) || 1;
                    var tp = ($('#DayAtTime').val() || '08:00').split(':');
                    var h = parseInt(tp[0])||0, m = parseInt(tp[1])||0;
                    cron = '0 ' + m + ' ' + h + ' */' + n + ' * *';
                    desc = '每 ' + n + ' 天，於 ' + pad(h) + ':' + pad(m) + ' 執行';
                    break;
                }
                case 'WEEK': {
                    var days = getCheckedWeekDays();
                    var dayStr = days.length ? days.join(',') : '*';
                    var weekTimeVal = document.getElementById('WeekAtTime').value || '08:00';
                    var tp = weekTimeVal.split(':');
                    var h = parseInt(tp[0], 10); if (isNaN(h)) h = 8;
                    var m = parseInt(tp[1], 10); if (isNaN(m)) m = 0;
                    cron = '0 ' + m + ' ' + h + ' * * ' + dayStr;
                    var names = {'0':'日','1':'一','2':'二','3':'三','4':'四','5':'五','6':'六'};
                    var labels = days.map(function(v){ return '週' + (names[String(v)] || v); }).join('、');
                    desc = (labels || '每天') + '，於 ' + pad(h) + ':' + pad(m) + ' 執行';
                    break;
                }
                case 'MONTH': {
                    var days = getCheckedMonthDays();
                    var dayStr = days.length ? days.join(',') : '1';
                    var monthTimeVal = document.getElementById('MonthAtTime').value || '08:00';
                    var tp = monthTimeVal.split(':');
                    var h = parseInt(tp[0], 10); if (isNaN(h)) h = 8;
                    var m = parseInt(tp[1], 10); if (isNaN(m)) m = 0;
                    cron = '0 ' + m + ' ' + h + ' ' + dayStr + ' * *';
                    desc = '每月 ' + dayStr + ' 號，於 ' + pad(h) + ':' + pad(m) + ' 執行';
                    break;
                }
            }
            $('#CronExpression').val(cron);
            $('#cronDescription').text(desc);
        }

        function pad(n) { return String(n).padStart(2, '0'); }

        // ========================================
        // 從資料物件產生 Cron 中文說明
        // ========================================
        function cronDescFromData(data) {
            switch (data.CycleType) {
                case 'SECOND': {
                    var n = parseInt(data.SecondInterval) || 1;
                    return '每 ' + n + ' 秒執行一次';
                }
                case 'MINUTE': {
                    var n = parseInt(data.MinuteInterval) || 1;
                    var s = parseInt(data.MinuteAtSecond) || 0;
                    return '每 ' + n + ' 分鐘，第 ' + s + ' 秒時執行';
                }
                case 'HOUR': {
                    var n = parseInt(data.HourInterval) || 1;
                    var mi = parseInt(data.HourAtMinute) || 0;
                    var s  = parseInt(data.HourAtSecond) || 0;
                    return '每 ' + n + ' 小時，於 ' + pad(mi) + ' 分 ' + pad(s) + ' 秒執行';
                }
                case 'DAY': {
                    var n = parseInt(data.DayInterval) || 1;
                    var tp = (data.DayAtTime || '08:00').split(':');
                    var h = parseInt(tp[0]) || 0, m = parseInt(tp[1]) || 0;
                    return '每 ' + n + ' 天，於 ' + pad(h) + ':' + pad(m) + ' 執行';
                }
                case 'WEEK': {
                    var names = {'0':'日','1':'一','2':'二','3':'三','4':'四','5':'五','6':'六'};
                    var tp = (data.WeekAtTime || '08:00').split(':');
                    var h = parseInt(tp[0], 10); if (isNaN(h)) h = 8;
                    var m = parseInt(tp[1], 10); if (isNaN(m)) m = 0;
                    var labels = data.WeekDays
                        ? String(data.WeekDays).split(',').map(function(v){ return '週' + (names[v.trim()] || v.trim()); }).join('、')
                        : '每天';
                    return labels + '，於 ' + pad(h) + ':' + pad(m) + ' 執行';
                }
                case 'MONTH': {
                    var tp = (data.MonthAtTime || '08:00').split(':');
                    var h = parseInt(tp[0], 10); if (isNaN(h)) h = 8;
                    var m = parseInt(tp[1], 10); if (isNaN(m)) m = 0;
                    var dayStr = data.MonthDays || '1';
                    return '每月 ' + dayStr + ' 號，於 ' + pad(h) + ':' + pad(m) + ' 執行';
                }
                default: return '';
            }
        }

        // ========================================
        // 送出前驗證（每週/每月至少勾選一項）
        // ========================================
        function beforeSubmitValidation() {
            var type = $('#CycleType').val();
            if (type === 'WEEK') {
                if (getCheckedWeekDays().length === 0) {
                    Swal.fire({
                        icon: 'warning',
                        title: '@(config.GetMessage("Cycle_WeekRequired").ToHtmlString())',
                        confirmButtonText: pageConfig.messages.confirm,
                    });
                    return false;
                }
            }
            if (type === 'MONTH') {
                if (getCheckedMonthDays().length === 0) {
                    Swal.fire({
                        icon: 'warning',
                        title: '@(config.GetMessage("Cycle_MonthRequired").ToHtmlString())',
                        confirmButtonText: pageConfig.messages.confirm,
                    });
                    return false;
                }
            }
            return true;
        }

        // ========================================
        // 送出資料準備
        // ========================================
        function prepareSubmitData($form) {
            buildCron();
            var weekDays  = getCheckedWeekDays();
            var monthDays = getCheckedMonthDays();
            var data = {
                Id:             currentId || '00000000-0000-0000-0000-000000000000',
                ScheduleCycleCode:   $('#ScheduleCycleCode').val(),
                CycleName:           $('#CycleName').val(),
                CycleType:           $('#CycleType').val(),
                IsEnabled:           $('#IsEnabled').is(':checked'),
                CronExpression:      $('#CronExpression').val(),
                Description:         $('#Description').val(),
                DBTransferSettings: $('#DBTransferSettings').val() || [],
                DbCsvTransferSettings: $('#DbCsvTransferSettings').val() || [],
                FileTransferSettings: $('#FileTransferSettings').val() || [],
                OtherTransferSettings: $('#OtherTransferSettings').val() || [],
                SecondInterval:  parseInt($('#SecondInterval').val()) || null,
                MinuteInterval:  parseInt($('#MinuteInterval').val()) || null,
                MinuteAtSecond:  parseInt($('#MinuteAtSecond').val()) || null,
                HourInterval:    parseInt($('#HourInterval').val()) || null,
                HourAtMinute:    parseInt($('#HourAtMinute').val()) || null,
                HourAtSecond:    parseInt($('#HourAtSecond').val()) || null,
                DayInterval:     parseInt($('#DayInterval').val()) || null,
                DayAtTime:       $('#DayAtTime').val(),
                WeekDays:        weekDays.join(','),
                WeekAtTime:      $('#WeekAtTime').val(),
                MonthDays:       monthDays.join(','),
                MonthAtTime:     $('#MonthAtTime').val(),
            };
            return {
                data: JSON.stringify(data),
                contentType: 'application/json; charset=utf-8',
                dataType: 'json'
            };
        }

        // ========================================
        // 編輯填入回呼
        // ========================================
        function onAfterEditFill(data) {
            loadSelectOptions(function() {
                // 先清空再填入
                clearFormFields();
                $('#ScheduleCycleCode').val(data.ScheduleCycleCode || '');
                $('#ScheduleCycleCode').prop('readonly', true);  // 編輯時不允許修改 PK
                $('#CycleName').val(data.CycleName || '');
                $('#IsEnabled').prop('checked', data.IsEnabled !== false);
                $('#Description').val(data.Description || '');

                // 還原各週期數值
                $('#SecondInterval').val(data.SecondInterval != null ? data.SecondInterval : 1);
                $('#MinuteInterval').val(data.MinuteInterval != null ? data.MinuteInterval : 1);
                $('#MinuteAtSecond').val(data.MinuteAtSecond != null ? data.MinuteAtSecond : 0);
                $('#HourInterval').val(data.HourInterval != null ? data.HourInterval : 1);
                $('#HourAtMinute').val(data.HourAtMinute != null ? data.HourAtMinute : 0);
                $('#HourAtSecond').val(data.HourAtSecond != null ? data.HourAtSecond : 0);
                $('#DayInterval').val(data.DayInterval != null ? data.DayInterval : 1);
                $('#DayAtTime').val(data.DayAtTime || '08:00');
                $('#WeekAtTime').val(data.WeekAtTime || '08:00');
                $('#MonthAtTime').val(data.MonthAtTime || '08:00');

                // 週期類型 → 顯示對應 block
                var cycleTypeEl = document.getElementById('CycleType');
                if (cycleTypeEl) {
                    $('#CycleType').val(data.CycleType || '').trigger('change');
                }
                onCycleTypeChange();

                // 還原週/月 checkbox（用 ID 精確設定）
                if (data.WeekDays) {
                    var wdMap = {'0':'wdSun','1':'wdMon','2':'wdTue','3':'wdWed','4':'wdThu','5':'wdFri','6':'wdSat'};
                    String(data.WeekDays).split(',').forEach(function(v) {
                        var id = wdMap[v.trim()];
                        if (id) document.getElementById(id).checked = true;
                    });
                }
                if (data.MonthDays) {
                    String(data.MonthDays).split(',').forEach(function(v) {
                        var el = document.getElementById('md' + v.trim());
                        if (el) el.checked = true;
                    });
                }

                // Choices 多選
                if (data.DBTransferSettings && data.DBTransferSettings.length) {
                    setChoicesValues('#DBTransferSettings', data.DBTransferSettings);
                }
                if (data.OtherTaskSettings && data.OtherTaskSettings.length) {
                    setChoicesValues('#OtherTaskSettings', data.OtherTaskSettings);
                }
                if (data.FileTransferSettings && data.FileTransferSettings.length) {
                    setChoicesValues('#FileTransferSettings', data.FileTransferSettings);
                }
                if (data.OtherTransferSettings && data.OtherTransferSettings.length) {
                    setChoicesValues('#OtherTransferSettings', data.OtherTransferSettings);
                }

                buildCron();
            });
        }

        function setChoicesValues(selector, values) {
            $(selector).val(values).trigger('change');
        }

        // ========================================
        // 初始化
        // ========================================
        $(document).ready(function () {
            // 週期類型 change
            $('#CycleType').on('change', function() { onCycleTypeChange(); });

            // 週期細節輸入即時預覽（input/select 用 delegated，checkbox 直接綁）
            $(document).on('input change', '#block-SECOND input, #block-MINUTE input, #block-HOUR input, #block-DAY input, #WeekAtTime, #MonthAtTime', function() {
                buildCron();
            });
            ['wdSun','wdMon','wdTue','wdWed','wdThu','wdFri','wdSat'].forEach(function(id) {
                document.getElementById(id).addEventListener('change', buildCron);
            });
            for (var d = 1; d <= 31; d++) {
                document.getElementById('md' + d).addEventListener('change', buildCron);
            }

            // 初始化 Choices.js
            // 已由頁面頂端的 initPageChoices() 統一初始化，此處不重複執行

            // 立即執行（事件委派）
            $(document).on('click', '.execute-now-btn', function () {
                if ($(this).hasClass('disabled')) return;
                var id = $(this).data('id');
                executeNow(id);
            });

            loadDatas();
        });

        // ========================================
        // 執行紀錄
        // ========================================
        var _logAllData = [];
        var _logActiveFilter = null;

        $(document).on('click', '.view-log-btn', function () {
            var code = $(this).data('code');
            var name = $(this).data('name');
            $('#logModalLabel').html('<i class="ri-history-line me-2"></i>執行時間軸 — <strong>' + name + '</strong>');
            $('#logFilterBar').html('<span class="spinner-border spinner-border-sm text-secondary"></span>');
            $('#logTimelineContainer').html('');
            _logAllData = [];
            _logActiveFilter = null;
            var modal = new bootstrap.Modal(document.getElementById('logModal'));
            modal.show();

            $.getJSON('@(Configuration["BackendURL"])/api/cycle-settings/GetRecentLogs?scheduleCycleCode=' + encodeURIComponent(code), function (resp) {
                if (!resp || !resp.Data) { $('#logFilterBar').html(''); renderLogTimeline([]); return; }
                _logAllData = resp.Data;
                renderLogFilters(_logAllData);
                renderLogTimeline(_logAllData);
            }).fail(function () {
                $('#logFilterBar').html('');
                $('#logTimelineContainer').html('<div class="text-danger p-3">載入失敗</div>');
            });
        });

        function renderLogFilters(logs) {
            var bar = $('#logFilterBar');
            bar.empty();

            // 全部按鈕
            var allBtn = $('<button class="btn btn-sm btn-dark log-filter-btn" data-filter="all">全部</button>');
            bar.append(allBtn);

            // 蒐集所有 TransferCode + type
            var seen = {};
            logs.forEach(function (log) {
                (log.Details || []).forEach(function (d) {
                    var key = d.TransferCode;
                    if (!seen[key]) {
                        seen[key] = d.TransferTypeDisplay;
                        var badge = getTypeBadge(d.TransferTypeDisplay);
                        var btn = $('<button class="btn btn-sm btn-outline-secondary log-filter-btn" data-filter="' + key + '">' + key + ' ' + badge + '</button>');
                        bar.append(btn);
                    }
                });
            });

            bar.on('click', '.log-filter-btn', function () {
                bar.find('.log-filter-btn').removeClass('btn-dark').addClass('btn-outline-secondary');
                $(this).removeClass('btn-outline-secondary').addClass('btn-dark');
                var f = $(this).data('filter');
                _logActiveFilter = (f === 'all') ? null : f;
                renderLogTimeline(_logAllData);
            });
        }

        function renderLogTimeline(logs) {
            var container = $('#logTimelineContainer');
            container.empty();

            var filtered = logs;
            if (_logActiveFilter) {
                filtered = logs.filter(function (log) {
                    return (log.Details || []).some(function (d) { return d.TransferCode === _logActiveFilter; });
                });
            }

            if (!filtered || filtered.length === 0) {
                container.html('<div class="text-muted p-3">無執行紀錄</div>');
                return;
            }

            // 依日期分組
            var byDate = {};
            filtered.forEach(function (log) {
                var date = log.RunAtDate;
                if (!byDate[date]) byDate[date] = [];
                byDate[date].push(log);
            });

            Object.keys(byDate).sort().reverse().forEach(function (date) {
                var dateGroup = $('<div class="mb-3"></div>');
                dateGroup.append('<div class="fw-bold text-muted mb-2"><i class="ri-calendar-line me-1"></i>' + date + '</div>');

                byDate[date].forEach(function (log) {
                    var details = (log.Details || []);
                    if (_logActiveFilter) {
                        details = details.filter(function (d) { return d.TransferCode === _logActiveFilter; });
                    }

                    var triggerBadge = log.TriggerType === 'Manual'
                        ? '<span class="badge bg-info-subtle text-info border ms-1">手動</span>'
                        : '<span class="badge bg-secondary-subtle text-secondary border ms-1">排程</span>';

                    var block = $('<div class="border-start border-warning border-3 ps-3 mb-3"></div>');
                    block.append('<div class="text-muted small">' + log.RunAtTime + '</div>');
                    block.append('<div class="fw-semibold">' + (log.ScheduleCycleCode || '') + triggerBadge + '</div>');
                    block.append('<div class="text-muted small mb-1">耗時 ' + (log.DurationMs || 0) + ' ms ｜ 資料 ' + log.TotalDataCount + ' 筆 ｜ 錯誤 ' + log.TotalErrorCount + ' 筆</div>');

                    details.forEach(function (d) {
                        var statusBadge = getStatusBadge(d.JobStatus);
                        var typeBadge = getTypeBadge(d.TransferTypeDisplay);
                        var errorIcon = (d.ErrorCount > 0)
                            ? ' <a href="javascript:void(0)" class="text-danger ms-1 show-error-detail-btn" data-detail-id="' + d.Id + '" title="查看錯誤"><i class="ri-external-link-line"></i></a>'
                            : '';
                        block.append(
                            '<div class="d-flex align-items-center gap-1 mb-1 small">' +
                            statusBadge + ' ' + typeBadge +
                            ' <span>' + (d.TransferCode || '') + ' — 資料 ' + d.DataCount + ' / 錯誤 ' + d.ErrorCount + ' / ' + (d.DurationMs || 0) + 'ms</span>' +
                            errorIcon +
                            '</div>'
                        );
                    });

                    dateGroup.append(block);
                });

                container.append(dateGroup);
            });

            // 錯誤 detail 點擊
            container.off('click', '.show-error-detail-btn').on('click', '.show-error-detail-btn', function () {
                var detailId = $(this).data('detail-id');
                showErrorDetail(detailId);
            });
        }

        function showErrorDetail(detailId) {
            // 從已載入的資料中找
            var detail = null;
            _logAllData.forEach(function (log) {
                (log.Details || []).forEach(function (d) {
                    if (d.Id === detailId) detail = d;
                });
            });
            if (!detail) return;

            var body = $('#logErrorModalBody');
            body.empty();

            var typeBadge = getTypeBadge(detail.TransferTypeDisplay);
            $('#logErrorModalLabel').html(
                '<i class="ri-alert-line me-2"></i>錯誤詳情 — ' + (detail.TransferCode || '') + ' ' + typeBadge
            );

            // 任務層級錯誤訊息
            if (detail.ErrorMessage) {
                body.append('<div class="alert alert-danger mb-3"><strong>任務錯誤：</strong> ' + escHtml(detail.ErrorMessage) + '</div>');
            }

            var errors = detail.ErrorLogs || [];
            body.append('<div class="fw-semibold mb-2">資料列錯誤說明細 <span class="badge bg-danger">' + errors.length + '</span></div>');

            if (errors.length === 0) {
                body.append('<div class="text-muted">無錯誤紀錄</div>');
            } else {
                var table = $('<table class="table table-sm table-bordered align-top"></table>');
                table.append('<thead><tr><th style="width:40px">#</th><th style="width:30%">SQL</th><th>Exception</th></tr></thead>');
                var tbody = $('<tbody></tbody>');
                errors.forEach(function (e, i) {
                    tbody.append(
                        '<tr>' +
                        '<td>' + (i + 1) + '</td>' +
                        '<td><code class="text-muted small">' + escHtml(e.Sql || '-') + '</code></td>' +
                        '<td class="text-danger small">' + escHtml(e.Exception || '') + '</td>' +
                        '</tr>'
                    );
                });
                table.append(tbody);
                body.append(table);
            }

            // 先關閉 logModal，再開 logErrorModal
            var logModalEl = document.getElementById('logModal');
            var logModal = bootstrap.Modal.getInstance(logModalEl);
            if (logModal) {
                logModalEl.addEventListener('hidden.bs.modal', function openErr() {
                    logModalEl.removeEventListener('hidden.bs.modal', openErr);
                    new bootstrap.Modal(document.getElementById('logErrorModal')).show();
                }, { once: true });
                logModal.hide();
            } else {
                new bootstrap.Modal(document.getElementById('logErrorModal')).show();
            }
        }

        // 錯誤 Modal 關閉後重開 logModal
        document.getElementById('logErrorModal').addEventListener('hidden.bs.modal', function () {
            var logModalEl = document.getElementById('logModal');
            if (logModalEl) new bootstrap.Modal(logModalEl).show();
        });

        function getStatusBadge(status) {
            if (status === 'Success') return '<span class="badge bg-success-subtle text-success border">✔ Success</span>';
            if (status === 'PartialFail') return '<span class="badge bg-warning-subtle text-warning border">◑ PartialFail</span>';
            if (status === 'Failed') return '<span class="badge bg-danger-subtle text-danger border">✖ Failed</span>';
            return '<span class="badge bg-secondary-subtle text-secondary border">' + (status || '') + '</span>';
        }

        function getTypeBadge(typeDisplay) {
            if (typeDisplay === '資料轉入') return '<span class="badge bg-primary-subtle text-primary border">資料轉入</span>';
            if (typeDisplay === '檔案轉入') return '<span class="badge bg-info-subtle text-info border">檔案轉入</span>';
            return '<span class="badge bg-secondary-subtle text-secondary border">' + (typeDisplay || '') + '</span>';
        }

        function escHtml(str) {
            if (!str) return '';
            return String(str).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
        }
    </script>

}
