@model ViewModel.AccountVM
@{
    ViewBag.Title = "帳號管理";
    ViewBag.pTitle = "帳號管理";
    ViewBag.pageTitle = "系統管理";

    var mapUrl = new
    {
        Create = $"{Configuration["BackendURL"]}/api/Account/Create",
        Edit = $"{Configuration["BackendURL"]}/api/Account/Edit",
        Delete = $"{Configuration["BackendURL"]}/api/Account/Delete",
        Get = $"{Configuration["BackendURL"]}/api/Account/Get",
        Enable = $"{Configuration["BackendURL"]}/api/Account/Enable",
        GetRoleList = $"{Configuration["BackendURL"]}/api/Account/GetRoleList",
    };

    var accountStatusSelectList = ViewData["AccountStatusSelectList"] as List<SelectListItem>;
}

<div class="row">
    <div class="col-lg-12">
        <div class="card" id="datasList">
            <div class="card-header border-0">
                <div class="d-flex align-items-center">
                    <h5 class="card-title mb-0 flex-grow-1"></h5>
                    <div class="flex-shrink-0">
                        <div class="d-flex flex-wrap gap-2">
                            <button id="btnShowModal" class="btn btn-danger add-btn" data-bs-toggle="modal" data-bs-target="#showModal">
                                <i class="ri-add-line align-bottom me-1"></i> 新增
                            </button>
                            <button class="btn btn-soft-danger" id="remove-actions" onClick="deleteMultiple()">
                                <i class="ri-delete-bin-2-line"></i>
                            </button>
                        </div>
                    </div>
                </div>
            </div>
            <div class="card-body border border-dashed border-end-0 border-start-0">
                <form>
                    <div class="row g-3">
                        <div class="col-xxl-5 col-sm-12">
                            <div class="search-box">
                                <input type="text"
                                       id="globalSearchInput"
                                       class="form-control search bg-light border-light"
                                       placeholder="搜尋表格內容">
                                <i class="ri-search-line search-icon"></i>
                            </div>
                        </div>
                        <div class="col-xxl-2 col-sm-12">
                            <input type="text" class="form-control bg-light border-light" placeholder="請輸入帳號" id="MemberAccountSearch" name="MemberAccountSearch">
                        </div>
                        <div class="col-xxl-2 col-sm-12">
                            <input type="text" class="form-control bg-light border-light" placeholder="請輸入姓名" id="AccountNameSearch" name="AccountNameSearch">
                        </div>
                        <div class="col-xxl-2 col-sm-12">
                            <select class="form-control" id="AccountStatus" name="AccountStatus">
                                <option value=""></option>
                                @foreach (var item in accountStatusSelectList)
                                {
                                    <option value="@item.Value">@item.Text</option>
                                }
                            </select>
                        </div>
                        <div class="col-xxl-1 col-sm-4">
                            <button type="button" class="btn btn-primary w-100" onclick="SearchData();">
                                <i class="ri-equalizer-fill me-1 align-bottom"></i>
                                篩選
                            </button>
                        </div>
                    </div>
                </form>
            </div>
            <div class="card-body">
                <div class="table-responsive table-card mb-4">
                    <table class="table align-middle table-nowrap mb-0" id="dataTable">
                        <thead>
                            <tr>
                                <th data-sort="action">操作</th>
                                <th data-sort="No">項次</th>
                                <th class="sort" data-sort="MemberAccount">帳號</th>
                                <th class="sort" data-sort="AccountName">姓名</th>
                                <th class="sort" data-sort="AccountEmail">Email</th>
                                <th>角色</th>
                                <th class="sort" data-sort="AccountStatus">狀態</th>
                                <th class="sort" data-sort="LastLoginTime">最後登入時間</th>
                            </tr>
                        </thead>
                        <tbody class="list form-check-all" id="data-list-data">
                            <tr>
                                <th scope="row">
                                    <div class="form-check">
                                        <input class="form-check-input" type="checkbox" name="checkAll" value="option1">
                                    </div>
                                </th>
                            </tr>
                        </tbody>
                    </table>
                    <div class="noresult" style="display: none">
                        <div class="text-center">
                            <lord-icon src="@Url.Content("~/assets/json/lord-icon/msoeawqm.json")" trigger="loop" colors="primary:#121331,secondary:#08a88a" style="width:75px;height:75px"></lord-icon>
                            <h5 class="mt-2">查無資料</h5>
                        </div>
                    </div>
                </div>
                <div class="d-flex justify-content-end mt-2">
                    <div class="pagination-wrap hstack gap-2">
                        <a class="page-item pagination-prev disabled" href="#">
                            上一頁
                        </a>
                        <ul class="pagination listjs-pagination mb-0"></ul>
                        <a class="page-item pagination-next" href="#">
                            下一頁
                        </a>
                    </div>
                </div>

                <!-- Delete Modal -->
                <div class="modal fade flip" id="deleteOrder" tabindex="-1" aria-hidden="true">
                    <div class="modal-dialog modal-dialog-centered">
                        <div class="modal-content">
                            <div class="modal-body p-5 text-center">
                                <lord-icon src="@Url.Content("~/assets/json/lord-icon/gsqxdxog.json")" trigger="loop" colors="primary:#405189,secondary:#f06548" style="width:90px;height:90px"></lord-icon>
                                <div class="mt-4 text-center">
                                    <h4>您即將刪除資料</h4>
                                    <p class="text-muted fs-14 mb-4">
                                        刪除後將無法復原
                                    </p>
                                    <div class="hstack gap-2 justify-content-center remove">
                                        <button class="btn btn-link link-success fw-medium text-decoration-none" id="deleteRecord-close" data-bs-dismiss="modal">
                                            <i class="ri-close-line me-1 align-middle"></i>
                                            取消
                                        </button>
                                        <button class="btn btn-danger" id="delete-record">確定刪除</button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Create/Edit Modal -->
<div class="modal fade zoomIn" id="showModal" tabindex="-1" aria-labelledby="exampleModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content border-0">
            <div class="modal-header p-3 bg-info-subtle">
                <h5 class="modal-title" id="exampleModalLabel_Create" style="display:none;">新增帳號</h5>
                <h5 class="modal-title" id="exampleModalLabel_Edit" style="display:none;">編輯帳號</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close" id="close-modal"></button>
            </div>
            <form class="needs-validation" novalidate="" method="post" id="submitForm">
                <div class="modal-body">
                    <div class="row g-3">
                        <div class="col-lg-6">
                            <div>
                                <label for="MemberAccount" class="form-label required">帳號</label>
                                <input type="text" name="MemberAccount" id="MemberAccount" class="form-control" placeholder="請輸入帳號" required maxlength="100"/>
                                <div class="invalid-feedback">請輸入帳號</div>
                            </div>
                        </div>
                        <div class="col-lg-6">
                            <div>
                                <label for="AccountName" class="form-label required">姓名</label>
                                <input type="text" name="AccountName" id="AccountName" class="form-control" placeholder="請輸入姓名" required maxlength="100"/>
                                <div class="invalid-feedback">請輸入姓名</div>
                            </div>
                        </div>
                        <div class="col-lg-12">
                            <div>
                                <label for="AccountEmail" class="form-label">Email</label>
                                <input type="email" name="AccountEmail" id="AccountEmail" class="form-control" placeholder="請輸入Email" pattern="[a-z0-9._%+-]+@@[a-z0-9.-]+\.[a-z]{2,4}$" maxlength="100"/>
                                <div class="invalid-feedback">Email格式錯誤</div>
                            </div>
                        </div>
                        <div class="col-lg-6">
                            <div>
                                <label for="MemberPWD" class="form-label required">密碼</label>
                                <input type="password" name="MemberPWD" id="MemberPWD" class="form-control" placeholder="請輸入密碼" required maxlength="100"/>
                                <small class="text-muted" id="pwd-edit-hint" style="display:none;">不輸入則保持原密碼</small>
                                <div class="invalid-feedback">請輸入密碼</div>
                            </div>
                        </div>
                        <div class="col-lg-6">
                            <div>
                                <label for="ConfirmPassword" class="form-label required">確認密碼</label>
                                <input type="password" name="ConfirmPassword" id="ConfirmPassword" class="form-control" placeholder="請再次輸入密碼" required maxlength="100"/>
                                <div class="invalid-feedback">請輸入密碼</div>
                            </div>
                        </div>
                        <div class="col-lg-6">
                            <div>
                                <label for="AccountStatus" class="form-label required">狀態</label>
                                <select name="AccountStatus" id="AccountStatus_Modal" class="form-control" required>
                                    @foreach (var item in accountStatusSelectList)
                                    {
                                        <option value="@item.Value">@item.Text</option>
                                    }
                                </select>
                            </div>
                        </div>
                        <div class="col-lg-6">
                            <div>
                                <label for="RoleIds" class="form-label">角色</label>
                                <select name="RoleIds" id="RoleIds" class="form-control" multiple>
                                </select>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <div class="hstack gap-2 justify-content-end">
                        <button type="button" class="btn btn-light" data-bs-dismiss="modal">取消</button>
                        <button type="submit" class="btn btn-success" id="add-btn">確定</button>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>

@section scripts {
    <script>
        // 全域查詢狀態
        let queryState = {
            pageIndex: 1,
            pageSize: 10,
            sortField: "CreatedAt",
            sortOrder: "desc",
            memberAccount: "",
            accountName: "",
            accountStatus: "",
        };

        let roleList = [];

        // 主載入函式
        function loadDatas() {
            showLoader();
            $.ajax({
                url: '@(Configuration["BackendURL"])/api/Account/GetPageList',
                type: 'GET',
                data: queryState,
                success: function (res) {
                    hideLoader();
                    if (!res.Success) {
                        Swal.fire({
                            icon: 'error',
                            title: res.Message,
                            confirmButtonText: '確定',
                        });
                        return;
                    }
                    renderTable(res.Data.Data);
                    renderPagination(res.Data.Total);
                    document.getElementById("remove-actions").style.display = 'none';
                },
                error: function () {
                    hideLoader();
                    
                    Swal.fire({
                            icon: 'error',
                            title:'@config.GetMessage("System_Error").ToHtmlString()',
                            confirmButtonText: '確定',
                        });
                }
            });
        }

        // 表格渲染
        function renderTable(rows) {
            const tbody = $('#data-list-data');
            tbody.empty();

            if (!rows || rows.length === 0) {
                $('.noresult').show();
                return;
            }
            $('.noresult').hide();

            rows.forEach(data => {
                const statusBadge = data.AccountStatus === '@AccountStatusEnum.Enabled.ToInt()' ?
                    '<span class="badge bg-success-subtle text-success">@AccountStatusEnum.Enabled.GetDescription().ToHtmlString()</span>' :
                    '<span class="badge bg-secondary-subtle text-secondary">@AccountStatusEnum.Disabled.GetDescription().ToHtmlString()</span>';

                tbody.append(`
                    <tr data-id="${data.Id}">
                        <td>
                            <div class="dropdown">
                                <button class="btn btn-soft-secondary btn-sm dropdown" type="button" data-bs-toggle="dropdown">
                                    <i class="ri-more-fill align-middle"></i>
                                </button>
                                <ul class="dropdown-menu dropdown-menu-end">
                                    <li><a class="dropdown-item edit-item-btn" href="#showModal" data-bs-toggle="modal"><i class="ri-pencil-fill align-bottom me-2 text-muted"></i> 編輯</a></li>
                                    <li><hr class="dropdown-divider"></li>
                                    <li><a class="dropdown-item enable-item-btn" href="javascript:void(0)" data-enable="${data.AccountStatus === '@AccountStatusEnum.Enabled.ToInt()' ? '@AccountStatusEnum.Disabled.ToInt()' : '@AccountStatusEnum.Enabled.ToInt()'}">
                                        <i class="ri-${data.AccountStatus === '@AccountStatusEnum.Enabled.ToInt()' ? 'lock' : 'lock-unlock'}-fill align-bottom me-2 text-muted"></i>
                                        ${data.AccountStatus === '@AccountStatusEnum.Enabled.ToInt()' ? '停用' : '啟用'}
                                    </a></li>
                                </ul>
                            </div>
                        </td>
                        <td class="No">${data.No}</td>
                        <td class="MemberAccount">${data.MemberAccount || ''}</td>
                        <td class="AccountName">${data.AccountName || ''}</td>
                        <td class="AccountEmail">${data.AccountEmail || ''}</td>
                        <td class="RoleName">${data.RoleName || ''}</td>
                        <td class="AccountStatus">${statusBadge}</td>
                        <td class="LastLoginTime">${data.LastLoginTime ? new Date(data.LastLoginTime).toLocaleString('zh-TW') : ''}</td>
                    </tr>
                `);
            });
            initDynamicDropdowns();
        }

        // 分頁渲染（與 ESDbTransfer 相同邏輯）
        function renderPagination(total) {
            const totalPages = Math.ceil(total / queryState.pageSize);
            const ul = $('.listjs-pagination');
            ul.empty();

            if (totalPages <= 1) return;

            const maxPages = 5;
            let startPage = Math.max(1, queryState.pageIndex - Math.floor(maxPages / 2));
            let endPage = startPage + maxPages - 1;

            if (endPage > totalPages) {
                endPage = totalPages;
                startPage = Math.max(1, endPage - maxPages + 1);
            }

            if (startPage > 1) {
                ul.append(`<li class="page-item"><a class="page-link" href="javascript:void(0)" onclick="gotoPage(1)">第一頁</a></li>`);
                ul.append(`<li class="page-item disabled"><span class="page-link">...</span></li>`);
            }

            for (let i = startPage; i <= endPage; i++) {
                ul.append(`<li class="page-item ${i === queryState.pageIndex ? 'active' : ''}"><a class="page-link" href="javascript:void(0)" onclick="gotoPage(${i})">${i}</a></li>`);
            }

            if (endPage < totalPages) {
                ul.append(`<li class="page-item disabled"><span class="page-link">...</span></li>`);
                ul.append(`<li class="page-item"><a class="page-link" href="javascript:void(0)" onclick="gotoPage(${totalPages})">最後一頁</a></li>`);
            }

            $('.pagination-prev').toggleClass('disabled', queryState.pageIndex === 1);
            $('.pagination-next').toggleClass('disabled', queryState.pageIndex === totalPages);

            $('.pagination-prev').off('click').on('click', function (e) {
                e.preventDefault();
                if (queryState.pageIndex > 1) {
                    queryState.pageIndex--;
                    loadDatas();
                }
            });

            $('.pagination-next').off('click').on('click', function (e) {
                e.preventDefault();
                if (queryState.pageIndex < totalPages) {
                    queryState.pageIndex++;
                    loadDatas();
                }
            });
        }

        function gotoPage(page) {
            queryState.pageIndex = page;
            loadDatas();
        }

        // 搜尋篩選
        function SearchData() {
            queryState.memberAccount = $('#MemberAccountSearch').val();
            queryState.accountName = $('#AccountNameSearch').val();
            queryState.accountStatus = $('#AccountStatus').val();
            queryState.pageIndex = 1;
            $('#globalSearchInput').val('').trigger('input');
            loadDatas();
        }

        // 載入角色列表
        function loadRoleList() {
            $.ajax({
                url: '@mapUrl.GetRoleList',
                type: 'GET',
                success: function (res) {
                    if (res.Success) {
                        roleList = res.Data;
                        SetupSelect($('#RoleIds'), roleList, false);
                    }
                }
            });
        }

        // 初始化
        $(document).ready(function () {
            loadDatas();
            loadRoleList();

            $('#AccountStatus').select2({
                minimumResultsForSearch:-1,
                placeholder:'請選擇狀態',
                allowClear:true
            })

            $('#globalSearchInput').on('input', function () {
                const keyword = $(this).val().toLowerCase();
                $('#data-list-data tr').each(function () {
                    const rowText = $(this).text().toLowerCase();
                    $(this).toggle(rowText.includes(keyword));
                });
            });

            // 初始化 Select2
            $('#AccountStatus_Modal').select2({
                minimumResultsForSearch: Infinity,
                width: '100%',
                dropdownParent: $('#showModal')
            });

            $('#RoleIds').select2({
                width: '100%',
                dropdownParent: $('#showModal'),
                allowClear: true,
            });

            $('.sort').on('click', function () {
                const field = $(this).data('sort');
                if (queryState.sortField === field) {
                    queryState.sortOrder = queryState.sortOrder === 'asc' ? 'desc' : 'asc';
                } else {
                    queryState.sortField = field;
                    queryState.sortOrder = 'asc';
                }
                loadDatas();
            });
        });

        function SetupSelect(obj, dataList, isSearchEnabled) {
            const $select = obj;
            $select.empty();
            dataList.forEach(x => {
                $select.append(new Option(x.CodeName, x.CodeID));
            });
            $select.trigger('change');
        }

        // 新增按鈕
        var postaction = 'create';
        $("#btnShowModal").click(function () {
            resetElement();
            $('#exampleModalLabel_Create').show();
            $('#exampleModalLabel_Edit').hide();
            $('#pwd-edit-hint').hide();
            $('#MemberPWD').prop('required', true);
            $('#ConfirmPassword').prop('required', true);
             $('#MemberAccount').prop('readonly',false)
            postaction = 'create';
        });

        // 表單提交
        $("#submitForm").submit(function (e) {
            e.preventDefault();

            // Bootstrap needs-validation：驗證所有 required + pattern 欄位
            const form = this;
            form.classList.add('was-validated');
            if (!form.checkValidity()) {
                return;
            }

            showLoader();

            // 密碼確認
            const pwd = $('#MemberPWD').val();
            const confirmPwd = $('#ConfirmPassword').val();
            
            if (postaction === 'create' && !pwd) {
                hideLoader();
                Swal.fire({
                    icon: 'warning',
                    title: '請輸入密碼',
                    confirmButtonText: '確定',
                });
                return;
            }

            if (pwd && pwd !== confirmPwd) {
                hideLoader();
                Swal.fire({
                    icon: 'warning',
                    title: '密碼不一致',
                    confirmButtonText: '確定',
                });
                return;
            }

            var postURL = postaction === 'create' ? '@mapUrl.Create' : '@mapUrl.Edit';
            var data = {};
            $.extend(data, $(this).serializeObject());
            data.Id = currentId;

            // 取得選中的角色
            data.RoleIds = $('#RoleIds').val();

            $.ajax({
                type: "POST",
                url: postURL,
                dataType: "json",
                data: data,
                cache: false,
                success: function (response) {
                    if (!response.Success) {
                        Swal.fire({
                            icon: 'warning',
                            title: response.Message,
                            confirmButtonText: '確定',
                        });
                        return;
                    }

                    const modal = bootstrap.Modal.getInstance(showModal);
                    modal.hide();

                    var successMsg = postaction === 'create' ? '新增成功' : '編輯成功';
                    Swal.fire({
                        icon: 'success',
                        title: successMsg,
                        confirmButtonText: '確定',
                    }).then(() => {
                        loadDatas();
                    });

                    resetElement();
                },
                error: function (xhr, status, error) {
                    Swal.fire({
                        icon: 'error',
                        title: '@config.GetMessage("System_Error").ToHtmlString()',
                        confirmButtonText: '確定',
                    });
                }
            }).always(function () {
                hideLoader();
            });
        });

        var currentId;

        // 刪除按鈕
        $(document).on('click', '.remove-item-btn', function (e) {
            e.preventDefault();
            const $tr = $(this).closest('tr');
            currentId = $tr.data('id');
            if (!currentId) return;
        });

        // 編輯按鈕
        $(document).on('click', '.edit-item-btn', function (e) {
            document.getElementById('submitForm').classList.remove('was-validated');
            $('#exampleModalLabel_Create').hide();
            $('#exampleModalLabel_Edit').show();
            $('#pwd-edit-hint').show();
            $('#MemberPWD').prop('required', false);
            $('#ConfirmPassword').prop('required', false);
            postaction = 'edit';
            e.preventDefault();

            const $tr = $(this).closest('tr');
            currentId = $tr.data('id');

            if (!currentId) {
                Swal.fire({
                    icon: 'warning',
                    title: '資料不存在',
                    confirmButtonText: '確定',
                });
                const modal = bootstrap.Modal.getInstance(showModal);
                modal.hide();
                return;
            }

            showLoader();

            $.ajax({
                type: "POST",
                url: '@mapUrl.Get',
                dataType: "json",
                data: { id: currentId },
                cache: false,
                success: function (response) {
                    if (!response.Success) {
                        Swal.fire({
                            icon: 'error',
                            title: response.Message,
                            confirmButtonText: '確定',
                        });
                        return;
                    }

                    $('#MemberAccount').val(response.Data.MemberAccount);
                    $('#MemberAccount').prop('readonly',true)
                    $('#AccountName').val(response.Data.AccountName);
                    $('#AccountEmail').val(response.Data.AccountEmail);
                    $('#MemberPWD').val('');
                    $('#ConfirmPassword').val('');

                    $('#AccountStatus_Modal').val(response.Data.AccountStatus || '1').trigger('change');

                    // 設定角色
                    if (response.Data.RoleIds) {
                        $('#RoleIds').val(response.Data.RoleIds).trigger('change');
                    }
                },
                error: function (xhr, status, error) {
                    Swal.fire({
                        icon: 'error',
                        title: '@config.GetMessage("System_Error").ToHtmlString()',
                        confirmButtonText: '確定',
                    });
                }
            }).always(function () {
                hideLoader();
            });
        });

        // 啟用/停用
        $(document).on('click', '.enable-item-btn', function (e) {
            e.preventDefault();
            const $tr = $(this).closest('tr');
            const id = $tr.data('id');
            const enable = $(this).data('enable');
            const action = enable === 1 ? '啟用' : '停用';

            Swal.fire({
                title: `確定要${action}嗎？`,
                icon: 'question',
                showCancelButton: true,
                confirmButtonText: '確定',
                cancelButtonText: '取消'
            }).then((result) => {
                if (result.isConfirmed) {
                    showLoader();
                    $.ajax({
                        type: "POST",
                        url: '@mapUrl.Enable',
                        data: { id: id, enable: enable },
                        success: function (response) {
                            if (response.Success) {
                                Swal.fire({
                                    icon: 'success',
                                    title: response.Data,
                                    confirmButtonText: '確定',
                                }).then(() => {
                                    loadDatas();
                                });
                            } else {
                                Swal.fire({
                                    icon: 'warning',
                                    title: response.Message,
                                    confirmButtonText: '確定',
                                });
                            }
                        },
                        error: function () {
                            Swal.fire({
                                icon: 'error',
                                title: '@config.GetMessage("System_Error").ToHtmlString()',
                                confirmButtonText: '確定',
                            });
                        }
                    }).always(function () {
                        hideLoader();
                    });
                }
            });
        });

        // 刪除確認
        $("#delete-record").click(function () {
            var ids = [currentId];
            showLoader();

            $.ajax({
                type: "POST",
                url: '@mapUrl.Delete',
                dataType: "json",
                data: { list: ids },
                cache: false,
                success: function (response) {
                    const modal = bootstrap.Modal.getInstance(deleteOrder);
                    modal.hide();

                    if (!response.Success) {
                        Swal.fire({
                            icon: 'warning',
                            title: response.Message,
                            confirmButtonText: '確定',
                        });
                        return;
                    }

                    loadDatas();

                    Swal.fire({
                        icon: 'success',
                        title: '刪除成功',
                        confirmButtonText: '確定',
                    });
                },
                error: function (xhr, status, error) {
                    Swal.fire({
                        icon: 'error',
                        title: '系統錯誤',
                        confirmButtonText: '確定',
                    });
                }
            }).always(function () {
                hideLoader();
            });
        });

        // 批次刪除
        function deleteMultiple() {
            let ids_array = [];
            $('.form-check [value=option1]:checked').each(function () {
                const $tr = $(this).closest('tr');
                const id = $tr.data('id');
                if (id) ids_array.push(id);
            });

            if (ids_array.length === 0) {
                Swal.fire({
                    title: '請至少選擇一筆資料',
                    confirmButtonText: '確定',
                });
                return;
            }

            Swal.fire({
                title: "確定要刪除嗎？",
                text: "刪除後將無法復原",
                icon: "warning",
                showCancelButton: true,
                confirmButtonText: "確定刪除",
                cancelButtonText: "取消",
            }).then(function (result) {
                if (result.value) {
                    showLoader();
                    $.ajax({
                        type: "POST",
                        url: '@mapUrl.Delete',
                        dataType: "json",
                        data: { list: ids_array },
                        cache: false,
                        success: function (response) {
                            if (!response.Success) {
                                Swal.fire({
                                    icon: 'warning',
                                    title: response.Message,
                                    confirmButtonText: '確定',
                                });
                                return;
                            }

                            loadDatas();

                            Swal.fire({
                                title: '已刪除',
                                text: '您的資料已被刪除',
                                icon: 'success',
                            });
                        },
                        error: function (xhr, status, error) {
                            Swal.fire({
                                icon: 'error',
                                title: '系統錯誤',
                                confirmButtonText: '確定',
                            });
                        }
                    }).always(function () {
                        hideLoader();
                    });
                }
            });
        }

        // 重置表單
        function resetElement() {
            document.getElementById('submitForm').classList.remove('was-validated');
            $('#showModal input').val('');
            $('#showModal textarea').val('');
            $('#showModal').find('[type="checkbox"]').prop('checked', false);

            $('#showModal').find('select').each(function () {
                if (this.multiple) {
                    $(this).val(null).trigger('change');
                } else {
                    const firstValue = this.options[0]?.value;
                    if (firstValue != null) {
                        $(this).val(firstValue).trigger('change');
                    }
                }
            });
        }

        // 勾選相關
        function toggleRemoveActions() {
            if ($('.row-check:checked').length > 0)
                $('#remove-actions').show();
            else
                $('#remove-actions').hide();
        }

        $(document).on('change', '.row-check', function () {
            const total = $('.row-check').length;
            const checked = $('.row-check:checked').length;
            $('#checkAll').prop('checked', total === checked);
            toggleRemoveActions();
        });

        $('#checkAll').on('change', function () {
            $('.row-check').prop('checked', this.checked);
            toggleRemoveActions();
        });
    </script>
}
