@{
    // Layout = "~/Views/Shared/_LayoutDemo.cshtml";
    ViewBag.Title = "配方主檔管理";
    ViewBag.pTitle = "配方主檔管理";
    ViewBag.pageTitle = "配方管理";
}

<div class="row">
    <div class="col-lg-12">
        <div class="card" id="datasList">
            <div class="card-header border-0">
                <div class="d-flex align-items-center">
                    <h5 class="card-title mb-0 flex-grow-1"></h5>
                    <div class="flex-shrink-0">
                        <div class="d-flex flex-wrap gap-2">
                            <button id="btnShowModal" class="btn btn-success add-btn" data-bs-toggle="modal"
                                    data-bs-target="#recipeModal">
                                <i class="ri-add-line align-bottom me-1"></i>新増
                            </button>
                            <button class="btn btn-soft-danger" id="remove-actions" style="display:none;">
                                <i class="ri-delete-bin-2-line"></i>
                            </button>
                        </div>
                    </div>
                </div>
            </div>

            <div class="card-body border border-dashed border-end-0 border-start-0">
                <form>
                    <div class="row g-3">
                        <div class="col-xxl-3 col-sm-12">
                            <div class="search-box">
                                <input type="text" id="globalSearchInput"
                                       class="form-control search bg-light border-light" placeholder="搜尋表格內容">
                                <i class="ri-search-line search-icon"></i>
                            </div>
                        </div>
                        <div class="col-xxl-3 col-sm-12">
                            <div class="search-box">
                                <input type="text" id="keywordInput" class="form-control search bg-light border-light"
                                       placeholder="搜尋關鍵字">
                                <i class="ri-search-line search-icon"></i>
                            </div>
                        </div>
                        <div class="col-xxl-1 col-sm-4">
                            <button type="button" class="btn btn-primary w-100" onclick="loadList();">
                                <i class="ri-equalizer-fill me-1 align-bottom"></i>篩選
                            </button>
                        </div>
                    </div>
                </form>
            </div>

            <div class="card-body">
                <div class="table-responsive table-card mb-4">
                    <table class="table align-middle table-nowrap mb-0" id="dataTable">
                        <thead>
                            <tr>
                                <th style="width:40px;">
                                    <div class="form-check">
                                        <input class="form-check-input" type="checkbox" id="checkAll">
                                    </div>
                                </th>
                                <th style="width:100px;">Action</th>
                                <th style="width:40px;">項次</th>
                                <th>配方編號</th>
                                <th>配方名稱</th>
                                <th>現行版號</th>
                                <th>版號規則</th>
                                <th>負責工程師</th>
                                <th>版本數</th>
                                <th>建立日期</th>
                                <th>最後更新</th>
                            </tr>
                        </thead>
                        <tbody id="recipe-list-data">
                        </tbody>
                    </table>
                    <div class="noresult" style="display:none;">
                        <div class="text-center">
                            <lord-icon src="https://cdn.lordicon.com/msoeawqm.json" trigger="loop"
                                       colors="primary:#121331,secondary:#08a88a" style="width:75px;height:75px"></lord-icon>
                            <h5 class="mt-2">查無資料</h5>
                        </div>
                    </div>
                </div>

                <!-- Delete Confirm Modal -->
                <div class="modal fade flip" id="deleteModal" tabindex="-1" aria-hidden="true">
                    <div class="modal-dialog modal-dialog-centered">
                        <div class="modal-content">
                            <div class="modal-body p-5 text-center">
                                <lord-icon src="https://cdn.lordicon.com/gsqxdxog.json" trigger="loop"
                                           colors="primary:#405189,secondary:#f06548"
                                           style="width:90px;height:90px"></lord-icon>
                                <div class="mt-4 text-center">
                                    <h4>確定要刪除此配方？</h4>
                                    <p class="text-muted"><small>刪除後將無法復原。</small></p>
                                    <div class="hstack gap-2 justify-content-center">
                                        <button class="btn btn-link link-success fw-medium text-decoration-none"
                                                data-bs-dismiss="modal">
                                            <i class="ri-close-line me-1 align-middle"></i>取消
                                        </button>
                                        <button class="btn btn-danger" id="btnConfirmDelete">確定刪除</button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- ═══ Modal: 新増配方 ═══ -->
<div class="modal fade zoomIn" id="recipeModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content border-0">
            <div class="modal-header p-3 bg-info-subtle">
                <h5 class="modal-title">新増配方</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form class="needs-validation" novalidate id="recipeForm">
                <div class="modal-body">
                    <input type="hidden" id="f_Id" value="0" />
                    <div class="row g-3">
                        <div class="col-lg-6">
                            <label for="f_RecipeNo" class="col-form-label pt-0 required">配方編號</label>
                            <input type="text" id="f_RecipeNo" name="RecipeNo" class="form-control" maxlength="50"
                                   placeholder="例：CVD-001" required />
                        </div>
                        <div class="col-lg-6">
                            <label for="f_Engineer" class="col-form-label pt-0 required">負責工程師</label>
                            <input type="text" id="f_Engineer" name="Engineer" class="form-control" maxlength="100"
                                   placeholder="工程師姓名" required />
                        </div>
                        <div class="col-lg-12">
                            <label for="f_RecipeName" class="col-form-label pt-0 required">配方名稱</label>
                            <input type="text" id="f_RecipeName" name="RecipeName" class="form-control" maxlength="200"
                                   placeholder="配方名稱描述" required />
                        </div>
                        <div class="col-lg-12">
                            <label for="f_VersionNoRuleId" class="col-form-label pt-0 required">版號規則</label>
                            <select id="f_VersionNoRuleId" name="VersionNoRuleId" class="form-select" required>
                            </select>
                            <div class="invalid-feedback">請選擇版號規則。</div>
                            <div class="form-text text-muted">新增版本時將依此規則自動產生版號。</div>
                        </div>
                        <div class="col-lg-6">
                            <label for="f_Process" class="col-form-label pt-0 required">流程</label>
                            <select id="f_Process" name="ProcessId" class="form-select" required>
                                <option value="P1">流程1</option>
                                <option value="P2">流程2</option>
                            </select>
                            <div class="invalid-feedback">請選擇流程。</div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-light" data-bs-dismiss="modal">取消</button>
                    <button type="submit" class="btn btn-success" id="btnSaveRecipe">
                        <i class="ri-save-line me-1"></i>儲存
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section scripts {
    <script>
        $(document).ready(function () {
            var pTitle = '@(Html.Raw(ViewBag.pTitle))';
            var pageTitle = '@(Html.Raw(ViewBag.pageTitle))';
            $('#header-pTitle').text(pTitle);
            var bElList = [];
            if (pageTitle) bElList.push('<li class="breadcrumb-item"><a href="javascript: void(0);">' + pageTitle + '</a></li>');
            bElList.push('<li class="breadcrumb-item active">' + pTitle + '</li>');
            $('#_page_title_row .breadcrumb').html(bElList.join(''));

            $('#f_Process').select2();
        });
    </script>
    @await Html.PartialAsync("_CrudCommonScripts")
    <script>
        $('#f_VersionNoRuleId').select2({ width: '100%', dropdownParent: $('#recipeModal') });

        var apiUrls = {
            GetList: '@(Configuration["BackendURL"])/api/RecipeMgmt/GetList',
            Save: '@(Configuration["BackendURL"])/api/RecipeMgmt/Save',
            Delete: '@(Configuration["BackendURL"])/api/RecipeMgmt/Delete',
            BatchDelete: '@(Configuration["BackendURL"])/api/RecipeMgmt/BatchDelete',
            EditPage: '@Url.Action("Edit", "RecipeMgmt")',
            GetVersionNoRuleOptions: '@(Configuration["BackendURL"])/api/RecipeMgmt/GetVersionNoRuleOptions'
        };

        var deleteId = 0;

        // ── 橋接 _CrudCommonScripts –––––––––––––––––––––––––––––––––––––––––––––––
        function loadDatas() { loadList(); }

        // ── DOM ––––––––––––––––––––––––––––––––––––––––––––––––––––––––––––––
        var dom = {
            listBody: $('#recipe-list-data'),
            noresult: $('.noresult'),
            recipeForm: $('#recipeForm'),
            recipeModal: $('#recipeModal'),
            deleteModal: $('#deleteModal'),
            btnConfirmDel: $('#btnConfirmDelete'),
            globalSearch: $('#globalSearchInput'),
            keywordInput: $('#keywordInput'),
        };

        // ── 工具函式 ───────────────────────────────────────────────────────────────────
        function escapeHtml(value) {
            return $('<div>').text(value ?? '').html();
        }

        function showSysError() {
            Swal.fire({
                icon: 'error',
                title: pageConfig.messages.systemError,
                confirmButtonText: pageConfig.messages.confirm,
            });
        }

        // ── 清單載入 ─────────────────────────────────────────────────────────────────
        function loadList() {
            showLoader();
            $.ajax({
                url: apiUrls.GetList,
                type: 'GET',
                data: { keyword: dom.keywordInput.val() },
                success: function (res) {
                    if (!res.Success) { showSysError(); return; }
                    var list = res.Data || [];
                    var globalKw = dom.globalSearch.val().trim().toLowerCase();
                    if (globalKw) {
                        list = list.filter(function (r) {
                            return [
                                r.RecipeNo, r.RecipeName, r.Engineer,
                                r.CurrentVersionNo, r.CreateTime, r.UpdateTime
                            ].some(function (v) {
                                return (v || '').toLowerCase().includes(globalKw);
                            });
                        });
                    }
                    renderList(list);
                },
                error: function () { showSysError(); },
                complete: function () { hideLoader(); }
            });
        }

        function renderList(list) {
            dom.listBody.empty();
            if (!list.length) {
                dom.noresult.show();
                return;
            }
            dom.noresult.hide();
            list.forEach(function (r, idx) {
                dom.listBody.append(buildRow(r, idx + 1));
            });
        }

        function buildRow(r, no) {
            return `<tr data-id="${r.Id}">
                    <td><div class="form-check"><input class="form-check-input row-check" type="checkbox" value="${r.Id}"></div></td>
                    <td>
                        <div class="dropdown">
                            <button class="btn btn-soft-secondary btn-sm dropdown" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                <i class="ri-more-fill align-middle"></i>
                            </button>
                            <ul class="dropdown-menu dropdown-menu-end">
                                <li><a class="dropdown-item" href="${apiUrls.EditPage}?Id=${r.Id}">
                                    <i class="ri-pencil-fill align-bottom me-2 text-muted"></i>編輯</a></li>
                                <li><a class="dropdown-item delete-btn" href="javascript:void(0)" data-id="${r.Id}">
                                    <i class="ri-delete-bin-fill align-bottom me-2 text-muted"></i>刪除</a></li>
                            </ul>
                        </div>
                    </td>
                    <td>${no}</td>
                    <td><span class="fw-semibold">${escapeHtml(r.RecipeNo)}</span></td>
                    <td>${escapeHtml(r.RecipeName)}</td>
                    <td><code>${escapeHtml(r.CurrentVersionNo)}</code></td>
                    <td><span class="badge bg-info-subtle text-info">${escapeHtml(r.VersionNoRuleName || '—')}</span></td>
                    <td>${escapeHtml(r.Engineer)}</td>
                    <td><span class="badge bg-secondary-subtle text-secondary">${r.VersionCount}</span></td>
                    <td>${escapeHtml(r.CreateTime)}</td>
                    <td>${escapeHtml(r.UpdateTime)}</td>
                </tr>`;
        }

        // ── 新増 ─────────────────────────────────────────────────────────────────────
        dom.recipeForm.on('submit', function (e) {
            e.preventDefault();
            if (!this.checkValidity()) {
                $(this).addClass('was-validated');
                return;
            }

            var payload = {
                Id: parseInt($('#f_Id').val()) || 0,
                RecipeNo: $('#f_RecipeNo').val().trim(),
                RecipeName: $('#f_RecipeName').val().trim(),
                CurrentVersionNo: '',
                Engineer: $('#f_Engineer').val().trim(),
                VersionNoRuleId: parseInt($('#f_VersionNoRuleId').val()) || 0,
            };

            showLoader();
            $.ajax({
                url: apiUrls.Save,
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify(payload),
                success: function (res) {
                    bootstrap.Modal.getInstance(dom.recipeModal[0]).hide();
                    showResponseResultAlert(res, '儲存', function () { loadList(); });
                },
                error: function () { showSysError(); },
                complete: function () { hideLoader(); }
            });
        });

        dom.recipeModal.on('show.bs.modal', function () {
            dom.recipeForm[0].reset();
            dom.recipeForm.removeClass('was-validated');
            $('#f_Id').val('0');
            // 載入版號規則下拉選單
            $.ajax({
                url: apiUrls.GetVersionNoRuleOptions,
                type: 'GET',
                success: function (res) {
                    var $sel = $('#f_VersionNoRuleId');
                    $sel.empty().append(new Option('請選擇', '', true, true));
                    if (res.Success && res.Data) {
                        res.Data.forEach(function (r) {
                            $sel.append(new Option(r.RuleName, r.Id));
                        });
                    }
                    $sel.trigger('change');
                }
            });
        });

        // ── 單筆刪除 ─────────────────────────────────────────────────────────────────
        $(document).on('click', '.delete-btn', function () {
            deleteId = $(this).data('id');
            bootstrap.Modal.getOrCreateInstance(dom.deleteModal[0]).show();
        });

        dom.btnConfirmDel.on('click', function () {
            if (!deleteId) return;
            showLoader();
            $.ajax({
                url: apiUrls.Delete + '?id=' + deleteId,
                type: 'DELETE',
                success: function (res) {
                    bootstrap.Modal.getInstance(dom.deleteModal[0]).hide();
                    showResponseResultAlert(res, '刪除', function () { loadList(); });
                },
                error: function () { showSysError(); },
                complete: function () { hideLoader(); }
            });
        });

        // ── 批次刪除 ─────────────────────────────────────────────────────────────────
        $('#btnBatchDelete').on('click', function () {
            var ids = $('.row-check:checked').map(function () { return $(this).val(); }).get();
            if (!ids.length) {
                Swal.fire({
                    icon: 'info', title: '請先勾選要刪除的資料',
                    confirmButtonText: '@(config.GetMessage("Confirm").ToHtmlString())'
                });
                return;
            }
            Swal.fire({
                icon: 'warning',
                title: `確定要刪除 ${ids.length} 筆配方？`,
                text: '刪除後將無法復原。',
                showCancelButton: true,
                confirmButtonText: '確定刪除',
                cancelButtonText: '取消',
                confirmButtonColor: '#d33',
            }).then(function (result) {
                if (!result.isConfirmed) return;
                showLoader();
                $.ajax({
                    url: apiUrls.BatchDelete + '?ids=' + ids.join(','),
                    type: 'DELETE',
                    success: function (res) {
                        showResponseResultAlert(res, '刪除', function () {
                            $('#checkAll').prop('checked', false);
                            loadList();
                        });
                    },
                    error: function () { showSysError(); },
                    complete: function () { hideLoader(); }
                });
            });
        });
    </script>
}
