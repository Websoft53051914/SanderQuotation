@* Monaco Editor 差異比對 PartialView
   提供：
     window.openViewContentModal(content, title)   — 單一版本內容檢視
     window.openDiffModal(original, modified, origTitle, modTitle)  — git-style diff
*@

<!-- ═══ Modal: 檢視版本內容 ═══ -->
<div class="modal fade" id="viewContentModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-xl">
        <div class="modal-content border-0">
            <div class="modal-header p-3 bg-secondary-subtle">
                <h5 class="modal-title" id="viewContentModalLabel">配方內容</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-0" style="border-radius:0 0 8px 8px;overflow:hidden;">
                <div id="viewEditorContainer" style="height:520px;"></div>
            </div>
            <div class="modal-footer py-2">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">關閉</button>
            </div>
        </div>
    </div>
</div>

<!-- ═══ Modal: 差異比對 ═══ -->
<div class="modal fade" id="diffContentModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-xl" style="max-width:90vw;">
        <div class="modal-content border-0">
            <div class="modal-header p-3 bg-primary-subtle">
                <h5 class="modal-title d-flex align-items-center gap-2 flex-wrap">
                    <i class="ri-git-compare-line"></i>
                    <span class="badge bg-secondary" id="diffOriginalTitle">舊版本</span>
                    <i class="ri-arrow-right-line text-muted"></i>
                    <span class="badge bg-primary" id="diffModifiedTitle">新版本</span>
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-0" style="border-radius:0 0 8px 8px;overflow:hidden;">
                <div id="diffEditorContainer" style="height:560px;"></div>
            </div>
            <div class="modal-footer py-2">
                <small class="text-muted me-auto"><i class="ri-information-line me-1"></i>紅色：刪除　綠色：新增</small>
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">關閉</button>
            </div>
        </div>
    </div>
</div>

<script>
    (function () {
        var VS_BASE = 'https://cdn.jsdelivr.net/npm/monaco-editor@0.44.0/min/vs';
        var _ready = false;
        var _loading = false;
        var _queue = [];
        var _viewEditor = null;
        var _diffEditor = null;

        function ensureMonaco(cb) {
            if (_ready) { cb(); return; }
            _queue.push(cb);
            if (_loading) { return; }
            _loading = true;

            var savedRequire = window.require;   // save — Feather etc. registered here
            var savedDefine = window.define;

            var s = document.createElement('script');
            s.src = VS_BASE + '/loader.js';
            s.onload = function () {
                var monacoRequire = window.require;  // capture Monaco's own loader
                // Do NOT restore yet — editor.main.js calls window.define() during load
                monacoRequire.config({ paths: { vs: VS_BASE } });
                monacoRequire(['vs/editor/editor.main'], function () {
                    // Monaco is fully loaded — safe to restore page globals now
                    window.require = savedRequire;
                    window.define  = savedDefine;
                    _ready = true;
                    _queue.forEach(function (fn) { fn(); });
                    _queue = [];
                });
            };
            document.head.appendChild(s);
        }

        window.openViewContentModal = function (content, title) {
            var $modal = $('#viewContentModal');
            var monacoOk = false, modalOk = false;
            $('#viewContentModalLabel').text(title || '配方內容');
            function tryCreate() {
                if (!monacoOk || !modalOk) return;
                if (_viewEditor) { _viewEditor.dispose(); _viewEditor = null; }
                _viewEditor = monaco.editor.create(
                    document.getElementById('viewEditorContainer'), {
                    value: content || '', language: 'plaintext', readOnly: true,
                    theme: 'vs', minimap: { enabled: false },
                    scrollBeyondLastLine: false, automaticLayout: true,
                    wordWrap: 'on', fontSize: 13, lineNumbers: 'on',
                }
                );
            }
            $modal.one('shown.bs.modal', function () { modalOk = true; tryCreate(); });
            ensureMonaco(function () { monacoOk = true; tryCreate(); });
            bootstrap.Modal.getOrCreateInstance($modal[0]).show();
        };

        window.openDiffModal = function (originalContent, modifiedContent, origTitle, modTitle) {
            var $modal = $('#diffContentModal');
            var monacoOk = false, modalOk = false;
            $('#diffOriginalTitle').text(origTitle || '舊版本');
            $('#diffModifiedTitle').text(modTitle || '新版本');
            function tryCreate() {
                if (!monacoOk || !modalOk) return;
                if (_diffEditor) {
                    var m = _diffEditor.getModel();
                    _diffEditor.dispose();
                    if (m) { if (m.original) m.original.dispose(); if (m.modified) m.modified.dispose(); }
                    _diffEditor = null;
                }
                _diffEditor = monaco.editor.createDiffEditor(
                    document.getElementById('diffEditorContainer'), {
                    readOnly: true, theme: 'vs', minimap: { enabled: false },
                    scrollBeyondLastLine: false, automaticLayout: true,
                    renderSideBySide: true, wordWrap: 'on', fontSize: 13,
                    ignoreTrimWhitespace: false,
                }
                );
                _diffEditor.setModel({
                    original: monaco.editor.createModel(originalContent || '', 'plaintext'),
                    modified: monaco.editor.createModel(modifiedContent || '', 'plaintext'),
                });
            }
            $modal.one('shown.bs.modal', function () { modalOk = true; tryCreate(); });
            ensureMonaco(function () { monacoOk = true; tryCreate(); });
            bootstrap.Modal.getOrCreateInstance($modal[0]).show();
        };
    })();
</script>
