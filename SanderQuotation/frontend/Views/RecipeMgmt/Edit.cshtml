@inject Microsoft.Extensions.Configuration.IConfiguration Configuration
@{
    // Layout = "~/Views/Shared/_LayoutDemo.cshtml";
    ViewBag.Title = "配方主檔編輯";
    ViewBag.pTitle = "配方主檔編輯";
    ViewBag.pageTitle = "配方管理";

    var recipeId = ViewBag.RecipeId as long? ?? 0L;
}

<div class="row">
    <div class="col-lg-12">

        <div class="card">
            <div class="card-header border-0 pb-0">

                <!-- ── 基本資訊（Tab 上方） ── -->
                <form id="basicInfoForm" class="needs-validation" novalidate>
                    <input type="hidden" id="e_Id" />
                    <div class="row g-2 align-items-end mb-3">
                        <div class="col-lg-2 col-md-3">
                            <label class="col-form-label pt-0">配方編號</label>
                            <input type="text" id="e_RecipeNo" class="form-control" readonly />
                        </div>
                        <div class="col-lg-2 col-md-3">
                            <label class="col-form-label pt-0 required">配方名稱</label>
                            <input type="text" id="e_RecipeName" class="form-control" maxlength="200" required />
                        </div>
                        <div class="col-lg-2 col-md-3">
                            <label class="col-form-label pt-0 required">負責工程師</label>
                            <input type="text" id="e_Engineer" class="form-control" maxlength="100" required />
                        </div>
                        <div class="col-lg-2 col-md-3">
                            <label class="col-form-label pt-0">現行版號</label>
                            <input type="text" id="e_CurrentVersionNo" class="form-control" readonly />
                        </div>
                        <div class="col-lg-2 col-md-3">
                            <label class="col-form-label pt-0">版號規則</label>
                            <input type="text" id="e_VersionNoRuleName" class="form-control" readonly
                                   placeholder="無規則（手動）" />
                        </div>
                        <div class="col-lg-2 col-md-3">
                            <label class="col-form-label pt-0">建立時間</label>
                            <input type="text" id="e_CreateTime" class="form-control" readonly />
                        </div>
                        <div class="col-lg-2 col-md-3">
                            <label class="col-form-label pt-0">最後更新</label>
                            <input type="text" id="e_UpdateTime" class="form-control" readonly />
                        </div>
                    </div>
                </form>

                <!-- ── Tab 導覽 ── -->
                <ul class="nav nav-tabs nav-tabs-custom" id="editTabs" role="tablist">
                    <li class="nav-item">
                        <a class="nav-link active" id="tab-params" data-bs-toggle="tab" href="#pane-params" role="tab">
                            <i class="ri-settings-3-line me-1"></i>配方參數
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" id="tab-version" data-bs-toggle="tab" href="#pane-version" role="tab">
                            <i class="ri-history-line me-1"></i>版本歷程
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" id="tab-review" data-bs-toggle="tab" href="#pane-review" role="tab">
                            <i class="ri-checkbox-circle-line me-1"></i>審核歷程
                        </a>
                    </li>
                </ul>
            </div>

            <div class="card-body">
                <div class="tab-content">

                    <!-- ══ Tab 1: 配方參數（示範資料） ══ -->
                    <div class="tab-pane fade show active" id="pane-params" role="tabpanel">
                        <div class="d-flex align-items-center justify-content-between mb-3">
                            <h6 class="text-muted mb-0"><i class="ri-settings-3-line me-1"></i>製程參數設定</h6>
                            <span class="badge bg-info-subtle text-info">僅供檢視（示範資料）</span>
                        </div>
                        <div class="table-responsive">
                            <table class="table table-bordered table-sm align-middle">
                                <thead class="table-light">
                                    <tr>
                                        <th>Step</th>
                                        <th>步驟名稱</th>
                                        <th>參數名稱</th>
                                        <th>設定值</th>
                                        <th>單位</th>
                                        <th>下限</th>
                                        <th>上限</th>
                                        <th>關鍵參數</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr>
                                        <td>1</td>
                                        <td>Preheat</td>
                                        <td>Temperature</td>
                                        <td class="fw-bold font-monospace text-primary">350</td>
                                        <td>°C</td>
                                        <td class="text-muted">200</td>
                                        <td class="text-muted">400</td>
                                        <td><span class="badge bg-warning-subtle text-warning">★ 關鍵</span></td>
                                    </tr>
                                    <tr>
                                        <td>1</td>
                                        <td>Preheat</td>
                                        <td>Pressure</td>
                                        <td class="fw-bold font-monospace text-primary">5.2</td>
                                        <td>Torr</td>
                                        <td class="text-muted">3.0</td>
                                        <td class="text-muted">8.0</td>
                                        <td><span class="badge bg-warning-subtle text-warning">★ 關鍵</span></td>
                                    </tr>
                                    <tr>
                                        <td>1</td>
                                        <td>Preheat</td>
                                        <td>Duration</td>
                                        <td class="fw-bold font-monospace text-primary">120</td>
                                        <td>sec</td>
                                        <td class="text-muted">60</td>
                                        <td class="text-muted">300</td>
                                        <td>—</td>
                                    </tr>
                                    <tr>
                                        <td>2</td>
                                        <td>Deposition</td>
                                        <td>Temperature</td>
                                        <td class="fw-bold font-monospace text-primary">420</td>
                                        <td>°C</td>
                                        <td class="text-muted">380</td>
                                        <td class="text-muted">450</td>
                                        <td><span class="badge bg-warning-subtle text-warning">★ 關鍵</span></td>
                                    </tr>
                                    <tr>
                                        <td>2</td>
                                        <td>Deposition</td>
                                        <td>Pressure</td>
                                        <td class="fw-bold font-monospace text-primary">3.8</td>
                                        <td>Torr</td>
                                        <td class="text-muted">2.0</td>
                                        <td class="text-muted">6.0</td>
                                        <td><span class="badge bg-warning-subtle text-warning">★ 關鍵</span></td>
                                    </tr>
                                    <tr>
                                        <td>2</td>
                                        <td>Deposition</td>
                                        <td>RF_Power</td>
                                        <td class="fw-bold font-monospace text-primary">1500</td>
                                        <td>W</td>
                                        <td class="text-muted">800</td>
                                        <td class="text-muted">2000</td>
                                        <td><span class="badge bg-warning-subtle text-warning">★ 關鍵</span></td>
                                    </tr>
                                    <tr>
                                        <td>2</td>
                                        <td>Deposition</td>
                                        <td>GasFlow_SiH4</td>
                                        <td class="fw-bold font-monospace text-primary">80</td>
                                        <td>sccm</td>
                                        <td class="text-muted">40</td>
                                        <td class="text-muted">120</td>
                                        <td><span class="badge bg-warning-subtle text-warning">★ 關鍵</span></td>
                                    </tr>
                                    <tr>
                                        <td>2</td>
                                        <td>Deposition</td>
                                        <td>GasFlow_N2</td>
                                        <td class="fw-bold font-monospace text-primary">200</td>
                                        <td>sccm</td>
                                        <td class="text-muted">100</td>
                                        <td class="text-muted">400</td>
                                        <td>—</td>
                                    </tr>
                                    <tr>
                                        <td>2</td>
                                        <td>Deposition</td>
                                        <td>Duration</td>
                                        <td class="fw-bold font-monospace text-primary">300</td>
                                        <td>sec</td>
                                        <td class="text-muted">120</td>
                                        <td class="text-muted">600</td>
                                        <td>—</td>
                                    </tr>
                                    <tr>
                                        <td>3</td>
                                        <td>Purge</td>
                                        <td>GasFlow_N2</td>
                                        <td class="fw-bold font-monospace text-primary">500</td>
                                        <td>sccm</td>
                                        <td class="text-muted">300</td>
                                        <td class="text-muted">800</td>
                                        <td>—</td>
                                    </tr>
                                    <tr>
                                        <td>3</td>
                                        <td>Purge</td>
                                        <td>Duration</td>
                                        <td class="fw-bold font-monospace text-primary">60</td>
                                        <td>sec</td>
                                        <td class="text-muted">30</td>
                                        <td class="text-muted">120</td>
                                        <td>—</td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>

                    <!-- ══ Tab 2: 版本歷程（PartialView） ══ -->
                    <div class="tab-pane fade" id="pane-version" role="tabpanel">

                        <!-- 提交新版本按鈕 -->
                        <div class="mb-3 text-end">
                            <div id="noRuleWarning" class="alert alert-warning py-2 px-3 text-start mb-2 d-none">
                                <i class="ri-alert-line me-1"></i>此配方尚未設定版號規則，無法提交版本。
                            </div>
                            <button type="button" class="btn btn-success" id="btnNewVersion"
                                    onclick="window.openVersionCommitModal && window.openVersionCommitModal()">
                                <i class="ri-git-commit-line me-1"></i>提交新版本
                            </button>
                        </div>

                        <!-- 目前配方內容（TB_Recipe.RecipeContent） -->
                        <div class="card mb-3 border">
                            <div class="card-header py-2 d-flex align-items-center justify-content-between bg-light">
                                <h6 class="mb-0 small fw-semibold">
                                    <i class="ri-file-text-line me-1 text-primary"></i>目前配方內容
                                    <span class="badge bg-warning-subtle text-warning ms-2">工作草稿</span>
                                </h6>
                                <button type="button" class="btn btn-sm btn-outline-primary"
                                        id="btnCompareContentWithCurrent">
                                    <i class="ri-git-compare-line me-1"></i>與現行版本比對
                                </button>
                            </div>
                            <div class="card-body p-2">
                                <textarea id="e_RecipeContent" class="form-control font-monospace" rows="7"
                                          style="font-size:12px;resize:vertical;" placeholder="（尚無配方內容）"></textarea>
                            </div>
                        </div>

                        @await Html.PartialAsync("~/Views/RecipeMgmt/_VersionHistory.cshtml")

                    </div>

                    <!-- ══ Tab 3: 審核歷程（示範資料） ══ -->
                    <div class="tab-pane fade" id="pane-review" role="tabpanel">
                        <div class="d-flex align-items-center justify-content-between mb-3">
                            <h6 class="text-muted mb-0"><i class="ri-checkbox-circle-line me-1"></i>審核流程紀錄</h6>
                            <span class="badge bg-info-subtle text-info">僅供檢視（示範資料）</span>
                        </div>
                        <div class="table-responsive">
                            <table class="table table-bordered table-sm align-middle">
                                <thead class="table-light">
                                    <tr>
                                        <th>審核步驟</th>
                                        <th>審核人員</th>
                                        <th>角色</th>
                                        <th>動作</th>
                                        <th>時間</th>
                                        <th>意見</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr>
                                        <td>申請送核</td>
                                        <td>張志明</td>
                                        <td><span class="badge bg-secondary-subtle text-secondary">製程工程師</span></td>
                                        <td><span class="badge bg-primary-subtle text-primary">提交</span></td>
                                        <td>2025/04/20 14:40</td>
                                        <td>參數調整後提交審核</td>
                                    </tr>
                                    <tr>
                                        <td>組長審核</td>
                                        <td>李組長</td>
                                        <td><span class="badge bg-secondary-subtle text-secondary">資深工程師</span></td>
                                        <td><span class="badge bg-success-subtle text-success">核准</span></td>
                                        <td>2025/04/21 09:15</td>
                                        <td>確認參數在規格範圍內</td>
                                    </tr>
                                    <tr>
                                        <td>主管核准</td>
                                        <td>—</td>
                                        <td><span class="badge bg-secondary-subtle text-secondary">工程主管</span></td>
                                        <td><span class="badge bg-warning-subtle text-warning">待審</span></td>
                                        <td>—</td>
                                        <td>—</td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>

                </div><!-- /tab-content -->
                <!-- ── 底部按鈕列 ── -->
                <div class="d-flex justify-content-end mt-3 gap-2">
                    <a href="@Url.Action("Index", "RecipeMgmt")" class="btn btn-secondary">
                        <i class="ri-arrow-left-line me-1"></i>返回
                    </a>
                    <button type="button" class="btn btn-success" id="btnSaveBasic">
                        <i class="ri-save-line me-1"></i>儲存基本資料
                    </button>
                </div>

            </div>
        </div>

    </div>
</div>

<!-- ═══ Modal: 提交新版本 ═══ -->
<div class="modal fade" id="commitVersionModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content border-0">
            <div class="modal-header p-3 bg-info-subtle">
                <h5 class="modal-title">提交新版本</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form id="commitVersionForm" class="needs-validation" novalidate>
                <div class="modal-body">
                    <div class="row g-3">
                        <div class="col-12">
                            <p class="mb-1 small text-muted">預計建立版號</p>
                            <p id="cv_NextVersionInfo" class="fw-bold font-monospace text-primary mb-0">—</p>
                        </div>
                        <div class="col-12">
                            <label for="cv_VersionBumpType" class="col-form-label pt-0 required">異動類型</label>
                            <select id="cv_VersionBumpType" class="form-select"
                                    required>
                                <option value="">請選擇</option>
                                <option value="MAJOR">MAJOR（重大變更）</option>
                                <option value="MINOR">MINOR（功能新增）</option>
                                <option value="PATCH">PATCH（錯誤修正）</option>
                            </select>
                        </div>
                        <div class="col-12">
                            <label for="cv_VersionLog" class="col-form-label pt-0 required">異動紀錄</label>
                            <textarea id="cv_VersionLog" class="form-control" rows="3" maxlength="1000"
                                      placeholder="說明本次版本的變更內容…" required></textarea>
                        </div>
                        <div class="col-12">
                            <label for="cv_RecipeContent" class="col-form-label pt-0">配方內容</label>
                            <textarea id="cv_RecipeContent" class="form-control" rows="5" maxlength="5000"
                                      placeholder="貼入配方內容（XML / JSON / 文字皆可）…"></textarea>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-light" data-bs-dismiss="modal">取消</button>
                    <button type="submit" class="btn btn-success">
                        <i class="ri-save-line me-1"></i>提交
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section scripts {
    <script>
        $(document).ready(function () {
            var pTitle = '@(Html.Raw(ViewBag.pTitle))';
            var pageTitle = '@(Html.Raw(ViewBag.pageTitle))';
            $('#header-pTitle').text(pTitle);
            var bElList = [];
            if (pageTitle) bElList.push('<li class="breadcrumb-item"><a href="javascript: void(0);">' + pageTitle + '</a></li>');
            bElList.push('<li class="breadcrumb-item active">' + pTitle + '</li>');
            $('#_page_title_row .breadcrumb').html(bElList.join(''));
        });
        window.currentRecipeId = @recipeId;

        var apiUrls = {
            GetById: '@(Configuration["BackendURL"])/api/RecipeMgmt/GetById',
            Save: '@(Configuration["BackendURL"])/api/RecipeMgmt/Save',
            CreateVersion: '@(Configuration["BackendURL"])/api/RecipeMgmt/CreateVersion',
            GetNextVersionPreview: '@(Configuration["BackendURL"])/api/RecipeMgmt/GetNextVersionPreview',
        };

        // ── 載入基本資料 ──────────────────────────────────────────────────────────
        function loadBasicInfo() {
            if (!window.currentRecipeId) return;
            showLoader();
            $.ajax({
                url: apiUrls.GetById,
                type: 'GET',
                data: { id: window.currentRecipeId },
                success: function (res) {
                    if (!res.Success || !res.Data) { showSysError(); return; }
                    fillForm(res.Data);
                },
                error: function () { showSysError(); },
                complete: function () { hideLoader(); }
            });
        }

        function fillForm(d) {
            $('#e_Id').val(d.Id);
            $('#e_RecipeNo').val(d.RecipeNo);
            $('#e_RecipeName').val(d.RecipeName);
            $('#e_Engineer').val(d.Engineer);
            $('#e_CurrentVersionNo').val(d.CurrentVersionNo);
            $('#e_VersionNoRuleName').val(d.VersionNoRuleName || '');
            $('#e_CreateTime').val(d.CreateTime);
            $('#e_UpdateTime').val(d.UpdateTime);
            // 配方內容
            $('#e_RecipeContent').val(d.RecipeContent || '');
            window.currentRecipeContent = d.RecipeContent || '';
            window.currentVersionNoRuleId = d.VersionNoRuleId || 0;
            updateCommitButtonState(window.currentVersionNoRuleId);
        }

        function updateCommitButtonState(ruleId) {
            if (!ruleId) {
                $('#btnNewVersion').prop('disabled', true);
                $('#noRuleWarning').removeClass('d-none');
            } else {
                $('#btnNewVersion').prop('disabled', false);
                $('#noRuleWarning').addClass('d-none');
            }
        }

        // ── 儲存基本資料 ──────────────────────────────────────────────────────────
        $('#btnSaveBasic').on('click', function () {
            var $form = $('#basicInfoForm');
            if (!$form[0].checkValidity()) {
                $form.addClass('was-validated');
                return;
            }

            var payload = {
                Id: parseInt($('#e_Id').val()) || 0,
                RecipeNo: $('#e_RecipeNo').val().trim(),
                RecipeName: $('#e_RecipeName').val().trim(),
                CurrentVersionNo: $('#e_CurrentVersionNo').val().trim(),
                Engineer: $('#e_Engineer').val().trim(),
                RecipeContent: $('#e_RecipeContent').val().trim(),
            };

            showLoader();
            $.ajax({
                url: apiUrls.Save,
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify(payload),
                success: function (res) {
                    showResponseResultAlert(res, '儲存', function () { loadBasicInfo(); });
                },
                error: function () { showSysError(); },
                complete: function () { hideLoader(); }
            });
        });

        // ── 提交新版本 Modal ──────────────────────────────────────────────────────
        window.openVersionCommitModal = function () {
            $('#commitVersionForm')[0].reset();
            $('#commitVersionForm').removeClass('was-validated');
            updateVersionPreview($('#cv_VersionBumpType').val() || 'PATCH');
            // 以目前配方内容預填 commit modal
            $('#cv_RecipeContent').val($('#e_RecipeContent').val());
            bootstrap.Modal.getOrCreateInstance(document.getElementById('commitVersionModal')).show();
        };

        function updateVersionPreview(bumpType) {
            var recipeId = window.currentRecipeId;
            if (!recipeId) return;
            $.ajax({
                url: apiUrls.GetNextVersionPreview,
                type: 'GET',
                data: { recipeId: recipeId, bumpType: bumpType || 'PATCH' },
                success: function (res) {
                    if (res.Success && res.Data) {
                        $('#cv_NextVersionInfo').text(res.Data.Preview || '—');
                    }
                }
            });
        }

        $('#cv_VersionBumpType').on('change', function () {
            updateVersionPreview($(this).val());
        });

        $('#commitVersionForm').on('submit', function (e) {
            e.preventDefault();
            if (!this.checkValidity()) { $(this).addClass('was-validated'); return; }

            var payload = {
                RecipeId: window.currentRecipeId,
                VersionBumpType: $('#cv_VersionBumpType').val(),
                VersionLog: $('#cv_VersionLog').val().trim(),
                RecipeContent: $('#cv_RecipeContent').val().trim(),
                IsCurrent: true,
                Creator: 1,
                Updater: 1,
                Status: 1
            };

            showLoader();
            $.ajax({
                url: apiUrls.CreateVersion,
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify(payload),
                success: function (res) {
                    bootstrap.Modal.getInstance(document.getElementById('commitVersionModal')).hide();
                    showResponseResultAlert(res, '提交', function () {
                        loadBasicInfo();
                        if (typeof window.reloadVersions === 'function') window.reloadVersions();
                    });
                },
                error: function () { showSysError(); },
                complete: function () { hideLoader(); }
            });
        });

        // 配方內容與現行版本比對
        $('#btnCompareContentWithCurrent').on('click', function () {
            var currentVerContent = typeof window.getCurrentVersionContent === 'function'
                ? window.getCurrentVersionContent() : '';
            var recipeContent = $('#e_RecipeContent').val();
            if (typeof window.openDiffModal === 'function') {
                window.openDiffModal(currentVerContent, recipeContent, '現行版本', '目前配方內容');
            }
        });

        // 配方內容變更時同步 window.currentRecipeContent
        $('#e_RecipeContent').on('input', function () {
            window.currentRecipeContent = $(this).val();
        });

        function showSysError() {
            Swal.fire({ icon: 'error', title: '系統錯誤', text: '操作失敗，請稍後再試。' });
        }

        // ── 初始化 ────────────────────────────────────────────────────────────────
        $(document).ready(function () {
            $('#cv_VersionBumpType').select2({ width: '100%', dropdownParent: $('#commitVersionModal') });
            loadBasicInfo();
        });
    </script>
}
