        // שששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששש
        // ½s¿ט«צ¶s
        // שששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששש
        $(document).on('click', '.edit-item-btn', function (e) {
            e.preventDefault();
            $('#exampleModalLabel_Create').hide();
            $('#exampleModalLabel_Edit').show();
            postaction = 'edit';
            currentId = $(this).closest('tr').data('id');

            if (!currentId) {
                Swal.fire({ icon: 'warning', title: '@(config.GetMessage("ESDbTransferMapping_DataNotFound").ToHtmlString())', confirmButtonText: '½T©w' });
                return;
            }

            new bootstrap.Modal(document.getElementById('showModal'), { backdrop: 'static', keyboard: false }).show();

            showLoader();
            $.ajax({
                type: 'POST', url: API.Get, dataType: 'json', data: { id: currentId },
                success: function (res) {
                    if (!res.Success) {
                        hideLoader();
                        Swal.fire({ icon: 'warning', title: res.Message, confirmButtonText: '½T©w' });
                        return;
                    }
                    const d = res.Data;

                    // ¼׀°O½s¿ט¸ך®ֶ¸ü₪J₪₪¡Aֱ׳§Kִ²µo¬Û¦P¸ך®ֶ®wִµ§i
                    isLoadingEditData = true;

                    // ¶ס₪J TransferMappingCode
                    $('#TransferMappingCode').val(d.TransferMappingCode);

                    // ³]©w¨׃·½DB¡Aִ²µo TABLE ₪U©װ­«¸ü
                    $('#SrcDbTransferCode').val(d.SrcDbTransferCode).trigger('change');
                    // ³]©w¥״×÷DB¡Aִ²µo TABLE ₪U©װ­«¸ü
                    $('#DstDbTransferCode').val(d.DstDbTransferCode).trigger('change');

                    setTimeout(function () {
                        isLoadingEditData = false;

                        // ³]©w¨׃·½×ם®ז
                        const $srcTbl = $('#SrcTableName');
                        $srcTbl.val(d.SrcTableName).trigger('change');

                        // ³]©w¥״¼׀×ם®ז
                        const $dstTbl = $('#DstTableName');
                        $dstTbl.val(d.DstTableName).trigger('change');

                        $('#Description').val(d.Description);

                        // ©I¥s GetColumns ¨ת±o₪l×םִז¦ל¹ןְ³¡A³v¦C¶ס₪J
                        const colPromise = $.get(API.GetColumns, { TransferMappingCode: d.TransferMappingCode }, function (colRes) {
                            $('#mappingRows').empty();
                            if (colRes.Success && colRes.Data?.length > 0) {
                                setTimeout(function () {
                                    colRes.Data.forEach(col => addMappingRow(col.SrcColumnName, col.DstColumnName, col.IsEncrypt, col.IsPrimaryKey));
                                }, 400);
                            }
                        });

                        // ¸ü₪J¿z¿ן±ר¥ף¡]₪ג¼g SQL ¼ׂ¦¡₪£»Ý­nִז¦ל§ײ¨ת¡A¥i×½±µ¸ü₪J¡Fbuilder ¼ׂ¦¡₪~»Ýµ¥«Ý§ײ¨ת¡^
                        let filterPromise;
                        if (d.FilterCondition) {
                            let fc;
                            try { fc = JSON.parse(d.FilterCondition); } catch { fc = null; }
                            const needCols = fc && (fc.mode || d.FilterMode || 'builder') !== 'manual';
                            if (needCols) {
                                filterPromise = $.Deferred();
                                getSrcColumns(d.SrcTableName, function () {
                                    loadFilterCondition(d.FilterCondition, d.FilterMode);
                                    filterPromise.resolve();
                                });
                            } else {
                                loadFilterCondition(d.FilterCondition, d.FilterMode);
                                filterPromise = $.Deferred().resolve();
                            }
                        } else {
                            loadFilterCondition(null, null);
                            filterPromise = $.Deferred().resolve();
                        }

                        $.when(colPromise, filterPromise).always(function () {
                            hideLoader();
                        });
                    }, 600);
                },
                error: function () {
                    hideLoader();
                    Swal.fire({ icon: 'error', title: '@(config.GetMessage("System_Error").ToHtmlString())', confirmButtonText: '½T©w' });
                }
            });
        });

        // שששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששש
        // §R°£¡]³זµ§¡^
        // שששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששש
        $(document).on('click', '.remove-item-btn', function (e) {
            e.preventDefault();
            currentId = $(this).closest('tr').data('id');
        });

        $('#delete-record').on('click', function () {
            $.ajax({
                type: 'POST', url: API.Delete, dataType: 'json', data: { list: [currentId] },
                success: function (res) {
                    bootstrap.Modal.getInstance(document.getElementById('deleteOrder')).hide();
                    if (!res.Success) {
                        Swal.fire({ icon: 'warning', title: res.Message, confirmButtonText: '½T©w' });
                        return;
                    }
                    loadDatas();
                    Swal.fire({ icon: 'success', title: '@(config.GetMessage("Successfully_Deleted").ToHtmlString())', confirmButtonText: '½T©w' });
                },
                error: function () {
                    Swal.fire({ icon: 'error', title: '@(config.GetMessage("System_Error").ToHtmlString())', confirmButtonText: '½T©w' });
                }
            }).always(() => hideLoader());
        });

        // שששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששש
        // §R°£¡]¦hµ§¡^
        // שששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששש
        function deleteMultiple() {
            const ids = [];
            document.querySelectorAll('.form-check [value=option1]').forEach(el => {
                if (el.checked) {
                    const id = el.closest('tr')?.querySelector('[data-id]')?.getAttribute('data-id');
                    if (id) ids.push(id);
                }
            });

            if (!ids.length) {
                Swal.fire({ title: 'Please select at least one checkbox', confirmButtonClass: 'btn btn-info', buttonsStyling: false, showCloseButton: true });
                return;
            }

            Swal.fire({
                title: '@(config.GetMessage("Are_you_sure").ToHtmlString())',
                text: '@(config.GetMessage("You_wont_be_able_to_revert_this").ToHtmlString())',
                icon: 'warning', showCancelButton: true,
                customClass: { confirmButton: 'btn btn-primary w-xs me-2 mt-2', cancelButton: 'btn btn-danger w-xs mt-2' },
                confirmButtonText: '@(config.GetMessage("Yes_delete_it").ToHtmlString())',
                cancelButtonText: '@(config.GetMessage("Cancel").ToHtmlString())',
                buttonsStyling: false, showCloseButton: true
            }).then(function (result) {
                if (!result.value) return;
                showLoader();
                $.ajax({
                    type: 'POST', url: API.Delete, dataType: 'json', data: { list: ids },
                    success: function (res) {
                        if (!res.Success) {
                            Swal.fire({ icon: 'warning', title: res.Message, confirmButtonText: '½T©w' });
                            return;
                        }
                        loadDatas();
                        Swal.fire({ title: '@(config.GetMessage("Deleted").ToHtmlString())', text: '@(config.GetMessage("Your_data_has_been_deleted").ToHtmlString())', icon: 'success', customClass: { confirmButton: 'btn btn-info w-xs mt-2' }, buttonsStyling: false });
                    },
                    error: function () {
                        Swal.fire({ icon: 'error', title: '@(config.GetMessage("System_Error").ToHtmlString())', confirmButtonText: '½T©w' });
                    }
                }).always(() => hideLoader());
            });
        }

        // שששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששש
        // »²§U¡Gִז¦ל§ײ¨ת & ¶ס¥R Select
        // שששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששש
        function getSrcColumns(tableName, cb) {
            if (srcColumnCache[tableName]) { cb(srcColumnCache[tableName]); return; }
            const guid = $('#SrcDbTransferCode').val();
            $.get(API.GetSourceColumns, { dbTransferGuid: guid, tableName: tableName }, function (res) {
                if (res.Success) {
                    srcColumnCache[tableName] = res.Data;
                    cb(res.Data);
                } else {
                        hideLoader();
                    Swal.fire({ icon: 'warning', title: res.Message || '@(config.GetMessage("ESDbTransferMapping_LoadFailedMsg").ToHtmlString())', confirmButtonText: '½T©w' });
                    cb([]);
                }
            }).fail(function () {
                Swal.fire({ icon: 'error', title: '@(config.GetMessage("System_Error").ToHtmlString())', confirmButtonText: '½T©w' });
                cb([]);
            });
        }

        function getDstColumns(tableName, cb) {
            if (dstColumnCache[tableName]) { cb(dstColumnCache[tableName]); return; }
            const guid = $('#DstDbTransferCode').val();
            $.get(API.GetTargetColumns, { dbTransferGuid: guid, tableName: tableName }, function (res) {
                if (res.Success) {
                    dstColumnCache[tableName] = res.Data;
                    cb(res.Data);
                } else {
                        hideLoader();
                    Swal.fire({ icon: 'warning', title: res.Message || '@(config.GetMessage("ESDbTransferMapping_LoadFailedMsg").ToHtmlString())', confirmButtonText: '½T©w' });
                    cb([]);
                }
            }).fail(function () {
                Swal.fire({ icon: 'error', title: '@(config.GetMessage("System_Error").ToHtmlString())', confirmButtonText: '½T©w' });
                cb([]);
            });
        }

        function refreshColumnSelect($sel, cols, selectedVal) {
            const prev = selectedVal || $sel.val() || '';
            $sel.html('<option value="">@(config.GetMessage("ESDbTransferMapping_PleaseSelect").ToHtmlString())</option>');
            cols.forEach(c => $sel.append(`<option value="${c}" ${c === prev ? 'selected' : ''}>${c}</option>`));
        }

        function clearAllSrcColumns() {
            $('#mappingRows .src-col-select').html('<option value="">@(config.GetMessage("ESDbTransferMapping_SelectSrcTableFirst").ToHtmlString())</option>');
        }

        function clearAllDstColumns() {
            $('#mappingRows .dst-col-select').html('<option value="">@(config.GetMessage("ESDbTransferMapping_SelectDstTableFirst").ToHtmlString())</option>');
        }

        // שששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששש
        // ¿z¿ן±ר¥ף
        // שששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששש
        const FILTER_OPERATORS = [
            { value: '=',           label: '@(config.GetMessage("ESDbTransferMapping_OpEq").ToHtmlString())' },
            { value: '!=',          label: '@(config.GetMessage("ESDbTransferMapping_OpNeq").ToHtmlString())' },
            { value: '>',           label: '@(config.GetMessage("ESDbTransferMapping_OpGt").ToHtmlString())' },
            { value: '>=',          label: '@(config.GetMessage("ESDbTransferMapping_OpGte").ToHtmlString())' },
            { value: '<',           label: '@(config.GetMessage("ESDbTransferMapping_OpLt").ToHtmlString())' },
            { value: '<=',          label: '@(config.GetMessage("ESDbTransferMapping_OpLte").ToHtmlString())' },
            { value: 'LIKE',        label: '@(config.GetMessage("ESDbTransferMapping_OpLike").ToHtmlString())' },
            { value: 'NOT LIKE',    label: '@(config.GetMessage("ESDbTransferMapping_OpNotLike").ToHtmlString())' },
            { value: 'IS NULL',     label: '@(config.GetMessage("ESDbTransferMapping_OpIsNull").ToHtmlString())' },
            { value: 'IS NOT NULL', label: '@(config.GetMessage("ESDbTransferMapping_OpIsNotNull").ToHtmlString())' },
            // { value: 'IN',          label: '@(config.GetMessage("ESDbTransferMapping_OpIn").ToHtmlString())' },
        ];

        // ·s¼W±ר¥ף¦C
        $('#btnAddFilterRow').on('click', function () {
            addFilterRow('AND', '', '=', '');
        });

        function addFilterRow(logic, column, operator_, value) {
            const isFirst = $('#filterRows tr').length === 0;
            const srcCols = getSrcColumnOptions();
            const opOptions = FILTER_OPERATORS.map(o =>
                `<option value="${o.value}" ${o.value === operator_ ? 'selected' : ''}>${o.label}</option>`
            ).join('');
            const noValueOps = ['IS NULL', 'IS NOT NULL'];
            const hideVal = noValueOps.includes(operator_);

            const $tr = $(`
                <tr>
                    <td>
                    ${isFirst
                            ? `<span class="text-muted small ps-1">@(config.GetMessage("ESDbTransferMapping_Where").ToHtmlString())</span>`
                            : `<select class="form-select form-select-sm filter-logic">
                                   <option value="AND" ${logic === 'AND' ? 'selected' : ''}>AND</option>
                                   <option value="OR"  ${logic === 'OR'  ? 'selected' : ''}>OR</option>
                               </select>`
                        }
                    </td>
                    <td>
                        <select class="form-select form-select-sm filter-col">
                            <option value="">@(config.GetMessage("ESDbTransferMapping_PleaseSelect").ToHtmlString())</option>
                            ${srcCols}
                        </select>
                    </td>
                    <td>
                        <select class="form-select form-select-sm filter-op">
                            ${opOptions}
                        </select>
                    </td>
                    <td>
                        <input type="text" class="form-control form-control-sm filter-val"
                               value="${escHtml(value)}" ${hideVal ? 'style="display:none"' : ''}>
                    </td>
                    <td class="text-center">
                        <button type="button" class="btn btn-sm btn-soft-danger btn-remove-filter">
                            <i class="ri-delete-bin-line"></i>
                        </button>
                    </td>
                </tr>
            `);

            if (column) $tr.find('.filter-col').val(column);
            $('#filterRows').append($tr);
            updateFilterEmpty();
        }

        // ¹B÷ג₪l§ןֵÜ®ֱֹפֲֳ/ֵד¥Ü­ָ¿י₪J®״
        $(document).on('change', '.filter-op', function () {
            const noVal = ['IS NULL', 'IS NOT NULL'].includes($(this).val());
            $(this).closest('tr').find('.filter-val').toggle(!noVal);
        });

        // §R°£±ר¥ף¦C
        $(document).on('click', '.btn-remove-filter', function () {
            $(this).closest('tr').remove();
            updateFilterEmpty();
        });

        function updateFilterEmpty() {
            const hasRows = $('#filterRows tr').length > 0;
            $('#filterEmpty').toggle(!hasRows);
        }

        function getSrcColumnOptions() {
            const tbl = $('#SrcTableName').val();
            if (!tbl || !srcColumnCache[tbl]) return '';
            return srcColumnCache[tbl].map(c => `<option value="${c}">${c}</option>`).join('');
        }

        // ¦¬¶°¿z¿ן±ר¥ף
        function collectFilterData() {
            const mode = $('input[name="filterMode"]:checked').val();
            if (mode === 'manual') {
                return { mode: 'manual', sql: $('#FilterConditionManual').val().trim(), rows: [] };
            }
            const rows = [];
            $('#filterRows tr').each(function (i) {
                const $logicSel = $(this).find('.filter-logic');
                const logic = $logicSel.length ? $logicSel.val() : '';
                const col   = $(this).find('.filter-col').val();
                const op    = $(this).find('.filter-op').val();
                const val   = $(this).find('.filter-val').val();
                if (col) rows.push({ logic: i === 0 ? '' : logic, col, op, val });
            });
            return { mode: 'builder', sql: '', rows };
        }

        // ¸ü₪J¿z¿ן±ר¥ף¡]½s¿ט®ֹ¡^
        function loadFilterCondition(filterCondition, filterMode) {
            $('#filterRows').empty();
            $('#FilterConditionManual').val('');

            if (!filterCondition) { updateFilterEmpty(); return; }

            try {
                const fc = JSON.parse(filterCondition);
                const mode = filterMode || fc.mode || 'builder';

                if (mode === 'manual') {
                    $('input[name="filterMode"][value="manual"]').prop('checked', true);
                    $('#filterBuilderArea').hide();
                    $('#btnAddFilterRow').hide();
                    $('#filterManualArea').show();
                    $('#FilterConditionManual').val(fc.sql || filterCondition);
                } else {
                    $('input[name="filterMode"][value="builder"]').prop('checked', true);
                    $('#filterBuilderArea').show();
                    $('#btnAddFilterRow').show();
                    $('#filterManualArea').hide();
                    (fc.rows || []).forEach((r, i) => addFilterRow(i === 0 ? 'AND' : r.logic, r.col, r.op, r.val));
                }
            } catch {
                // ¯ֲ₪ו¦rµר¬°₪ג¼g SQL
                $('input[name="filterMode"][value="manual"]').prop('checked', true);
                $('#filterBuilderArea').hide();
                $('#btnAddFilterRow').hide();
                $('#filterManualArea').show();
                $('#FilterConditionManual').val(filterCondition);
            }
            updateFilterEmpty();
        }

        function escHtml(str) {
            return (str || '').replace(/&/g, '&amp;').replace(/"/g, '&quot;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
        }

        // שששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששש
        // ­«¸m Modal
        // שששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששש
        function resetElement() {
            $('#submitForm input:not([type="radio"]):not([type="checkbox"])').val('');
            $('#submitForm textarea').val('');
            $('#TransferMappingCode').val('');
            $('#SrcDbTransferCode').val('');
            $('#DstDbTransferCode').val('');

            // ­«¸m Source Table ©M Target Table
            const $srcTbl = $('#SrcTableName');
            const $dstTbl = $('#DstTableName');
                const defaultMsg = '@(config.GetMessage("Please_Select").ToHtmlString())';

            $srcTbl.empty().append(`<option value="">${defaultMsg}</option>`).trigger('change');
            $dstTbl.empty().append(`<option value="">${defaultMsg}</option>`).trigger('change');

            $('#mappingRows').empty();
            $('#filterRows').empty();
            $('#FilterConditionManual').val('');
            $('input[name="filterMode"][value="builder"]').prop('checked', true);
            $('#filterBuilderArea').show();
            $('#btnAddFilterRow').show();
            $('#filterManualArea').hide();
            updateFilterEmpty();
            srcColumnCache = {};
            dstColumnCache = {};
        }
    </script>
}
