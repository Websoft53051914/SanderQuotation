@model ViewModel.ESDbTransferMappingVM
@{
    ViewBag.Title = "資料表轉檔設定";
    ViewBag.pTitle = "資料表轉檔設定";
    ViewBag.pageTitle = ("系統管理模組");

    var mapUrl = new
    {
        Create = $"{Configuration["BackendURL"]}/api/ESDbTransferMapping/Create",
        Edit = $"{Configuration["BackendURL"]}/api/ESDbTransferMapping/Edit",
        Delete = $"{Configuration["BackendURL"]}/api/ESDbTransferMapping/Delete",
        Get = $"{Configuration["BackendURL"]}/api/ESDbTransferMapping/Get",
        GetColumns = $"{Configuration["BackendURL"]}/api/ESDbTransferMapping/GetColumns",
        GetDbTransferList = $"{Configuration["BackendURL"]}/api/ESDbTransferMapping/GetDbTransferList",
        GetSourceTables = $"{Configuration["BackendURL"]}/api/ESDbTransferMapping/GetSourceTables",
        GetSourceColumns = $"{Configuration["BackendURL"]}/api/ESDbTransferMapping/GetSourceColumns",
        GetTargetTables = $"{Configuration["BackendURL"]}/api/ESDbTransferMapping/GetTargetTables",
        GetTargetColumns = $"{Configuration["BackendURL"]}/api/ESDbTransferMapping/GetTargetColumns",
        GetDstDbTransferList = $"{Configuration["BackendURL"]}/api/ESDbTransferMapping/GetDbTransferList",
    };
}

<div class="row">
    <div class="col-lg-12">
        <div class="card" id="datasList">
            <div class="card-header border-0">
                <div class="d-flex align-items-center">
                    <h5 class="card-title mb-0 flex-grow-1"></h5>
                    <div class="flex-shrink-0">
                        <div class="d-flex flex-wrap gap-2">
                            <button id="btnShowModal" class="btn btn-danger add-btn">
                                <i class="ri-add-line align-bottom me-1"></i> 新增
                            </button>
                            <button class="btn btn-soft-danger" id="remove-actions" onclick="deleteMultiple()">
                                <i class="ri-delete-bin-2-line"></i>
                            </button>
                        </div>
                    </div>
                </div>
            </div>
            <div class="card-body border border-dashed border-end-0 border-start-0">
                <form>
                    <div class="row g-3">
                        <div class="col-xxl-3 col-sm-12">
                            <div class="search-box">
                                <input type="text" id="globalSearchInput" class="form-control search bg-light border-light"
                                       placeholder="搜尋表格內容">
                                <i class="ri-search-line search-icon"></i>
                            </div>
                        </div>
                        <div class="col-xxl-2 col-sm-12">
                            <input type="text" class="form-control bg-light border-light" placeholder="請輸入關鍵字" id="Keyword" name="Keyword">
                        </div>
                        <div class="col-xxl-1 col-sm-4">
                            <button type="button" class="btn btn-primary w-100" onclick="SearchData();">
                                <i class="ri-equalizer-fill me-1 align-bottom"></i>
                                篩選
                            </button>
                        </div>
                    </div>
                </form>
            </div>
            <div class="card-body">
                <div class="table-responsive table-card mb-4">
                    <table class="table align-middle table-nowrap mb-0" id="dataTable">
                        <thead>
                            <tr>
                                <th scope="col" style="width: 40px;">
                                    <div class="form-check">
                                        <input class="form-check-input" type="checkbox" id="checkAll" value="option">
                                    </div>
                                </th>
                                <th data-sort="action">Action</th>
                                <th data-sort="No">項次</th>
                                <th class="sort" data-sort="TransferMappingCode">資料表轉檔代碼</th>
                                <th class="sort" data-sort="SrcTransferName">來源資料庫</th>
                                <th class="sort" data-sort="SrcTableName">來源資料表</th>
                                <th class="sort" data-sort="DstTransferName">目標資料庫</th>
                                <th class="sort" data-sort="DstTableName">目標資料表</th>
                                <th>欄位對應數</th>
                                <th class="sort" data-sort="Description">描述</th>
                            </tr>
                        </thead>
                        <tbody class="list form-check-all" id="data-list-data">
                            <tr>
                                <th scope="row">
                                    <div class="form-check">
                                        <input class="form-check-input" type="checkbox" name="checkAll" value="option1">
                                    </div>
                                </th>
                            </tr>
                        </tbody>
                    </table>
                    <div class="noresult" style="display: none">
                        <div class="text-center">
                            <lord-icon src="@Url.Content("~/assets/json/lord-icon/msoeawqm.json")" trigger="loop" colors="primary:#121331,secondary:#08a88a" style="width:75px;height:75px"></lord-icon>
                            <h5 class="mt-2">查無資料</h5>
                        </div>
                    </div>
                </div>
                <div class="d-flex justify-content-end mt-2">
                    <div class="pagination-wrap hstack gap-2">
                        <a class="page-item pagination-prev disabled" href="#">上一頁</a>
                        <ul class="pagination listjs-pagination mb-0"></ul>
                        <a class="page-item pagination-next" href="#">下一頁</a>
                    </div>
                </div>

                <!-- Delete Modal -->
                <div class="modal fade flip" id="deleteOrder" tabindex="-1" aria-hidden="true">
                    <div class="modal-dialog modal-dialog-centered">
                        <div class="modal-content">
                            <div class="modal-body p-5 text-center">
                                <lord-icon src="@Url.Content("~/assets/json/lord-icon/gsqxdxog.json")" trigger="loop" colors="primary:#405189,secondary:#f06548" style="width:90px;height:90px"></lord-icon>
                                <div class="mt-4 text-center">
                                    <h4>
                                        您即將刪除一筆資料
                                    </h4>
                                    <p class="text-muted fs-14 mb-4">
                                        刪除您的資料將會把所有資訊從我們的資料庫中移除。
                                    </p>
                                    <div class="hstack gap-2 justify-content-center remove">
                                        <button class="btn btn-link link-success fw-medium text-decoration-none" id="deleteRecord-close" data-bs-dismiss="modal">
                                            <i class="ri-close-line me-1 align-middle"></i>
                                            關閉
                                        </button>
                                        <button class="btn btn-danger" id="delete-record">是的，刪除它!</button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Create/Edit Modal -->
<div class="modal fade zoomIn" id="showModal" tabindex="-1" aria-labelledby="exampleModalLabel" aria-hidden="true" data-bs-backdrop="static" data-bs-keyboard="false">
    <div class="modal-dialog modal-dialog-centered modal-xl">
        <div class="modal-content border-0">
            <div class="modal-header p-3 bg-info-subtle">
                <h5 class="modal-title" id="exampleModalLabel_Create" style="display:none;">新增</h5>
                <h5 class="modal-title" id="exampleModalLabel_Edit" style="display:none;">編輯</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close" id="close-modal"></button>
            </div>
            <form class="needs-validation" novalidate="" method="post" id="submitForm">
                <div class="modal-body">

                    <!-- TransferMappingCode -->
                    <div class="row g-3 mb-3">
                        <div class="col-lg-4">
                            <label for="TransferMappingCode" class="form-label required">資料表轉檔代碼</label>
                            <input type="text" id="TransferMappingCode" name="TransferMappingCode" class="form-control" required
                                   placeholder="資料表轉檔代碼" />
                        </div>
                    </div>

                    <!-- Source / Target Column Mapping Area -->
                    <div class="row g-3 mb-3">
                        <!-- Source DB -->
                        <div class="col-lg-4">
                            <label class="form-label required">來源資料庫</label>
                            <select id="SrcDbTransferCode" name="SrcDbTransferCode" class="form-select" required>
                                <option value="">-- 請選擇 --</option>
                            </select>
                        </div>
                        <!-- Source TABLE -->
                        <div class="col-lg-4">
                            <label class="form-label required">來源資料表</label>
                            <select id="SrcTableName" name="SrcTableName" class="form-select" searchEnabled>
                            </select>
                        </div>
                    </div>

                    <div class="row g-3 mb-3">
                        <!-- Destination DB -->
                        <div class="col-lg-4">
                            <label class="form-label required">目標資料庫</label>
                            <select id="DstDbTransferCode" name="DstDbTransferCode" class="form-select" required>
                                <option value="">-- 請選擇 --</option>
                            </select>
                        </div>
                        <!-- Target TABLE -->
                        <div class="col-lg-4">
                            <label class="form-label required">目標資料表</label>
                            <select id="DstTableName" name="DstTableName" class="form-select" searchEnabled>
                            </select>
                        </div>
                    </div>

                    <!-- Column Mapping Area -->
                    <div class="card border">
                        <div class="card-header d-flex justify-content-between align-items-center py-2">
                            <span class="fw-semibold">欄位對應設定</span>
                            <button type="button" class="btn btn-sm btn-primary" id="btnAddMappingRow">
                                <i class="ri-add-line"></i> 新增對應
                            </button>
                        </div>
                        <div class="card-body p-0">
                            <table class="table table-sm table-bordered mb-0" id="mappingTable">
                                <thead class="table-light">
                                    <tr>
                                        <th style="width:32%">來源欄位</th>
                                        <th style="width:32%">目標欄位</th>
                                        <th style="width:12%" class="text-center">是否加密</th>
                                        <th style="width:12%" class="text-center">是否為主鍵</th>
                                        <th style="width:12%">動作</th>
                                    </tr>
                                </thead>
                                <tbody id="mappingRows">
                                </tbody>
                            </table>
                        </div>
                    </div>

                    <!-- Filter Condition Area -->
                    <div class="card border mt-3">
                        <div class="card-header d-flex justify-content-between align-items-center py-2">
                            <span class="fw-semibold">篩選條件設定</span>
                            <div class="d-flex gap-2 align-items-center">
                                <div class="form-check form-check-inline mb-0">
                                    <input class="form-check-input" type="radio" name="filterMode" id="filterModeBuilder" value="builder" checked>
                                    <label class="form-check-label" for="filterModeBuilder">條件設定</label>
                                </div>
                                <div class="form-check form-check-inline mb-0">
                                    <input class="form-check-input" type="radio" name="filterMode" id="filterModeManual" value="manual">
                                    <label class="form-check-label" for="filterModeManual">手寫 SQL</label>
                                </div>
                                <button type="button" class="btn btn-sm btn-primary" id="btnAddFilterRow">
                                    <i class="ri-add-line"></i> 新增條件
                                </button>
                            </div>
                        </div>
                        <div class="card-body p-2" id="filterBuilderArea">
                            <table class="table table-sm table-bordered mb-0" id="filterTable">
                                <thead class="table-light">
                                    <tr>
                                        <th style="width:10%">AND/OR</th>
                                        <th style="width:30%">來源欄位</th>
                                        <th style="width:20%">篩選</th>
                                        <th style="width:30%">內容</th>
                                        <th style="width:10%">動作</th>
                                    </tr>
                                </thead>
                                <tbody id="filterRows"></tbody>
                            </table>
                            <div id="filterEmpty" class="text-muted small p-2" style="display:none;">尚未設定任何篩選條件</div>
                        </div>
                        <div class="card-body p-2" id="filterManualArea" style="display:none;">
                            <textarea id="FilterConditionManual" class="form-control font-monospace"
                                      rows="3" placeholder="請勿包含 WHERE 關鍵字，直接輸入條件式"></textarea>
                            <div class="form-text">請勿包含 WHERE 關鍵字，直接輸入條件式</div>
                        </div>
                    </div>

                    <!-- Description -->
                    <div class="row g-3 mt-1">
                        <div class="col-lg-12">
                            <label for="Description" class="form-label">描述</label>
                            <textarea name="Description" id="Description" class="form-control"
                                      placeholder="描述" rows="2"></textarea>
                        </div>
                    </div>

                </div>
                <div class="modal-footer">
                    <div class="hstack gap-2 justify-content-end">
                        <button type="button" class="btn btn-light" data-bs-dismiss="modal">關閉</button>
                        <button type="button" class="btn btn-success" id="btnSaveAll">確認</button>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>

@section scripts {
    <style>
        /* Select2 驗證錯誤樣式 */
        select.is-invalid + .select2-container .select2-selection {
            border-color: #dc3545 !important;
            background-color: #fff5f5;
        }
        select.is-invalid + .select2-container .select2-selection:focus {
            border-color: #dc3545 !important;
            box-shadow: 0 0 0 0.2rem rgba(220, 53, 69, 0.25);
        }
    </style>
    <script>
        // ── URL 常數 ────────────────────────────────────────────────────────────────
        const API = {
            GetPageList:      '@(Configuration["BackendURL"])/api/ESDbTransferMapping/GetPageList',
            Get:              '@(mapUrl.Get)',
            GetColumns:       '@(mapUrl.GetColumns)',
            Create:           '@(mapUrl.Create)',
            Edit:             '@(mapUrl.Edit)',
            Delete:           '@(mapUrl.Delete)',
            GetDbTransferList:'@(mapUrl.GetDbTransferList)',
            GetDstDbTransferList:'@(mapUrl.GetDstDbTransferList)',
            GetSourceTables:  '@(mapUrl.GetSourceTables)',
            GetSourceColumns: '@(mapUrl.GetSourceColumns)',
            GetTargetTables:  '@(mapUrl.GetTargetTables)',
            GetTargetColumns: '@(mapUrl.GetTargetColumns)',
        };

        // ── 查詢狀態 ────────────────────────────────────────────────────────────────
        let queryState = {
            pageIndex: 1, pageSize: 10,
            sortField: 'SrcTableName', sortDir: 'asc',
            Keyword1: '', Keyword2: '',
            Status: '', StartDate: '', EndDate: '',
        };

        // ── 快取 ────────────────────────────────────────────────────────────────────
        let srcColumnCache  = {};   // tableName → [col,…]
        let dstColumnCache  = {};   // tableName → [col,…]
        let currentId       = null;
        let postaction      = 'create';
        let isLoadingEditData = false;  // 編輯資料載入中，跳過相同資料庫警告

        // ═══════════════════════════════════════════════════════════════════════════
        // 初始化
        // ═══════════════════════════════════════════════════════════════════════════
        $(document).ready(function () {

            loadDatas();
            loadDbTransferList();
            loadDstDbTransferList();

            // 初始化 Source DB、Target DB、Source Table 和 Target Table 的 select2
            $('#SrcDbTransferCode, #DstDbTransferCode, #SrcTableName, #DstTableName').each(function () {
                if (!$(this).data('select2')) {
                    $(this).select2({
                        placeholder: '請選擇',
                        allowClear: true,
                        width: '100%',
                        dropdownParent: $('#showModal')
                    });
                }
            });

            $('#globalSearchInput').on('input', function () {
                const kw = $(this).val().toLowerCase();
                $('#data-list-data tr').each(function () {
                    $(this).toggle($(this).text().toLowerCase().includes(kw));
                });
            });

        });

        // 切換篩選模式
        $(document).on('change', 'input[name="filterMode"]', function () {
            const isManual = $(this).val() === 'manual';
            if (isManual) {
                $('#filterBuilderArea').hide();
                $('#btnAddFilterRow').hide();
                $('#filterManualArea').show();
            } else {
                $('#filterBuilderArea').show();
                $('#btnAddFilterRow').show();
                $('#filterManualArea').hide();
            }
        });

        // ── Select2 輔助 ────────────────────────────────────────────────────────────
        function initColSelect2($sel) {
            $sel.select2({
                placeholder: '-- 請選擇 --',
                allowClear: true,
                width: '100%',
                dropdownParent: $('#showModal')
            });
        }
        function destroyColSelect2($sel) {
            $sel.each(function () {
                if ($(this).hasClass('select2-hidden-accessible')) $(this).select2('destroy');
            });
        }

        // ── 載入來源資料庫下拉 ──────────────────────────────────────────────────────
        function loadDbTransferList() {
            $.get(API.GetDbTransferList, function (res) {
                if (!res.Success) return;
                const $sel = $('#SrcDbTransferCode');
                $sel.find('option:not(:first)').remove();
                res.Data.forEach(x => {
                        $sel.append(`<option value="${x.TransferCode}">${x.TransferName}（${x.DbHost} / ${x.DbName}）</option>`);
                });
            });
        }

        // ── 載入目的資料庫下拉 ──────────────────────────────────────────────────────
        function loadDstDbTransferList() {
            $.get(API.GetDstDbTransferList, function (res) {
                if (!res.Success) return;
                const $sel = $('#DstDbTransferCode');
                $sel.find('option:not(:first)').remove();
                res.Data.forEach(x => {
                        $sel.append(`<option value="${x.TransferCode}">${x.TransferName}（${x.DbHost} / ${x.DbName}）</option>`);
                });
            });
        }

        // ── 來源資料庫變更 → 重載來源TABLE ─────────────────────────────────────────
        $(document).on('change', '#SrcDbTransferCode', function () {
            const guid = $(this).val();
            srcColumnCache = {};
            const $tbl = $('#SrcTableName');

            if (!guid) {
                $tbl.empty().append('<option value="">-- 請選擇 --</option>').trigger('change');
                clearAllSrcColumns();
                return;
            }

            // 顯示載入中
            $tbl.empty().append('<option value="">-- 載入中 --</option>').trigger('change');

            $.get(API.GetSourceTables, { dbTransferGuid: guid }, function (res) {
                $tbl.empty().append('<option value="">-- 請選擇 --</option>');
                if (res.Success) {
                    res.Data.forEach(t => $tbl.append(`<option value="${t}">${t}</option>`));
                } else {
                    Swal.fire({ icon: 'warning', title: res.Message || '載入失敗', confirmButtonText: '確定' });
                }
                $tbl.val('').trigger('change');
            });

            clearAllSrcColumns();

            // 檢查是否與目標DB相同（編輯載入期間跳過）
            const dstGuid = $('#DstDbTransferCode').val();
            if (!isLoadingEditData && dstGuid && guid === dstGuid) {
                Swal.fire({
                    icon: 'warning',
                    title: '來源資料庫與目標資料庫相同，是否繼續？',
                    showCancelButton: true,
                    confirmButtonText: '確定',
                    cancelButtonText: '取消'
                }).then(result => {
                    if (!result.isConfirmed) {
                        $('#SrcDbTransferCode').val('');
                        $tbl.empty().append('<option value="">-- 請選擇 --</option>').trigger('change');
                        clearAllSrcColumns();
                    }
                });
            }
        });

        // ── 來源TABLE變更 → 更新欄位對應列 & 篩選條件欄位下拉（統一由篩選條件區塊處理）──
        $(document).on('change', '#SrcTableName', function () {
            const tbl = $(this).val();

            // 移除驗證錯誤樣式
            if (tbl) {
                $(this).removeClass('is-invalid');
            }

            if (!tbl) {
                clearAllSrcColumns();
                $('#filterRows .filter-col').each(function () {
                    const cur = $(this).val();
                    $(this).html('<option value="">-- 請選擇 --</option>');
                    if (cur) $(this).append(`<option value="${cur}" selected>${cur}</option>`);
                });
                return;
            }

            getSrcColumns(tbl, function (cols) {
                // 更新欄位對應列
                $('#mappingRows .src-col-select').each(function () {
                    refreshColumnSelect($(this), cols, $(this).val());
                });
                // 更新篩選條件欄位下拉
                $('#filterRows .filter-col').each(function () {
                    const cur = $(this).val();
                    destroyColSelect2($(this));
                    const opts = '<option value="">-- 請選擇 --</option>' +
                        cols.map(c => `<option value="${c}" ${c === cur ? 'selected' : ''}>${c}</option>`).join('');
                    $(this).html(opts);
                    initColSelect2($(this));
                    if (cur) $(this).val(cur).trigger('change');
                });
            });
        });

        // ── 目的資料庫變更 → 重載目的TABLE ─────────────────────────────────────────
        $(document).on('change', '#DstDbTransferCode', function () {
            const guid = $(this).val();
            dstColumnCache = {};
            const $tbl = $('#DstTableName');

            if (!guid) {
                $tbl.empty().append('<option value="">-- 請選擇 --</option>').trigger('change');
                clearAllDstColumns();
                return;
            }

            // 顯示載入中
            $tbl.empty().append('<option value="">-- 載入中 --</option>').trigger('change');

            $.get(API.GetTargetTables, { dbTransferGuid: guid }, function (res) {
                $tbl.empty().append('<option value="">-- 請選擇 --</option>');
                if (res.Success) {
                    res.Data.forEach(t => $tbl.append(`<option value="${t}">${t}</option>`));
                } else {
                    Swal.fire({ icon: 'warning', title: res.Message || '載入失敗', confirmButtonText: '確定' });
                }
                $tbl.val('').trigger('change');
            });

            clearAllDstColumns();

            // 檢查是否與來源DB相同（編輯載入期間跳過）
            const srcGuid = $('#SrcDbTransferCode').val();
            if (!isLoadingEditData && srcGuid && guid === srcGuid) {
                Swal.fire({
                    icon: 'warning',
                    title: '來源與目標資料庫相同，可能造成資料被覆蓋，是否繼續？',
                    showCancelButton: true,
                    confirmButtonText: '確認',
                    cancelButtonText: '取消'
                }).then(result => {
                    if (!result.isConfirmed) {
                        $('#DstDbTransferCode').val('');
                        $tbl.empty().append('<option value="">-- 請選擇 --</option>').trigger('change');
                        clearAllDstColumns();
                    }
                });
            }
        });

        // ── 目的TABLE變更 → 更新各列的目標欄位選項 ─────────────────────────────────
        $(document).on('change', '#DstTableName', function () {
            const tbl = $(this).val();

            // 移除驗證錯誤樣式
            if (tbl) {
                $(this).removeClass('is-invalid');
            }

            if (!tbl) { clearAllDstColumns(); return; }

            getDstColumns(tbl, function (cols) {
                $('#mappingRows .dst-col-select').each(function () {
                    refreshColumnSelect($(this), cols, $(this).val());
                });
                refreshDstSelectOptions();
            });
        });

        // 目標欄位選更改時 → 同步所有列的 disabled 狀態
        $(document).on('change', '.dst-col-select', function () {
            refreshDstSelectOptions();
        });

        // 重新計算所有 dst-col-select 的 disabled 選項（已被其他列選用的值不可再選）
        function refreshDstSelectOptions() {
            const usedVals = new Set();
            $('#mappingRows .dst-col-select').each(function () {
                const v = $(this).val();
                if (v) usedVals.add(v);
            });

            $('#mappingRows .dst-col-select').each(function () {
                const myVal = $(this).val();
                $(this).find('option').each(function () {
                    const optVal = $(this).val();
                    if (!optVal) return;
                    $(this).prop('disabled', usedVals.has(optVal) && optVal !== myVal);
                });
            });
        }

        // ── 新增對應列 ──────────────────────────────────────────────────────────────
        $('#btnAddMappingRow').on('click', function () {
            addMappingRow('', '', false, false);
        });

        function addMappingRow(srcVal, dstVal, isEncrypt, isPrimaryKey) {
            const idx = $('#mappingRows tr').length;
            const $tr = $(`
                <tr data-row="${idx}">
                    <td>
                        <select class="form-select form-select-sm src-col-select" required>
                            <option value="">請先選擇來源資料表</option>
                        </select>
                    </td>
                    <td>
                        <select class="form-select form-select-sm dst-col-select" required>
                            <option value="">請先選擇目標資料表</option>
                        </select>
                    </td>
                    <td class="text-center align-middle">
                        <div class="form-check d-flex justify-content-center mb-0">
                            <input class="form-check-input is-encrypt-check" type="checkbox" ${isEncrypt ? 'checked' : ''}>
                        </div>
                    </td>
                    <td class="text-center align-middle">
                        <div class="form-check d-flex justify-content-center mb-0">
                            <input class="form-check-input is-primary-key-check" type="checkbox" ${isPrimaryKey ? 'checked' : ''}>
                        </div>
                    </td>
                    <td class="text-center align-middle">
                        <button type="button" class="btn btn-sm btn-soft-danger btn-remove-row">
                            <i class="ri-delete-bin-line"></i>
                        </button>
                    </td>
                </tr>
            `);

            $('#mappingRows').append($tr);

            // 初始化 select2
            initColSelect2($tr.find('.src-col-select'));
            initColSelect2($tr.find('.dst-col-select'));

            // 填充來源欄位
            const srcTbl = $('#SrcTableName').val();
            if (srcTbl) {
                getSrcColumns(srcTbl, function (cols) {
                    refreshColumnSelect($tr.find('.src-col-select'), cols, srcVal);
                });
            }

            // 填充目標欄位（排除已被其他列選用的值）
            const dstTbl = $('#DstTableName').val();
            if (dstTbl) {
                getDstColumns(dstTbl, function (cols) {
                    refreshColumnSelect($tr.find('.dst-col-select'), cols, dstVal);
                    refreshDstSelectOptions();
                });
            }
        }

        // ── 刪除對應列 ──────────────────────────────────────────────────────────────
        $(document).on('click', '.btn-remove-row', function () {
            const $tr = $(this).closest('tr');
            destroyColSelect2($tr.find('.src-col-select, .dst-col-select'));
            $tr.remove();
            refreshDstSelectOptions();
        });

        // ── 欄位驗證（目標欄位不可重複，來源欄位允許重複）────────────────────────
        function validateNoDuplicateColumns() {
            return true;
        }

        // ── 儲存（一次送出主表 + Columns 陣列）──────────────────────────────────────
        $('#btnSaveAll').on('click', function () {
            const $form = $('#submitForm');

            // 手動驗證必填欄位
            let isValid = true;
            let firstInvalidField = null;

            // 驗證 TransferMappingCode
            if (!$('#TransferMappingCode').val().trim()) {
                $('#TransferMappingCode').addClass('is-invalid');
                if (!firstInvalidField) firstInvalidField = $('#TransferMappingCode');
                isValid = false;
            } else {
                $('#TransferMappingCode').removeClass('is-invalid');
            }

            // 驗證來源資料庫
            if (!$('#SrcDbTransferCode').val()) {
                $('#SrcDbTransferCode').addClass('is-invalid');
                if (!firstInvalidField) firstInvalidField = $('#SrcDbTransferCode');
                isValid = false;
            } else {
                $('#SrcDbTransferCode').removeClass('is-invalid');
            }

            // 驗證來源資料表
            const srcTableVal = $('#SrcTableName').val();
            if (!srcTableVal) {
                $('#SrcTableName').addClass('is-invalid');
                if (!firstInvalidField) firstInvalidField = $('#SrcTableName');
                isValid = false;
            } else {
                $('#SrcTableName').removeClass('is-invalid');
            }

            // 驗證目標資料庫
            if (!$('#DstDbTransferCode').val()) {
                $('#DstDbTransferCode').addClass('is-invalid');
                if (!firstInvalidField) firstInvalidField = $('#DstDbTransferCode');
                isValid = false;
            } else {
                $('#DstDbTransferCode').removeClass('is-invalid');
            }

            // 驗證目標資料表
            const dstTableVal = $('#DstTableName').val();
            if (!dstTableVal) {
                $('#DstTableName').addClass('is-invalid');
                if (!firstInvalidField) firstInvalidField = $('#DstTableName');
                isValid = false;
            } else {
                $('#DstTableName').removeClass('is-invalid');
            }

            if (!isValid) {
                Swal.fire({
                    icon: 'warning',
                    title: '請填寫所有必填欄位',
                    text: '請確認已選擇來源資料庫、來源資料表、目標資料庫及目標資料表',
                    confirmButtonText: '確定'
                });
                // 將焦點移到第一個無效欄位
                if (firstInvalidField) {
                    firstInvalidField.focus();
                }
                return;
            }

            if ($('#mappingRows tr').length === 0) {
                Swal.fire({ icon: 'warning', title: '請至少新增一筆欄位對應', confirmButtonText: '確定' });
                return;
            }

            if (!validateNoDuplicateColumns()) return;

            const srcDbGuid    = $('#SrcDbTransferCode').val();
            const dstDbGuid    = $('#DstDbTransferCode').val();
            const srcTableName = $('#SrcTableName').val();
            const dstTableName = $('#DstTableName').val();
            const description  = $('#Description').val();

            const columns = [];
            let valid = true;
            $('#mappingRows tr').each(function () {
                const src = $(this).find('.src-col-select').val();
                const dst = $(this).find('.dst-col-select').val();
                const enc = $(this).find('.is-encrypt-check').prop('checked');
                const isPk = $(this).find('.is-primary-key-check').prop('checked');
                if (!src || !dst) { valid = false; return false; }
                columns.push({ SrcColumnName: src, DstColumnName: dst, IsEncrypt: enc, IsPrimaryKey: isPk });
            });

            if (!valid) {
                Swal.fire({ icon: 'warning', title: '請完整選擇每列的來源與目標欄位', confirmButtonText: '確定' });
                return;
            }

            showLoader();

            const postURL = postaction === 'create' ? API.Create : API.Edit;
            const filterData = collectFilterData();
            const data = {
                Id:              postaction === 'edit' ? currentId : '00000000-0000-0000-0000-000000000000',
                TransferMappingCode:  $('#TransferMappingCode').val(),
                SrcDbTransferCode:    srcDbGuid,
                SrcTableName:      srcTableName,
                DstDbTransferCode: dstDbGuid,
                DstTableName:      dstTableName,
                Description:       description,
                FilterCondition:   JSON.stringify(filterData),
                FilterMode:        filterData.mode,
            };
            columns.forEach((col, i) => {
                data[`Columns[${i}][SrcColumnName]`] = col.SrcColumnName;
                data[`Columns[${i}][DstColumnName]`] = col.DstColumnName;
                data[`Columns[${i}][IsEncrypt]`]     = col.IsEncrypt;
                data[`Columns[${i}][IsPrimaryKey]`]  = col.IsPrimaryKey;
            });

            $.ajax({
                type: 'POST', url: postURL, dataType: 'json', data: data,
                success: function (res) {
                    if (!res.Success) {
                        Swal.fire({ icon: 'warning', title: res.Message, confirmButtonText: '確定' });
                        return;
                    }
                    const modal = bootstrap.Modal.getInstance(document.getElementById('showModal'));
                    modal.hide();
                    const msg = postaction === 'create'
                        ? '新增成功'
                        : '編輯成功';
                    Swal.fire({ icon: 'success', title: msg, confirmButtonText: '確定' }).then(() => loadDatas());
                    resetElement();
                },
                error: function () {
                    Swal.fire({ icon: 'error', title: '系統錯誤，請聯絡系統管理員', confirmButtonText: '確定' });
                }
            }).always(() => hideLoader());
        });

        // ═══════════════════════════════════════════════════════════════════════════
        // 列表載入
        // ═══════════════════════════════════════════════════════════════════════════
        function loadDatas() {
            showLoader();
            $.ajax({
                url: API.GetPageList,
                type: 'GET',
                data: queryState,
                success: function (res) {
                    hideLoader();
                    if (!res.Success) {
                        Swal.fire({
                            icon: (res.Errors?.AlertLevel || 'warning').toLowerCase(),
                            title: res.Errors?.ReturnCode,
                            text: res.Errors?.ReturnMsg,
                            confirmButtonText: '確認',
                        });
                        return;
                    }
                    renderTable(res.Data.Data);
                    renderPagination(res.Data.Total);
                    document.getElementById('remove-actions').style.display = 'none';
                },
                error: function () { hideLoader(); alert('Failed to load data.'); }
            });
        }

        function renderTable(rows) {
            const tbody = $('#data-list-data');
            tbody.empty();

            if (!rows || rows.length === 0) { $('.noresult').show(); return; }
            $('.noresult').hide();

            rows.forEach(data => {
                tbody.append(`
                    <tr data-id="${data.Id}">
                        <th scope="row">
                            <div class="form-check">
                                <input class="form-check-input row-check" type="checkbox" data-id="${data.Id}" value="option1">
                            </div>
                        </th>
                        <td>
                            <div class="dropdown">
                                <button class="btn btn-soft-secondary btn-sm" type="button" data-bs-toggle="dropdown">
                                    <i class="ri-more-fill align-middle"></i>
                                </button>
                                <ul class="dropdown-menu dropdown-menu-end">
                                    <li><a class="dropdown-item edit-item-btn" href="javascript:void(0)"><i class="ri-pencil-fill align-bottom me-2 text-muted"></i> 編輯</a></li>
                                    <li><a class="dropdown-item remove-item-btn" data-bs-toggle="modal" href="#deleteOrder"><i class="ri-delete-bin-fill align-bottom me-2 text-muted"></i> 刪除</a></li>
                                </ul>
                            </div>
                        </td>
                        <td class="No">${data.No}</td>
                        <td class="TransferMappingCode">${data.TransferMappingCode || ''}</td>
                        <td class="SrcTransferName">${data.SrcTransferName || ''}</td>
                        <td class="SrcTableName">${data.SrcTableName || ''}</td>
                        <td class="DstTransferName">${data.DstTransferName || ''}</td>
                        <td class="DstTableName">${data.DstTableName || ''}</td>
                        ${(data.Columns && data.Columns.length) || 0} 筆
                        <td class="Description">${data.Description || ''}</td>
                    </tr>
                `);
            });
            initDynamicDropdowns();
        }

        function renderPagination(total) {
            const totalPages = Math.ceil(total / queryState.pageSize);
            const ul = $('.listjs-pagination');
            ul.empty();
            if (totalPages <= 1) return;

            const maxPages = 5;
            let startPage = Math.max(1, queryState.pageIndex - Math.floor(maxPages / 2));
            let endPage = Math.min(totalPages, startPage + maxPages - 1);
            if (endPage - startPage < maxPages - 1) startPage = Math.max(1, endPage - maxPages + 1);


            if (startPage > 1) {
                ul.append(`<li class="page-item"><a class="page-link" href="javascript:void(0)" onclick="gotoPage(1)">上一頁</a></li>`);
                ul.append(`<li class="page-item disabled"><span class="page-link">...</span></li>`);
            }
            for (let i = startPage; i <= endPage; i++) {
                ul.append(`<li class="page-item ${i === queryState.pageIndex ? 'active' : ''}"><a class="page-link" href="javascript:void(0)" onclick="gotoPage(${i})">${i}</a></li>`);
            }
            if (endPage < totalPages) {
                ul.append(`<li class="page-item disabled"><span class="page-link">...</span></li>`);
                ul.append(`<li class="page-item"><a class="page-link" href="javascript:void(0)" onclick="gotoPage(${totalPages})">最後一頁</a></li>`);
            }

            $('.pagination-prev').toggleClass('disabled', queryState.pageIndex === 1);
            $('.pagination-next').toggleClass('disabled', queryState.pageIndex === totalPages);

            $('.pagination-prev').off('click').on('click', function (e) {
                e.preventDefault();
                if (queryState.pageIndex > 1) { queryState.pageIndex--; loadDatas(); }
            });
            $('.pagination-next').off('click').on('click', function (e) {
                e.preventDefault();
                if (queryState.pageIndex < totalPages) { queryState.pageIndex++; loadDatas(); }
            });
        }

        function gotoPage(page) { queryState.pageIndex = page; loadDatas(); }

        function SearchData() {
            queryState.Keyword1 = $('#Keyword1').val();
            queryState.Keyword2 = $('#Keyword2').val();
            queryState.pageIndex = 1;
            $('#globalSearchInput').val('').trigger('input');
            loadDatas();
        }

        $('.sort').on('click', function () {
            const field = $(this).data('sort');
            if (queryState.sortField === field)
                queryState.sortDir = queryState.sortDir === 'asc' ? 'desc' : 'asc';
            else { queryState.sortField = field; queryState.sortDir = 'asc'; }
            loadDatas();
        });

        // ═══════════════════════════════════════════════════════════════════════════
        // 勾選 / 全選
        // ═══════════════════════════════════════════════════════════════════════════
        function toggleRemoveActions() {
            $('#remove-actions').toggle($('.row-check:checked').length > 0);
        }
        $(document).on('change', '.row-check', function () {
            $('#checkAll').prop('checked', $('.row-check').length === $('.row-check:checked').length);
            toggleRemoveActions();
        });
        $('#checkAll').on('change', function () {
