        // ═══════════════════════════════════════════════════════════════════════════
        // 刪除（多筆）
        // ═══════════════════════════════════════════════════════════════════════════
        function deleteMultiple() {
            const ids = [];
            document.querySelectorAll('.form-check [value=option1]').forEach(el => {
                if (el.checked) {
                    const id = el.closest('tr')?.querySelector('[data-id]')?.getAttribute('data-id');
                    if (id) ids.push(id);
                }
            });

            if (!ids.length) {
                Swal.fire({ title: 'Please select at least one checkbox', confirmButtonClass: 'btn btn-info', buttonsStyling: false, showCloseButton: true });
                return;
            }

            Swal.fire({
                title: '您確定要刪除此項目嗎？',
                text: '您無法撤銷這個操作！',
                icon: 'warning', showCancelButton: true,
                customClass: { confirmButton: 'btn btn-primary w-xs me-2 mt-2', cancelButton: 'btn btn-danger w-xs mt-2' },
                confirmButtonText: '是的，刪除它！',
                cancelButtonText: '取消',
                buttonsStyling: false, showCloseButton: true
            }).then(function (result) {
                if (!result.value) return;
                showLoader();
                $.ajax({
                    type: 'POST', url: API.Delete, dataType: 'json', data: { list: ids },
                    success: function (res) {
                        if (!res.Success) {
                            Swal.fire({ icon: 'warning', title: res.Message, confirmButtonText: '確定' });
                            return;
                        }
                        loadDatas();
                        Swal.fire({ title: '已刪除！', text: '您的資料已被刪除。', icon: 'success', customClass: { confirmButton: 'btn btn-info w-xs mt-2' }, buttonsStyling: false });
                    },
                    error: function () {
                        Swal.fire({ icon: 'error', title: '系統錯誤，請聯絡系統管理員', confirmButtonText: '確定' });
                    }
                }).always(() => hideLoader());
            });
        }

        // ═══════════════════════════════════════════════════════════════════════════
        // 輔助：欄位快取 & 填充 Select
        // ═══════════════════════════════════════════════════════════════════════════
        function getSrcColumns(tableName, cb) {
            if (srcColumnCache[tableName]) { cb(srcColumnCache[tableName]); return; }
            const guid = $('#SrcDbTransferCode').val();
            $.get(API.GetSourceColumns, { dbTransferGuid: guid, tableName: tableName }, function (res) {
                if (res.Success) {
                    srcColumnCache[tableName] = res.Data;
                    cb(res.Data);
                } else {
                        hideLoader();
                    Swal.fire({ icon: 'warning', title: res.Message || '載入失敗', confirmButtonText: '確定' });
                    cb([]);
                }
            }).fail(function () {
                Swal.fire({ icon: 'error', title: '系統錯誤，請聯絡系統管理員', confirmButtonText: '確定' });
                cb([]);
            });
        }

        function getDstColumns(tableName, cb) {
            if (dstColumnCache[tableName]) { cb(dstColumnCache[tableName]); return; }
            const guid = $('#DstDbTransferCode').val();
            $.get(API.GetTargetColumns, { dbTransferGuid: guid, tableName: tableName }, function (res) {
                if (res.Success) {
                    dstColumnCache[tableName] = res.Data;
                    cb(res.Data);
                } else {
                        hideLoader();
                    Swal.fire({ icon: 'warning', title: res.Message || '載入失敗', confirmButtonText: '確定' });
                    cb([]);
                }
            }).fail(function () {
                Swal.fire({ icon: 'error', title: '系統錯誤，請聯絡系統管理員', confirmButtonText: '確定' });
                cb([]);
            });
        }

        function refreshColumnSelect($sel, cols, selectedVal) {
            const prev = selectedVal || $sel.val() || '';
            destroyColSelect2($sel);
            $sel.html('<option value="">-- 請選擇 --</option>');
            cols.forEach(c => $sel.append(`<option value="${c}" ${c === prev ? 'selected' : ''}>${c}</option>`));
            initColSelect2($sel);
            if (prev) $sel.val(prev).trigger('change');
        }

        function clearAllSrcColumns() {
            $('#mappingRows .src-col-select').each(function () {
                destroyColSelect2($(this));
                $(this).html('<option value="">-- 請先選擇來源資料表 --</option>');
                initColSelect2($(this));
            });
        }

        function clearAllDstColumns() {
            $('#mappingRows .dst-col-select').each(function () {
                destroyColSelect2($(this));
                $(this).html('<option value="">-- 請先選擇目標資料表 --</option>');
                initColSelect2($(this));
            });
        }

        // ═══════════════════════════════════════════════════════════════════════════
        // 篩選條件
        // ═══════════════════════════════════════════════════════════════════════════
        const FILTER_OPERATORS = [
            { value: '=',           label: '等於 (=)' },
            { value: '!=',          label: '不等於 (!=)' },
            { value: '>',           label: '大於 (>)' },
            { value: '>=',          label: '大於等於 (>=)' },
            { value: '<',           label: '小於 (<)' },
            { value: '<=',          label: '小於等於 (<=)' },
            { value: 'LIKE',        label: '包含 (LIKE)' },
            { value: 'NOT LIKE',    label: '不包含 (NOT LIKE)' },
            { value: 'IS NULL',     label: '為空 (IS NULL)' },
            { value: 'IS NOT NULL', label: '不為空 (IS NOT NULL)' },
            // { value: 'IN',          label: '在清單內 (IN)' },
        ];

        // 新增條件列
        $('#btnAddFilterRow').on('click', function () {
            addFilterRow('AND', '', '=', '');
        });

        function addFilterRow(logic, column, operator_, value) {
            const isFirst = $('#filterRows tr').length === 0;
            const srcCols = getSrcColumnOptions();
            const opOptions = FILTER_OPERATORS.map(o =>
                `<option value="${o.value}" ${o.value === operator_ ? 'selected' : ''}>${o.label}</option>`
            ).join('');
            const noValueOps = ['IS NULL', 'IS NOT NULL'];
            const hideVal = noValueOps.includes(operator_);

            const $tr = $(`
                <tr>
                    <td class="align-middle">
                    ${isFirst
                            ? `<span class="text-muted ps-1">WHERE</span>`
                            : `<select class="form-select form-select-sm filter-logic">
                                   <option value="AND" ${logic === 'AND' ? 'selected' : ''}>AND</option>
                                   <option value="OR"  ${logic === 'OR'  ? 'selected' : ''}>OR</option>
                               </select>`
                        }
                    </td>
                    <td>
                        <select class="form-select form-select-sm filter-col">
                            <option value="">-- 請選擇 --</option>
                            ${srcCols}
                        </select>
                    </td>
                    <td>
                        <select class="form-select form-select-sm filter-op">
                            ${opOptions}
                        </select>
                    </td>
                    <td>
                        <input type="text" class="form-control filter-val"
                               value="${escHtml(value)}" ${hideVal ? 'style="display:none"' : ''}>
                    </td>
                    <td class="text-center align-middle">
                        <button type="button" class="btn btn-sm btn-soft-danger btn-remove-filter">
                            <i class="ri-delete-bin-line"></i>
                        </button>
                    </td>
                </tr>
            `);

            $('#filterRows').append($tr);
            initColSelect2($tr.find('.filter-col'));
            if (column) $tr.find('.filter-col').val(column).trigger('change');
            $tr.find('.filter-op').select2({
                minimumResultsForSearch: Infinity,
                width: '100%',
                dropdownParent: $('#showModal')
            });
            $tr.find('.filter-op').val(operator_).trigger('change');
            updateFilterEmpty();
        }

        // 運算子改變時隱藏/顯示值輸入框
        $(document).on('change', '.filter-op', function () {
            const noVal = ['IS NULL', 'IS NOT NULL'].includes($(this).val());
            $(this).closest('tr').find('.filter-val').toggle(!noVal);
        });

        // 刪除條件列
        $(document).on('click', '.btn-remove-filter', function () {
            const $tr = $(this).closest('tr');
            destroyColSelect2($tr.find('.filter-col, .filter-op'));
            $tr.remove();
            updateFilterEmpty();
        });

        function updateFilterEmpty() {
            const hasRows = $('#filterRows tr').length > 0;
            $('#filterEmpty').toggle(!hasRows);
        }

        function getSrcColumnOptions() {
            const tbl = $('#SrcTableName').val();
            if (!tbl || !srcColumnCache[tbl]) return '';
            return srcColumnCache[tbl].map(c => `<option value="${c}">${c}</option>`).join('');
        }

        // 收集篩選條件
        function collectFilterData() {
            const mode = $('input[name="filterMode"]:checked').val();
            if (mode === 'manual') {
                return { mode: 'manual', sql: $('#FilterConditionManual').val().trim(), rows: [] };
            }
            const rows = [];
            $('#filterRows tr').each(function (i) {
                const $logicSel = $(this).find('.filter-logic');
                const logic = $logicSel.length ? $logicSel.val() : '';
                const col   = $(this).find('.filter-col').val();
                const op    = $(this).find('.filter-op').val();
                const val   = $(this).find('.filter-val').val();
                if (col) rows.push({ logic: i === 0 ? '' : logic, col, op, val });
            });
            return { mode: 'builder', sql: '', rows };
        }

        // 載入篩選條件（編輯時）
        function loadFilterCondition(filterCondition, filterMode) {
            $('#filterRows').empty();
            $('#FilterConditionManual').val('');

            if (!filterCondition) { updateFilterEmpty(); return; }

            try {
                const fc = JSON.parse(filterCondition);
                const mode = filterMode || fc.mode || 'builder';

                if (mode === 'manual') {
                    $('input[name="filterMode"][value="manual"]').prop('checked', true);
                    $('#filterBuilderArea').hide();
                    $('#btnAddFilterRow').hide();
                    $('#filterManualArea').show();
                    $('#FilterConditionManual').val(fc.sql || filterCondition);
                } else {
                    $('input[name="filterMode"][value="builder"]').prop('checked', true);
                    $('#filterBuilderArea').show();
                    $('#btnAddFilterRow').show();
                    $('#filterManualArea').hide();
                    (fc.rows || []).forEach((r, i) => addFilterRow(i === 0 ? 'AND' : r.logic, r.col, r.op, r.val));
                }
            } catch {
                // 純文字視為手寫 SQL
                $('input[name="filterMode"][value="manual"]').prop('checked', true);
                $('#filterBuilderArea').hide();
                $('#btnAddFilterRow').hide();
                $('#filterManualArea').show();
                $('#FilterConditionManual').val(filterCondition);
            }
            updateFilterEmpty();
        }

        function escHtml(str) {
            return (str || '').replace(/&/g, '&amp;').replace(/"/g, '&quot;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
        }

        // ═══════════════════════════════════════════════════════════════════════════
        // 重置 Modal
        // ═══════════════════════════════════════════════════════════════════════════
        function resetElement() {
            $('#submitForm input:not([type="radio"]):not([type="checkbox"])').val('');
            $('#submitForm textarea').val('');
            $('#TransferMappingCode').val('');
            $('#SrcDbTransferCode').val('');
            $('#DstDbTransferCode').val('');

            // 重置 Source Table 和 Target Table
            const $srcTbl = $('#SrcTableName');
            const $dstTbl = $('#DstTableName');
                const defaultMsg = '請選擇';

            $srcTbl.empty().append(`<option value="">${defaultMsg}</option>`).trigger('change');
            $dstTbl.empty().append(`<option value="">${defaultMsg}</option>`).trigger('change');

            destroyColSelect2($('#mappingRows .src-col-select, #mappingRows .dst-col-select'));
            destroyColSelect2($('#filterRows .filter-col, #filterRows .filter-op'));
            $('#mappingRows').empty();
            $('#filterRows').empty();
            $('#FilterConditionManual').val('');
            $('input[name="filterMode"][value="builder"]').prop('checked', true);
            $('#filterBuilderArea').show();
            $('#btnAddFilterRow').show();
            $('#filterManualArea').hide();
            updateFilterEmpty();
            srcColumnCache = {};
            dstColumnCache = {};
        }
    </script>
}
