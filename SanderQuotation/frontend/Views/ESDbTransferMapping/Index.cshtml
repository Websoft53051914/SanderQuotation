        // ═══════════════════════════════════════════════════════════════════════════
        // 新增按鈕
        // ═══════════════════════════════════════════════════════════════════════════
        $('#btnShowModal').on('click', function () {
            resetElement();
            $('#exampleModalLabel_Create').show();
            $('#exampleModalLabel_Edit').hide();
            postaction = 'create';
            currentId = null;
            new bootstrap.Modal(document.getElementById('showModal'), { backdrop: 'static', keyboard: false }).show();
