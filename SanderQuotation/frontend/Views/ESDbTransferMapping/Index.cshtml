@model ViewModel.ESDbTransferMappingVM
@{
    ViewBag.Title = config.GetMessage("ESDbTransferMapping_PageTitle");
    ViewBag.pTitle = config.GetMessage("ESDbTransferMapping_PageTitle");
    ViewBag.pageTitle = (config.GetMessage("SystemManagementModule").ToHtmlString());

    var mapUrl = new
    {
        Create = $"{Configuration["BackendURL"]}/api/ESDbTransferMapping/Create",
        Edit = $"{Configuration["BackendURL"]}/api/ESDbTransferMapping/Edit",
        Delete = $"{Configuration["BackendURL"]}/api/ESDbTransferMapping/Delete",
        Get = $"{Configuration["BackendURL"]}/api/ESDbTransferMapping/Get",
        GetColumns = $"{Configuration["BackendURL"]}/api/ESDbTransferMapping/GetColumns",
        GetDbTransferList = $"{Configuration["BackendURL"]}/api/ESDbTransferMapping/GetDbTransferList",
        GetSourceTables = $"{Configuration["BackendURL"]}/api/ESDbTransferMapping/GetSourceTables",
        GetSourceColumns = $"{Configuration["BackendURL"]}/api/ESDbTransferMapping/GetSourceColumns",
        GetTargetTables = $"{Configuration["BackendURL"]}/api/ESDbTransferMapping/GetTargetTables",
        GetTargetColumns = $"{Configuration["BackendURL"]}/api/ESDbTransferMapping/GetTargetColumns",
        GetDstDbTransferList = $"{Configuration["BackendURL"]}/api/ESDbTransferMapping/GetDbTransferList",
    };
}

<div class="row">
    <div class="col-lg-12">
        <div class="card" id="datasList">
            <div class="card-header border-0">
                <div class="d-flex align-items-center">
                    <h5 class="card-title mb-0 flex-grow-1"></h5>
                    <div class="flex-shrink-0">
                        <div class="d-flex flex-wrap gap-2">
                            <button id="btnShowModal" class="btn btn-danger add-btn">
                                <i class="ri-add-line align-bottom me-1"></i> @(config.GetMessage("Create").ToHtmlString())
                            </button>
                            <button class="btn btn-soft-danger" id="remove-actions" onclick="deleteMultiple()">
                                <i class="ri-delete-bin-2-line"></i>
                            </button>
                        </div>
                    </div>
                </div>
            </div>
            <div class="card-body border border-dashed border-end-0 border-start-0">
                <form>
                    <div class="row g-3">
                        <div class="col-xxl-3 col-sm-12">
                            <div class="search-box">
                                <input type="text" id="globalSearchInput" class="form-control search bg-light border-light"
                                       placeholder="@(config.GetMessage("SearchTableContent").ToHtmlString())">
                                <i class="ri-search-line search-icon"></i>
                            </div>
                        </div>
@*                         <div class="col-xxl-3 col-sm-12">
                            <div class="search-box">
                                <input type="text" class="form-control search bg-light border-light"
                                       placeholder="@(config.GetMessage("EnterKeyword").ToHtmlString())" id="Keyword1" name="Keyword1">
                                <i class="ri-search-line search-icon"></i>
                            </div>
                        </div>
                        <div class="col-xxl-3 col-sm-12">
                            <div class="search-box">
                                <input type="text" class="form-control search bg-light border-light"
                                       placeholder="@(config.GetMessage("EnterKeyword").ToHtmlString())" id="Keyword2" name="Keyword2">
                                <i class="ri-search-line search-icon"></i>
                            </div>
                        </div> *@
                        <div class="col-xxl-1 col-sm-4">
                            <button type="button" class="btn btn-primary w-100" onclick="SearchData();">
                                <i class="ri-equalizer-fill me-1 align-bottom"></i>
                                @(config.GetMessage("Filters").ToHtmlString())
                            </button>
                        </div>
                    </div>
                </form>
            </div>
            <div class="card-body">
                <div class="table-responsive table-card mb-4">
                    <table class="table align-middle table-nowrap mb-0" id="dataTable">
                        <thead>
                            <tr>
                                <th scope="col" style="width: 40px;">
                                    <div class="form-check">
                                        <input class="form-check-input" type="checkbox" id="checkAll" value="option">
                                    </div>
                                </th>
                                <th data-sort="action">Action</th>
                                <th data-sort="No">@(config.GetMessage("No").ToHtmlString())</th>
                                <th class="sort" data-sort="TransferMappingCode">@(config.GetMessage("ESDbTransferMapping_MappingCode").ToHtmlString())</th>
                                <th class="sort" data-sort="SrcTransferName">@(config.GetMessage("ESDbTransferMapping_SrcDb").ToHtmlString())</th>
                                <th class="sort" data-sort="SrcTableName">@(config.GetMessage("ESDbTransferMapping_SrcTable").ToHtmlString())</th>
                                <th class="sort" data-sort="DstTransferName">@(config.GetMessage("ESDbTransferMapping_DstDb").ToHtmlString())</th>
                                <th class="sort" data-sort="DstTableName">@(config.GetMessage("ESDbTransferMapping_DstTable").ToHtmlString())</th>
                                <th>@(config.GetMessage("ESDbTransferMapping_ColumnCount").ToHtmlString())</th>
                                <th class="sort" data-sort="Description">@(config.GetMessage("Description").ToHtmlString())</th>
                            </tr>
                        </thead>
                        <tbody class="list form-check-all" id="data-list-data">
                            <tr>
                                <th scope="row">
                                    <div class="form-check">
                                        <input class="form-check-input" type="checkbox" name="checkAll" value="option1">
                                    </div>
                                </th>
                            </tr>
                        </tbody>
                    </table>
                    <div class="noresult" style="display: none">
                        <div class="text-center">
                            <lord-icon src="https://cdn.lordicon.com/msoeawqm.json" trigger="loop"
                                       colors="primary:#121331,secondary:#08a88a" style="width:75px;height:75px"></lord-icon>
                            <h5 class="mt-2">@(config.GetMessage("No_Result_Found").ToHtmlString())</h5>
                        </div>
                    </div>
                </div>
                <div class="d-flex justify-content-end mt-2">
                    <div class="pagination-wrap hstack gap-2">
                        <a class="page-item pagination-prev disabled" href="#">@(config.GetMessage("Page_Previous").ToHtmlString())</a>
                        <ul class="pagination listjs-pagination mb-0"></ul>
                        <a class="page-item pagination-next" href="#">@(config.GetMessage("Page_Next").ToHtmlString())</a>
                    </div>
                </div>

                <!-- Delete Modal -->
                <div class="modal fade flip" id="deleteOrder" tabindex="-1" aria-hidden="true">
                    <div class="modal-dialog modal-dialog-centered">
                        <div class="modal-content">
                            <div class="modal-body p-5 text-center">
                                <lord-icon src="https://cdn.lordicon.com/gsqxdxog.json" trigger="loop"
                                           colors="primary:#405189,secondary:#f06548" style="width:90px;height:90px"></lord-icon>
                                <div class="mt-4 text-center">
                                    <h4>@(config.GetMessage("You_are_about_to_delete_a_data").ToHtmlString())</h4>
                                    <p class="text-muted fs-14 mb-4">
                                        @(config.GetMessage("Deleting_your_data_will_remove_all_of_your_information_from_our_database.").ToHtmlString())
                                    </p>
                                    <div class="hstack gap-2 justify-content-center remove">
                                        <button class="btn btn-link link-success fw-medium text-decoration-none"
                                                id="deleteRecord-close" data-bs-dismiss="modal">
                                            <i class="ri-close-line me-1 align-middle"></i>
                                            @(config.GetMessage("Close").ToHtmlString())
                                        </button>
                                        <button class="btn btn-danger" id="delete-record">@(config.GetMessage("Yes_delete_it").ToHtmlString())</button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Create/Edit Modal -->
<div class="modal fade zoomIn" id="showModal" tabindex="-1" aria-labelledby="exampleModalLabel" aria-hidden="true" data-bs-backdrop="static" data-bs-keyboard="false">
    <div class="modal-dialog modal-dialog-centered modal-xl">
        <div class="modal-content border-0">
            <div class="modal-header p-3 bg-info-subtle">
                <h5 class="modal-title" id="exampleModalLabel_Create" style="display:none;">@(config.GetMessage("Create").ToHtmlString())</h5>
                <h5 class="modal-title" id="exampleModalLabel_Edit" style="display:none;">@(config.GetMessage("Edit").ToHtmlString())</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close" id="close-modal"></button>
            </div>
            <form class="needs-validation" novalidate="" method="post" id="submitForm">
                <div class="modal-body">

                    <!-- TransferMappingCode -->
                    <div class="row g-3 mb-3">
                        <div class="col-lg-4">
                            <label for="TransferMappingCode" class="form-label required">@(config.GetMessage("ESDbTransferMapping_MappingCode").ToHtmlString())</label>
                            <input type="text" id="TransferMappingCode" name="TransferMappingCode" class="form-control" required
                                   placeholder="@(config.GetMessage("ESDbTransferMapping_MappingCode").ToHtmlString())" />
                        </div>
                    </div>

                    <!-- Source / Target Column Mapping Area -->
                    <div class="row g-3 mb-3">
                        <!-- Source DB -->
                        <div class="col-lg-4">
                            <label class="form-label required">@(config.GetMessage("ESDbTransferMapping_SrcDb").ToHtmlString())</label>
                            <select id="SrcDbTransferCode" name="SrcDbTransferCode" class="form-select" required>
                                <option value="">-- @(config.GetMessage("Please_Select").ToHtmlString()) --</option>
                            </select>
                        </div>
                        <!-- Source TABLE -->
                        <div class="col-lg-4">
                            <label class="form-label required">@(config.GetMessage("ESDbTransferMapping_SrcTable").ToHtmlString())</label>
                            <select id="SrcTableName" name="SrcTableName" class="form-select" searchEnabled>
                            </select>
                        </div>
                    </div>

                    <div class="row g-3 mb-3">
                        <!-- Destination DB -->
                        <div class="col-lg-4">
                            <label class="form-label required">@(config.GetMessage("ESDbTransferMapping_DstDb").ToHtmlString())</label>
                            <select id="DstDbTransferCode" name="DstDbTransferCode" class="form-select" required>
                                <option value="">-- @(config.GetMessage("Please_Select").ToHtmlString()) --</option>
                            </select>
                        </div>
                        <!-- Target TABLE -->
                        <div class="col-lg-4">
                            <label class="form-label required">@(config.GetMessage("ESDbTransferMapping_DstTable").ToHtmlString())</label>
                            <select id="DstTableName" name="DstTableName" class="form-select" searchEnabled>
                            </select>
                        </div>
                    </div>

                    <!-- Column Mapping Area -->
                    <div class="card border">
                        <div class="card-header d-flex justify-content-between align-items-center py-2">
                            <span class="fw-semibold">@(config.GetMessage("ESDbTransferMapping_ColumnMapping").ToHtmlString())</span>
                            <button type="button" class="btn btn-sm btn-primary" id="btnAddMappingRow">
                                <i class="ri-add-line"></i> @(config.GetMessage("ESDbTransferMapping_AddMapping").ToHtmlString())
                            </button>
                        </div>
                        <div class="card-body p-0">
                            <table class="table table-sm table-bordered mb-0" id="mappingTable">
                                <thead class="table-light">
                                    <tr>
                                        <th style="width:32%">@(config.GetMessage("ESDbTransferMapping_SrcColumn").ToHtmlString())</th>
                                        <th style="width:32%">@(config.GetMessage("ESDbTransferMapping_DstColumn").ToHtmlString())</th>
                                        <th style="width:12%" class="text-center">@(config.GetMessage("ESDbTransferMapping_IsEncrypt").ToHtmlString())</th>
                                        <th style="width:12%" class="text-center">@(config.GetMessage("ESDbTransferMapping_IsPrimaryKey").ToHtmlString())</th>
                                        <th style="width:12%">@(config.GetMessage("Action").ToHtmlString())</th>
                                    </tr>
                                </thead>
                                <tbody id="mappingRows">
                                </tbody>
                            </table>
                        </div>
                    </div>

                    <!-- Filter Condition Area -->
                    <div class="card border mt-3">
                        <div class="card-header d-flex justify-content-between align-items-center py-2">
                            <span class="fw-semibold">@(config.GetMessage("ESDbTransferMapping_FilterCondition").ToHtmlString())</span>
                            <div class="d-flex gap-2 align-items-center">
                                <div class="form-check form-check-inline mb-0">
                                    <input class="form-check-input" type="radio" name="filterMode" id="filterModeBuilder" value="builder" checked>
                                    <label class="form-check-label" for="filterModeBuilder">@(config.GetMessage("ESDbTransferMapping_FilterModeBuilder").ToHtmlString())</label>
                                </div>
                                <div class="form-check form-check-inline mb-0">
                                    <input class="form-check-input" type="radio" name="filterMode" id="filterModeManual" value="manual">
                                    <label class="form-check-label" for="filterModeManual">@(config.GetMessage("ESDbTransferMapping_FilterModeManual").ToHtmlString())</label>
                                </div>
                                <button type="button" class="btn btn-sm btn-primary" id="btnAddFilterRow">
                                    <i class="ri-add-line"></i> @(config.GetMessage("ESDbTransferMapping_AddCondition").ToHtmlString())
                                </button>
                            </div>
                        </div>
                        <div class="card-body p-2" id="filterBuilderArea">
                            <table class="table table-sm table-bordered mb-0" id="filterTable">
                                <thead class="table-light">
                                    <tr>
                                        <th style="width:10%">@(config.GetMessage("ESDbTransferMapping_AndOr").ToHtmlString())</th>
                                        <th style="width:30%">@(config.GetMessage("ESDbTransferMapping_SrcColumn").ToHtmlString())</th>
                                        <th style="width:20%">@(config.GetMessage("Filters").ToHtmlString())</th>
                                        <th style="width:30%">@(config.GetMessage("Content").ToHtmlString())</th>
                                        <th style="width:10%">@(config.GetMessage("Action").ToHtmlString())</th>
                                    </tr>
                                </thead>
                                <tbody id="filterRows"></tbody>
                            </table>
                            <div id="filterEmpty" class="text-muted small p-2" style="display:none;">@(config.GetMessage("ESDbTransferMapping_NoFilter").ToHtmlString())</div>
                        </div>
                        <div class="card-body p-2" id="filterManualArea" style="display:none;">
                            <textarea id="FilterConditionManual" class="form-control font-monospace"
                                      rows="3" placeholder="@(config.GetMessage("ESDbTransferMapping_FilterWhereHint").ToHtmlString())"></textarea>
                            <div class="form-text">@(config.GetMessage("ESDbTransferMapping_FilterWhereHint").ToHtmlString())</div>
                        </div>
                    </div>

                    <!-- Description -->
                    <div class="row g-3 mt-1">
                        <div class="col-lg-12">
                            <label for="Description" class="form-label">@(config.GetMessage("Description").ToHtmlString())</label>
                            <textarea name="Description" id="Description" class="form-control"
                                      placeholder="@(config.GetMessage("Description").ToHtmlString())" rows="2"></textarea>
                        </div>
                    </div>

                </div>
                <div class="modal-footer">
                    <div class="hstack gap-2 justify-content-end">
                        <button type="button" class="btn btn-light" data-bs-dismiss="modal">@(config.GetMessage("Close").ToHtmlString())</button>
                        <button type="button" class="btn btn-success" id="btnSaveAll">@(config.GetMessage("Confirm").ToHtmlString())</button>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>

@section scripts {
    <style>
        /* Select2 ֵחֳׂ¿ש»~¼ֻ¦¡ */
        select.is-invalid + .select2-container .select2-selection {
            border-color: #dc3545 !important;
            background-color: #fff5f5;
        }
        select.is-invalid + .select2-container .select2-selection:focus {
            border-color: #dc3545 !important;
            box-shadow: 0 0 0 0.2rem rgba(220, 53, 69, 0.25);
        }
    </style>
    <script>
        // ¢w¢w URL ±`¼ֶ ¢w¢w¢w¢w¢w¢w¢w¢w¢w¢w¢w¢w¢w¢w¢w¢w¢w¢w¢w¢w¢w¢w¢w¢w¢w¢w¢w¢w¢w¢w¢w¢w¢w¢w¢w¢w¢w¢w¢w¢w¢w¢w¢w¢w¢w¢w¢w¢w¢w¢w¢w¢w¢w¢w¢w¢w¢w¢w¢w¢w¢w¢w¢w¢w
        const API = {
            GetPageList:      '@(Configuration["BackendURL"])/api/ESDbTransferMapping/GetPageList',
            Get:              '@(mapUrl.Get)',
            GetColumns:       '@(mapUrl.GetColumns)',
            Create:           '@(mapUrl.Create)',
            Edit:             '@(mapUrl.Edit)',
            Delete:           '@(mapUrl.Delete)',
            GetDbTransferList:'@(mapUrl.GetDbTransferList)',
            GetDstDbTransferList:'@(mapUrl.GetDstDbTransferList)',
            GetSourceTables:  '@(mapUrl.GetSourceTables)',
            GetSourceColumns: '@(mapUrl.GetSourceColumns)',
            GetTargetTables:  '@(mapUrl.GetTargetTables)',
            GetTargetColumns: '@(mapUrl.GetTargetColumns)',
        };

        // ¢w¢w ¬d¸ß×¬÷A ¢w¢w¢w¢w¢w¢w¢w¢w¢w¢w¢w¢w¢w¢w¢w¢w¢w¢w¢w¢w¢w¢w¢w¢w¢w¢w¢w¢w¢w¢w¢w¢w¢w¢w¢w¢w¢w¢w¢w¢w¢w¢w¢w¢w¢w¢w¢w¢w¢w¢w¢w¢w¢w¢w¢w¢w¢w¢w¢w¢w¢w¢w¢w¢w
        let queryState = {
            pageIndex: 1, pageSize: 10,
            sortField: 'SrcTableName', sortDir: 'asc',
            Keyword1: '', Keyword2: '',
            Status: '', StartDate: '', EndDate: '',
        };

        // ¢w¢w §ײ¨ת ¢w¢w¢w¢w¢w¢w¢w¢w¢w¢w¢w¢w¢w¢w¢w¢w¢w¢w¢w¢w¢w¢w¢w¢w¢w¢w¢w¢w¢w¢w¢w¢w¢w¢w¢w¢w¢w¢w¢w¢w¢w¢w¢w¢w¢w¢w¢w¢w¢w¢w¢w¢w¢w¢w¢w¢w¢w¢w¢w¢w¢w¢w¢w¢w¢w¢w¢w¢w
        let srcColumnCache  = {};   // tableName ¡ק [col,¡K]
        let dstColumnCache  = {};   // tableName ¡ק [col,¡K]
        let currentId       = null;
        let postaction      = 'create';
        let isLoadingEditData = false;  // ½s¿ט¸ך®ֶ¸ü₪J₪₪¡A¸ץ¹L¬Û¦P¸ך®ֶ®wִµ§i

        // שששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששש
        // ×ל©l₪ֶ
        // שששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששש
        $(document).ready(function () {

            loadDatas();
            loadDbTransferList();
            loadDstDbTransferList();

            // ×ל©l₪ֶ Source Table ©M Target Table ×÷ select2
            $('#SrcTableName, #DstTableName').each(function () {
                if (!$(this).data('select2')) {
                    $(this).select2({
                        placeholder: '@config.GetMessage("Please_Select").ToHtmlString()',
                        allowClear: true,
                        width: '100%',
                        dropdownParent: $('#showModal')
                    });
                }
            });

            $('#globalSearchInput').on('input', function () {
                const kw = $(this).val().toLowerCase();
                $('#data-list-data tr').each(function () {
                    $(this).toggle($(this).text().toLowerCase().includes(kw));
                });
            });

        });

        // ₪ֱ´«¿z¿ן¼ׂ¦¡
        $(document).on('change', 'input[name="filterMode"]', function () {
            const isManual = $(this).val() === 'manual';
            if (isManual) {
                $('#filterBuilderArea').hide();
                $('#btnAddFilterRow').hide();
                $('#filterManualArea').show();
            } else {
                $('#filterBuilderArea').show();
                $('#btnAddFilterRow').show();
                $('#filterManualArea').hide();
            }
        });

        // ¢w¢w ¸ü₪J¨׃·½¸ך®ֶ®w₪U©װ ¢w¢w¢w¢w¢w¢w¢w¢w¢w¢w¢w¢w¢w¢w¢w¢w¢w¢w¢w¢w¢w¢w¢w¢w¢w¢w¢w¢w¢w¢w¢w¢w¢w¢w¢w¢w¢w¢w¢w¢w¢w¢w¢w¢w¢w¢w¢w¢w¢w¢w¢w¢w¢w¢w
        function loadDbTransferList() {
            $.get(API.GetDbTransferList, function (res) {
                if (!res.Success) return;
                const $sel = $('#SrcDbTransferCode');
                $sel.find('option:not(:first)').remove();
                res.Data.forEach(x => {
                        $sel.append(`<option value="${x.TransferCode}">${x.TransferName}¡]${x.DbHost} / ${x.DbName}¡^</option>`);
                });
            });
        }

        // ¢w¢w ¸ü₪J¥״×÷¸ך®ֶ®w₪U©װ ¢w¢w¢w¢w¢w¢w¢w¢w¢w¢w¢w¢w¢w¢w¢w¢w¢w¢w¢w¢w¢w¢w¢w¢w¢w¢w¢w¢w¢w¢w¢w¢w¢w¢w¢w¢w¢w¢w¢w¢w¢w¢w¢w¢w¢w¢w¢w¢w¢w¢w¢w¢w¢w¢w
        function loadDstDbTransferList() {
            $.get(API.GetDstDbTransferList, function (res) {
                if (!res.Success) return;
                const $sel = $('#DstDbTransferCode');
                $sel.find('option:not(:first)').remove();
                res.Data.forEach(x => {
                        $sel.append(`<option value="${x.TransferCode}">${x.TransferName}¡]${x.DbHost} / ${x.DbName}¡^</option>`);
                });
            });
        }

        // ¢w¢w ¨׃·½¸ך®ֶ®wֵÜ§ף ¡ק ­«¸ü¨׃·½TABLE ¢w¢w¢w¢w¢w¢w¢w¢w¢w¢w¢w¢w¢w¢w¢w¢w¢w¢w¢w¢w¢w¢w¢w¢w¢w¢w¢w¢w¢w¢w¢w¢w¢w¢w¢w¢w¢w¢w¢w¢w¢w
        $(document).on('change', '#SrcDbTransferCode', function () {
            const guid = $(this).val();
            srcColumnCache = {};
            const $tbl = $('#SrcTableName');

            if (!guid) {
                $tbl.empty().append('<option value="">-- @(config.GetMessage("Please_Select").ToHtmlString()) --</option>').trigger('change');
                clearAllSrcColumns();
                return;
            }

            // ֵד¥Ü¸ü₪J₪₪
            $tbl.empty().append('<option value="">-- @(config.GetMessage("ESDbTransferMapping_Loading").ToHtmlString()) --</option>').trigger('change');

            $.get(API.GetSourceTables, { dbTransferGuid: guid }, function (res) {
                $tbl.empty().append('<option value="">-- @(config.GetMessage("Please_Select").ToHtmlString()) --</option>');
                if (res.Success) {
                    res.Data.forEach(t => $tbl.append(`<option value="${t}">${t}</option>`));
                } else {
                    Swal.fire({ icon: 'warning', title: res.Message || '@(config.GetMessage("ESDbTransferMapping_LoadFailedMsg").ToHtmlString())', confirmButtonText: '½T©w' });
                }
                $tbl.val('').trigger('change');
            });

            clearAllSrcColumns();

            // ְֻ¬d¬O§_»P¥״¼׀DB¬Û¦P¡]½s¿ט¸ü₪J´ֱ¶¡¸ץ¹L¡^
            const dstGuid = $('#DstDbTransferCode').val();
            if (!isLoadingEditData && dstGuid && guid === dstGuid) {
                Swal.fire({
                    icon: 'warning',
                    title: '@(config.GetMessage("ESDbTransferMapping_SameDatabaseWarning").ToHtmlString())',
                    showCancelButton: true,
                    confirmButtonText: '@(config.GetMessage("Confirm").ToHtmlString())',
                    cancelButtonText: '@(config.GetMessage("Cancel").ToHtmlString())'
                }).then(result => {
                    if (!result.isConfirmed) {
                        $('#SrcDbTransferCode').val('');
                        $tbl.empty().append('<option value="">-- @(config.GetMessage("Please_Select").ToHtmlString()) --</option>').trigger('change');
                        clearAllSrcColumns();
                    }
                });
            }
        });

        // ¢w¢w ¨׃·½TABLEֵÜ§ף ¡ק §ף·sִז¦ל¹ןְ³¦C & ¿z¿ן±ר¥ףִז¦ל₪U©װ¡]²־₪@¥ׁ¿z¿ן±ר¥ף°ֿ¶פ³B²z¡^¢w¢w
        $(document).on('change', '#SrcTableName', function () {
            const tbl = $(this).val();

