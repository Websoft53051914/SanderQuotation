@{
    ViewData["Title"] = "OCAP 流程執行";
}

@section styles {
    <link rel="stylesheet" href="~/css/ocap-flow.css" />
}

<div id="ocap-page">
    <!-- TOP HISTORY TIMELINE -->
    <div id="run-history-top"></div>

    <div id="ocap-wrapper">

        <!-- LEFT TOOLBAR -->
        <div id="ocap-toolbar">
            <h6>JSON</h6>
            <button class="toolbar-btn secondary" id="btn-import">匯入 JSON</button>

            <hr class="toolbar-sep" />
            <h6>操作</h6>
            <button class="toolbar-btn secondary" id="btn-go-back">回上一步</button>
            <button class="toolbar-btn secondary" id="btn-reset-run">重設流程</button>
        </div>

        <!-- CANVAS -->
        <div id="ocap-canvas-wrap">
            <div id="ocap-canvas"></div>
        </div>

        <!-- RIGHT INFO PANEL -->
        <div id="run-info-panel">
            <div id="run-info-placeholder">
                <div class="run-info-ph-icon"></div>
                <div>點選節點以查看說明</div>
            </div>
            <div id="run-info-content" style="display:none;">
                <div id="run-info-header">
                    <span id="run-info-type"></span>
                    <div id="run-info-title"></div>
                </div>
                <div id="run-info-desc-card">
                    <div class="run-info-desc-label">說明</div>
                    <div id="run-info-desc"></div>
                </div>
                <div id="run-info-image-card" style="display:none;padding:0 18px 18px;">
                    <div class="run-info-desc-label">圖片</div>
                    <img id="run-info-img" style="max-width:100%;border-radius:6px;border:1px solid #eaecef;"
                         alt="節點圖片" />
                </div>
            </div>
        </div>

    </div>
</div>

<!-- Image Lightbox -->
<div id="img-lightbox" role="dialog" aria-modal="true" aria-label="圖片放大">
    <img id="img-lightbox-src" src="" alt="" />
</div>

<!-- INFO MODAL -->
<div class="modal fade" id="info-modal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">
                    <span id="info-modal-title"></span>
                    <span id="info-modal-type" class="badge bg-secondary ms-2"
                          style="font-size:11px;font-weight:400;"></span>
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body" id="info-modal-body"></div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">關閉</button>
            </div>
        </div>
    </div>
</div>

<!-- JSON MODAL -->
<div class="modal fade" id="json-modal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="json-modal-title">JSON</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <textarea id="json-textarea" class="form-control" spellcheck="false"></textarea>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">取消</button>
                <button type="button" class="btn btn-primary" id="btn-modal-ok">確定</button>
            </div>
        </div>
    </div>
</div>



@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jsPlumb/2.15.6/js/jsplumb.min.js"></script>
    <script src="~/js/ocap-core.js"></script>
    <script>
        (function () {
        "use strict";

        var currentRunNodeId = null;
        var visitedNodes = [];
        var visitedTimes = [];
        var visitedEdges = [];
        var visitedConns = [];
        var autoScroll = false;  // 設為 false 可關閉點節點時自動捲動

        /* ---- 啟用節點 ---- */
        function activateNode(id, fromConn) {
        if (id === currentRunNodeId && !fromConn) return;
        var jp = OcapCore.getJp();

        if (currentRunNodeId) {
        var prevEl = document.getElementById(currentRunNodeId);
        if (prevEl) {
        prevEl.classList.remove("active-node");
        prevEl.classList.add("visited-node");
        }
        }
        if (fromConn) {
        fromConn.canvas.classList.remove("conn-active-animate");
        fromConn.canvas.classList.add("conn-visited");
        visitedEdges.push(fromConn);
        }
        visitedConns.push(fromConn || null);
        if (currentRunNodeId) {
        jp.getConnections({ source: currentRunNodeId }).forEach(function (c) {
        if (c !== fromConn) c.canvas.classList.remove("conn-active-animate");
        });
        }

        visitedNodes.push(id);
        visitedTimes.push(new Date());
        currentRunNodeId = id;

        // Update right info panel
        (function () {
        var n = OcapCore.getNodes()[id];
        if (!n) return;
        var typeMap = { start: "開始", end: "結束", action: "動作", decision: "判斷" };
        var content = document.getElementById("run-info-content");
        content.setAttribute("data-type", n.type);
        document.getElementById("run-info-title").textContent = n.label;
        document.getElementById("run-info-type").textContent = typeMap[n.type] || n.type;
        document.getElementById("run-info-desc").textContent = n.desc || "(無說明內容)";
        var imgCard = document.getElementById("run-info-image-card");
        var img = document.getElementById("run-info-img");
        if (imgCard && img) {
        if (n.image) { img.src = n.image; imgCard.style.display = "block"; }
        else { img.src = ""; imgCard.style.display = "none"; }
        }
        document.getElementById("run-info-placeholder").style.display = "none";
        content.style.display = "flex";
        })();

        var el = document.getElementById(id);
        if (el) {
        el.classList.remove("visited-node");
        el.classList.add("active-node");
        if (autoScroll) el.scrollIntoView({ behavior: "smooth", block: "center", inline: "center" });
        }

        var outConns = jp.getConnections({ source: id });
        outConns.forEach(function (c) {
        // 若此連線曾被走過（紫色），先清除再顯示綠色動畫
        c.canvas.classList.remove("conn-visited");
        c.canvas.classList.add("conn-active-animate");
        });

        updateHistoryBar();
        }

        function handleEdgeClick(conn) {
        // 停用：僅允許點節點前進
        }

        function goBack() {
        if (visitedNodes.length <= 1) return;
        var jp = OcapCore.getJp();

        var curEl = document.getElementById(currentRunNodeId);
        if (curEl) { curEl.classList.remove("active-node", "visited-node"); }
        jp.getConnections({ source: currentRunNodeId }).forEach(function (c) {
        c.canvas.classList.remove("conn-active-animate");
        });

        var lastConn = visitedConns.pop();
        if (lastConn && lastConn.canvas) {
        lastConn.canvas.classList.remove("conn-visited");
        visitedEdges.splice(visitedEdges.lastIndexOf(lastConn), 1);
        }

        visitedNodes.pop();
        visitedTimes.pop();
        currentRunNodeId = visitedNodes[visitedNodes.length - 1];

        var prevEl = document.getElementById(currentRunNodeId);
        if (prevEl) {
        prevEl.classList.remove("visited-node");
        prevEl.classList.add("active-node");
        if (autoScroll) prevEl.scrollIntoView({ behavior: "smooth", block: "center", inline: "center" });
        }

        var outConns = jp.getConnections({ source: currentRunNodeId });
        outConns.forEach(function (c) {
        c.canvas.classList.remove("conn-visited");
        c.canvas.classList.add("conn-active-animate");
        });

        // Update right info panel
        (function () {
        var n = OcapCore.getNodes()[currentRunNodeId];
        if (!n) return;
        var typeMap = { start: "開始", end: "結束", action: "動作", decision: "判斷" };
        var content = document.getElementById("run-info-content");
        content.setAttribute("data-type", n.type);
        document.getElementById("run-info-title").textContent = n.label;
        document.getElementById("run-info-type").textContent = typeMap[n.type] || n.type;
        document.getElementById("run-info-desc").textContent = n.desc || "(無說明內容)";
        var imgCard = document.getElementById("run-info-image-card");
        var img = document.getElementById("run-info-img");
        if (imgCard && img) {
        if (n.image) { img.src = n.image; imgCard.style.display = "block"; }
        else { img.src = ""; imgCard.style.display = "none"; }
        }
        document.getElementById("run-info-placeholder").style.display = "none";
        content.style.display = "flex";
        })();

        updateHistoryBar();
        }

        function pad2(n) { return n.toString().padStart(2, '0'); }

        function updateHistoryBar() {
        var bar = document.getElementById("run-history-top");
        var nodes = OcapCore.getNodes();
        if (visitedNodes.length === 0) { bar.style.display = "none"; return; }
        bar.style.display = "flex";
        bar.innerHTML = visitedNodes.map(function (nid, i) {
        var n = nodes[nid];
        var label = n ? n.label : nid;
        var t = visitedTimes[i];
        var timeStr = t ? (pad2(t.getHours()) + ':' + pad2(t.getMinutes()) + ':' + pad2(t.getSeconds())) : '';
        var isCur = i === visitedNodes.length - 1;
        var type = n ? n.type : 'action';
        var stateCls = isCur ? 'hist-item-cur' : 'hist-item-visited';
        var cls = 'hist-item hist-type-' + type + ' ' + stateCls;
        var arrow = i > 0 ? '<span class="hist-arrow">&#8594;</span>' : '';
        return arrow +
        '<div class="' + cls + '" title="' + nid + '">' +
        '<div class="hist-name">' + label + '</div>' +
        '<div class="hist-time">' + timeStr + '</div>' +
        '</div>';
        }).join('');
        // 自動捲動到最右邊（目前步驟）
        bar.scrollLeft = bar.scrollWidth;
        }

        function clearRunHighlights() {
        document.querySelectorAll(".active-node").forEach(function (el) { el.classList.remove("active-node"); });
        document.querySelectorAll(".visited-node").forEach(function (el) { el.classList.remove("visited-node"); });
        var jp = OcapCore.getJp();
        if (jp) jp.getAllConnections().forEach(function (c) {
        c.canvas.classList.remove("conn-active", "conn-active-animate", "conn-visited");
        });
        visitedNodes = [];
        visitedTimes = [];
        visitedEdges = [];
        visitedConns = [];
        var bar = document.getElementById("run-history-top");
        bar.style.display = "none";
        bar.innerHTML = "";
        // Reset right info panel
        document.getElementById("run-info-placeholder").style.display = "block";
        document.getElementById("run-info-content").style.display = "none";
        }

        document.getElementById("btn-go-back").addEventListener("click", function () {
        goBack();
        });

        document.getElementById("btn-reset-run").addEventListener("click", function () {
        clearRunHighlights();
        currentRunNodeId = null;
        var startNode = Object.values(OcapCore.getNodes()).find(function (n) { return n.type === "start"; });
        if (startNode) activateNode(startNode.id, null);
        });

        document.getElementById("btn-import").addEventListener("click", function () {
        OcapCore.openJsonModal("匯入 JSON", "", true);
        });

        OcapCore.setEdgeClickHandler(handleEdgeClick);
        OcapCore.setRunNodeClickHandler(function (nodeId) {
        var jp = OcapCore.getJp();
        if (currentRunNodeId === null) {
        // 流程尚未開始，點任意節點啟動
        activateNode(nodeId, null);
        return;
        }
        // 找出從目前節點連到被點節點的連線
        var conns = jp.getConnections({ source: currentRunNodeId, target: nodeId });
        if (conns.length > 0) {
        activateNode(nodeId, conns[0]);
        }
        });
        OcapCore.init("ocap-canvas", "ocap-canvas-wrap", true, function () {
        OcapCore.bindJsonModal(function () {
        clearRunHighlights();
        currentRunNodeId = null;
        var startNode = Object.values(OcapCore.getNodes()).find(function (n) { return n.type === "start"; });
        if (startNode) activateNode(startNode.id, null);
        });
        });

        /* ---- 圖片點擊放大 ---- */
        (function () {
        var lb = document.getElementById("img-lightbox");
        var lbImg = document.getElementById("img-lightbox-src");
        document.getElementById("run-info-img").addEventListener("click", function () {
            if (!this.src) return;
            lbImg.src = this.src;
            lb.classList.add("open");
        });
        lb.addEventListener("click", function () {
            lb.classList.remove("open");
            lbImg.src = "";
        });
        document.addEventListener("keydown", function (e) {
            if (e.key === "Escape") { lb.classList.remove("open"); lbImg.src = ""; }
        });
        })();

        })();
    </script>
}
