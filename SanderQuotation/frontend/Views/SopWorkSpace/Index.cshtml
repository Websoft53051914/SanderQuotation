@{
    ViewBag.Title = "工規瀏覽";
    ViewBag.pTitle = "工規瀏覽";
    var backendUrl = Configuration["BackendURL"];
}

<style>
    .rule-station-header {
        background-color: transparent;
        font-weight: bold;
        font-size: 1rem;
        padding: 6px 4px;
        border: none;
    }

    .rule-col-header {
        background-color: #c3c3c3 !important;
        font-weight: bold;
        text-align: center;
        vertical-align: middle;
        border: 1px solid #888 !important;
        font-size: 0.875rem;
        white-space: nowrap;
    }

    .rule-data-cell {
        border: 1px solid #888 !important;
        vertical-align: middle;
        font-size: 0.875rem;
        padding: 4px 6px;
    }

    .rule-remark-cell {
        border-left: 1px solid #888 !important;
        border-right: 1px solid #888 !important;
        /*border-bottom: 1px solid #888 !important;*/
        border-bottom: none !important;
        border-top: none !important;
        font-size: 0.875rem;
        padding: 4px 8px;
    }

    /*    .rule-remark-cell:last-child {
        border-bottom: 1px solid #888 !important;
    }*/

    #remarkTableBody tr:last-child {
        border-bottom: 1px solid #888 !important;
    }
</style>

<div class="row">
    <div class="col-lg-12">
        <div class="card">
            <div class="card-header border-0">
                <h5 class="card-title mb-0">站點工規查詢</h5>
            </div>
            <div class="card-body">
                <div class="row g-3 mb-3">
                    <div class="col-xxl-4 col-sm-6">
                        <label class="form-label">文件</label>
                        <select id="ddlOrder" class="form-select">
                            <option value="">-- 請選擇文件 --</option>
                        </select>
                    </div>
                    <div class="col-xxl-4 col-sm-6">
                        <label class="form-label">站點</label>
                        <select id="ddlStation" class="form-select" disabled>
                            <option value="">-- 請先選擇文件 --</option>
                        </select>
                    </div>
                    <div class="col-xxl-2 col-sm-4 d-flex align-items-end">
                        <button type="button" id="btnQuery" class="btn btn-primary w-100" disabled>
                            <i class="ri-search-line me-1"></i> 查詢
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <!--工規內容區域-->
        <div class="card d-none" id="contentArea">
            <div class="card-header border-0 d-flex align-items-center justify-content-between">
                <h5 class="card-title mb-0" id="contentTitle">工規內容</h5>
            </div>
            <div class="card-body">
                <div class="table-responsive overflow-y-hidden">
                    <table class="table table-bordered mb-0" id="ruleTable"
                           style="table-layout: fixed; width: 100%; border-collapse: collapse;">
                        <colgroup>
                            <col style="width: 20%">
                            <col style="width: 25%">
                            <col style="width: 30%">
                            <col style="width: 25%">
                        </colgroup>
                        <thead id="ruleTableHead">
                        </thead>
                        <tbody id="ruleTableBody">
                        </tbody>
                    </table>
                </div>
                <!--備註區域-->
                <div id="remarkArea" class="mt-0 d-none">
                    <table class="table mb-0" id="remarkTable"
                           style="table-layout: fixed; width: 100%; border-collapse: collapse; border-top: none;">
                        <colgroup>
                            <col style="width: 100%">
                        </colgroup>
                        <tbody id="remarkTableBody"></tbody>
                    </table>
                </div>
            </div>
        </div>

        <!--A4 預覽區域-->
        <div class="card d-none mt-3" id="a4PreviewArea">
            <div class="card-body p-3" style="background-color: #707070; overflow-x: auto;">
                <div id="a4Sheet"
                     style="width: 794px; min-height: 100px; margin: 0 auto; background: #ffffff; padding: 40px 45px; box-shadow: 0 2px 12px rgba(0,0,0,0.5);">
                </div>
            </div>
        </div>
    </div>
</div>

@section scripts {
    <script>
        const backendUrl = '@backendUrl';
        const jwtToken = getCookie('jwtname');

        function getCookie(name) {
            const match = document.cookie.match(new RegExp('(^| )' + name + '=([^;]+)'));
            return match ? match[2] : '';
        }

        function authFetch(url) {
            return fetch(url, {
                headers: {
                    'Authorization': 'Bearer ' + jwtToken
                }
            });
        }

        // 載入工單下拉
        authFetch(backendUrl + '/api/SopWorkSpace/GetOrderList')
            .then(r => r.json())
            .then(res => {
                if (!res || !res.Data) return;
                const ddl = document.getElementById('ddlOrder');
                res.Data.forEach(o => {
                    const opt = document.createElement('option');
                    opt.value = o.OrderID;
                    opt.text = o.DisplayText;
                    ddl.appendChild(opt);
                });
            });

        // 工單變更 → 載入站點
        document.getElementById('ddlOrder').addEventListener('change', function () {
            const orderId = this.value;
            const ddlStation = document.getElementById('ddlStation');
            const btnQuery = document.getElementById('btnQuery');

            ddlStation.innerHTML = '<option value="">-- 請先選擇文件 --</option>';
            ddlStation.disabled = true;
            btnQuery.disabled = true;
            document.getElementById('contentArea').classList.add('d-none');
            document.getElementById('a4PreviewArea').classList.add('d-none');

            if (!orderId) return;

            authFetch(backendUrl + '/api/SopWorkSpace/GetStationList?orderId=' + encodeURIComponent(orderId))
                .then(r => r.json())
                .then(res => {
                    if (!res || !res.Data) return;
                    ddlStation.innerHTML = '<option value="">-- 請選擇站點 --</option>';
                    res.Data.forEach(s => {
                        const opt = document.createElement('option');
                        opt.value = s.OpNo;
                        opt.text = s.OpNo + '　' + (s.OpName || '');
                        ddlStation.appendChild(opt);
                    });
                    ddlStation.disabled = false;
                });
        });

        // 站點變更 → 啟用查詢按鈕
        document.getElementById('ddlStation').addEventListener('change', function () {
            document.getElementById('btnQuery').disabled = !this.value;
            document.getElementById('contentArea').classList.add('d-none');
            document.getElementById('a4PreviewArea').classList.add('d-none');
        });

        // 查詢工規
        document.getElementById('btnQuery').addEventListener('click', function () {
            const orderId = document.getElementById('ddlOrder').value;
            const opNo = document.getElementById('ddlStation').value;
            if (!orderId || !opNo) return;

            authFetch(backendUrl + '/api/SopWorkSpace/GetStationContent?orderId='
                + encodeURIComponent(orderId) + '&opNo=' + encodeURIComponent(opNo))
                .then(r => r.json())
                .then(res => {
                    if (!res || !res.Data) {
                        alert('查無工規內容');
                        return;
                    }
                    renderRuleContent(res.Data);
                });
        });

        function renderRuleContent(data) {
            // 標題
            document.getElementById('contentTitle').textContent =
                '■ ' + (data.OpNo || '') + '　' + (data.OpName || '');

            // 欄位標題列
            const thead = document.getElementById('ruleTableHead');
            thead.innerHTML = `
                <tr>
                    <th class="rule-col-header">機台 M/C 特殊裝置</th>
                    <th class="rule-col-header">項目 ITEM</th>
                    <th class="rule-col-header">規格 SPEC</th>
                    <th class="rule-col-header">參照 Reference</th>
                </tr>`;

            // 工規資料列
            const tbody = document.getElementById('ruleTableBody');
            tbody.innerHTML = '';
            const rows = data.RuleList || [];
            // rows.length === 0
            // tbody.innerHTML = '<tr><td colspan="4" class="text-center text-muted rule-data-cell">（無工規資料）</td></tr>';
            if (rows.length > 0) {
                rows.forEach(row => {
                    const tr = document.createElement('tr');
                    tr.innerHTML = `
                        <td class="rule-data-cell">${escHtml(row.Machine)}</td>
                        <td class="rule-data-cell">${escHtml(row.Item)}</td>
                        <td class="rule-data-cell">${escHtml(row.Spec)}</td>
                        <td class="rule-data-cell">${escHtml(row.Reference)}</td>`;
                    tbody.appendChild(tr);
                });
            }

            // 備註
            const remarkArea = document.getElementById('remarkArea');
            const remarkBody = document.getElementById('remarkTableBody');
            remarkBody.innerHTML = '';
            const remarks = (data.Remark || []).filter(r => r.ContentText && r.ContentText.trim() !== '');
            if (remarks.length > 0) {
                remarks.forEach((r, idx) => {
                    const tr = document.createElement('tr');
                    const td = document.createElement('td');
                    td.className = 'rule-remark-cell';
                    //td.style.borderTop = idx === 0 ? '1px solid #888' : 'none';
                    td.innerHTML = escHtml((idx + 1) + '. ' + r.ContentText).replace(/\n/g, '<br>');
                    tr.appendChild(td);
                    remarkBody.appendChild(tr);
                });
                remarkArea.classList.remove('d-none');
            } else {
                remarkArea.classList.add('d-none');
            }

            // 圖片（繼續加在 remarkTableBody）
            const imagePaths = data.ImageFilePaths || [];
            if (imagePaths.length > 0) {
                imagePaths.forEach((path, i) => {
                    const tr = document.createElement('tr');
                    const td = document.createElement('td');
                    td.className = 'rule-remark-cell';
                    //if (i === 0 && remarks.length === 0) {
                    //    td.style.cssText += 'border-top: 1px solid #888 !important;'
                    //}
                    td.style.textAlign = 'center';
                    td.style.padding = '5px';
                    const img = document.createElement('img');
                    img.src = backendUrl + '/api/SopWorkSpace/GetImage?path=' + encodeURIComponent(path);
                    img.style.maxWidth = '100%';
                    img.style.maxHeight = '400px';
                    img.addEventListener('error', function () { this.parentElement.textContent = '[圖片無法顯示]'; });
                    td.appendChild(img);
                    tr.appendChild(td);
                    remarkBody.appendChild(tr);
                });
                remarkArea.classList.remove('d-none');
            }

            document.getElementById('contentArea').classList.remove('d-none');
            renderA4Preview(data);
        }

        function renderA4Preview(data) {
            const sheet = document.getElementById('a4Sheet');
            const opNo = data.OpNo || '';
            const opName = data.OpName || '';
            const displayOpNo = opNo.length > 1 ? opNo.substring(1) : opNo;
            const fontStyle = 'font-family:"Microsoft JhengHei","DFKai-SB",sans-serif;font-size:12pt;line-height:1.4;';
            let html = `<div style="${fontStyle}">`;

            // 站點標題
            html += `<div style="font-size:13pt;font-weight:bold;padding:3px 0;min-height:25pt;display:flex;align-items:center;">■ ${escHtml(displayOpNo)}&nbsp;&nbsp;${escHtml(opName)}</div>`;

            // 工規表格
            html += `<table style="width:100%;border-collapse:collapse;table-layout:fixed;">
                <colgroup><col style="width:25%"><col style="width:25%"><col style="width:25%"><col style="width:25%"></colgroup>
                <thead>
                    <tr>
                        <th style="background-color:#c3c3c3;border:1px solid #333;text-align:center;padding:2px 4px;font-size:12pt;white-space:nowrap;">機台M/C特殊裝置</th>
                        <th style="background-color:#c3c3c3;border:1px solid #333;text-align:center;padding:2px 4px;font-size:12pt;white-space:nowrap;">項目 ITEM</th>
                        <th style="background-color:#c3c3c3;border:1px solid #333;text-align:center;padding:2px 4px;font-size:12pt;white-space:nowrap;">規格 SPEC</th>
                        <th style="background-color:#c3c3c3;border:1px solid #333;text-align:center;padding:2px 4px;font-size:12pt;white-space:nowrap;">參照 Reference</th>
                    </tr>
                </thead>
                <tbody>`;

            const a4Rows = data.RuleList || [];
            // a4Rows.length === 0
            // html += `<tr><td colspan="4" style="border:1px solid #333;padding:2px 4px;font-size:12pt;text-align:center;color:#666;">（無工規資料）</td></tr>`;
            if (a4Rows.length > 0) {
                a4Rows.forEach(row => {
                    html += `<tr>
                        <td style="border:1px solid #333;padding:1px 4px;font-size:12pt;vertical-align:middle;">${escHtml(row.Machine || '')}</td>
                        <td style="border:1px solid #333;padding:1px 4px;font-size:12pt;vertical-align:middle;">${escHtml(row.Item || '')}</td>
                        <td style="border:1px solid #333;padding:1px 4px;font-size:12pt;vertical-align:middle;">${escHtml(row.Spec || '')}</td>
                        <td style="border:1px solid #333;padding:1px 4px;font-size:12pt;vertical-align:middle;">${escHtml(row.Reference || '')}</td>
                    </tr>`;
                });
            }
            html += `</tbody></table>`;

            // 備註與圖片
            const a4Remarks = (data.Remark || []).filter(r => r.ContentText && r.ContentText.trim() !== '');
            const a4Images = data.ImageFilePaths || [];
            const hasAny = a4Remarks.length > 0 || a4Images.length > 0;
            if (hasAny) {
                html += `<table style="width:100%;border-collapse:collapse;table-layout:fixed;">`;
                a4Remarks.forEach((r, i) => {
                    const isFirst = i === 0;
                    const isLast = i === a4Remarks.length - 1 && a4Images.length === 0;
                    html += `<tr><td style="border-left:1px solid #333;border-right:1px solid #333;border-bottom:${isLast ? '1px solid #333' : '0'};${isFirst ? 'border-top:1px solid #333;' : ''}padding:2px 8px;font-size:12pt;">${escHtml((i + 1) + '. ' + r.ContentText).replace(/\n/g, '<br>')}</td></tr>`;
                });
                a4Images.forEach((path, i) => {
                    const isFirst = i === 0 && a4Remarks.length === 0;
                    const isLast = i === a4Images.length - 1;
                    html += `<tr><td style="border-left:1px solid #333;border-right:1px solid #333;border-bottom:${isLast ? '1px solid #333' : '0'};${isFirst ? 'border-top:1px solid #333;' : ''}padding:5px;text-align:center;"><img src="${backendUrl}/api/SopWorkSpace/GetImage?path=${encodeURIComponent(path)}" style="max-width:400px;max-height:200px;" onerror="this.parentElement.textContent='[圖片無法顯示]'"></td></tr>`;
                });
                html += `</table>`;
            }

            html += `</div>`;
            sheet.innerHTML = html;
            document.getElementById('a4PreviewArea').classList.remove('d-none');
        }

        function escHtml(str) {
            if (!str) return '';
            return str.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
        }
    </script>
}
