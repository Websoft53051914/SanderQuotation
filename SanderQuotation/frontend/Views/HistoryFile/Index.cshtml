@*
    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@{
    ViewBag.Title = "歷史資料上傳";
}
@section styles {
    <link href="@Url.Content("~/assets/css/filepond.css")" rel="stylesheet" />
    <link href="@Url.Content("~/assets/css/filepond-plugin-image-preview.css")" rel="stylesheet" />
    <style>
        .filepond--root { font-family: inherit; }
        .filepond--panel-root { background-color: #f3f6f9; border: 2px dashed #ced4da; border-radius: 0.375rem; }
        .filepond--drop-label { color: #6c757d; }
        .filepond--label-action { text-decoration-color: #405189; color: #405189; }
    </style>
}

<div class="row">
    <div class="col-lg-12">
        <div class="card" id="datasList">
            <div class="card-header border-0">
                <div class="d-flex align-items-center">
                    <h5 class="card-title mb-0 flex-grow-1"></h5>
                    <div class="flex-shrink-0">
                        <div class="d-flex flex-wrap gap-2">
                            <button id="btnShowModal" class="btn btn-danger add-btn" data-bs-toggle="modal" data-bs-target="#uploadModal"><i class="ri-upload-2-line align-bottom me-1"></i> 上傳</button>
                            <button class="btn btn-soft-danger" id="remove-actions" onClick="deleteMultiple()"><i class="ri-delete-bin-2-line"></i></button>
                        </div>
                    </div>
                </div>
            </div>
            <div class="card-body border border-dashed border-end-0 border-start-0">
                <form>
                    @* *** 篩選條件 *@
                    <div class="row g-3">
                        <div class="col-xxl-3 col-sm-12">
                            <div class="search-box">
                                <input type="text"
                                       id="globalSearchInput"
                                       class="form-control search bg-light border-light"
                                       placeholder="搜尋表格內容">
                                <i class="ri-search-line search-icon"></i>
                            </div>
                        </div>
                        <div class="col-xxl-2 col-sm-12">
                            <input type="text" class="form-control bg-light border-light" placeholder="請輸入關鍵字" id="Keyword" name="Keyword">
                        </div>
                        <!--end col-->
                        <div class="col-xxl-1 col-sm-4">
                            <button type="button" class="btn btn-primary w-100" onclick="SearchData();">
                                <i class="ri-equalizer-fill me-1 align-bottom"></i>
                                篩選
                            </button>
                        </div>
                        <!--end col-->
                    </div>
                    <!--end row-->
                </form>
            </div>
            <!--end card-body-->
            <div class="card-body">
                <div class="table-responsive table-card mb-4">
                    <table class="table align-middle mb-0" id="dataTable">
                        <thead>
                            <tr>
                                <th scope="col" style="width: 40px;">
                                    <div class="form-check">
                                        <input class="form-check-input" type="checkbox" id="checkAll" value="option">
                                    </div>
                                </th>
                                @* *** 顯示欄位 *@
                                <th data-sort="action">Action</th>@* 功能名稱 *@
                                <th data-sort="No">項次</th>
                                <th class="sort" data-sort="FileName">檔案名稱</th>
                                <th class="sort" data-sort="FileSummary" style="width: 600px;">內容摘要</th>
                                <th class="sort" data-sort="UpdatedAt">更新時間</th>
                                <th>更新人員</th>
                            </tr>
                        </thead>
                        <tbody class="list form-check-all" id="data-list-data">
                            <tr>
                                <th scope="row">
                                    <div class="form-check">
                                        <input class="form-check-input" type="checkbox" name="checkAll" value="option1">
                                    </div>
                                </th>
                            </tr>
                        </tbody>
                    </table>
                    <div class="noresult" style="display: none">
                        <div class="text-center">
                            <lord-icon src="@Url.Content("~/assets/json/lord-icon/msoeawqm.json")" trigger="loop" colors="primary:#121331,secondary:#08a88a" style="width:75px;height:75px"></lord-icon>
                            <h5 class="mt-2">查無資料</h5>
                            @* <p class="text-muted mb-0">We've searched more than 150+ Datas We did not find any Datas for you search.</p> *@
                        </div>
                    </div>
                </div>
                <div class="d-flex justify-content-end mt-2">
                    <div class="pagination-wrap hstack gap-2">
                        <a class="page-item pagination-prev disabled" href="#">
                            上一頁
                        </a>
                        <ul class="pagination listjs-pagination mb-0"></ul>
                        <a class="page-item pagination-next" href="#">
                            下一頁
                        </a>
                    </div>
                </div>

                <!-- Modal -->
                <div class="modal fade flip" id="deleteOrder" tabindex="-1" aria-hidden="true">
                    <div class="modal-dialog modal-dialog-centered">
                        <div class="modal-content">
                            <div class="modal-body p-5 text-center">
                                <lord-icon src="@Url.Content("~/assets/json/lord-icon/gsqxdxog.json")" trigger="loop" colors="primary:#405189,secondary:#f06548" style="width:90px;height:90px"></lord-icon>
                                <div class="mt-4 text-center">
                                    <h4>
                                        您確定要刪除此項目嗎？
                                    </h4>

                                    <div class="hstack gap-2 justify-content-center remove">
                                        <button class="btn btn-link link-success fw-medium text-decoration-none" id="deleteRecord-close" data-bs-dismiss="modal">
                                            <i class="ri-close-line me-1 align-middle"></i>
                                            關閉
                                        </button>
                                        <button class="btn btn-danger" id="delete-record">是的，刪除它！</button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <!--end modal -->
            </div>
            <!--end card-body-->
        </div>
        <!--end card-->
    </div>
    <!--end col-->
</div>
<!--end row-->

<div class="modal fade zoomIn" id="uploadModal" tabindex="-1" aria-labelledby="uploadModalLabel" aria-hidden="true" data-bs-backdrop="static" data-bs-keyboard="false">
    <div class="modal-dialog modal-dialog-centered modal-xl modal-dialog-scrollable">
        <div class="modal-content border-0">
            <div class="modal-header p-3 bg-primary-subtle">
                <h5 class="modal-title">
                    <i class="ri-upload-2-line me-2"></i>上傳檔案
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body px-4 py-4">
                <!-- FilePond 上傳區 -->
                <div class="mb-2">
                    <label class="form-label fw-semibold">選取檔案（可多選）</label>
                    <input type="file" id="uploadFileInput" multiple accept="application/pdf" />
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-light" data-bs-dismiss="modal">取消</button>
                <button type="button" class="btn btn-primary" id="btnSaveUpload" disabled>
                    <i class="ri-save-line me-1"></i>儲存
                </button>
            </div>
        </div>
    </div>
</div>



<div class="modal fade zoomIn" id="showModal" tabindex="-1" aria-labelledby="showModalLabel" aria-hidden="true" ">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0">
                <div class="modal-header p-3 bg-info-subtle">
                    <h5 class="modal-title" id="showModalLabel">編輯</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <form id="editForm">
                    <div class="modal-body">
                        <div class="row g-3">
                            <div class="col-lg-12">
                                <label for="edit_FileName" class="form-label">檔案名稱</label>
                                <input type="text" id="edit_FileName" class="form-control" readonly />
                            </div>
                            <div class="col-lg-12">
                                <label for="edit_ContentSummary" class="form-label">內容摘要</label>
                                <textarea id="edit_ContentSummary" class="form-control" rows="8"></textarea>
                                <div class="mt-1">
                                    <small class="text-danger">※內容摘要空白時，AI 重新產生摘要</small>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <div class="hstack gap-2 justify-content-end">
                            <button type="submit" class="btn btn-success" id="edit-btn">確認</button>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
@section scripts {
    <script>
        // ⭐ 全域查詢狀態（完全由前端控制）
            let queryState = {
                pageIndex: 1,
                pageSize: 10,
                sortField: "FileName", //*** 頁面預設排序欄位，必須是TABLE內欄位
                sortOrder: "asc",

                //*** 篩選條件
                Keyword1: "",
                Keyword2: "",
                Status: "",
                StartDate: "",
                EndDate: "",
            };

            // ⭐ 主載入函式（分頁 / 搜尋 / 排序 都走這裡）
            function loadDatas() {
                showLoader();
                $.ajax({
                    url: '@(Configuration["BackendURL"])/api/HistoryFile/GetPageList',
                    type: 'GET',
                    data: queryState,
                    success: function (res) {
                    hideLoader();
                    if (!res.Success) {
                        Swal.fire({
                            icon: 'error',
                            title: res.Message,
                            confirmButtonText: '確定',
                        });
                        return;
                    };
                        renderTable(res.Data.Data);
                        renderPagination(res.Data.Total);
                        document.getElementById("remove-actions").style.display = 'none';
                    },
                    error: function () {
                        hideLoader();
                        Swal.fire({
                            icon: 'error',
                            title: '@config.GetMessage("System_Error").ToHtmlString()',
                            confirmButtonText: '確定',
                        });
                    }
                });
            }

            // ⭐ 表格渲染
            function renderTable(rows) {
                const tbody = $('#data-list-data');
                tbody.empty();

                if (!rows || rows.length === 0) {
                    $('.noresult').show();
                    return;
                }
                $('.noresult').hide();

                //*** 取得後端資料後產生tr
                rows.forEach(data => {
                    tbody.append(`
                        <tr data-id="${data.Id}">
                            <th scope="row">
                                <div class="form-check">
                                    <input class="form-check-input row-check" type="checkbox" data-id="${data.Id}" value=option1>
                                </div>
                            </th>
                            <td>
                                <div class="dropdown">
                                    <button class="btn btn-soft-secondary btn-sm dropdown" type="button" data-bs-toggle="dropdown">
                                        <i class="ri-more-fill align-middle"></i>
                                    </button>
                                    <ul class="dropdown-menu dropdown-menu-end">
                                    <li><a class="dropdown-item edit-item-btn" href="javascript:void(0)"><i class="ri-pencil-fill align-bottom me-2 text-muted"></i>編輯</a></li>
                                        <li><a class="dropdown-item remove-item-btn" data-bs-toggle="modal" href="#deleteOrder"><i class="ri-delete-bin-fill align-bottom me-2 text-muted"></i>刪除</a></li>
                                        <li><a class="dropdown-item download-item-btn"><i class="ri-download-line align-bottom me-2 text-muted"></i>下載</a></li>
                                    </ul>
                                </div>
                            </td>
                            <td class="No">${data.No}</td>
                            <td class="No">${data.FileName}</td>
                            <td class="No" style="max-width:300px;"><div title="${data.FileSummary}" style="display:-webkit-box; -webkit-line-clamp:5; -webkit-box-orient:vertical; overflow:hidden; text-overflow:ellipsis; word-break:break-word; white-space:pre-wrap;">${data.FileSummary}</div></td>
                            <td class="No">${data.UpdatedAtStr}</td>
                            <td class="No">${data.UpdatedByName}</td>
                        </tr>
                    `);
                });
                initDynamicDropdowns();
            }

            // ⭐ 分頁渲染
            function renderPagination(total) {
                const totalPages = Math.ceil(total / queryState.pageSize);
                const ul = $('.listjs-pagination');
                ul.empty();

                if (totalPages <= 1) return;

                const maxPages = 5;

                let startPage = Math.max(1, queryState.pageIndex- Math.floor(maxPages / 2));
                let endPage = startPage + maxPages - 1;

                if (endPage > totalPages) {
                    endPage = totalPages;
                    startPage = Math.max(1, endPage - maxPages + 1);
                }

                // ⭐ 前面有隱藏 → 第一頁 …
                if (startPage > 1) {
                    ul.append(`
                        <li class="page-item">
                            <a class="page-link" href="javascript:void(0)" onclick="gotoPage(1)">第一頁</a>
                        </li>
                    `);

                    ul.append(`
                        <li class="page-item disabled">
                            <span class="page-link">...</span>
                        </li>
                    `);
                }

                // ⭐ 中間連續頁碼（最多5頁）
                for (let i = startPage; i <= endPage; i++) {
                    ul.append(`
                        <li class="page-item ${i === queryState.pageIndex? 'active' : ''}">
                            <a class="page-link" href="javascript:void(0)" onclick="gotoPage(${i})">${i}</a>
                        </li>
                    `);
                }

                // ⭐ 後面有隱藏 → … 最後一頁
                if (endPage < totalPages) {
                    ul.append(`
                        <li class="page-item disabled">
                            <span class="page-link">...</span>
                        </li>
                    `);

                    ul.append(`
                        <li class="page-item">
                            <a class="page-link" href="javascript:void(0)" onclick="gotoPage(${totalPages})">最後一頁</a>
                        </li>
                    `);
                }

                // ⭐ 上一頁 / 下一頁狀態
                $('.pagination-prev').toggleClass('disabled', queryState.pageIndex=== 1);
                $('.pagination-next').toggleClass('disabled', queryState.pageIndex=== totalPages);

                // ⭐ 上一頁
                $('.pagination-prev').off('click').on('click', function (e) {
                    e.preventDefault();
                    if (queryState.pageIndex> 1) {
                        queryState.pageIndex--;
                        loadDatas();
                    }
                });

                // ⭐ 下一頁
                $('.pagination-next').off('click').on('click', function (e) {
                    e.preventDefault();
                    if (queryState.pageIndex< totalPages) {
                        queryState.pageIndex++;
                        loadDatas();
                    }
                });
            }

            function gotoPage(page) {
                queryState.pageIndex= page;
                loadDatas();
            }

            // ⭐ 搜尋 + 篩選
            function SearchData() {

                //*** 篩選條件
                queryState.Keyword = $('#Keyword').val();

                queryState.pageIndex= 1;
                $('#globalSearchInput').val('').trigger('input');
                loadDatas();
            }

            // ⭐ 點擊排序（完全用你原本的 class="sort"）
            $('.sort').on('click', function () {
                const field = $(this).data('sort');

                if (queryState.sortField === field) {
                    queryState.sortOrder = queryState.sortOrder === 'asc' ? 'desc' : 'asc';
                } else {
                    queryState.sortField = field;
                    queryState.sortOrder = 'asc';
                }

                loadDatas();
            });

            // ⭐ 狀態樣式（沿用你原邏輯）
            function getStatusBadge(status) {
                switch(String(status)) {
                    case '1': return 'bg-success-subtle text-success';
                    case '0': return 'bg-secondary-subtle text-secondary';
                    default: return 'bg-light text-dark';
                }
            }

            // 顯示 / 隱藏刪除區塊
            function toggleRemoveActions() {
                if($('.row-check:checked').length > 0)
                    $('#remove-actions').show();
                else
                    $('#remove-actions').hide();
            }

            // ⭐ 單筆勾選
            $(document).on('change', '.row-check', function () {

                const total = $('.row-check').length;
                const checked = $('.row-check:checked').length;

                // header checkbox 狀態同步
                $('#checkAll').prop('checked', total === checked);

                toggleRemoveActions();
            });

            // ⭐ 全選 / 取消全選
            $('#checkAll').on('change', function () {
                $('.row-check').prop('checked', this.checked);
                toggleRemoveActions();
            });

            // ⭐ 上傳 Modal 邏輯（FilePond）
            let pond = null;
            const _backendUrl = '@(Configuration["BackendURL"])';

            function initFilePond() {
                if (pond) return; // 已初始化就不重複
                FilePond.registerPlugin(FilePondPluginImagePreview, FilePondPluginFileValidateType);
                pond = FilePond.create(document.getElementById('uploadFileInput'), {
                    allowMultiple: true,
                    maxFiles: 50,
                    acceptedFileTypes: ['application/pdf'],
                    labelFileTypeNotAllowed: '只允許上傳 PDF 檔案',
                    fileValidateTypeLabelExpectedTypes: '請選擇 PDF 檔案',
                    chunkUploads: true,
                    chunkForce: true,
                    chunkSize: 5000000, // 5MB 每塊
                    labelIdle: '上傳檔案',
                    labelFileProcessing: '上傳中...',
                    labelFileProcessingComplete: '上傳完成',
                    labelFileProcessingAborted: '已取消',
                    labelFileProcessingError: '上傳失敗',
                    labelTapToCancel: '點擊取消',
                    labelTapToRetry: '點擊重試',
                    labelTapToUndo: '點擊移除',
                    labelButtonRemoveItem: '移除',
                    labelButtonAbortItemLoad: '中止',
                    labelButtonRetryItemLoad: '重試',
                    labelButtonAbortItemProcessing: '取消',
                    labelButtonUndoItemProcessing: '復原',
                    labelButtonRetryItemProcessing: '重試',
                    labelButtonProcessItem: '上傳',
                    instantUpload: true,
                    server: {
                        // 1. 初始化：取得 server 端的 transfer ID
                        process: {
                            url: _backendUrl + '/api/HistoryFile/Process',
                            method: 'POST',
                            onload: (response) => {
                                return response.responseText
                            },
                            onerror: (response) =>  {
                                return response
                            },
                            withCredentials:true
                        },
                        // 2. 分塊上傳：帶入 Upload-Name / Upload-Offset / Upload-Length header
                        patch: {
                            url: _backendUrl + '/api/HistoryFile/Patch?id=',
                            method: 'PATCH',
                            headers: this.headers,
                            onload: (response) => response,
                            onerror: (response) => response,
                             withCredentials:true
                        },
                        // 3. 取消上傳：將 upload ID 送往後端刪除暫存
                        revert: {
                            url: _backendUrl + '/api/HistoryFile/Revert',
                            method: 'DELETE',
                            onload: (response) => response,
                             withCredentials:true
                        },
                    },
                    onaddfile: updateSaveBtn,
                    onremovefile: updateSaveBtn,
                    onprocessfile: updateSaveBtn,
                    // 單一檔案上傳失敗
                    onprocessfileerror: function (error, file) {
                        updateSaveBtn();
                        Swal.fire({ icon: 'error', title: '上傳失敗：' + file.filename, confirmButtonText: '確認' });
                    },
                });
            }

            function updateSaveBtn() {
                const files = pond ? pond.getFiles() : [];
                const count = files.length;
                const allDone = count > 0 && files.every(f => f.status === 5 /* PROCESSING_COMPLETE */);
                $('#btnSaveUpload').prop('disabled', !allDone);
            }

            // Modal 開啟時初始化 FilePond 並清空
            $('#uploadModal').on('shown.bs.modal', function () {
                initFilePond();
                pond.removeFiles();
                updateSaveBtn();
            });

            // 儲存按鈕 — 收集已上傳的 uploadId，呼叫 Upload API
            $('#btnSaveUpload').on('click', function () {
                const uploadIdList = pond.getFiles()
                    .filter(f => f.status === 5 && f.serverId)
                    .map(f => f.serverId);

                if (uploadIdList.length === 0) {
                    Swal.fire({ icon: 'warning', title: '沒有可儲存的檔案', confirmButtonText: '確認' });
                    return;
                }
                showLoader();
                $('#btnSaveUpload').prop('disabled', true).html('<i class="ri-loader-4-line me-1"></i>儲存中...');

                $.ajax({
                    url: '@(Configuration["BackendURL"])/api/HistoryFile/Upload',
                    type: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify({ NewFileUploadIdList: uploadIdList }),
                    success: function (res) {
                        bootstrap.Modal.getOrCreateInstance(document.getElementById('uploadModal')).hide();
                        const icon = res.Success ? 'success' : 'warning';
                        Swal.fire({ icon: icon, title: res.Success?res.Data:res.Message, confirmButtonText: '確認' })
                            .then(() => loadDatas());
                    },
                    error: function () {
                        Swal.fire({ icon: 'error', title: '@config.GetMessage("System_Error").ToHtmlString()', confirmButtonText: '確認' });
                    },
                    complete: function () {
                        hideLoader();
                        $('#btnSaveUpload').prop('disabled', false).html('<i class="ri-save-line me-1"></i>儲存');
                    }
                });
            });

            // ⭐ 點擊下載按鈕
            $(document).on('click', '.download-item-btn', function () {
                const id = $(this).closest('tr').data('id');
                showLoader();
                fetch('@(Configuration["BackendURL"])/api/HistoryFile/Download/' + id, {
                    method: 'GET',
                    credentials: 'include'
                })
                .then(function (res) {
                    if (!res.ok) throw new Error('下載失敗');
                    const disposition = res.headers.get('Content-Disposition');
                    let fileName = 'download';
                    if (disposition) {
                        const match = disposition.match(/filename\*?=(?:UTF-8'')?["']?([^;"'\n]+)["']?/i);
                        if (match) fileName = decodeURIComponent(match[1]);
                    }
                    return res.blob().then(function (blob) {
                        return { blob, fileName };
                    });
                })
                .then(function ({ blob, fileName }) {
                    const url = URL.createObjectURL(blob);
                    const a = document.createElement('a');
                    a.href = url;
                    a.download = fileName;
                    document.body.appendChild(a);
                    a.click();
                    a.remove();
                    URL.revokeObjectURL(url);
                })
                .catch(function () {
                    Swal.fire({ icon: 'error', title: '@config.GetMessage("System_Error").ToHtmlString()', confirmButtonText: '確定' });
                })
                .finally(function () {
                    hideLoader();
                });
            });

            var currentDeleteId = null;

            // ⭐ 多筆刪除
            function deleteMultiple() {
                var ids_array = [];
                var items = document.querySelectorAll('.form-check [value=option1]');
                for (var i = 0; i < items.length; i++) {
                    if (items[i].checked == true) {
                        var trNode = items[i].parentNode.parentNode.parentNode;
                        var tdDataId = trNode.querySelector("th [data-id]");
                        var id = tdDataId.getAttribute("data-id");
                        ids_array.push(id);
                    }
                }
                if (typeof ids_array !== 'undefined' && ids_array.length > 0) {
                    Swal.fire({
                        title: "@(config.GetMessage("Are_you_sure").ToHtmlString())",
                        text: "@(config.GetMessage("You_wont_be_able_to_revert_this").ToHtmlString())",
                        icon: "warning",
                        showCancelButton: true,
                        customClass: {
                            confirmButton: "btn btn-primary w-xs me-2 mt-2",
                            cancelButton: "btn btn-danger w-xs mt-2"
                        },
                        confirmButtonText: "@(config.GetMessage("Yes_delete_it").ToHtmlString())",
                        cancelButtonText: "@(config.GetMessage("Cancel").ToHtmlString())",
                        buttonsStyling: false,
                        showCloseButton: true
                    }).then(function (result) {
                        if (result.value) {
                            showLoader();
                            $.ajax({
                                type: 'POST',
                                url: '@(Configuration["BackendURL"])/api/HistoryFile/Delete',
                                contentType: 'application/json',
                                data: JSON.stringify(ids_array),
                                success: function (response) {
                                    if (!response.Success) {
                                        Swal.fire({
                                            icon: 'warning',
                                            title: response.Message,
                                            confirmButtonText: '@(config.GetMessage("Confirm").ToHtmlString())',
                                        });
                                        return;
                                    }
                                    loadDatas();
                                    Swal.fire({
                                        title: '@(config.GetMessage("Deleted").ToHtmlString())',
                                        text: '@(config.GetMessage("Your_data_has_been_deleted").ToHtmlString())',
                                        icon: 'success',
                                        customClass: {
                                            confirmButton: "btn btn-info w-xs mt-2",
                                        },
                                        buttonsStyling: false
                                    });
                                },
                                error: function () {
                                    Swal.fire({
                                        icon: 'error',
                                        title: '@(config.GetMessage("System_Error").ToHtmlString())',
                                        confirmButtonText: '@(config.GetMessage("Confirm").ToHtmlString())',
                                    });
                                }
                            }).always(function () {
                                hideLoader();
                            });
                        }
                    });
                } else {
                    Swal.fire({
                        title: 'Please select at least one checkbox',
                        confirmButtonClass: 'btn btn-info',
                        buttonsStyling: false,
                        showCloseButton: true
                    });
                }
            }

            // ⭐ 單筆刪除按鈕
            $(document).on('click', '.remove-item-btn', function (e) {
                e.preventDefault();
                currentDeleteId = $(this).closest('tr').data('id');
            });

            // ⭐ 確認單筆刪除
            $('#delete-record').on('click', function () {
                if (!currentDeleteId) return;
                showLoader();

                $.ajax({
                    type: 'POST',
                    url: '@(Configuration["BackendURL"])/api/HistoryFile/Delete',
                    contentType: 'application/json',
                    data: JSON.stringify([currentDeleteId]),
                    success: function (res) {
                        bootstrap.Modal.getOrCreateInstance(document.getElementById('deleteOrder')).hide();
                        const icon = res.Success ? 'success' : 'warning';
                        Swal.fire({ icon: icon, title: res.Success ? '@(config.GetMessage("Deleted").ToHtmlString())' : res.Message, confirmButtonText: '@(config.GetMessage("Confirm").ToHtmlString())' })
                            .then(() => loadDatas());
                    },
                    error: function () {
                        bootstrap.Modal.getOrCreateInstance(document.getElementById('deleteOrder')).hide();
                        Swal.fire({ icon: 'error', title: '@(config.GetMessage("System_Error").ToHtmlString())', confirmButtonText: '@(config.GetMessage("Confirm").ToHtmlString())' });
                    },
                    complete: function () { hideLoader(); }
                });
            });

            var currentEditId = null;

            // ⭐ 點擊編輯按鈕
            $(document).on('click', '.edit-item-btn', function (e) {
                e.preventDefault();
                const $tr = $(this).closest('tr');
                currentEditId = $tr.data('id');
                if (!currentEditId) return;

                const $tds = $tr.find('td');
                const fileName = $tds.eq(2).text().trim();
                const fileSummary = $tds.eq(3).find('div').attr('title') || $tds.eq(3).text().trim();

                $('#edit_FileName').val(fileName);
                $('#edit_ContentSummary').val(fileSummary);

                bootstrap.Modal.getOrCreateInstance(document.getElementById('showModal')).show();
            });

            // ⭐ 編輯表單送出
            $('#editForm').on('submit', function (e) {
                e.preventDefault();
                if (!currentEditId) return;
                showLoader();

                $.ajax({
                    type: 'POST',
                    url: '@(Configuration["BackendURL"])/api/HistoryFile/Edit',
                    contentType: 'application/json',
                    data: JSON.stringify({ Id: currentEditId, FileSummary: $('#edit_ContentSummary').val() }),
                    success: function (res) {
                        bootstrap.Modal.getOrCreateInstance(document.getElementById('showModal')).hide();
                        const icon = res.Success ? 'success' : 'warning';
                        Swal.fire({ icon: icon, title: res.Success ? res.Data : res.Message, confirmButtonText: '確定' })
                            .then(() => loadDatas());
                    },
                    error: function () {
                        Swal.fire({ icon: 'error', title: '@config.GetMessage("System_Error").ToHtmlString()', confirmButtonText: '確定' });
                    },
                    complete: function () { hideLoader(); }
                });
            });

            // ⭐ 初始化
            $(document).ready(function () {
                loadDatas();

                $('#globalSearchInput').on('input', function () {
                    const keyword = $(this).val().toLowerCase();
                    $('#data-list-data tr').each(function () {
                        const rowText = $(this).text().toLowerCase();
                        $(this).toggle(rowText.includes(keyword));
                    });
                });

                var CodeType='';

                //func尾
            });

    </script>
    <script src="@Url.Content("~/assets/libs/filepond-plugin-image-preview/filepond-plugin-image-preview.min.js")"></script>
    <script src="@Url.Content("~/assets/libs/filepond-plugin-file-validate-type/filepond-plugin-file-validate-type.min.js")"></script>
    <script src="@Url.Content("~/assets/libs/filepond/filepond.min.js")"></script>
}