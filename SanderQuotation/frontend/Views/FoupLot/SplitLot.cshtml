@{
    ViewBag.Title = "拆批";
    ViewBag.pTitle = "拆批";
    ViewBag.pageTitle = "EMS";
    var lotId = ViewBag.LotId as string ?? "LOT-DEMO-001";
}

<style>
    /* ── FOUP Container ─────────────────────────────────── */
    .foup-wrapper {
        display: flex;
        flex-direction: column;
        align-items: center;
    }

    .foup-body {
        width: 260px;
        border: 3px solid #6c757d;
        border-radius: 8px;
        background: #f8f9fa;
        padding: 6px;
        position: relative;
    }

    .foup-body::before {
        content: '';
        position: absolute;
        top: -14px;
        left: 50%;
        transform: translateX(-50%);
        width: 80px;
        height: 14px;
        background: #6c757d;
        border-radius: 4px 4px 0 0;
    }

    .foup-slot {
        display: flex;
        align-items: center;
        height: 26px;
        margin: 1px 0;
        border-radius: 4px;
        cursor: pointer;
        transition: all .15s;
        padding: 0 8px;
        font-size: 12px;
        font-weight: 500;
        user-select: none;
        border: 1px solid transparent;
    }

    .foup-slot .slot-no {
        width: 22px;
        color: #495057;
        font-size: 11px;
    }

    .foup-slot .slot-bar {
        flex: 1;
        height: 10px;
        border-radius: 3px;
        margin: 0 4px;
    }

    /* Slot states */
    .slot-empty {
        background: #e9ecef;
        border-color: #dee2e6;
    }

    .slot-empty .slot-bar {
        background: #ced4da;
    }

    .slot-occupied {
        background: #d1e7dd;
        border-color: #a3cfbb;
    }

    .slot-occupied .slot-bar {
        background: #198754;
    }

    .slot-occupied:hover {
        background: #b9e0cc;
        border-color: #198754;
    }

    .slot-selected {
        background: #fff3cd;
        border-color: #ffc107;
        box-shadow: 0 0 0 2px rgba(255, 193, 7, .3);
    }

    .slot-selected .slot-bar {
        background: #ffc107;
    }

    .slot-child {
        background: #cfe2ff;
        border-color: #9ec5fe;
        cursor: default;
    }

    .slot-child .slot-bar {
        background: #0d6efd;
    }

    /* ── Transfer button ─────────────────────────────────── */
    .transfer-btn {
        width: 56px;
        height: 56px;
        border-radius: 50%;
        font-size: 20px;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }

    .foup-label {
        font-size: 13px;
        font-weight: 600;
        color: #495057;
        margin-bottom: 10px;
        text-align: center;
    }

    .foup-bottom-label {
        font-size: 11px;
        color: #adb5bd;
        margin-top: 4px;
        text-align: center;
    }

    .slot-number-bottom {
        font-size: 12px;
        color: #6c757d;
        text-align: center;
        margin-top: 4px;
    }
</style>

<!-- Breadcrumb / back button -->
<div class="row mb-3">
    <div class="col-12">
        <a href="@Url.Action("Index", "FoupLot")" class="btn btn-sm btn-soft-secondary">
            <i class="ri-arrow-left-line me-1"></i>返回批次列表
        </a>
    </div>
</div>

<div class="row">
    <div class="col-lg-12">
        <div class="card">
            <div class="card-header border-0">
                <div class="d-flex align-items-center">
                    <h5 class="card-title mb-0 flex-grow-1">
                        拆批
                    </h5>
                </div>
            </div>
            <div class="card-body">
                <!-- Info row -->
                <div class="row g-3 mb-4">
                    <div class="col-md-3">
                        <label class="form-label fw-semibold">來源批號</label>
                        <input type="text" class="form-control" id="srcLotId" value="@lotId" readonly>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label fw-semibold">新子批號</label>
                        <input type="text" class="form-control" id="childLotId" value="@(lotId)-S1">
                    </div>
                </div>

                <div class="d-flex align-items-center justify-content-start gap-4 flex-wrap">

                    <!-- Parent FOUP -->
                    <div class="foup-wrapper">
                        <div class="foup-label">
                            <span id="parentLotLabel">@lotId</span><br>
                            <small class="text-muted">父 FOUP</small>
                        </div>
                        <div class="foup-body" id="parentFoup"></div>
                        <span class="badge bg-success-subtle text-success mt-2" id="parentCount" style="display:none;">0
                            片</span>
                            <span class="badge bg-warning-subtle text-warning ms-1" id="selectedCount"
                                  style="display:none;">0 已選</span>
                        </div>

                        <!-- Transfer button -->
                        <div class="d-flex flex-column align-items-center gap-3">
                            <button class="btn btn-warning transfer-btn" id="btnTransfer" title="移動已選晶圓至子批 FOUP">
                                <i class="ri-arrow-right-line"></i>
                            </button>
                            <button class="btn btn-soft-secondary btn-sm" id="btnUndo" title="復原上一步">
                                <i class="ri-arrow-go-back-line me-1"></i>復原
                            </button>
                            <button class="btn btn-soft-danger btn-sm" id="btnClear" title="清除選取">
                                <i class="ri-close-circle-line me-1"></i>清除選取
                            </button>
                        </div>

                        <!-- Child FOUP -->
                        <div class="foup-wrapper">
                            <div class="foup-label">
                                <span id="childLotLabel">新子批</span><br>
                                <small class="text-muted">子 FOUP</small>
                            </div>
                            <div class="foup-body" id="childFoup"></div>
                            <span class="badge bg-primary-subtle text-primary mt-2" id="childCount" style="display:none;">0
                                片</span>
                            </div>

                            <!-- 本次異動資訊 -->
                            <div class="border rounded p-3"
                                 style="background:#f8f9fa;width:280px;flex-shrink:0;align-self:flex-start;">
                                <h5 class="fw-semibold mb-3"><i class="ri-file-list-3-line me-1 text-warning"></i>本次異動資訊</h5>
                                <div class="mb-1 d-flex gap-2 align-items-center">
                                    <span class="text-muted" style="width:70px;">來源批號</span>
                                    <span class="fw-semibold fs-6" id="infoSrc">@lotId</span>
                                </div>
                                <div class="mb-1 d-flex gap-2 align-items-center">
                                    <span class="text-muted" style="width:70px;">子批號</span>
                                    <span class="fw-semibold fs-6" id="infoChild">@(lotId)-S1</span>
                                </div>
                                <div class="mb-3 d-flex gap-2 align-items-center">
                                    <span class="text-muted" style="width:70px;">移動片數</span>
                                    <span class="badge bg-primary-subtle text-primary" style="font-size:14px;" id="infoCount">0
                                        片</span>
                                    </div>
                                    <hr class="my-2">
                                    <div class="mb-2 fw-semibold fs-6">移入子批的 Wafer</div>
                                    <div id="waferTagList">
                                        <span class="text-muted" id="waferTagEmpty">尚未移動任何晶圓</span>
                                    </div>
                                </div>

                            </div>

                            <!-- Action buttons -->
                            <div class="d-flex justify-content-end gap-2 mt-4 border-top pt-3">
                                <a href="@Url.Action("Index", "FoupLot")" class="btn btn-light">取消</a>
                                <button class="btn btn-warning" id="btnConfirmSplit" disabled>
                                    <i class="ri-scissors-cut-line me-1"></i>確認拆批
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            @section scripts {
                <script>
                    (function () {
                        // ── Demo occupied slots (1-based, bottom to top) ──────────────────────────
                        const TOTAL_SLOTS = 25;
                        const LOT_PREFIX = 'W-DEMO-';
                        // parent lot has wafers in slots 1-20, each with a waferId
                        const parentSlots = Array.from({ length: TOTAL_SLOTS }, (_, i) => ({
                            slot: i + 1,
                            state: i < 20 ? 'occupied' : 'empty',
                            waferId: i < 20 ? LOT_PREFIX + String(i + 1).padStart(3, '0') : null
                        }));
                        // child starts empty
                        const childSlots = Array.from({ length: TOTAL_SLOTS }, (_, i) => ({
                            slot: i + 1,
                            state: 'empty',
                            waferId: null
                        }));

                        function renderFoup(containerId, slots) {
                            const container = document.getElementById(containerId);
                            container.innerHTML = '';
                            // render from slot 25 down to slot 1 so top = slot 25 visually
                            for (let i = TOTAL_SLOTS; i >= 1; i--) {
                                const s = slots[i - 1];
                                const div = document.createElement('div');
                                div.className = `foup-slot slot-${s.state}`;
                                div.dataset.slot = s.slot;
                                div.innerHTML = `
                                                                                                        <span class="slot-no">${String(s.slot).padStart(2, '0')}</span>
                                                                                                        <span class="slot-bar"></span>
                                                                                                    `;
                                if (containerId === 'parentFoup' && s.state === 'occupied') {
                                    div.addEventListener('click', () => toggleSelect(s.slot));
                                }
                                container.appendChild(div);
                            }
                            updateCounts();
                        }

                        function toggleSelect(slotNo) {
                            const s = parentSlots[slotNo - 1];
                            if (s.state === 'occupied') {
                                s.state = 'selected';
                            } else if (s.state === 'selected') {
                                s.state = 'occupied';
                            }
                            renderFoup('parentFoup', parentSlots);
                        }

                        function updateCounts() {
                            const occupied = parentSlots.filter(s => s.state === 'occupied').length;
                            const selected = parentSlots.filter(s => s.state === 'selected').length;
                            const childOcc = childSlots.filter(s => s.state === 'child').length;

                            document.getElementById('parentCount').textContent = `${occupied + selected} 片`;
                            document.getElementById('selectedCount').textContent = `${selected} 已選`;
                            document.getElementById('childCount').textContent = `${childOcc} 片`;
                            document.getElementById('btnConfirmSplit').disabled = childOcc === 0;
                            updateTransferPanel();
                        }

                        function updateTransferPanel() {
                            const movedSlots = childSlots.filter(s => s.state === 'child');
                            document.getElementById('infoChild').textContent = document.getElementById('childLotId').value || '新子批';
                            document.getElementById('infoCount').textContent = movedSlots.length + ' 片';
                            const tagList = document.getElementById('waferTagList');
                            if (movedSlots.length === 0) {
                                tagList.innerHTML = '<span class="text-muted" id="waferTagEmpty">尚未移動任何晶圓</span>';
                                return;
                            }
                            tagList.innerHTML =
                                '<table class="table table-sm table-bordered mb-0" style="font-size:13px;">'
                                + '<thead class="table-light"><tr><th style="width:60px">Slot</th><th>Wafer ID</th></tr></thead>'
                                + '<tbody>'
                                + movedSlots.map(s =>
                                    `<tr><td class="text-center fw-semibold">${String(s.slot).padStart(2, '0')}</td><td>${s.waferId}</td></tr>`
                                ).join('')
                                + '</tbody></table>';
                        }

                        // Transfer selected → child
                        document.getElementById('btnTransfer').addEventListener('click', () => {
                            let moved = 0;
                            parentSlots.forEach((s, i) => {
                                if (s.state === 'selected') {
                                    childSlots[i].waferId = s.waferId;
                                    s.state = 'empty';
                                    s.waferId = null;
                                    childSlots[i].state = 'child';
                                    moved++;
                                }
                            });
                            if (moved === 0) {
                                Swal.fire({ icon: 'info', title: '未選取晶圓', text: '請先點擊父 FOUP 中有片的槽位進行選取。', confirmButtonText: '確認' });
                                return;
                            }
                            renderFoup('parentFoup', parentSlots);
                            renderFoup('childFoup', childSlots);
                        });

                        // Undo: move child wafers back to parent
                        document.getElementById('btnUndo').addEventListener('click', () => {
                            childSlots.forEach((s, i) => {
                                if (s.state === 'child') {
                                    parentSlots[i].waferId = s.waferId;
                                    s.waferId = null;
                                    s.state = 'empty';
                                    parentSlots[i].state = 'occupied';
                                }
                            });
                            renderFoup('parentFoup', parentSlots);
                            renderFoup('childFoup', childSlots);
                        });

                        // Clear selection
                        document.getElementById('btnClear').addEventListener('click', () => {
                            parentSlots.forEach(s => { if (s.state === 'selected') s.state = 'occupied'; });
                            renderFoup('parentFoup', parentSlots);
                        });

                        // Update child lot label
                        document.getElementById('childLotId').addEventListener('input', function () {
                            document.getElementById('childLotLabel').textContent = this.value || '新子批';
                            document.getElementById('infoChild').textContent = this.value || '新子批';
                        });

                        // Confirm split
                        document.getElementById('btnConfirmSplit').addEventListener('click', () => {
                            const childId = document.getElementById('childLotId').value.trim();
                            const childCount = childSlots.filter(s => s.state === 'child').length;
                            if (!childId) {
                                Swal.fire({ icon: 'warning', title: '缺少子批號', text: '請輸入新子批號。', confirmButtonText: '確認' });
                                return;
                            }
                            Swal.fire({
                                icon: 'success',
                                title: '拆批已送出（Demo）',
                                html: `已將 <b>${childCount}</b> 片移至子批 <b>${childId}</b>。<br><small class="text-muted">此為 Demo，未呼叫後端。</small>`,
                                confirmButtonText: '返回列表'
                            }).then(() => { window.location.href = '@Url.Action("Index", "FoupLot")'; });
                        });

                        // Initial render
                        renderFoup('parentFoup', parentSlots);
                        renderFoup('childFoup', childSlots);
                        document.getElementById('childLotLabel').textContent = document.getElementById('childLotId').value || '新子批';
                    })();
                </script>
            }
