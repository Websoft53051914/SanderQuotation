@{
    ViewBag.Title = (config.GetMessage("Change_Pin_Code").ToHtmlString());
    Layout = null;
}

<!doctype html>
<html lang="en" data-layout="vertical" data-topbar="light" data-sidebar="ladylip" data-sidebar-size="lg">
<head>
    @Html.Partial("~/Views/Shared/_title_meta.cshtml")
    @Html.Partial("~/Views/Shared/_head_css.cshtml")

    <link href="~/assets/libs/sweetalert2/sweetalert2.min.css" rel="stylesheet" type="text/css" />


    <script src="/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/assets/libs/sweetalert2/sweetalert2.min.js"></script>

</head>
<body >

    <div class="auth-page-wrapper pt-5">
        <!-- auth page bg -->
        <div class="auth-one-bg-position auth-one-bg" id="auth-particles">
            <div></div>
             <div class="bg-overlay"></div> 

             <div class="shape">
                <svg xmlns="http://www.w3.org/2000/svg" version="1.1" xmlns:xlink="http://www.w3.org/1999/xlink" viewBox="0 0 1440 120">
                    <path d="M 0,36 C 144,53.6 432,123.2 720,124 C 1008,124.8 1296,56.8 1440,40L1440 140L0 140z"></path>
                </svg>
            </div> 
        </div>

        <!-- auth page content -->
        <div class="auth-page-content">
            <div class="container">
                <div class="row">
                    <div class="col-lg-12">
                        <div class="text-center mt-sm-5 mb-4 text-white-50">
                            <div>
                                <img src="~/assets/images/logo.svg" alt="" style="filter: brightness(0) invert(1);">
                                @* <img src="~/assets/images/logo-light.png" alt="" height="20"> *@
                  @*               <a href="@Url.Action("Index", "Dashboard")" class="d-inline-block auth-logo">
                                </a> *@
                            </div>
                            @* <p class="mt-3 fs-15 fw-medium">Premium Admin & Dashboard Template</p> *@
                        </div>
                    </div>
                </div>
                <!-- end row -->

                <div class="row justify-content-center">
                    <div class="col-md-8 col-lg-6 col-xl-5">
                        <div class="card mt-4 card-bg-fill">

                            <div class="card-body p-4">
                                <div class="text-center mt-2">
                                    <h5 class="text-primary">@(config.GetMessage("Change_Pin_Code").ToHtmlString())</h5>
                                    @* <p class="text-muted">你的新Pin Code必須與之前使用的Pin Code不同。</p> *@
                                </div>

                                <div class="p-2">
                                    <form action="@Url.Action("PasswordChange", "Home")">
                                        <div class="mb-3">
                                            <label class="form-label" for="confirm-password-input">@(config.GetMessage("Current_Pin_Code").ToHtmlString())</label>
                                            <div class="position-relative auth-pass-inputgroup mb-3">
                                                <input type="password" class="form-control pe-5 password-input" onpaste="return false" id="old-password-input" aria-describedby="passwordInput" pattern="[0-9]{4}" required maxlength="4">
                                                <button class="btn btn-link position-absolute end-0 top-0 text-decoration-none text-muted password-addon material-shadow-none" type="button" id="password-addon-old">
                                                    <i class="ri-eye-fill align-middle"></i>
                                                </button>
                                            </div>
                                        </div>

                                        <div class="mb-3">
                                            <label class="form-label" for="password-input">@(config.GetMessage("New_Pin_Code").ToHtmlString())</label>
                                            <div class="position-relative auth-pass-inputgroup">
                                                <input type="password" class="form-control pe-5 password-input" onpaste="return false" id="password-input" aria-describedby="passwordInput" pattern="[0-9]{4}" required maxlength="4">
                                                <button class="btn btn-link position-absolute end-0 top-0 text-decoration-none text-muted password-addon material-shadow-none" type="button" id="password-addon">
                                                    <i class="ri-eye-fill align-middle"></i>
                                                </button>
                                            </div>
                                        </div>
                                        <div class="mb-3">
                                            <label class="form-label" for="confirm-password-input">@(config.GetMessage("Confirm_New_Pin_Code").ToHtmlString())</label>
                                            <div class="position-relative auth-pass-inputgroup mb-3">
                                                <input type="password" class="form-control pe-5 password-input" onpaste="return false" pattern="[0-9]{4}" id="confirm-password-input" required maxlength="4">
                                                <button class="btn btn-link position-absolute end-0 top-0 text-decoration-none text-muted password-addon material-shadow-none" type="button" id="confirm-password-input"><i class="ri-eye-fill align-middle"></i></button>
                                            </div>
                                        </div>
                                        <div class="mt-4">
                                            <button class="btn btn-success w-100" type="button" id="btnChangePinCode">@(config.GetMessage("Reset_Pin_Code").ToHtmlString())</button>
                                        </div>

                                    </form>
                                </div>
                            </div>
                            <!-- end card body -->
                        </div>
                        <!-- end card -->

@*                         <div class="mt-4 text-center">
                            <p class="mb-0">Wait, I remember my password... <a href="@Url.Action("SignInBasic", "Authentication")" class="fw-semibold text-primary text-decoration-underline"> Click here </a> </p>
                        </div> *@

                    </div>
                </div>
                <!-- end row -->
            </div>
            <!-- end container -->
        </div>
        <!-- end auth page content -->
        <!-- footer -->
        <footer class="footer">
            <div class="container">
                <div class="row">
                    <div class="col-lg-12">
@*                         <div class="text-center">
                            <p class="mb-0 text-muted">&copy;
                            <script>document.write(new Date().getFullYear())</script> frontend. Crafted with <i class="mdi mdi-heart text-danger"></i> by Themesbrand</p>
                        </div> *@
                    </div>
                </div>
            </div>
        </footer>
        <!-- end Footer -->
    </div>
    <!-- end auth-page-wrapper -->

    @Html.Partial("~/Views/Shared/_vendor_scripts.cshtml")

    <!-- particles js -->
    <script src="~/assets/libs/particles.js/particles.js"></script>

    <!-- particles app js -->
    <script src="~/assets/js/pages/particles.app.js"></script>

    <!-- password-addon init -->
    <script src="~/assets/js/pages/passowrd-create.init.js"></script>
    <script>
        if (document.getElementById("btnChangePinCode"))
            document.getElementById("btnChangePinCode").addEventListener("click", function (e) {
                 
                var oldPINCode=$('#old-password-input').val();
                var newPINCode=$('#password-input').val();
                var confirmPINCode=$('#confirm-password-input').val();

                $.ajax({
                    url: '@(config.GetBackendUrl() + "/api" + Url.Action("PINCodeDoUpdate", "Auth"))',
                    xhrFields: {
                        withCredentials: true   // 🔴 沒這行，Cookie 不會存
                    },
                    type: 'POST',
                    contentType: 'application/json', // ⭐ 必須
                    data: JSON.stringify({                              
                        OldPINCode : oldPINCode,
                        NewPINCode : newPINCode,
                        ConfirmPINCode : confirmPINCode,
                    }),
                    success: function (res) {
                        var msg = res.Success ? res.Data : res.Message;
                        var alertType = res.Success ? "success" : "error";
                        if(res.Success){
                            Swal.fire({
                                title: msg,
                                icon: alertType,
                                confirmButtonText: '@(config.GetMessage("Confirm").ToHtmlString())',
                            }).then((result) => {
                                location.href = '@Url.Action("Index", "Home")';
                            });
                        }
                        else{
                            Swal.fire({
                                title: msg,
                                icon: alertType,
                                confirmButtonText: '@(config.GetMessage("Confirm").ToHtmlString())',
                            }).then((result) => {

                            });
                        }
                    },
                    error: function (xhr) {
                        console.log(xhr.responseText);
                    }
                });
            });

    </script>
</body>
</html>