@{
    ViewBag.Title = (config.GetMessage("Lock_Screen").ToHtmlString());
    Layout = null;
    var name = ViewData["name"] as string;
    var acc = ViewData["acc"] as string;
}

<!doctype html>
<html lang="en" data-layout="vertical" data-topbar="light" data-sidebar="ladylip" data-sidebar-size="lg">

<head>
    @Html.Partial("~/Views/Shared/_title_meta.cshtml")
    @Html.Partial("~/Views/Shared/_head_css.cshtml")
</head>
<body >

    <div class="auth-page-wrapper pt-5">
        <!-- auth page bg -->
        <div class="auth-one-bg-position auth-one-bg" id="auth-particles">
            <div></div>
             <div class="bg-overlay"></div> 

             <div class="shape">
                <svg xmlns="http://www.w3.org/2000/svg" version="1.1" xmlns:xlink="http://www.w3.org/1999/xlink" viewBox="0 0 1440 120">
                    <path d="M 0,36 C 144,53.6 432,123.2 720,124 C 1008,124.8 1296,56.8 1440,40L1440 140L0 140z"></path>
                </svg>
            </div> 
        </div>

        <!-- auth page content -->
        <div class="auth-page-content">
            <div class="container">
                <div class="row">
                    <div class="col-lg-12">
                        <div class="text-center mt-sm-5 mb-4 text-white-50">
                            <div>
                                <img src="~/assets/images/logo.svg" alt="" style="filter: brightness(0) invert(1);">
                                @* <img src="~/assets/images/logo-light.png" alt="" height="20"> *@
@*                                 <a href="@Url.Action("Index", "Dashboard")" class="d-inline-block auth-logo">
                                </a> *@
                            </div>
                            @* <p class="mt-3 fs-16 fw-semibold">Premium Admin & Dashboard Template</p> *@
                        </div>
                    </div>
                </div>
                <!-- end row -->

                <div class="row justify-content-center">
                    <div class="col-md-8 col-lg-6 col-xl-5">
                        <div class="card mt-4  card-bg-fill">

                            <div class="card-body p-4">
                                <div class="text-center mt-2">
                                    <h5 class="text-primary">@(config.GetMessage("Lock_Screen").ToHtmlString())</h5>
                                    <p class="text-muted">@(config.GetMessage("Please_enter_your_password_to_unlock_the_screen").ToHtmlString())</p>
                                </div>
                                <div class="user-thumb text-center">
                                    <img src="~/assets/images/users/user-dummy-img.jpg" class="rounded-circle img-thumbnail avatar-lg material-shadow" alt="thumbnail">
                                    <h5 class="font-size-15 mt-3">@(acc) @(name)</h5>
                                </div>
                                <div class="p-2 mt-4">
                                    <form>
                                        <div class="mb-3">
                                            <label class="form-label" for="userpassword">@(config.GetMessage("Password").ToHtmlString())</label>
                                            <input type="password" class="form-control" id="userpassword" placeholder="@(config.GetMessage("Please_enter_your_password").ToHtmlString())" required>
                                        </div>
                                        <div class="mb-2 mt-4">
                                            <button class="btn btn-success w-100" type="submit">@(config.GetMessage("Unlock").ToHtmlString())</button>
                                        </div>
                                    </form><!-- end form -->

                                </div>
                            </div>
                            <!-- end card body -->
                        </div>
                        <!-- end card -->

                        <div class="mt-4 text-center">
                            <p class="mb-0">
                                <a href="@Url.Action("Index", "Login")" class="fw-semibold text-primary text-decoration-underline">
                                    @(config.GetMessage("Not_you_Back_to_login").ToHtmlString())
                                </a>
                            </p>
                        </div>

                    </div>
                </div>
                <!-- end row -->
            </div>
            <!-- end container -->
        </div>
        <!-- end auth page content -->
        <!-- footer -->
        <footer class="footer galaxy-border-none">
            <div class="container">
                <div class="row">
                    <div class="col-lg-12">
@*                         <div class="text-center">
                            <p class="mb-0 text-muted">&copy;
                            <script>document.write(new Date().getFullYear())</script> frontend. Crafted with <i class="mdi mdi-heart text-danger"></i> by Themesbrand</p>
                        </div> *@
                    </div>
                </div>
            </div>
        </footer>
        <!-- end Footer -->
    </div>
    <!-- end auth-page-wrapper -->

    @Html.Partial("~/Views/Shared/_vendor_scripts.cshtml")

    <!-- particles js -->
    <script src="~/assets/libs/particles.js/particles.js"></script>
    <!-- particles app js -->
    <script src="~/assets/js/pages/particles.app.js"></script>

</body>
</html>