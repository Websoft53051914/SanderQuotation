@using ViewModel.ImportTransferExcel
@{
    ViewBag.Title = "轉入檔案上傳";
    ViewBag.pTitle = "轉入檔案上傳";
    ViewBag.pageTitle = "採購管理";
}

<div class="row">
    <div class="col-lg-12">
        <div class="card" id="importFileListCard">
            <div class="card-header border-0">
                <div class="d-flex align-items-center">
                    <h5 class="card-title mb-0 flex-grow-1"></h5>
                    <div class="flex-shrink-0">
                        <button id="btnBatchDelete" class="btn btn-soft-danger me-1" type="button" style="display:none;">
                            <i class="ri-delete-bin-2-line"></i>
                        </button>
                        <button id="btnUpload" class="btn btn-primary add-btn" type="button">
                            <i class="ri-upload-2-line align-bottom me-1"></i>上傳
                        </button>
                    </div>
                </div>
            </div>

            <div class="card-body border border-dashed border-end-0 border-start-0">
                <form>
                    <div class="row g-3">
                        <div class="col-xxl-3 col-sm-12">
                            <div class="search-box">
                                <input type="text" id="globalSearchInput"
                                       class="form-control search bg-light border-light" placeholder="搜尋表格內容">
                                <i class="ri-search-line search-icon"></i>
                            </div>
                        </div>
                        <div class="col-xxl-3 col-sm-12">
                            <div class="search-box">
                                <input type="text" id="keywordInput"
                                       class="form-control search bg-light border-light" placeholder="搜尋關鍵字">
                                <i class="ri-search-line search-icon"></i>
                            </div>
                        </div>
                        <div class="col-xxl-1 col-sm-4">
                            <button type="button" class="btn btn-primary w-100" onclick="loadList()">
                                <i class="ri-equalizer-fill me-1 align-bottom"></i>篩選
                            </button>
                        </div>
                    </div>
                </form>
            </div>

            <div class="card-body">
                <div class="table-responsive table-card mb-4">
                    <table class="table align-middle table-nowrap mb-0" id="dataTable">
                        <thead>
                            <tr>
                                <th style="width:40px;"><div class="form-check"><input class="form-check-input" type="checkbox" id="checkAll"></div></th>
                                <th style="width:110px;">Action</th>
                                <th style="width:40px;">項次</th>
                                <th style="min-width:200px;">檔案名稱</th>
                                <th style="min-width:130px;">匯入設定規則</th>
                                <th style="min-width:120px;">客戶名稱</th>
                                <th style="min-width:130px;">產品料號</th>
                                <th style="width:80px;">客戶別</th>
                                <th style="width:90px;">採購數量</th>
                                <th style="width:100px;">狀態</th>
                                <th style="width:120px;">建立日期</th>
                                <th style="width:120px;">最後更新</th>
                            </tr>
                        </thead>
                        <tbody id="import-file-list-data"></tbody>
                    </table>
                    <div class="noresult" style="display:none;">
                        <div class="text-center">
                            <lord-icon src="https://cdn.lordicon.com/msoeawqm.json" trigger="loop"
                                       colors="primary:#121331,secondary:#08a88a"
                                       style="width:75px;height:75px"></lord-icon>
                            <h5 class="mt-2">查無資料</h5>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- ═══ Modal：刪除確認 ═══ -->
<div class="modal fade flip" id="deleteModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-body p-5 text-center">
                <lord-icon src="https://cdn.lordicon.com/gsqxdxog.json" trigger="loop"
                           colors="primary:#405189,secondary:#f06548"
                           style="width:90px;height:90px"></lord-icon>
                <div class="mt-4 text-center">
                    <h4>確定要刪除此筆資料？</h4>
                    <p class="text-muted"><small>刪除後將無法復原。</small></p>
                    <div class="hstack gap-2 justify-content-center">
                        <button class="btn btn-link link-success fw-medium text-decoration-none"
                                data-bs-dismiss="modal">
                            <i class="ri-close-line me-1 align-middle"></i>取消
                        </button>
                        <button class="btn btn-danger" id="btnConfirmDelete">確定刪除</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- ═══ Modal：上傳檔案 ═══ -->
<div class="modal fade" id="uploadModal" tabindex="-1" aria-hidden="true" data-bs-backdrop="static">
    <div class="modal-dialog modal-dialog-centered modal-xl modal-dialog-scrollable">
        <div class="modal-content border-0">
            <div class="modal-header p-3 bg-primary-subtle">
                <h5 class="modal-title">
                    <i class="ri-upload-2-line me-2"></i>上傳檔案
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">

                <!-- 檔案選取區 -->
                <div class="mb-3">
                    <label class="form-label fw-semibold">選取檔案（可多選）</label>
                    <input type="file" id="bomFileInput" class="form-control"
                           multiple accept=".xlsx,.xls" />
                    <div class="form-text text-muted">
                        支援格式：xlsx、xls；可一次選取多個檔案。
                    </div>
                </div>

                <!-- 設定表格（選取檔案後顯示） -->
                <div id="uploadConfigSection" style="display:none;">
                    <hr class="my-3" />
                    <h6 class="mb-3 fw-semibold">
                        <i class="ri-settings-3-line me-1"></i>設定匯入參數
                    </h6>
                    <div class="table-responsive">
                        <table class="table table-bordered table-sm align-middle" id="uploadConfigTable">
                            <thead class="table-light">
                                <tr>
                                    <th style="min-width:200px;">檔案名稱</th>
                                    <th style="min-width:160px;" class="required">匯入設定規則</th>
                                    <th style="min-width:160px;" class="required">客戶名稱</th>
                                    <th style="min-width:140px;">產品料號</th>
                                    <th style="min-width:130px;" class="required">客戶別</th>
                                    <th style="min-width:110px;">採購數量</th>
                                </tr>
                            </thead>
                            <tbody id="uploadConfigBody"></tbody>
                        </table>
                    </div>
                </div>

            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-light" data-bs-dismiss="modal">取消</button>
                <button type="button" class="btn btn-primary" id="btnSaveUpload" disabled>
                    <i class="ri-save-line me-1"></i>儲存
                </button>
            </div>
        </div>
    </div>
</div>

<!-- ═══ Modal：編輯 ═══ -->
<div class="modal fade" id="editModal" tabindex="-1" aria-hidden="true" data-bs-backdrop="static">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0">
            <div class="modal-header p-3 bg-info-subtle">
                <h5 class="modal-title">
                    <i class="ri-pencil-line me-2"></i>編輯
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form id="editForm" class="needs-validation" novalidate>
                <div class="modal-body">
                    <input type="hidden" id="ef_Id" />
                    <div class="row g-3">
                        <div class="col-12">
                            <label class="col-form-label pt-0">檔案名稱</label>
                            <input type="text" id="ef_BomFileName" class="form-control" readonly />
                        </div>
                        <div class="col-12">
                            <label class="col-form-label pt-0 required">客戶名稱</label>
                            <select id="ef_CustomerName" class="form-select" required></select>
                            <div class="invalid-feedback">請選擇客戶名稱。</div>
                        </div>
                        <div class="col-12">
                            <label class="col-form-label pt-0">產品料號</label>
                            <input type="text" id="ef_ProductNo" class="form-control" maxlength="100" />
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-light" data-bs-dismiss="modal">取消</button>
                    <button type="submit" class="btn btn-primary" id="btnConfirmEdit">
                        <i class="ri-save-line me-1"></i>確認
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section scripts {
    <script>
        $(document).ready(function () {
            var pTitle    = '@(Html.Raw(ViewBag.pTitle))';
            var pageTitle = '@(Html.Raw(ViewBag.pageTitle))';
            $('#header-pTitle').text(pTitle);
            var bElList = [];
            if (pageTitle) bElList.push('<li class="breadcrumb-item"><a href="javascript: void(0);">' + pageTitle + '</a></li>');
            bElList.push('<li class="breadcrumb-item active">' + pTitle + '</li>');
            $('#_page_title_row .breadcrumb').html(bElList.join(''));

            loadOptionData();
            loadList();
        });

        // ── API URL ────────────────────────────────────────────────────────────
        var apiUrls = {
            GetList:       '@(Configuration["BackendURL"])/api/ImportTransferExcel/GetList',
            GetOptionData: '@(Configuration["BackendURL"])/api/ImportTransferExcel/GetOptionData',
            SaveEdit:      '@(Configuration["BackendURL"])/api/ImportTransferExcel/SaveEdit',
            Delete:        '@(Configuration["BackendURL"])/api/ImportTransferExcel/Delete',
            BatchDelete:   '@(Configuration["BackendURL"])/api/ImportTransferExcel/BatchDelete',
        };

        // ── 欄位名稱（nameof 強型別） ──────────────────────────────────────────
        var FG = {
            Id:             '@nameof(ImportTransferExcelGridVM.Id)',
            BomFileName:    '@nameof(ImportTransferExcelGridVM.BomFileName)',
            ImportRuleName: '@nameof(ImportTransferExcelGridVM.ImportRuleName)',
            CustomerName:   '@nameof(ImportTransferExcelGridVM.CustomerName)',
            ProductNo:      '@nameof(ImportTransferExcelGridVM.ProductNo)',
            CustomerType:   '@nameof(ImportTransferExcelGridVM.CustomerType)',
            PurchaseQty:    '@nameof(ImportTransferExcelGridVM.PurchaseQty)',
            StatusCode:     '@nameof(ImportTransferExcelGridVM.StatusCode)',
            Status:         '@nameof(ImportTransferExcelGridVM.Status)',
            CreateTime:     '@nameof(ImportTransferExcelGridVM.CreateTime)',
            UpdateTime:     '@nameof(ImportTransferExcelGridVM.UpdateTime)',
        };

        // ── 狀態對應設定 ───────────────────────────────────────────────────────
        var statusConfig = {
            0: { text: '未轉檔', cls: 'badge bg-secondary-subtle text-secondary' },
            1: { text: '已轉檔', cls: 'badge bg-info-subtle text-info' },
            2: { text: '未查料', cls: 'badge bg-warning-subtle text-warning' },
            3: { text: '已查料', cls: 'badge bg-primary-subtle text-primary' },
            4: { text: '已查價', cls: 'badge bg-success-subtle text-success' },
        };

        // ── 客戶別對應設定 ─────────────────────────────────────────────────────
        var customerTypeConfig = {
            'MM':  'bg-primary-subtle text-primary',
            'D3':  'bg-info-subtle text-info',
            'STL': 'bg-success-subtle text-success',
            'CTB': 'bg-warning-subtle text-warning',
            'WT':  'bg-danger-subtle text-danger',
            'AED': 'bg-secondary-subtle text-secondary',
            'EDS': 'bg-dark-subtle text-dark',
        };

        // ── 選項快取 ───────────────────────────────────────────────────────────
        var optionData = { ImportRules: [], CustomerNames: [] };

        // ── 刪除用 ID ──────────────────────────────────────────────────────────
        var deleteId = 0;
        // ── 橋接 _CrudCommonScripts ───────────────────────────────────────────
        function loadDatas() { loadList(); }

        // ── DOM ──────────────────────────────────────────────────────────────
        var dom = {
            listBody: $('#import-file-list-data'),
            noresult: $('.noresult'),
            deleteModal: $('#deleteModal'),
            btnConfirmDel: $('#btnConfirmDelete'),
        };
        // ── 工具函式 ───────────────────────────────────────────────────────────
        function escapeHtml(v) {
            return $('<div>').text(v ?? '').html();
        }

        function showSysError() {
            Swal.fire({ icon: 'error', title: pageConfig.messages.systemError, confirmButtonText: pageConfig.messages.confirm });
        }

        // ── 載入下拉選項 ───────────────────────────────────────────────────────
        function loadOptionData() {
            $.ajax({
                url: apiUrls.GetOptionData,
                type: 'GET',
                success: function (res) {
                    if (!res.Success) return;
                    optionData.ImportRules   = res.Data.ImportRules   || [];
                    optionData.CustomerNames = res.Data.CustomerNames || [];
                },
            });
        }

        // ── 清單載入 ───────────────────────────────────────────────────────────
        function loadList() {
            showLoader();
            $.ajax({
                url: apiUrls.GetList,
                type: 'GET',
                data: { keyword: $('#keywordInput').val().trim() },
                success: function (res) {
                    if (!res.Success) { showSysError(); return; }
                    var list = res.Data || [];
                    var globalKw = $('#globalSearchInput').val().trim().toLowerCase();
                    if (globalKw) {
                        list = list.filter(function (r) {
                            return [r[FG.BomFileName], r[FG.ImportRuleName], r[FG.CustomerName],
                                    r[FG.ProductNo], r[FG.CustomerType], r[FG.Status]]
                                .some(function (v) { return (v || '').toLowerCase().includes(globalKw); });
                        });
                    }
                    renderList(list);
                },
                error: function () { showSysError(); },
                complete: function () { hideLoader(); },
            });
        }

        /** 渲染清單 */
        function renderList(list) {
            var $tbody = $('#import-file-list-data');
            $tbody.empty();
            if (!list.length) {
                $('.noresult').show();
                return;
            }
            $('.noresult').hide();
            list.forEach(function (r, idx) {
                $tbody.append(buildRow(r, idx + 1));
            });
        }

        /** 建立單列 HTML */
        function buildRow(r, no) {
            var statusCode = r[FG.StatusCode] ?? 0;
            var sc = statusConfig[statusCode] || { text: r[FG.Status], cls: 'badge bg-secondary-subtle text-secondary' };
            var ctCls = customerTypeConfig[r[FG.CustomerType]] || 'bg-secondary-subtle text-secondary';

            return '<tr data-id="' + r[FG.Id] + '">'
                + '<td><div class="form-check"><input class="form-check-input row-check" type="checkbox" value="' + r[FG.Id] + '"></div></td>'
                + '<td>'
                    + '<div class="dropdown">'
                        + '<button class="btn btn-soft-secondary btn-sm" type="button"'
                        + ' data-bs-toggle="dropdown" aria-expanded="false">'
                            + '<i class="ri-more-fill align-middle"></i>'
                        + '</button>'
                        + '<ul class="dropdown-menu dropdown-menu-end">'
                            + '<li><a class="dropdown-item" href="javascript:void(0)"'
                            + ' onclick="openEditModal(' + r[FG.Id] + ', \'' + escapeHtml(r[FG.BomFileName]) + '\','
                            + ' \'' + escapeHtml(r[FG.CustomerName]) + '\', \'' + escapeHtml(r[FG.ProductNo]) + '\')">'
                                + '<i class="ri-pencil-fill align-bottom me-2 text-muted"></i>編輯'
                            + '</a></li>'
                            + '<li><a class="dropdown-item delete-btn text-danger" href="javascript:void(0)"'
                            + ' data-id="' + r[FG.Id] + '">'
                                + '<i class="ri-delete-bin-fill align-bottom me-2"></i>刪除'
                            + '</a></li>'
                        + '</ul>'
                    + '</div>'
                + '</td>'
                + '<td class="text-muted">' + no + '</td>'
                + '<td class="fw-semibold">' + escapeHtml(r[FG.BomFileName]) + '</td>'
                + '<td>' + escapeHtml(r[FG.ImportRuleName]) + '</td>'
                + '<td>' + escapeHtml(r[FG.CustomerName]) + '</td>'
                + '<td><code>' + escapeHtml(r[FG.ProductNo]) + '</code></td>'
                + '<td>' + escapeHtml(r[FG.CustomerType]) + '</td>'
                + '<td class="text-end">' + Number(r[FG.PurchaseQty]).toLocaleString() + '</td>'
                + '<td class="text-center"><span class="' + sc.cls + '">' + escapeHtml(sc.text) + '</span></td>'
                + '<td class="text-muted">' + escapeHtml(r[FG.CreateTime]) + '</td>'
                + '<td class="text-muted">' + escapeHtml(r[FG.UpdateTime]) + '</td>'
                + '</tr>';
        }

        // ── 刪除 ───────────────────────────────────────────────────────────────

        // ── checkAll ───
        $('#checkAll').on('change', function () {
            $('.row-check').prop('checked', $(this).is(':checked'));
            $('#btnBatchDelete').toggle($('.row-check:checked').length > 0);
        });
        $(document).on('change', '.row-check', function () {
            $('#btnBatchDelete').toggle($('.row-check:checked').length > 0);
            $('#checkAll').prop('checked', $('.row-check').length === $('.row-check:checked').length);
        });

        // ── 單筆刪除 ───
        $(document).on('click', '.delete-btn', function () {
            deleteId = parseInt($(this).data('id')) || 0;
            bootstrap.Modal.getOrCreateInstance(dom.deleteModal[0]).show();
        });

        dom.btnConfirmDel.on('click', function () {
            if (!deleteId) return;
            showLoader();
            $.ajax({
                url: apiUrls.Delete + '?id=' + deleteId,
                type: 'DELETE',
                success: function (res) {
                    bootstrap.Modal.getInstance(dom.deleteModal[0]).hide();
                    showResponseResultAlert(res, '刪除', function () { loadList(); });
                },
                error: function () { showSysError(); },
                complete: function () { hideLoader(); },
            });
        });

        // ── 批次刪除 ───
        $('#btnBatchDelete').on('click', function () {
            var ids = $('.row-check:checked').map(function () { return $(this).val(); }).get();
            if (!ids.length) return;
            Swal.fire({
                icon: 'warning',
                title: '確定要刪除 ' + ids.length + ' 筆資料？',
                text: '刪除後將無法復原。',
                showCancelButton: true,
                confirmButtonText: '確定刪除',
                cancelButtonText: '取消',
                confirmButtonColor: '#d33'
            }).then(function (result) {
                if (!result.isConfirmed) return;
                showLoader();
                $.ajax({
                    url: apiUrls.BatchDelete + '?ids=' + ids.join(','),
                    type: 'DELETE',
                    success: function (res) {
                        showResponseResultAlert(res, '刪除', function () {
                            $('#checkAll').prop('checked', false);
                            $('#btnBatchDelete').hide();
                            loadList();
                        });
                    },
                    error: function () { showSysError(); },
                    complete: function () { hideLoader(); },
                });
            });
        });

        // ── 上傳 Modal ─────────────────────────────────────────────────────────

        $('#btnUpload').on('click', function () {
            $('#bomFileInput').val('');
            $('#uploadConfigSection').hide();
            $('#uploadConfigBody').empty();
            $('#btnSaveUpload').prop('disabled', true);
            bootstrap.Modal.getOrCreateInstance(document.getElementById('uploadModal')).show();
        });

        $('#bomFileInput').on('change', function () {
            var files = this.files;
            if (!files || !files.length) {
                $('#uploadConfigSection').hide();
                $('#btnSaveUpload').prop('disabled', true);
                return;
            }

            var $tbody = $('#uploadConfigBody');
            $tbody.empty();

            for (var i = 0; i < files.length; i++) {
                $tbody.append(buildUploadConfigRow(files[i].name, i));
            }

            // 初始化每列的 select2
            $tbody.find('.up-import-rule').each(function () {
                initUploadSelect2($(this), optionData.ImportRules, '請選擇匯入設定規則');
            });
            $tbody.find('.up-customer-name').each(function () {
                initUploadSelect2($(this), optionData.CustomerNames, '請選擇客戶名稱');
            });
            $tbody.find('.up-customer-type').each(function () {
                initUploadSelect2($(this), ['MM', 'D3', 'STL', 'CTB', 'WT', 'AED', 'EDS'], '請選擇客戶別');
            });

            $('#uploadConfigSection').show();
            $('#btnSaveUpload').prop('disabled', false);
        });

        /** 建立上傳設定表格單列 */
        function buildUploadConfigRow(fileName, idx) {
            return '<tr>'
                + '<td class="small fw-semibold">' + escapeHtml(fileName) + '</td>'
                + '<td><select class="form-select form-select-sm up-import-rule" data-idx="' + idx + '" required></select></td>'
                + '<td><select class="form-select form-select-sm up-customer-name" data-idx="' + idx + '" required></select></td>'
                + '<td><input type="text" class="form-control form-control-sm up-product-no" data-idx="' + idx + '" maxlength="100" placeholder="產品料號" /></td>'
                + '<td><select class="form-select form-select-sm up-customer-type" data-idx="' + idx + '" required></select></td>'
                + '<td><input type="number" class="form-control form-control-sm up-purchase-qty" data-idx="' + idx + '" min="1" value="1" /></td>'
                + '</tr>';
        }

        /** 初始化上傳設定 select2 */
        function initUploadSelect2($sel, optList, placeholder) {
            var data = [{ id: '', text: placeholder }].concat(
                optList.map(function (v) { return { id: v, text: v }; })
            );
            $sel.select2({
                width: '100%',
                minimumResultsForSearch: -1,
                data: data,
                dropdownParent: $('#uploadModal'),
            });
        }

        $('#btnSaveUpload').on('click', function () {
            // 依規格：不儲存至 JSON，直接顯示成功訊息後關閉
            bootstrap.Modal.getInstance(document.getElementById('uploadModal')).hide();
            Swal.fire({ icon: 'success', title: '上傳成功', text: '檔案已加入匯入佇列。', confirmButtonText: '確定' })
                .then(function () { loadList(); });
        });

        // ── 編輯 Modal ─────────────────────────────────────────────────────────

        /** 開啟編輯 Modal */
        function openEditModal(id, bomFileName, customerName, productNo) {
            $('#editForm').removeClass('was-validated').trigger('reset');
            $('#ef_Id').val(id);
            $('#ef_BomFileName').val(bomFileName);
            $('#ef_ProductNo').val(productNo);

            // 初始化 / 更新 select2
            var $sel = $('#ef_CustomerName');
            if (!$sel.hasClass('select2-hidden-accessible')) {
                var nameData = [{ id: '', text: '請選擇客戶名稱' }].concat(
                    optionData.CustomerNames.map(function (v) { return { id: v, text: v }; })
                );
                $sel.select2({
                    width: '100%',
                    data: nameData,
                    dropdownParent: $('#editModal'),
                });
            }
            $sel.val(customerName).trigger('change');

            bootstrap.Modal.getOrCreateInstance(document.getElementById('editModal')).show();
        }

        $('#editForm').on('submit', function (e) {
            e.preventDefault();

            if (!this.checkValidity()) {
                $(this).addClass('was-validated');
                return;
            }

            var payload = {
                Id:           parseInt($('#ef_Id').val()) || 0,
                CustomerName: $('#ef_CustomerName').val() || '',
                ProductNo:    $('#ef_ProductNo').val().trim(),
            };

            showLoader();
            $.ajax({
                url: apiUrls.SaveEdit,
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify(payload),
                success: function (res) {
                    bootstrap.Modal.getInstance(document.getElementById('editModal')).hide();
                    if (!res.Success) {
                        Swal.fire({ icon: 'error', title: '儲存失敗', text: res.Message, confirmButtonText: '確定' });
                        return;
                    }
                    Swal.fire({ icon: 'success', title: '儲存成功', timer: 1200, showConfirmButton: false })
                        .then(function () { loadList(); });
                },
                error: function () { showSysError(); },
                complete: function () { hideLoader(); },
            });
        });
    </script>
    @await Html.PartialAsync("_CrudCommonScripts")
}
