<script>
    // ⭐ 全域查詢狀態（完全由前端控制）
    let queryState = {
        page: 1,
        pageSize: 40,
        sortField: "RowGuid", //*** 頁面預設排序欄位，必須是TABLE內欄位
        sortDir: "asc",

        //*** 篩選條件
        Keyword1: "",
        Keyword2: "",
    };
    var currentId = '';
    const data = [
        {'No':1,'Id':1,'ProcessCode':'流程代碼1','ProcessName':'流程名稱1'},
        {'No':2,'Id':2,'ProcessCode':'流程代碼2','ProcessName':'流程名稱2'},
    ]
    // ⭐ 主載入函式（分頁 / 搜尋 / 排序 都走這裡）
    function loadDatas() {
        // showLoader();
        // $.ajax({
        //     url: '@(Configuration["BackendURL"])/api/SysProcess/GetPageList',
        //     type: 'GET',
        //     data: queryState,
        //     success: function (res) {
        //         hideLoader();
        //         if (!res.Success) {
        //             Swal.fire({
        //                 icon: (res.Errors.AlertLevel || '').toLowerCase(),
        //                 title: res.Errors.ReturnCode,
        //                 text: res.Errors.ReturnMsg,
        //                 confirmButtonText: '@(config.GetMessage("Confirm").ToHtmlString())',
        //             });
        //             return;
        //         };

        //         renderTable(res.Data.Data);
        //         renderPagination(res.Data.Total);
        //         //document.getElementById("remove-actions").style.display = 'none';
        //         //$('#checkAll').prop('checked', false)
        //     },
        //     error: function () {
        //         hideLoader();
        //         Swal.fire({
        //             title: '@(config.GetMessage("System_Error").ToHtmlString())',
        //             icon: 'error',
        //             confirmButtonText: '@(config.GetMessage("Confirm").ToHtmlString())',
        //         });
        //     }
        // });
        renderTable(data);
        renderPagination(data.length);
    }
    // ⭐ 表格渲染
    function renderTable(rows) {
        const tbody = $('#data-list-data');
        tbody.empty();

        if (!rows || rows.length === 0) {
            $('.noresult').show();
            return;
        }
        $('.noresult').hide();

        // 決定要輸出的屬性順序：以第一筆的鍵為準（對應 SysResCategoryGridVM 成員）
        const first = rows[0] || {};
        const props = Object.keys(first);

        // 要特殊處理或跳過的屬性
        const skipProps = new Set(['RowGuid']);
        const statusProps = new Set(['Status', 'StatusName']);
        const booleanProps = new Set(['IsNeedWFW', 'IsSystem']);

        // 產生每筆 row 的 HTML
        rows.forEach(data => {
            const editUrl = '@mapUrl.Edit.ToHtmlString()'.replace('tempId', data.RowGuid)
            tbody.append(`
                                <tr data-id="${data.Id}">
                                    <td>
                                        <div class="dropdown">
                                            <button class="btn btn-soft-secondary btn-sm dropdown" type="button" data-bs-toggle="dropdown">
                                                <i class="ri-more-fill align-middle"></i>
                                            </button>
                                            <ul class="dropdown-menu dropdown-menu-end">
                                                    <li><a class="dropdown-item edit-item-btn" href="${editUrl}"><i class="ri-pencil-fill align-bottom me-2 text-muted"></i>編輯</a></li>
                                                
                                            </ul>
                                        </div>
                                    </td>
                                    <td>${data.No}</td>
                                    <td>${data.ProcessCode}</td>
                                    <td>${data.ProcessName}</td>
                                </tr>
                            `);
        });
        initDynamicDropdowns();
    }
    // ⭐ 分頁渲染
    function renderPagination(total) {
        const totalPages = Math.ceil(total / queryState.pageSize);
        const ul = $('.listjs-pagination');
        ul.empty();

        if (totalPages <= 1) return;

        const maxPages = 5;

        let startPage = Math.max(1, queryState.page - Math.floor(maxPages / 2));
        let endPage = startPage + maxPages - 1;

        if (endPage > totalPages) {
            endPage = totalPages;
            startPage = Math.max(1, endPage - maxPages + 1);
        }

        // ⭐ 前面有隱藏 → 第一頁 …
        if (startPage > 1) {
            ul.append(`
                                                        <li class="page-item">
                                                            <a class="page-link" href="javascript:void(0)" onclick="gotoPage(1)">@(config.GetMessage("First_Page").ToHtmlString())</a>
                                                        </li>
                                                    `);

            ul.append(`
                                                        <li class="page-item disabled">
                                                            <span class="page-link">...</span>
                                                        </li>
                                                    `);
        }

        // ⭐ 中間連續頁碼（最多5頁）
        for (let i = startPage; i <= endPage; i++) {
            ul.append(`
                                                        <li class="page-item ${i === queryState.page ? 'active' : ''}">
                                                            <a class="page-link" href="javascript:void(0)" onclick="gotoPage(${i})">${i}</a>
                                                        </li>
                                                    `);
        }

        // ⭐ 後面有隱藏 → … 最後一頁
        if (endPage < totalPages) {
            ul.append(`
                                                        <li class="page-item disabled">
                                                            <span class="page-link">...</span>
                                                        </li>
                                                    `);

            ul.append(`
                                                        <li class="page-item">
                                                            <a class="page-link" href="javascript:void(0)" onclick="gotoPage(${totalPages})">@(config.GetMessage("Last_Page").ToHtmlString())</a>
                                                        </li>
                                                    `);
        }

        // ⭐ 上一頁 / 下一頁狀態
        $('.pagination-prev').toggleClass('disabled', queryState.page === 1);
        $('.pagination-next').toggleClass('disabled', queryState.page === totalPages);

        // ⭐ 上一頁
        $('.pagination-prev').off('click').on('click', function (e) {
            e.preventDefault();
            if (queryState.page > 1) {
                queryState.page--;
                $('#globalSearchInput').val('');
                loadDatas();
            }
        });

        // ⭐ 下一頁
        $('.pagination-next').off('click').on('click', function (e) {
            e.preventDefault();
            if (queryState.page < totalPages) {
                queryState.page++;
                $('#globalSearchInput').val('');
                loadDatas();
            }
        });
    }

    function gotoPage(page) {
        queryState.page = page;
        $('#globalSearchInput').val('');
        loadDatas();
    }
    // ⭐ 搜尋 + 篩選
    function SearchData() {

        //*** 篩選條件
        queryState.Keyword1 = $('#Keyword1').val();
        queryState.Keyword2 = $('#Keyword2').val();

        queryState.page = 1;
        $('#globalSearchInput').val('');
        loadDatas();
    }
    $(function () {
        loadDatas();
        // ⭐ 點擊排序（完全用你原本的 class="sort"）
        $('.sort').on('click', function () {
            const field = $(this).data('sort');

            if (queryState.sortField === field) {
                queryState.sortDir = queryState.sortDir === 'asc' ? 'desc' : 'asc';
            } else {
                queryState.sortField = field;
                queryState.sortDir = 'asc';
            }

            loadDatas();
        });

        // 使用 event delegation，支援動態新增 tr
        $(document).on('click', '.remove-item-btn', function (e) {
            e.preventDefault();

            // 找到所在的 tr
            const $tr = $(this).closest('tr');

            // 取得 data-id 或 value（依你的 HTML）
            currentId = $tr.data('id');

            if (!currentId) return;
        });

        $("#delete-record").click(function () {
            //呼叫刪除API
            var ids = [currentId];

            //*** 刪除資料的ACTION
            $.ajax({
                type: "POST",
                url: '@(mapUrl.Delete)',
                dataType: "json",   // ⭐ 期望回傳 JSON
                contentType: "application/json; charset=utf-8",
                data: JSON.stringify(ids),
                cache: false,
                success: function (response) {
                    const modal = bootstrap.Modal.getInstance(deleteOrder);
                    modal.hide();


                    if (!response.Success) {
                        Swal.fire({
                            icon: (response.Errors.AlertLevel || '').toLowerCase(),
                            title: response.Errors.ReturnCode,
                            text: response.Errors.ReturnMsg,
                            confirmButtonText: '@(config.GetMessage("Confirm").ToHtmlString())',
                        });
                        return;
                    };



                    loadDatas();

                    var successMsg = '@(config.GetMessage("Successfully_Deleted").ToHtmlString())';

                    Swal.fire({
                        icon: 'success',
                        title: successMsg,
                        confirmButtonText: '@(config.GetMessage("Confirm").ToHtmlString())',
                    }).then(() => {
                    });
                },
                error: function (xhr, status, error) {
                    Swal.fire({
                        icon: 'error',
                        title: '@(config.GetMessage("System_Error").ToHtmlString())',
                        confirmButtonText: '@(config.GetMessage("Confirm").ToHtmlString())',
                    });
                }
            }).always(function () {
                hideLoader();
            });
        });
    
        $('#globalSearchInput').on('input', function () {

            const keyword = $(this).val().toLowerCase();

            $('#data-list-data tr').each(function () {
                const rowText = $(this).text().toLowerCase();
                $(this).toggle(rowText.includes(keyword));
            });
        });
    })
        
</script>