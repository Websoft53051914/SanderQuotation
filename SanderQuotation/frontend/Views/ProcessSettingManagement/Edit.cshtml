    // 拖曳吸附 + 提示線
    function makeDraggableWithAlign(node) {
        let alignLines = [];
        const threshold = 10;

        instance.draggable(node, {
            start: () => {
                node.classList.add('selected');
                // 建立提示線
                alignLines = [
                    createAlignLine('h'),
                    createAlignLine('v')
                ];
            },
            drag: () => {
                const x = node.offsetLeft;
                const y = node.offsetTop;
                let snapX = x;
                let snapY = y;

                document.querySelectorAll('.flow-node').forEach(other => {
                    if (other === node) return;
                    const ox = other.offsetLeft;
                    const oy = other.offsetTop;

                    // 水平吸附
                    if (Math.abs(oy - y) <= threshold) {
                        snapY = oy;
                        alignLines[0].style.top = oy + 'px';
                        alignLines[0].style.display = 'block';
                    } else alignLines[0].style.display = 'none';

                    // 垂直吸附
                    if (Math.abs(ox - x) <= threshold) {
                        snapX = ox;
                        alignLines[1].style.left = ox + 'px';
                        alignLines[1].style.display = 'block';
                    } else alignLines[1].style.display = 'none';
                });

                node.style.left = snapX + 'px';
                node.style.top = snapY + 'px';
                instance.revalidate(node);
            },
            stop: () => {
                alignLines.forEach(l => l.remove());
                instance.repaintEverything();
            }
        });
    }

    // 建立提示線
    function createAlignLine(type) {
        const line = document.createElement('div');
        line.classList.add('align-line', type);
        line.style.position = 'absolute';
        line.style.pointerEvents = 'none';
        line.style.zIndex = 9999;
        if (type === 'h') {
            line.style.height = '1px';
            line.style.width = '100%';
            line.style.borderTop = '1px dashed #0ab39c';
        } else {
            line.style.width = '1px';
            line.style.height = '100%';
            line.style.borderLeft = '1px dashed #0ab39c';
        }
        document.getElementById('canvas').appendChild(line);
        return line;
    }

    function importFlow(json) {
        const flowData = typeof json === 'string' ? JSON.parse(json) : json;

        // 清空畫布與資料
        instance.deleteEveryEndpoint();
        instance.deleteEveryConnection();
        document.querySelectorAll('.flow-node').forEach(n => n.remove());
        nodeConfigs = {};
        nodeIndex = 1;

        // 載入節點
        flowData.nodes.forEach(n => {
            const div = document.createElement('div');
            div.className = 'flow-node';
            div.id = n.id;
            div.innerText = n.name;
            div.style.top = n.position.top + 'px';
            div.style.left = n.position.left + 'px';
            canvas.appendChild(div);

            makeDraggableWithAlign(div);
            div.onclick = () => selectNode(div);
            if(canEdit){
                div.oncontextmenu = e => { e.preventDefault(); openNodeModal(n.id, n.isInitial); };
            }
            

            nodeConfigs[n.id] = {
                name: n.name,
                flowRules: n.flowRules,
                approverSetting: n.approverSetting,
                isInitial: n.isInitial,
                approvalMode: n.nodeType || (approvalTypeList.length>0?approvalTypeList[0].CodeID:""),
            };

            nodeIndex = Math.max(nodeIndex, parseInt(n.id.split('_')[1]) + 1);
        });

        // 載入連線
        instance.batch(() => {
            flowData.connections.forEach(c => {
                if (document.getElementById(c.source) && document.getElementById(c.target)) {
                    instance.connect({ source: c.source, target: c.target, anchors: ["Bottom","Top"], detachable: false });
                }
            });
        });
    }

    function copyTextToClipboard(text) {
        if (navigator.clipboard) {
            navigator.clipboard.writeText(text)
                .then(() => {
                    console.log('複製成功:', text);
                })
                .catch(err => {
                    console.error('複製失敗:', err);
                });
        } else {
            // 瀏覽器不支援 Clipboard API 時退回舊方法
            fallbackCopyTextToClipboard(text);
        }
    }

    $("#submitForm").submit(function (e) {
        e.preventDefault();
        showLoader();

        if ($(this).is(':invalid')) {
                hideLoader();
                return;
            }
        const allNodeIds = Object.keys(nodeConfigs);
        //一定要有節點
        if (allNodeIds.length == 0) {
            hideLoader();
            Swal.fire({
                icon: 'warning',
                title: '@config.GetMessage("Msg_Node_Required").ToHtmlString()',
                confirmButtonText: '@(config.GetMessage("Confirm").ToHtmlString())'
            });
            return;
        }
        //節點不能只有申請人
        if (allNodeIds.length == 1 && nodeConfigs[allNodeIds[0]].isInitial){
            hideLoader();
            Swal.fire({
                icon: 'warning',
                title: '@config.GetMessage("Msg_Node_CannotOnlyHaveApplicant").ToHtmlString()',
                confirmButtonText: '@(config.GetMessage("Confirm").ToHtmlString())'
            });
            return;
        }
        
        let allErrors = [];
        // 驗證每個節點
        allNodeIds.forEach(id => {
            const nodeError = validateNodeLogic(id, nodeConfigs[id].flowRules);
            if (nodeError) {
                allErrors.push(`${'@(config.GetMessage("Node_Name").ToHtmlString())'}「${nodeConfigs[id].name}」: ${nodeError}`);
            }
        });
        if (allErrors.length > 0) {
            hideLoader();
            Swal.fire({
                icon: 'warning',
                html: `<div>${allErrors.join('<br>')}</div>`,
                confirmButtonText: '@(config.GetMessage("Confirm").ToHtmlString())'
            });
            return;
        }


            // 節點資料
            const nodes = Object.keys(nodeConfigs).map(id => {
                const el = document.getElementById(id);
                return {
                    id,
                    name: nodeConfigs[id].name,
                    isInitial: nodeConfigs[id].isInitial,
                    flowRules: nodeConfigs[id].flowRules,
                    approverSetting: nodeConfigs[id].approverSetting,
                    position: { top: el.offsetTop, left: el.offsetLeft },
                    nodeType: nodeConfigs[id].approvalMode,
                    expiredDays:  nodeConfigs[id].expiredDays,
                };
            });

            // 連線資料
            const connections = instance.getAllConnections().map(c => ({
                source: c.sourceId,
                target: c.targetId
            }));

            const flowData = { nodes, connections };
            const json = JSON.stringify(flowData, null, 2);

            var data = {};
            $.extend(data, $(this).serializeObject());
            data.DataJson=json;

            $.ajax({
                type: "POST",
                url: "@(action == "create" ? mapUrl.Create.ToHtmlString() : mapUrl.Edit.ToHtmlString())",
                dataType: "json",                               // ⭐ 期望回傳 JSON
                data: data,                     // ⭐ 轉字串

                cache: false,
                success: function (response) {
                    hideLoader()


                        if (!response.Success) {
                            Swal.fire({
                                icon: (response?.Errors?.AlertLevel || 'error').toLowerCase(),
                                title: response?.Errors?.ReturnCode || response?.Message,
                                text: response?.Errors?.ReturnMsg || "" ,
                                confirmButtonText: '@(config.GetMessage("Confirm").ToHtmlString())',
                            });
                            return;
                        };

                        var successMsg = '@action' == "create" ? '@(config.GetMessage("Successfully_Added").ToHtmlString())' : '@(config.GetMessage("Successfully_Edited").ToHtmlString())';

                        Swal.fire({
                            icon: 'success',
                            title: successMsg,
                            confirmButtonText: '@(config.GetMessage("Confirm").ToHtmlString())',
                        }).then(() => {
                           location.href = '@Url.Action("Index")';
                            
                            

                        });
                },
                error: function (xhr, status, error) {
                    Swal.fire({
                        icon: 'error',
                        title: '@(config.GetMessage("System_Error").ToHtmlString())',
                        button: '@(config.GetMessage("Confirm").ToHtmlString())',
                    });
                }
            }).always(function () {
                hideLoader();
            });
        });
