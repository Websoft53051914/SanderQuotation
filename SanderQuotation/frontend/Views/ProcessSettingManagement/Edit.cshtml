@model BaseVM
@{
    List<SelectListItem> statusList = ViewData["StatusList"] as List<SelectListItem>;

    var mapUrl = new
    {
        Create = $"{Configuration["BackendURL"]}/api/SysProcess/Create",
        Edit = $"{Configuration["BackendURL"]}/api/SysProcess/Edit",
        GetEdit = $"{Configuration["BackendURL"]}/api/SysProcess/Edit",
    };

    var mapAttr = new
    {
        ConditionSelect = Guid.NewGuid(),
        ConditionJobRoleSelect = Guid.NewGuid(),
        ConditionDepartmentSelect = Guid.NewGuid(),
        ConditionJobGradeSelect = Guid.NewGuid(),
    };

    var action = Html.ActionName().ToLower() == "create" ? "create" : "edit";
    var actionName = action == "create" ? config.GetMessage("Create").ToHtmlString() : config.GetMessage("Edit").ToHtmlString();
}

<head>

    <script src="/lib/jsplumb/jsplumb.min.js"></script>


    <style>
        body {
            background: #f3f3f9;
        }

        #canvas {
            height: 620px;
            background-color: #F0F4F2; /* 霧感護眼底色 */
            /* 選配：增加極細微的點狀網格輔助對齊 */
            background-image: radial-gradient(#D1DBD6 1px, transparent 1px);
            background-size: 25px 25px;
            position: relative;
            overflow: auto;
        }

        .flow-node {
            position: absolute;
            min-width: 130px;
            padding: 10px 14px;
            background: #fff;
            border-radius: 12px;
            border-left: 5px solid #405189;
            box-shadow: 0 4px 10px rgba(0,0,0,.08);
            cursor: move;
            text-align: center;
            font-weight: 600;
            transition: box-shadow .15s, border-color .15s; /* 不要 all */
        }

            .flow-node.selected {
                border-color: #0ab39c;
                box-shadow: 0 0 14px rgba(10,179,156,.6);
                transform: scale(1.06);
            }

            .flow-node.dragging {
                transform: none !important;
                transition: none !important;
            }

            .flow-node.parallel {
                border-left: 5px solid #0ab39c;
                background: #f0fffb;
            }

        .rule-row {
            display: flex;
            align-items: center;
            margin-bottom: 4px;
        }


        .jtk-endpoint.jtk-endpoint-anchor.jtk-draggable.jtk-droppable {
            display: none;
        }
    </style>
</head>

<div class="row">
    <div class="col-12">
        <form class="needs-validation" novalidate="" method="post" id="submitForm">
            @Html.HiddenFor(m => m.Id)
            <div class="card">
                <div class="card-body">
                    <div class="row">
                        <div class="col-lg-4">
                            <div class="mb-3 mb-lg-0">
                                <label class="col-form-label required" for="ProcessCode">
                                    流程代碼
                                </label>
                                <input class="form-control" @(action!="create"?"readonly":"") name="ProcessCode" id="ProcessCode" placeholder="請輸入流程代碼" required maxlength="100" />
                                <div class="invalid-feedback">請輸入流程代碼</div>
                            </div>

                        </div>
                        <div class="col-lg-4">
                            <div class="mb-3 mb-lg-0">
                                <label class="col-form-label required" for="ProcessName">
                                    流程名稱
                                </label>
                                <input class="form-control" name="ProcessName" id="ProcessName" placeholder="請輸入流程名稱" required maxlength="100" />
                                <div class="invalid-feedback">請輸入流程名稱</div>
                            </div>

                        </div>
                        
                        <div class="col-lg-8">
                            <div class="mb-3 mb-lg-0">
                                <label class="col-form-label required" for="Description">
                                   描述
                                </label>
                                <textarea rows="5" class="form-control" name="Description" id="Description" placeholder="請輸入描述" required maxlength="500"></textarea>
                                <div class="invalid-feedback">請輸入描述</div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </form>
        <div class="text-end mb-4">
            <a href="@Url.Action("Index")" class="btn btn-secondary w-sm">返回</a>
            <button type="submit" class="btn btn-success w-sm" form="submitForm">儲存</button>
        </div>
    </div>
</div>
<div class="row">
    <div class="col-8">
        <div class="card velzon-card">
            <div class="card-header pb-0">
                <h5>
                    配方流程設計
                </h5>
            </div>
            <div class="card-body p-0"><div id="canvas"></div></div>
        </div>
    </div>

    <div class="col-4">
        <div class="card velzon-card">
            <div class="card-header pb-0">
                <h5>
                    節點瀏覽
                </h5>
            </div>
            <div class="card-body" id="rightPanel">
                左鍵點擊節點瀏覽
            </div>
        </div>
        @if (Configuration.GetValue<bool>("EnableProcessFlowImportExport"))
        {
            <div class="card velzon-card">
                <div class="card-header pb-0">
                    <h5>
                        @(config.GetMessage("Tools").ToHtmlString())
                    </h5>
                </div>
                <div class="card-body d-grid gap-2">
                    <button class="btn btn-outline-secondary" onclick="exportFlow()">
                        📤 @(config.GetMessage("Copy_Process_JSON").ToHtmlString())
                    </button>
                    <button class="btn btn-outline-secondary" onclick="importFlow(prompt())">
                        📥 @(config.GetMessage("Load_Process_JSON").ToHtmlString())
                    </button>

                </div>
            </div>
        }
        
    </div>

</div>


<!-- Modal -->
<div class="modal fade" id="nodeConfigModal" tabindex="-1" data-bs-backdrop="static" data-bs-keyboard="false">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">

            <div class="modal-header">
                <h5 class="modal-title">
                    節點設定
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body">

                <div class="mb-2">
                    <label class="form-label required">
                        節點名稱
                    </label>
                    <input id="modalNodeName" class="form-control">
                </div>
                <div class="mb-2" id="approverModeBox">
                    <label class="form-label">簽核方式</label>
                    <select id="modalApprovalMode" class="form-select select2">
                       <option value="1">串簽</option>
                       <option value="2">會簽</option>
                    </select>
                </div>

                <button class="btn btn-sm btn-outline-success mt-2" id="addNextNodeBtn">
                    ➕ 新增下一節點
                </button>
                <button class="btn btn-sm btn-outline-danger mt-2" id="deleteNodeBtn">
                   刪除節點
                </button>

            </div>

            <div class="modal-footer">
                <div class="hstack gap-2 justify-content-end">
                    <button class="btn btn-success" id="saveNodeConfig">
                        儲存
                    </button>
                </div>
                
            </div>

        </div>
    </div>
</div>

<script>
    let instance,nodeIndex=1,nodeConfigs={};
    let tempFlowRules = []; // 宣告在全域或 Modal 作用域
    let canEdit = true

    function initSelect2(){
      $('.select2').select2({width:"100%"});
    }

    function switchApproverUI(type){
          $("#approverUserBox,#approverRoleBox,#approverDeptBox").addClass("d-none");
          if(type.toLowerCase()==="Fixed_User".toLowerCase()) {
            $("#approverUserBox").removeClass("d-none");
          }
        if (type.toLowerCase() === "Approve_Role".toLowerCase()) {
            $("#approverRoleBox").removeClass("d-none");
          }
          if (type.toLowerCase() === "Dept".toLowerCase()) {
            $("#approverDeptBox").removeClass("d-none");
          }
        }

    function getApproverNames(values) {
            if(!values || !values.length) return "";
            const options = $("#modalApproverUsers option");
            return values.map(v => {
                const opt = options.filter(`[value='${v}']`);
                return opt.length ? opt.text() : v;  // 找不到就直接用 value
            }).join(",");
        }

    function getApproverRoles(values) {
            if (values && Array.isArray(values)) {
            } else {
                values=[values];
            }

            if(!values || !values.length) return "";
            const options = $("#modalApproverRoles option");
            return values.map(v => {
                const opt = options.filter(`[value='${v}']`);
                return opt.length ? opt.text() : v;  // 找不到就直接用 value
            }).join(",");
        }

    function getApproverDepts(values) {
        if (values && Array.isArray(values)) {
        } else {
            values = [values];
        }

        if (!values || !values.length) return "";
        const options = $("#modalApproverDepts option");
        return values.map(v => {
            const opt = options.filter(`[value='${v}']`);
            return opt.length ? opt.text() : v;  // 找不到就直接用 value
        }).join(",");
    }

    jsPlumb.ready(()=>{
          instance=jsPlumb.getInstance({
            Connector:["Flowchart",{cornerRadius:6}],
            PaintStyle:{stroke:"#405189",strokeWidth:2},
            ConnectionOverlays:[["Arrow",{width:10,length:10,location:1}]],
            Container:"canvas"
          });
          instance.bind("connection",info=>info.connection.setDetachable(false));
              addNode("申請人",true);
          initSelect2();
        });

    function addNode(name,isInitial){
        const id="node_"+nodeIndex++;
        const div=document.createElement("div");
        div.className="flow-node";div.id=id;
        div.style.top="40px";div.style.left=(200+nodeIndex*40)+"px";
        div.innerHTML=name;
        canvas.appendChild(div);

        // 這裡改用帶吸附對齊的 draggable
        makeDraggableWithAlign(div);

        div.onclick=()=>selectNode(div);
        div.oncontextmenu=e=>{e.preventDefault();openNodeModal(id,isInitial);};

        nodeConfigs[id] = {
          name,
          approvalMode: '1',
          isInitial
        };

        return id;
    }

    function selectNode(node){
          document.querySelectorAll(".flow-node").forEach(n=>n.classList.remove("selected"));
          node.classList.add("selected");
          const cfg=nodeConfigs[node.id];
          if (!cfg.isInitial){
            const liElList = []
            
            rightPanel.innerHTML = `
    <h6>${cfg.name}</h6>
    <div>
        <b>簽核方式：</b>
        ${(cfg.approvalMode == 1 ? "串簽" : "會簽")}
    </div>
    ${(canEdit ? `<small class="text-muted">右鍵點擊節點編輯</small>` : '')}
    ` // 這裡記得補上最後的反引號與分號;
          }
          else{
            rightPanel.innerHTML = `
                    <h6>${cfg.name}</h6>


                        ${(canEdit ? `<small class="text-muted">右鍵點擊節點編輯</small>` : '')}`;
          }
        }

    function renderApprover(a){
        if (!a) {
            return "@(config.GetMessage("Not_Set").ToHtmlString())";
        }
        else {
            const name = approverTypeList.find(x => x.CodeID == a.type)?.CodeName ?? "";
            if (a.type.toLowerCase() == "Fixed_User".toLowerCase()) {

                return name + "：" + getApproverNames(a.values);
            }
            else if (a.type.toLowerCase() == "Approve_Role".toLowerCase()) {
                return name + "：" + getApproverRoles(a.values);
            }
            else if (a.type.toLowerCase() == "Dept".toLowerCase()) {
                return name + "：" + getApproverDepts(a.values);
            }
            else {
                return name;
            }
        }
    }

    /**
    * 輔助函式：將平鋪的 rules 陣列根據 operand ("OR") 拆分成多個 AND 鏈
    */
    function splitIntoAndChains(rules) {
        let chains = [];
        let currentChain = [];
        rules.forEach(r => {
            currentChain.push(r);
            if (r.operand === "OR") {
                chains.push(currentChain);
                currentChain = [];
            }
        });
        if (currentChain.length > 0) chains.push(currentChain);
        return chains;
    }

    function validateInternalFlowRules(tempFlowRules = []) {
        // 1. 先給每一筆規則貼上「行號標籤」
        const rulesWithNo = tempFlowRules.map((r, index) => ({
            ...r,
            _absoluteNo: index + 1
        }));
        const andChains = splitIntoAndChains(rulesWithNo);
        let flowRulesErrMsg = "";
        let globalNo = 1; // 追蹤畫面上真正的規則行號 (1, 2, 3...)

        for (let chain of andChains) {
            let minLimit = 0;
            let maxLimit = Infinity;

            // Map 紀錄欄位第一次出現的行號 (Key: field, Value: no)
            let usedTypesMap = new Map();
            // 紀錄這一組 AND 鏈中參與金額計算的行號
            let amtNos = [];
            let chainHasError = false; // 標記此鏈是否已出錯

            for (let r of chain) {
                const currentNo = r._absoluteNo;

                // --- 1. 重複欄位檢查 ---
                if (usedTypesMap.has(r.field)) {
                    const firstNo = usedTypesMap.get(r.field);
                    flowRulesErrMsg += `${formatString('@config.GetMessage("Msg_FlowRules_NO").ToHtmlString()', firstNo+','+currentNo)} : @config.GetMessage("Msg_FlowRules_Equal_Invalid").ToHtmlString()\n`;
                    chainHasError = true;
                } else {
                    usedTypesMap.set(r.field, currentNo);
                }

                // 如果已經重複欄位，直接中斷此鏈檢查
                if (chainHasError) break;

                // --- 2. AMT 金額矛盾檢查 ---
                if (r.field === 'AMT') {
                    amtNos.push(currentNo);

                    // 必填檢查
                    if (r.minAmount === "" || r.maxAmount === "") {
                        flowRulesErrMsg += `${formatString('@config.GetMessage("Msg_FlowRules_NO").ToHtmlString()', currentNo)} : @config.GetMessage("Msg_Amount_MinMax_Required").ToHtmlString()\n`;
                        chainHasError = true;
                    }
                    // 正數檢查
                    else if (parseFloat(r.minAmount) < 0 || parseFloat(r.maxAmount) < 0) {
                        flowRulesErrMsg += `${formatString('@config.GetMessage("Msg_FlowRules_NO").ToHtmlString()', currentNo)} : @config.GetMessage("Msg_Amount_MinMax_GreaterThanZero").ToHtmlString()\n`;
                        chainHasError = true;
                    }

                    if (chainHasError) break; // 格式錯誤直接跳出此鏈

                    const rMin = parseFloat(r.minAmount);
                    const rMax = parseFloat(r.maxAmount);

                    // 計算交集
                    minLimit = Math.max(minLimit, rMin);
                    maxLimit = Math.min(maxLimit, rMax);

                    if (minLimit >= maxLimit) {
                        const conflictNos = amtNos.join(',');
                        flowRulesErrMsg += `${formatString('@config.GetMessage("Msg_FlowRules_NO").ToHtmlString()', conflictNos)} : @config.GetMessage("Msg_FlowRules_Amount_Invalid").ToHtmlString()\n`;
                        chainHasError = true;
                        break; // 金額矛盾，此鏈後續無須再測，直接 break
                    }
                }


            }
        }

        return flowRulesErrMsg;
    }

    /**
    * 核心判斷：兩個節點之間的路徑是否可行
    * 邏輯：只要父節點的任一 AND 鏈與子節點的任一 AND 鏈有交集，即為 true
    */
    function checkPathViability(parentRules = [], childRules = []) {
        // 取得雙方的 AND 鏈 (利用你現有的拆分邏輯)
        const pChains = splitIntoAndChains(parentRules);
        const cChains = splitIntoAndChains(childRules);

        // 如果其中一方完全沒設條件，代表全放行，一定有交集
        if (pChains.length === 0 || cChains.length === 0) return true;

        // 只要「父節點的某個分支」能走進「子節點的某個分支」，這條路就是通的
        return pChains.some(pChain =>
            cChains.some(cChain => canChainsIntersect(pChain, cChain))
        );
    }
    /**
    * 修正後的交集判斷：比對兩個 AND 鏈
    * 邏輯：檢查所有重疊的 field，只要有一個 field 互斥，這兩條鏈就無法交集
    */
    function canChainsIntersect(pChain, cChain) {
        // 遍歷父鏈中的每一個條件，去跟子鏈中「同欄位」的條件做比對
        for (let pRule of pChain) {
            // 在子鏈中找尋相同欄位的限制
            const cRule = cChain.find(r => r.field === pRule.field);

            // 如果子鏈中沒有這個欄位的限制，代表子鏈對此欄位全收，不構成衝突，繼續檢查下一個 field
            if (!cRule) continue;

            // --- A. 金額比對 ---
            if (pRule.field === 'AMT') {
                const pMin = parseFloat(pRule.minAmount) || 0;
                const pMax = pRule.maxAmount === "" ? Infinity : parseFloat(pRule.maxAmount);
                const cMin = parseFloat(cRule.minAmount) || 0;
                const cMax = cRule.maxAmount === "" ? Infinity : parseFloat(cRule.maxAmount);

                // 區間互斥判定：如果 (父小 >= 子大) 或 (子小 >= 父大)，則無交集
                if (pMin >= cMax || cMin >= pMax) return false;
            }
            // --- B. 等於類比對 (JobRole, Department, JobLevel) ---
            else {
                const vP = pRule.value ? pRule.value.trim() : "";
                const vC = cRule.value ? cRule.value.trim() : "";

                // 只要兩邊都有填值，且值不同，就是互斥
                if (vP !== "" && vC !== "" && vP !== vC) {
                    return false;
                }
            }
        }

        // 所有重疊的欄位都檢查過了，沒有發現互斥，則這兩條鏈可以交集
        return true;
    }

    /**
    * 核心驗證：檢查特定節點的內部邏輯、上下游連通性、兄弟互斥、以及單據遺失風險
    */
    function validateNodeLogic(nodeId, currentRules, isOnlyValidateInternalError = false) {
        const node = nodeConfigs[nodeId];
        const allConns = instance.getAllConnections().map(c => ({ source: c.sourceId, target: c.targetId }));

        // 1. 內部格式與物理衝突檢查
        const internalError = validateInternalFlowRules(currentRules);
        if (internalError) return internalError;


        if (isOnlyValidateInternalError) {
            return '';
        }

        //5. 內部格式，AprovalUserType是1或是2，value必須有值
        if(!node.isInitial){
            const userType = node.approverSetting.type;
            const name = approverTypeList.find(x => x.CodeID == userType)?.CodeName ?? "";
            if ((userType.toLowerCase() === "Fixed_User".toLowerCase() || userType.toLowerCase() === "Approve_Role".toLowerCase() || userType.toLowerCase() === "Dept".toLowerCase()) && (!node.approverSetting.values || node.approverSetting.values.length === 0)) {


                return `@(config.GetMessage("Msg_Node_ApproveUser_Required").ToHtmlString())` + name;
        }
        }
        

        const myChains = splitIntoAndChains(currentRules);
        const myIsDefault = myChains.length === 0;

        // 2. 向下檢查 (子節點連通性)
        const childConns = allConns.filter(c => c.source === nodeId);
        for (let conn of childConns) {
            const targetCfg = nodeConfigs[conn.target];
            if (targetCfg.flowRules && targetCfg.flowRules.length > 0) {
                if (!checkPathViability(currentRules, targetCfg.flowRules)) {
                    return `@(config.GetMessage("Msg_FlowRules_Target_NotIntersect").ToHtmlString())(${targetCfg.name})`;
                }
            }
        }

        // 3. 向上檢查 (父節點連通性) 與 兄弟檢查 (唯一性)
        const parentConns = allConns.filter(c => c.target === nodeId);
        for (let pConn of parentConns) {
            const parentCfg = nodeConfigs[pConn.source];

            // 向上連通
            if (!checkPathViability(parentCfg.flowRules, currentRules)) {
                return `@(config.GetMessage("Msg_FlowRules_Source_NotIntersect").ToHtmlString())(${parentCfg.name})`;
            }

            // 兄弟互斥
            const siblingConns = allConns.filter(c => c.source === pConn.source && c.target !== nodeId);
            for (let sConn of siblingConns) {
                const siblingCfg = nodeConfigs[sConn.target];
                const siblingChains = splitIntoAndChains(siblingCfg.flowRules);
                const siblingIsDefault = siblingChains.length === 0;

                if (!myIsDefault && !siblingIsDefault) {
                    if (checkPathViability(currentRules, siblingCfg.flowRules)) {
                        return `@config.GetMessage("Msg_FlowRules_Sibliings_Intersect").ToHtmlString()`+`${siblingCfg.name}`;
                    }
                } else if (myIsDefault && siblingIsDefault) {
                    return `@config.GetMessage("Msg_FlowRules_Siblings_IsDefault").ToHtmlString()` + `${siblingCfg.name}`;
                }
            }
        }

        // ---------------------------------------------------------
        // 4. 單據遺失與預設路徑唯一性偵測 (Dead End & Default Uniqueness)
        // ---------------------------------------------------------
        if (childConns.length > 0) {
            const childConfigs = childConns.map(conn => nodeConfigs[conn.target]);

            // 找出所有「無條件 (Default)」的小孩節點
            const defaultChildren = childConfigs.filter(c => {
                const chains = splitIntoAndChains(c.flowRules || []);
                // 定義：完全沒規則，或是所有鏈都是空的
                return chains.length === 0;
            });

            // --- A. 預設路徑唯一性檢查 ---
            if (defaultChildren.length > 1) {
                const names = defaultChildren.map(c => c.name).join('、');
                return `@config.GetMessage("Msg_FlowRules_Target_MultipleIsDefault").ToHtmlString()`+`(${names})`;
            }

            // --- B. 遺失偵測 (強制要求必須有一個 Default) ---
            const hasDefaultChild = defaultChildren.length === 1;

            if (!hasDefaultChild) {
                // 如果連一個 Default 都沒有，不論有多少孩子，都視為有風險
                return `@config.GetMessage("Msg_FlowRules_Target_NoneIsDefault").ToHtmlString()`;
            }
        }

        return ''; // 通過所有檢查
    }

    function openNodeModal(id, isInitial) {
        const cfg = nodeConfigs[id];
        // 深度複製一份，避免改到原始資料
        tempFlowRules = JSON.parse(JSON.stringify(cfg.flowRules || []));

        // 節點名稱必保留
        modalNodeName.value = cfg.name;

        // 如果是初始節點，只保留節點名稱 + 新增下一節點
        if (isInitial) {
            $("#modalApproverType,#approveExpiredDayBox,#approverUserBox,#approverRoleBox,#approverDeptBox,#modalNodeFlowRules,#addFlowRuleBtn,#addFlowRuleBtnBox,#approverModeBox,#approverTypeBox").hide();
        } else {
            $("#modalApproverType,#approveExpiredDayBox,#approverUserBox,#approverRoleBox,#approverDeptBox,#modalNodeFlowRules,#addFlowRuleBtn,#addFlowRuleBtnBox,#approverModeBox,#approverTypeBox").show();

            // 初始化簽核人與分流條件
            $('#modalApprovalMode').val(cfg.approvalMode).trigger('change');
           
            
        }

        // 新增下一節點按鈕
        addNextNodeBtn.onclick = () => {
            const outConnections = instance.getConnections({ source: id });
            const connectionCount = outConnections.length; // 已經存在的子節點數量
            // 取得所有被管理的元素物件
            const managedElements = instance.getManagedElements();

            // 取得節點總數
            const nodeCount = Object.keys(managedElements).length;
            const newId = addNode("新節點" + (nodeCount + 1), false);
            const old = document.getElementById(id);
            const n = document.getElementById(newId);
            // 3. 計算偏移：每一條既有連線就讓新節點多往右移 50px
            // 如果是第一個子節點 (count=0)，偏移 0；第二個偏移 50，以此類推
            const horizontalOffset = connectionCount * 50;
            const verticalOffset = 120; // 固定的垂直間距 [cite: 98]
            n.style.top = (old.offsetTop + verticalOffset) + "px";
            n.style.left = (old.offsetLeft + horizontalOffset) + "px";
            instance.batch(() => {
                instance.revalidate(old);
                instance.revalidate(n);
                instance.connect({ source: id, target: newId, anchors: ["Bottom", "Top"], detachable: false });
            });
        };

        // 初始節點不可刪除
        deleteNodeBtn.style.display = isInitial ? "none" : "inline-block";
        deleteNodeBtn.onclick = () => {
            const outConnections = instance.getConnections({ source: id });
            if (outConnections.length > 0) {
                // 2. 如果有小孩，跳出提示並阻斷刪除
                Swal.fire({
                    icon: 'warning',
                    title: '有子節點存在，不可刪除',
                    confirmButtonText: '確定'
                });
                return; // 結束函式，不執行刪除
            }
            instance.remove(id);
            delete nodeConfigs[id];
            bootstrap.Modal.getInstance(nodeConfigModal).hide();
        };

        // 儲存節點名稱
        saveNodeConfig.onclick = () => {
            //欄位檢查
            let errorMsg = "";
            //基本資訊檢查
            //節點名稱不可為空
            if (!modalNodeName.value.trim()) {
                errorMsg += "節點名稱不可為空\n";
            }
            //approverSetting.type如果是1，那麼values不能是空陣列

            

            if (errorMsg) {
                Swal.fire({
                    icon: 'warning',
                    html: errorMsg.replace('\n','<br/>'),
                    confirmButtonText: '確定)'
                });
                return; // 阻止儲存
            }

            
            cfg.name = modalNodeName.value;
            cfg.approvalMode = $('#modalApprovalMode').val();
            // 更新畫面節點名稱
            document.getElementById(id).innerText = cfg.name;

            // ✅ 立即刷新右側節點瀏覽
            selectNode(document.getElementById(id));
            bootstrap.Modal.getInstance(nodeConfigModal).hide();
        };

        initSelect2();
        new bootstrap.Modal(nodeConfigModal).show();
    }

   

    function addRuleRow(rule,arr,index){
        const row = document.createElement("div");
        row.className = "rule-row row";

        // 為 select 增加特定 class 方便初始化
        const conditionOpElList = conditionList.map(function (x) {
            return `<option value="${x.CodeID}">${x.CodeName}</option>`
        })
        row.innerHTML = `
            <div class="col-3">
                <select class="form-select rule-field-select">
                    ${conditionOpElList.join('\n')}
                </select>
            </div>
            <div class="col-5 condition-value-container"></div>
            <div class="col-3">
                <select class="form-select rule-operand-select">
                    <option value="OR">OR</option>
                    <option value="AND">AND</option>
                </select>
            </div>
            <div class="col-1">
                 <button class="btn btn-outline-danger">🗑</button>
            </div>
           `;

        // 先將 row 加入畫布，Select.js 才能正確計算寬度
        modalNodeFlowRules.appendChild(row);

        // 取得元素
        const fieldSelect = row.querySelector('.rule-field-select');
        const operandSelect = row.querySelector('.rule-operand-select');
        const valueContainer = row.querySelector('.condition-value-container');
        const deleteBtn = row.querySelector('button');

        



        // 設定初始值
        fieldSelect.value = rule.field;
        operandSelect.value = rule.operand || "AND";
        

        const select2Config = { width: '100%', dropdownParent: $('#nodeConfigModal') };

        $(fieldSelect).select2(select2Config);
        $(operandSelect).select2(select2Config);
        let $currentValueSelect = null; // 追蹤目前的 value select2 實例


        // --- 動態 UI 切換 ---
        const updateValueUI = (type) => {
            valueContainer.innerHTML = '';
            rule.field = type;

            if (type === 'AMT') {
                valueContainer.innerHTML = `
                            <div class="input-group">
                                <input type="number" class="form-control min-amount" placeholder="@(config.GetMessage("Please_Enter").ToHtmlString())@(config.GetMessage("Min").ToHtmlString())" min="0" value="${rule.minAmount || 0}">
                                <span class="input-group-text">~</span>
                                <input type="number" class="form-control max-amount" placeholder="@(config.GetMessage("Please_Enter").ToHtmlString())@(config.GetMessage("Max").ToHtmlString())" min="0" value="${rule.maxAmount || ''}">
                            </div>`;
                const minIn = valueContainer.querySelector('.min-amount');
                const maxIn = valueContainer.querySelector('.max-amount');
                minIn.oninput = () => { rule.minAmount = minIn.value; 
                };
                maxIn.oninput = () => { rule.maxAmount = maxIn.value; 
                };
            } else {
                valueContainer.innerHTML = `<select class="rule-value form-select"></select>`;
                const valIn = valueContainer.querySelector('.rule-value');

                let rowDataList = conditionValueListObj[rule.field] || [];
                rowDataList.forEach(function (item) {
                    $(valIn).append(new Option(item.CodeName, item.CodeID));
                });

                $(valIn).select2({ width: '100%', dropdownParent: $('#nodeConfigModal'), minimumResultsForSearch: 5 });
                $currentValueSelect = $(valIn);

                let selectedValue = rule.value;
                if (rowDataList.length > 0 && (!selectedValue || !rowDataList.find(x => x.CodeID == selectedValue))) {
                    selectedValue = rowDataList[0].CodeID;
                    rule.value = selectedValue;
                }
                $(valIn).val(selectedValue).trigger('change');

                $(valIn).on('change', function () {
                    rule.value = $(this).val();
                });
            }
        };
        updateValueUI(fieldSelect.value);

        // 監聽變更
        $(fieldSelect).on('change', function () {
            updateValueUI($(this).val());
        });

        $(operandSelect).on('change', function () {
            rule.operand = $(this).val();
        });

        row.querySelector('button').onclick = () => {
            if ($(fieldSelect).data('select2')) $(fieldSelect).select2('destroy');
            if ($(operandSelect).data('select2')) $(operandSelect).select2('destroy');
            if ($currentValueSelect && $currentValueSelect.data('select2')) $currentValueSelect.select2('destroy');
            row.remove();
            const idx = arr.indexOf(rule);
            if (idx > -1) arr.splice(idx, 1);
        };
    }

