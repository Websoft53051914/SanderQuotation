@using ViewModel.QuotationResult
@{
    ViewBag.Title = "定時查價結果";
    ViewBag.pTitle = "定時查價結果";
    ViewBag.pageTitle = "採購管理";
}

<div class="row">
    <div class="col-lg-12">
        <div class="card" id="datasList">
            <div class="card-header border-0">
                <div class="d-flex align-items-center">
                    <h5 class="card-title mb-0 flex-grow-1"></h5>
                    <div class="flex-shrink-0">
                    </div>
                </div>
            </div>

            <div class="card-body border border-dashed border-end-0 border-start-0">
                <form>
                    <div class="row g-3">
                        <div class="col-xxl-3 col-sm-12">
                            <div class="search-box">
                                <input type="text" id="globalSearchInput"
                                       class="form-control search bg-light border-light" placeholder="搜尋表格內容">
                                <i class="ri-search-line search-icon"></i>
                            </div>
                        </div>
                        <div class="col-xxl-3 col-sm-12">
                            <div class="search-box">
                                <input type="text" id="keywordInput" class="form-control search bg-light border-light"
                                       placeholder="搜尋關鍵字">
                                <i class="ri-search-line search-icon"></i>
                            </div>
                        </div>
                        <div class="col-xxl-1 col-sm-4">
                            <button type="button" class="btn btn-primary w-100" onclick="loadList(1)">
                                <i class="ri-equalizer-fill me-1 align-bottom"></i>篩選
                            </button>
                        </div>
                    </div>
                </form>
            </div>

            <div class="card-body">
                <div class="table-responsive table-card mb-4">
                    <table class="table align-middle table-nowrap mb-0" id="dataTable">
                        <thead>
                            <tr>
                                <th style="width:100px;">Action</th>
                                <th style="width:40px;">項次</th>
                                <th class="sort" data-sort="FileName">BOM 檔案名稱</th>
                                <th class="sort" data-sort="CustomerName">客戶名稱</th>
                                <th class="sort" data-sort="CustomerCode">客戶代碼</th>
                                <th class="sort" data-sort="QuotationQty">報價數量</th>
                                <th class="sort" data-sort="ItemCount">料項數</th>
                                <th class="sort" data-sort="CreatedAtText">建立日期</th>
                                <th class="sort" data-sort="UpdatedAtText">最後更新</th>
                            </tr>
                        </thead>
                        <tbody id="quotation-list-data">
                        </tbody>
                    </table>
                    <div class="noresult" style="display:none;">
                        <div class="text-center">
                            <lord-icon src="https://cdn.lordicon.com/msoeawqm.json" trigger="loop"
                                       colors="primary:#121331,secondary:#08a88a" style="width:75px;height:75px"></lord-icon>
                            <h5 class="mt-2">查無資料</h5>
                        </div>
                    </div>
                </div>
                <!-- 分頁 -->
                <div class="d-flex justify-content-end px-3 pb-2" id="paginationContainer"></div>
            </div>
        </div>
    </div>
</div>

<style>
    #dataTable .sort {
        cursor: pointer;
        padding-right: 1.5rem;
    }

        #dataTable .sort.asc::after {
            opacity: 1;
        }

        #dataTable .sort.desc::before {
            opacity: 1;
        }
</style>

@section scripts {
    @await Html.PartialAsync("_CrudCommonScripts")
<script>
        // ── _CrudCommonScripts Hooks ──────────────────────────────────────────
        function loadDatas() { loadList(1); }

        function onDocumentReady() {

        }

        var pageUrls = {
            GetPageList: '@(Configuration["BackendURL"])/api/QuotationResult/GetPageList',
            EditPage: '@Url.Action("Edit", "QuotationResult")'
        };

        // ── 欄位名稱（Razor nameof 強型別） ──────────────────────────────────
        var QfgM = {
            No: '@nameof(QuotationFileGridVM.No)',
            Id: '@nameof(QuotationFileGridVM.Id)',
            FileName: '@nameof(QuotationFileGridVM.FileName)',
            CustomerCode: '@nameof(QuotationFileGridVM.CustomerCode)',
            CustomerName: '@nameof(QuotationFileGridVM.CustomerName)',
            CustomerName: '@nameof(QuotationFileGridVM.ManualCustomerName)',
            ProdNo: '@nameof(QuotationFileGridVM.ProdNo)',
            QuotationQty: '@nameof(QuotationFileGridVM.QuotationQty)',
            ItemCount: '@nameof(QuotationFileGridVM.ItemCount)',
            CreatedAtText: '@nameof(QuotationFileGridVM.CreatedAtText)',
            UpdatedAtText: '@nameof(QuotationFileGridVM.UpdatedAtText)'
        };

        // ── 查詢狀態 ──────────────────────────────────────────────────────────
        var queryState = { page: 1, pageSize: 20, total: 0, sortField: QfgM.CreatedAtText, sortDir: 'desc', keyword: '' };

        // ── DOM ──────────────────────────────────────────────────────────────
        var dom = {
            listBody: $('#quotation-list-data'),
            noresult: $('.noresult'),
            keywordInput: $('#keywordInput')
        };

        // ── 工具函式 ──────────────────────────────────────────────────────────
        function showSysError() {
            Swal.fire({ icon: 'error', title: '系統錯誤', confirmButtonText: '確定' });
        }

        // ── 清單載入 ─────────────────────────────────────────────────────────
        function loadList(page) {
            if (page) queryState.page = page;
            queryState.keyword = dom.keywordInput.val().trim();
            showLoader();
            $.ajax({
                url: pageUrls.GetPageList,
                type: 'GET',
                data: {
                    Page: queryState.page,
                    PageSize: queryState.pageSize,
                    KeywordLike: queryState.keyword,
                    SortField: queryState.sortField,
                    SortDir: queryState.sortDir,
                },
                success: function (res) {
                    if (!res.Success) { showSysError(); return; }
                    renderList(res.Data.Data || []);
                    renderPagination(res.Data.Total);
                },
                error: function () { showSysError(); },
                complete: function () { hideLoader(); }
            });
        }

        // ── 分頁渲染 ─────────────────────────────────────────────────────────
        function renderPagination(total) {
            queryState.total = total;
            var totalPages = Math.ceil(total / queryState.pageSize) || 1;
            var $container = $('#paginationContainer');
            $container.empty();
            if (totalPages <= 1) return;

            var html = '<ul class="pagination mb-0">';
            html += '<li class="page-item ' + (queryState.page <= 1 ? 'disabled' : '') + '">';
            html += '<a class="page-link" href="javascript:void(0)" onclick="loadList(' + Math.max(1, queryState.page - 1) + ')">上一頁</a></li>';

            var maxPages = 5;
            var startPage = Math.max(1, queryState.page - Math.floor(maxPages / 2));
            var endPage = Math.min(totalPages, startPage + maxPages - 1);
            startPage = Math.max(1, endPage - maxPages + 1);

            if (startPage > 1) {
                html += '<li class="page-item"><a class="page-link" href="javascript:void(0)" onclick="loadList(1)">1</a></li>';
                if (startPage > 2) html += '<li class="page-item disabled"><span class="page-link">...</span></li>';
            }
            for (var i = startPage; i <= endPage; i++) {
                html += '<li class="page-item ' + (i === queryState.page ? 'active' : '') + '">';
                html += '<a class="page-link" href="javascript:void(0)" onclick="loadList(' + i + ')">' + i + '</a></li>';
            }
            if (endPage < totalPages) {
                if (endPage < totalPages - 1) html += '<li class="page-item disabled"><span class="page-link">...</span></li>';
                html += '<li class="page-item"><a class="page-link" href="javascript:void(0)" onclick="loadList(' + totalPages + ')">' + totalPages + '</a></li>';
            }
            html += '<li class="page-item ' + (queryState.page >= totalPages ? 'disabled' : '') + '">';
            html += '<a class="page-link" href="javascript:void(0)" onclick="loadList(' + Math.min(totalPages, queryState.page + 1) + ')">下一頁</a></li>';
            html += '</ul>';
            $container.html(html);
        }

        // ── 清單渲染 ─────────────────────────────────────────────────────────
        function renderList(list) {
            dom.listBody.empty();
            if (!list.length) {
                dom.noresult.show();
                return;
            }
            dom.noresult.hide();
            list.forEach(function (r) {
                dom.listBody.append(buildRow(r));
            });

            // 更新排序欄位視覺指示
            $('#dataTable .sort').each(function () {
                $(this).removeClass('asc desc');
                if ($(this).data('sort') === queryState.sortField) {
                    $(this).addClass(queryState.sortDir);
                }
            });
        }

        function buildRow(r) {
            return `<tr data-id="${r[QfgM.Id]}">
                <td>
                    <div class="dropdown">
                        <button class="btn btn-soft-secondary btn-sm dropdown" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                            <i class="ri-more-fill align-middle"></i>
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end">
                            <li><a class="dropdown-item" href="${pageUrls.EditPage}?Id=${r[QfgM.Id]}">
                                <i class="ri-pencil-fill align-bottom me-2 text-muted"></i>結果</a></li>
                        </ul>
                    </div>
                </td>
                <td>${r[QfgM.No]}</td>
                <td><span class="fw-semibold">${escapeHtml(r[QfgM.FileName])}</span></td>
                <td>${escapeHtml(r[QfgM.CustomerName] || '')}${escapeHtml(r[QfgM.CustomerName] || r[QfgM.ManualCustomerName] || '')}</td>
                <td><code class="fs-6">${escapeHtml(r[QfgM.CustomerCode] || '')}</code></td>
                <td class="text-end">${(r[QfgM.QuotationQty] || 0).toLocaleString()}</td>
                <td><span class="badge bg-secondary-subtle text-secondary">${r[QfgM.ItemCount] ?? '—'}</span></td>
                <td class="text-muted">${escapeHtml(r[QfgM.CreatedAtText])}</td>
                <td class="text-muted">${escapeHtml(r[QfgM.UpdatedAtText])}</td>
            </tr>`;
        }
</script>
}
