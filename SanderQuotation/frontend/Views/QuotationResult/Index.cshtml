@using ViewModel.QuotationResult
@{
    ViewBag.Title = "定時查價結果";
    ViewBag.pTitle = "定時查價結果";
    ViewBag.pageTitle = "採購管理";
}

<div class="row">
    <div class="col-lg-12">
        <div class="card" id="datasList">
            <div class="card-header border-0">
                <div class="d-flex align-items-center">
                    <h5 class="card-title mb-0 flex-grow-1"></h5>
                    <div class="flex-shrink-0">
                    </div>
                </div>
            </div>

            <div class="card-body border border-dashed border-end-0 border-start-0">
                <form>
                    <div class="row g-3">
                        <div class="col-xxl-3 col-sm-12">
                            <div class="search-box">
                                <input type="text" id="globalSearchInput"
                                       class="form-control search bg-light border-light" placeholder="搜尋表格內容">
                                <i class="ri-search-line search-icon"></i>
                            </div>
                        </div>
                        <div class="col-xxl-3 col-sm-12">
                            <div class="search-box">
                                <input type="text" id="keywordInput" class="form-control search bg-light border-light"
                                       placeholder="搜尋關鍵字">
                                <i class="ri-search-line search-icon"></i>
                            </div>
                        </div>
                        <div class="col-xxl-1 col-sm-4">
                            <button type="button" class="btn btn-primary w-100" onclick="loadList();">
                                <i class="ri-equalizer-fill me-1 align-bottom"></i>篩選
                            </button>
                        </div>
                    </div>
                </form>
            </div>

            <div class="card-body">
                <div class="table-responsive table-card mb-4">
                    <table class="table align-middle table-nowrap mb-0" id="dataTable">
                        <thead>
                            <tr>
                                <th style="width:100px;">Action</th>
                                <th style="width:40px;">項次</th>
                                <th>BOM File 名稱</th>
                                <th>客戶名稱</th>
                                <th>產品料號</th>
                                <th>客戶別</th>
                                <th>採購數量</th>
                                <th>料項數</th>
                                <th>建立日期</th>
                                <th>最後更新</th>
                            </tr>
                        </thead>
                        <tbody id="quotation-list-data">
                        </tbody>
                    </table>
                    <div class="noresult" style="display:none;">
                        <div class="text-center">
                            <lord-icon src="https://cdn.lordicon.com/msoeawqm.json" trigger="loop"
                                       colors="primary:#121331,secondary:#08a88a" style="width:75px;height:75px"></lord-icon>
                            <h5 class="mt-2">查無資料</h5>
                        </div>
                    </div>
                </div>


            </div>
        </div>
    </div>
</div>

@section scripts {
    <script>
        $(document).ready(function () {
            var pTitle = '@(Html.Raw(ViewBag.pTitle))';
            var pageTitle = '@(Html.Raw(ViewBag.pageTitle))';
            $('#header-pTitle').text(pTitle);
            var bElList = [];
            if (pageTitle) bElList.push('<li class="breadcrumb-item"><a href="javascript: void(0);">' + pageTitle + '</a></li>');
            bElList.push('<li class="breadcrumb-item active">' + pTitle + '</li>');
            $('#_page_title_row .breadcrumb').html(bElList.join(''));

            loadList();
        });
    </script>
    <script>
        var apiUrls = {
            GetList: '@(Configuration["BackendURL"])/api/QuotationResult/GetList',
            Delete: '@(Configuration["BackendURL"])/api/QuotationResult/Delete',
            BatchDelete: '@(Configuration["BackendURL"])/api/QuotationResult/BatchDelete',
            EditPage: '@Url.Action("Edit", "QuotationResult")'
        };

        // ── 欄位名稱（Razor nameof 強型別） ──────────────────────────────────
        var F = {
            Id: '@nameof(QuotationFileGridVM.Id)',
            BomFileName: '@nameof(QuotationFileGridVM.BomFileName)',
            CustomerName: '@nameof(QuotationFileGridVM.CustomerName)',
            ProductNo: '@nameof(QuotationFileGridVM.ProductNo)',
            CustomerType: '@nameof(QuotationFileGridVM.CustomerType)',
            PurchaseQty: '@nameof(QuotationFileGridVM.PurchaseQty)',
            ItemCount: '@nameof(QuotationFileGridVM.ItemCount)',
            CreateTime: '@nameof(QuotationFileGridVM.CreateTime)',
            UpdateTime: '@nameof(QuotationFileGridVM.UpdateTime)'
        };

        var deleteId = 0;

        // ── DOM ──────────────────────────────────────────────────────────────
        var dom = {
            listBody: $('#quotation-list-data'),
            noresult: $('.noresult'),
            globalSearch: $('#globalSearchInput'),
            keywordInput: $('#keywordInput')
        };

        // ── 工具函式 ──────────────────────────────────────────────────────────
        function escapeHtml(value) {
            return $('<div>').text(value ?? '').html();
        }

        function showSysError() {
            Swal.fire({ icon: 'error', title: '系統錯誤', confirmButtonText: '確定' });
        }

        var customerTypeBadgeMap = {
            'MM': 'bg-primary-subtle text-primary',
            'D3': 'bg-success-subtle text-success',
            'STL': 'bg-info-subtle text-info',
            'CTB': 'bg-warning-subtle text-warning',
            'WT': 'bg-danger-subtle text-danger',
            'AED': 'bg-secondary-subtle text-secondary',
            'EDS': 'bg-dark-subtle text-dark'
        };

        function customerTypeBadge(ct) {
            return escapeHtml(ct || '—');
        }

        // ── 清單載入 ─────────────────────────────────────────────────────────
        function loadList() {
            showLoader();
            $.ajax({
                url: apiUrls.GetList,
                type: 'GET',
                data: { keyword: dom.keywordInput.val() },
                success: function (res) {
                    if (!res.Success) { showSysError(); return; }
                    var list = res.Data || [];
                    var globalKw = dom.globalSearch.val().trim().toLowerCase();
                    if (globalKw) {
                        list = list.filter(function (r) {
                            return [
                                r[F.BomFileName], r[F.CustomerName], r[F.ProductNo], r[F.CustomerType]
                            ].some(function (v) {
                                return (v || '').toLowerCase().includes(globalKw);
                            });
                        });
                    }
                    renderList(list);
                },
                error: function () { showSysError(); },
                complete: function () { hideLoader(); }
            });
        }

        function renderList(list) {
            dom.listBody.empty();
            if (!list.length) {
                dom.noresult.show();
                return;
            }
            dom.noresult.hide();
            list.forEach(function (r, idx) {
                dom.listBody.append(buildRow(r, idx + 1));
            });
        }

        function buildRow(r, no) {
            return '<tr data-id="' + r[F.Id] + '">' +
                '<td>' +
                '<div class="dropdown">' +
                '<button class="btn btn-soft-secondary btn-sm dropdown" type="button" data-bs-toggle="dropdown" aria-expanded="false">' +
                '<i class="ri-more-fill align-middle"></i>' +
                '</button>' +
                '<ul class="dropdown-menu dropdown-menu-end">' +
                '<li><a class="dropdown-item" href="' + apiUrls.EditPage + '?Id=' + r[F.Id] + '">' +
                '<i class="ri-pencil-fill align-bottom me-2 text-muted"></i>結果</a></li>' +
                '</ul>' +
                '</div>' +
                '</td>' +
                '<td>' + no + '</td>' +
                '<td><span class="fw-semibold">' + escapeHtml(r[F.BomFileName]) + '</span></td>' +
                '<td>' + escapeHtml(r[F.CustomerName]) + '</td>' +
                '<td><code>' + escapeHtml(r[F.ProductNo]) + '</code></td>' +
                '<td>' + customerTypeBadge(r[F.CustomerType]) + '</td>' +
                '<td class="text-end">' + (r[F.PurchaseQty] || 0).toLocaleString() + '</td>' +
                '<td><span class="badge bg-secondary-subtle text-secondary">' + r[F.ItemCount] + '</span></td>' +
                '<td>' + escapeHtml(r[F.CreateTime]) + '</td>' +
                '<td>' + escapeHtml(r[F.UpdateTime]) + '</td>' +
                '</tr>';
        }


    </script>
}
