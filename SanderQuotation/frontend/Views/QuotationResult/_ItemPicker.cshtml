@using ViewModel.SanderModule
@model ViewModel.ItemPickerVCM
@inject Microsoft.Extensions.Configuration.IConfiguration Configuration
@{
    var modalId = !string.IsNullOrEmpty(Model?.ViewId) ? Model.ViewId : "itemPickerModal";
    var apiUrl  = !string.IsNullOrEmpty(Model?.ItemPickerApiUrl)
        ? Model.ItemPickerApiUrl
        : $"{Configuration["BackendURL"]}/api/SanderModuleItem/GetList";
}
@*
    ════════════════════════════════════════════════════════════════════════════
    _ItemPicker.cshtml
    採購型號選取器 Partial View（Modal 元件）── 支援同頁多實例
    ── 使用方式 ──────────────────────────────────────────────────────────────
    ① 在父頁面主體（@section scripts 前）加入：
         @{
             var mapData = new
             {
                 ItemPicker = new ItemPickerVCM { ViewId = "myModalId" },
             };
         }
         @await Html.PartialAsync("~/Views/QuotationResult/_ItemPicker.cshtml", mapData.ItemPicker)
       ItemPickerApiUrl 可選填；留空則使用後端預設 API。
    ② 呼叫：
         ItemPicker['myModalId'].open(function(no) { /* 取得選取的料號 no */ });
    ════════════════════════════════════════════════════════════════════════════
*@

<!-- Modal: 採購型號選取（@modalId）-->
<div class="modal fade" id="@modalId" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-xl">
        <div class="modal-content border-0">
            <div class="modal-header p-3 bg-info-subtle">
                <h5 class="modal-title">
                    <i class="ri-search-line me-2"></i>選取採購型號
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">

                <!-- 搜尋列 -->
                <div class="row mb-3">
                    <div class="col-md-5">
                        <div class="search-box">
                            <input type="text" class="ip-search-input form-control search bg-light border-light"
                                   placeholder="搜尋料號、品名…">
                            <i class="ri-search-line search-icon"></i>
                        </div>
                    </div>
                    <div class="col-md-7 d-flex align-items-center">
                        <span class="text-muted small">
                            <i class="ri-information-line me-1"></i>點擊「選取」或雙擊列以選取型號
                        </span>
                    </div>
                </div>

                <!-- 列表 -->
                <div class="table-responsive" style="max-height:450px; overflow-y:auto;">
                    <table class="ip-table table align-middle table-hover table-bordered table-sm mb-0">
                        <thead class="table-light sticky-top" style="top:0; z-index:1;">
                            <tr>
                                <th style="min-width:140px;">料號</th>
                                <th style="min-width:140px;">品名</th>
                                <th style="min-width:200px;">說明</th>
                                <th style="min-width:280px;">長描述</th>
                                <th style="width:90px;" class="text-center">選取</th>
                            </tr>
                        </thead>
                        <tbody class="ip-table-body">
                            <tr>
                                <td colspan="5" class="text-center text-muted py-4">載入中…</td>
                            </tr>
                        </tbody>
                    </table>
                </div>

            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-light" data-bs-dismiss="modal">關閉</button>
            </div>
        </div>
    </div>
</div>

<script>
    (function () {
        var modalId = '@modalId';
        var apiUrl  = '@apiUrl';

        // ── 工具 ─────────────────────────────────────────────────────────────
        function _esc(v) {
            return $('<div>').text(v ?? '').html();
        }

        // ── 欄位名稱（nameof 強型別） ─────────────────────────────────────────
        var FIP = {
            Id:           '@nameof(SanderModuleItemVM.Id)',
            No:           '@nameof(SanderModuleItemVM.No)',
            Description:  '@nameof(SanderModuleItemVM.Description)',
            Description2: '@nameof(SanderModuleItemVM.Description2)',
            LongDesc:     '@nameof(SanderModuleItemVM.LongDesc)',
            LongDesc2:    '@nameof(SanderModuleItemVM.LongDesc2)'
        };

        // ── 註冊此實例 ────────────────────────────────────────────────────────
        window.ItemPicker = window.ItemPicker || {};
        window.ItemPicker[modalId] = {
            _callback: null,
            _allItems: [],
            _loaded:   false,

            /// 開啟選取器；callback(no) 在確認後被呼叫
            open: function (callback) {
                this._callback = callback;
                $('#' + modalId + ' .ip-search-input').val('');
                bootstrap.Modal.getOrCreateInstance(
                    document.getElementById(modalId)
                ).show();
                if (!this._loaded) { this._fetchList(''); }
                else { this._applyFilter(''); }
            },

            /// 過濾已快取清單並重繪
            _applyFilter: function (kw) {
                var list = this._allItems;
                if (kw) {
                    var lower = kw.toLowerCase();
                    list = list.filter(function (i) {
                        return (i[FIP.No] || '').toLowerCase().includes(lower)
                            || (i[FIP.Description] || '').toLowerCase().includes(lower)
                            || (i[FIP.Description2] || '').toLowerCase().includes(lower)
                            || (i[FIP.LongDesc] || '').toLowerCase().includes(lower);
                    });
                }
                this._renderTable(list);
            },

            /// 渲染至表格
            _renderTable: function (list) {
                var $body = $('#' + modalId + ' .ip-table-body');
                $body.empty();
                if (!list.length) {
                    $body.append('<tr><td colspan="5" class="text-center text-muted py-4">查無符合的料號</td></tr>');
                    return;
                }
                var self = this;
                list.forEach(function (item) { $body.append(self._buildRow(item)); });
            },

            /// 建立單行 HTML
            _buildRow: function (item) {
                var longDescHtml = _esc(item[FIP.LongDesc] || '').replace(/\n/g, '<br>');
                return '<tr class="ip-data-row" data-no="' + _esc(item[FIP.No]) + '" style="cursor:pointer;">'
                    + '<td><code class="fs-6">' + _esc(item[FIP.No]) + '</code></td>'
                    + '<td class="fw-semibold">' + _esc(item[FIP.Description]) + '</td>'
                    + '<td class="text-muted">' + _esc(item[FIP.Description2]) + '</td>'
                    + '<td class="text-muted" style="white-space:pre-wrap;max-width:280px;">' + longDescHtml + '</td>'
                    + '<td class="text-center">'
                    + '<button type="button" class="btn btn-primary ip-select-btn"'
                    + ' data-no="' + _esc(item[FIP.No]) + '">'
                    + '<i class="ri-check-line me-1"></i>選取'
                    + '</button>'
                    + '</td>'
                    + '</tr>';
            },

            /// 確認選取：呼叫 callback 並關閉 Modal
            _confirm: function (no) {
                if (this._callback) {
                    this._callback(no);
                    this._callback = null;
                }
                bootstrap.Modal.getInstance(document.getElementById(modalId)).hide();
            },

            /// 呼叫後端 API 載入清單
            _fetchList: function (keyword) {
                var self = this;
                var $body = $('#' + modalId + ' .ip-table-body');
                if (!apiUrl) {
                    $body.html('<tr><td colspan="5" class="text-center text-danger py-3">未設定 API 位址</td></tr>');
                    return;
                }
                $body.html(
                    '<tr><td colspan="5" class="text-center text-muted py-4">'
                    + '<span class="spinner-border spinner-border-sm me-2"></span>載入中…</td></tr>'
                );
                $.ajax({
                    url:  apiUrl,
                    type: 'GET',
                    data: { keyword: keyword || '' },
                    success: function (res) {
                        if (!res.Success) {
                            $body.html('<tr><td colspan="5" class="text-center text-danger py-3">載入失敗</td></tr>');
                            return;
                        }
                        self._allItems = res.Data || [];
                        self._loaded   = true;
                        self._applyFilter('');
                    },
                    error: function () {
                        $body.html('<tr><td colspan="5" class="text-center text-danger py-3">網路錯誤，請稍後再試</td></tr>');
                    }
                });
            }
        };

        // ── 事件綁定（以 #modalId 為範圍，支援多實例） ───────────────────────
        $(document).on('input', '#' + modalId + ' .ip-search-input', function () {
            window.ItemPicker[modalId]._applyFilter($(this).val().trim());
        });

        $(document).on('click', '#' + modalId + ' .ip-select-btn', function (e) {
            e.stopPropagation();
            window.ItemPicker[modalId]._confirm($(this).data('no'));
        });

        $(document).on('dblclick', '#' + modalId + ' .ip-data-row', function () {
            window.ItemPicker[modalId]._confirm($(this).data('no'));
        });

        $(document).on('click', '#' + modalId + ' .ip-data-row', function () {
            $('#' + modalId + ' .ip-data-row').removeClass('table-active');
            $(this).addClass('table-active');
        });

    }());
</script>
