@using ViewModel.QuotationResult
@using ViewModel
@{
    ViewBag.Title = "定時查價結果編輯";
    ViewBag.pTitle = "定時查價結果編輯";
    ViewBag.pageTitle = "採購管理";

    Guid? quotationFileId = ViewBag.QuotationFileId as Guid?;

    var ui = new
    {
        PartialSmip = new SanderModuleItemPickerVCM(),
        PartialMdl = new ModalDecisionLogVCM
        {
            UrlGetDecisionLogs = $"{Configuration["BackendURL"]}/api/QuotationResult/GetDecisionLogs",
            UrlGetPriceClusterPageList = $"{Configuration["BackendURL"]}/api/QuotationResult/GetPriceClusterPageList"
        }
    };
}

<div class="row">
    <div class="col-lg-12">

        <div class="card quotation-result-card">
            <div class="card-header border-0 pb-0">

                <!-- ── Header 資訊 ── -->
                <form id="headerForm" class="needs-validation" novalidate>
                    <input type="hidden" id="e_Id" />
                    <div class="row g-2 align-items-end quotation-header-row">
                        <div class="col-lg-2 col-md-3">
                            <label class="col-form-label pt-0">BOM 檔案名稱</label>
                            <input type="text" id="e_FileName" class="form-control" readonly />
                        </div>
                        <div class="col-lg-2 col-md-3">
                            <label class="col-form-label pt-0">客戶代碼</label>
                            <input type="text" id="e_CustomerCode" class="form-control" readonly />
                        </div>
                        <div class="col-lg-2 col-md-3">
                            <label class="col-form-label pt-0">客戶名稱</label>
                            <input type="text" id="e_CustomerName" class="form-control" readonly />
                        </div>
                        <div class="col-lg-2 col-md-3 d-none">
                            <label class="col-form-label pt-0">產品料號</label>
                            <input type="text" id="e_ProdNo" class="form-control" readonly />
                        </div>
                        <div class="col-lg-2 col-md-3">
                            <label class="col-form-label pt-0">報價數量(MOQ)</label>
                            <input type="text" id="e_QuotationQty" class="form-control" readonly />
                        </div>
                        <div class="col-lg-2 col-md-3">
                            <label class="col-form-label pt-0">建立時間</label>
                            <input type="text" id="e_CreatedAtText" class="form-control" readonly />
                        </div>
                        <div class="col-lg-2 col-md-3">
                            <label class="col-form-label pt-0">最後更新</label>
                            <input type="text" id="e_UpdatedAtText" class="form-control" readonly />
                        </div>
                    </div>
                </form>
            </div>

            <div class="card-body quotation-result-body">

                <!-- ── 查價結果表 ── -->
                <div class="d-flex align-items-center justify-content-between mb-2 quotation-toolbar">
                    <div class="d-flex align-items-center gap-2">
                        <h6 class="text-dark mb-0">
                            <i class="ri-price-tag-3-line me-1"></i>BOM 料項查價結果
                        </h6>
                        <button type="button" class="btn btn-warning" id="btnToggleRecommended"
                                title="勾選建議料號">
                            <i class="ri-checkbox-line me-1"></i>勾選建議料號
                        </button>
                    </div>
                    <span class="badge bg-info-subtle text-info" id="itemCountBadge">— 筆料項</span>
                </div>

                <div class="table-responsive" style="max-height:600px; overflow-y:auto;">
                    <table class="table table-bordered table-sm align-middle mb-0" id="itemTable"
                           style="min-width:1600px;">
                        <thead class="table-light sticky-top" style="top:0;z-index:10;">
                            <tr>
                                <th rowspan="2" style="min-width: 40px; max-width: 40px; " class="text-center align-middle">
                                    <div class="form-check">
                                        <input class="form-check-input" type="checkbox" id="checkAllItems">
                                    </div>
                                </th>
                                <th rowspan="2" style="min-width: 40px; max-width: 40px; " class="text-center align-middle decision-log-col"></th>
                                <th rowspan="2" style="min-width: 40px; max-width: 40px; " class="align-middle">項次</th>
                                <th rowspan="2" style="min-width: 150px; max-width: 150px; " class="align-middle">製造商料號</th>
                                <th rowspan="2" style="min-width: 150px; max-width: 150px; " class="align-middle">製造商</th>
                                <th rowspan="2" style="min-width: 150px; max-width: 150px; " class="align-middle">元件描述</th>
                                <th rowspan="2" style="min-width: 150px; max-width: 150px; " class="align-middle">元件料號</th>
                                <th rowspan="2" style="min-width: 150px; max-width: 150px; " class="align-middle">顯示料號</th>
                                <th rowspan="2" style="width:70px;" class="text-center align-middle">數量</th>
                                <th rowspan="2" style="min-width:180px;"
                                    class="text-center align-middle bg-warning-subtle text-warning internal-part-col">
                                    <div class="small fw-normal internal-part-hint mb-1">黃底標示表示建議料號</div>
                                    <div>內部料號</div>
                                </th>
                                <th rowspan="2" style="min-width:80px;"
                                    class="text-center align-middle">比對分類</th>
                                <th rowspan="2" style="min-width:80px;"
                                    class="text-center align-middle">命中欄位</th>
                                <th colspan="8" class="text-center bg-primary-subtle text-primary">內部採購紀錄</th>
                                <th colspan="8" class="text-center bg-success-subtle text-success">外部查價</th>
                                <th colspan="2" class="text-center bg-warning-subtle text-warning">Mouser</th>
                                <th colspan="2" class="text-center bg-info-subtle text-info">DigiKey</th>
                            </tr>
                            <tr>
                                <!-- 內部採購紀錄 sub-headers -->
                                <th class="bg-primary-subtle text-primary" style="min-width:100px;">採購日期</th>
                                <th class="bg-primary-subtle text-primary" style="min-width:90px;">單價(原幣)</th>
                                <th class="bg-primary-subtle text-primary" style="min-width:90px;">單價(台幣)</th>
                                <th class="bg-primary-subtle text-primary" style="width:70px;">數量</th>
                                <th class="bg-primary-subtle text-primary" style="width:65px;">幣別</th>
                                <th class="bg-primary-subtle text-primary" style="min-width:140px;">供應商</th>
                                <th class="bg-primary-subtle text-primary" style="min-width:120px;">採購型號</th>
                                <th class="bg-primary-subtle text-primary text-center" style="width:80px;">Variant 過濾</th>
                                <!-- 外部查價 sub-headers -->
                                <th class="bg-success-subtle text-success" style="min-width:100px;">查價日期</th>
                                <th class="bg-success-subtle text-success" style="min-width:90px;">單價(原幣)</th>
                                <th class="bg-success-subtle text-success" style="min-width:90px;">單價(台幣)</th>
                                <th class="bg-success-subtle text-success" style="width:70px;">MOQ</th>
                                <th class="bg-success-subtle text-success" style="width:65px;">幣別</th>
                                <th class="bg-success-subtle text-success" style="min-width:120px;">供應商名稱</th>
                                <th class="bg-success-subtle text-success" style="width:70px;">庫存量</th>
                                <th class="bg-success-subtle text-success" style="width:100px;">情境</th>
                                <!-- Mouser sub-headers -->
                                <th class="bg-warning-subtle text-warning" style="min-width:100px;">查價日期</th>
                                <th class="bg-warning-subtle text-warning" style="min-width:90px;">優惠價(原幣)</th>
                                <!-- DigiKey sub-headers -->
                                <th class="bg-info-subtle text-info" style="min-width:100px;">查價日期</th>
                                <th class="bg-info-subtle text-info" style="min-width:90px;">優惠價(原幣)</th>
                            </tr>
                        </thead>
                        <tbody id="item-table-body">
                        </tbody>
                    </table>
                </div>

                <!-- ── 底部按鈕列 ── -->
                <div class="d-flex justify-content-end mt-3 gap-2">
                    <a href="@Url.Action("Index", "QuotationResult")" class="btn btn-secondary">
                        <i class="ri-arrow-left-line"></i>返回
                    </a>
                    <button type="button" class="btn btn-success" id="btnReInternalQuotation">
                        <i class="ri-refresh-line"></i>內部重新查價
                    </button>
                    <button type="button" class="btn btn-success" id="btnReExternalQuotation">
                        <i class="ri-refresh-line"></i>外部重新查價
                    </button>
                    <button type="button" class="btn btn-success" id="btnCheckInStockPrice">
                        <i class="ri-search-line"></i>查詢現貨優惠價
                    </button>
                </div>

            </div>
        </div>

    </div>
</div>

@await Html.PartialAsync("_SanderModuleItemPicker", ui.PartialSmip)
@await Html.PartialAsync("_ModalDecisionLog", ui.PartialMdl)

<style>
    /* 上方表單與工具列間距縮為約 30% */
    .quotation-result-card .quotation-header-row {
        margin-bottom: 0.3rem !important;
    }

    .quotation-result-card .quotation-result-body {
        padding-top: 0.375rem;
    }

    #e_FileName {
        font-size: 150%;
    }

    #itemCountBadge {
        font-size: 150%;
    }

    #btnToggleRecommended {
        color: #4A3208;
    }

        #btnToggleRecommended i {
            color: #4A3208;
        }

    #itemTable .internal-part-hint {
        color: #4A3208;
        line-height: 1.3;
        white-space: normal;
    }

    #itemTable.hide-decision-log .decision-log-col {
        display: none;
    }

    /* ── 凍結欄（含元件描述）────────────────────────────── */
    #itemTable thead tr:first-child th:nth-child(-n+6) {
        position: sticky;
        background-color: #f8f9fa;
        z-index: 3;
    }

    #itemTable tbody td:nth-child(-n+6) {
        position: sticky;
        background-color: #fff;
        z-index: 3;
    }
    /*left 偏移 – 正常狀態（decision-log 顯示） */
    #itemTable th:nth-child(1), #itemTable td:nth-child(1) {
        left: 0;
    }

    #itemTable th:nth-child(2), #itemTable td:nth-child(2) {
        left: 40px;
    }

    #itemTable th:nth-child(3), #itemTable td:nth-child(3) {
        left: 80px;
    }

    #itemTable th:nth-child(4), #itemTable td:nth-child(4) {
        left: 120px;
    }

    #itemTable th:nth-child(5), #itemTable td:nth-child(5) {
        left: 270px;
    }

    #itemTable th:nth-child(6), #itemTable td:nth-child(6) {
        left: 420px;
    }
    /*left 偏移 – hide-decision-log 狀態（第 2 列隱藏，其餘左移 40px）*/
    #itemTable.hide-decision-log th:nth-child(3), #itemTable.hide-decision-log td:nth-child(3) {
        left: 40px;
    }

    #itemTable.hide-decision-log th:nth-child(4), #itemTable.hide-decision-log td:nth-child(4) {
        left: 80px;
    }

    #itemTable.hide-decision-log th:nth-child(5), #itemTable.hide-decision-log td:nth-child(5) {
        left: 230px;
    }

    #itemTable.hide-decision-log th:nth-child(6), #itemTable.hide-decision-log td:nth-child(6) {
        left: 380px;
    }
    /* 凍結區右側陰影指示線 */
    #itemTable thead tr:first-child th:nth-child(6),
    #itemTable tbody td:nth-child(6) {
        box-shadow: 2px 0 4px -1px rgba(0, 0, 0, .15);
    }

    /* border-collapse: separate 讓每格獨立持有邊框，背景完整覆蓋，縫隙消失 */
    #itemTable {
        border-collapse: separate !important;
        border-spacing: 0;
    }

        /* 重建格線：separate 下邊框不合併，每格只留 right+bottom 避免 2px 雙線 */
        #itemTable > :not(caption) > * {
            border: 0 !important;
        }

            #itemTable > :not(caption) > * > * {
                border-color: var(--vz-table-border-color) !important;
                border-style: solid !important;
                border-width: 0 1px 1px 0 !important;
            }
                /* 第一欄補回左邊框 */
                #itemTable > :not(caption) > * > *:first-child {
                    border-left-width: 1px !important;
                }
        /* 第一列補回上邊框 */
        #itemTable > :not(caption):first-child > tr:first-child > * {
            border-top-width: 1px !important;
        }

    /* 群組標題列與子標題列之間的白色分隔線 */
    #itemTable thead tr:first-child > th {
        border-bottom: 2px solid #fff !important;
    }
</style>

@section scripts {
    <script>
        $(document).ready(function () {
            loadDetail();
        });

        var currentFileId = '@(quotationFileId?.ToString() ?? "")';

        var pageUrls = {
            GetById: '@(Configuration["BackendURL"])/api/QuotationResult/GetById',
            ReInternalQuotation: '@(Configuration["BackendURL"])/api/QuotationResult/ReInternalQuotation',
            ReExternalQuotation: '@(Configuration["BackendURL"])/api/QuotationResult/ReExternalQuotation',
            CheckInStockPrice: '@(Configuration["BackendURL"])/api/QuotationResult/CheckInStockPrice',
            GetDecisionLogs: '@(Configuration["BackendURL"])/api/QuotationResult/GetDecisionLogs',
            GetPriceClusterPageList: '@(Configuration["BackendURL"])/api/QuotationResult/GetPriceClusterPageList',
        };

        // ── 欄位名稱（Razor nameof 強型別） ──────────────────────────────────
        var FH = {
            Id: '@nameof(QuotationFileEditVM.Id)',
            FileName: '@nameof(QuotationFileEditVM.FileName)',
            CustomerCode: '@nameof(QuotationFileEditVM.CustomerCode)',
            CustomerName: '@nameof(QuotationFileEditVM.CustomerName)',
            ProdNo: '@nameof(QuotationFileEditVM.ProdNo)',
            QuotationQty: '@nameof(QuotationFileEditVM.QuotationQty)',
            CreatedAtText: '@nameof(QuotationFileEditVM.CreatedAtText)',
            UpdatedAtText: '@nameof(QuotationFileEditVM.UpdatedAtText)',
            Items: '@nameof(QuotationFileEditVM.Items)',
            IsAIDecisionProcessDisplay: '@nameof(QuotationFileEditVM.IsAIDecisionProcessDisplay)'
        };

        var FI = {
            Id: '@nameof(QuotationItemVM.Id)',
            ComponentPart: '@nameof(QuotationItemVM.ComponentPart)',
            DisplayPart: '@nameof(QuotationItemVM.DisplayPart)',
            Description: '@nameof(QuotationItemVM.Description)',
            Qty: '@nameof(QuotationItemVM.Qty)',
            Manufacturer: '@nameof(QuotationItemVM.Manufacturer)',
            ManufacturerPartNumber: '@nameof(QuotationItemVM.ManufacturerPartNumber)',
            No: '@nameof(QuotationItemVM.No)',
            InternalPurchaseOrderDate: '@nameof(QuotationItemVM.InternalPurchaseOrderDate)',
            InternalUnitPriceOriginalCurrency: '@nameof(QuotationItemVM.InternalUnitPriceOriginalCurrency)',
            InternalUnitPriceTwd: '@nameof(QuotationItemVM.InternalUnitPriceTwd)',
            InternalQuantity: '@nameof(QuotationItemVM.InternalQuantity)',
            InternalCurrency: '@nameof(QuotationItemVM.InternalCurrency)',
            InternalSupplierName: '@nameof(QuotationItemVM.InternalSupplierName)',
            InternalSupplierCode: '@nameof(QuotationItemVM.InternalSupplierCode)',
            InternalItemDescription2: '@nameof(QuotationItemVM.InternalItemDescription2)',
            ExternalQuotationDate: '@nameof(QuotationItemVM.ExternalQuotationDate)',
            ExternalUnitPriceOriginalCurrency: '@nameof(QuotationItemVM.ExternalUnitPriceOriginalCurrency)',
            ExternalUnitPriceTwd: '@nameof(QuotationItemVM.ExternalUnitPriceTwd)',
            ExternalMoq: '@nameof(QuotationItemVM.ExternalMoq)',
            ExternalCurrency: '@nameof(QuotationItemVM.ExternalCurrency)',
            ExternalSupplierName: '@nameof(QuotationItemVM.ExternalSupplierName)',
            ExternalStock: '@nameof(QuotationItemVM.ExternalStock)',
            ExternalScenario: '@nameof(QuotationItemVM.ExternalScenario)',
            ExternalScenarioText: '@nameof(QuotationItemVM.ExternalScenarioText)',
            MatchCategoryText: '@nameof(QuotationItemVM.MatchCategoryText)',
            MatchField: '@nameof(QuotationItemVM.MatchField)',
            MouserQuotationDate: '@nameof(QuotationItemVM.MouserQuotationDate)',
            MouserUnitPriceOriginalCurrency: '@nameof(QuotationItemVM.MouserUnitPriceOriginalCurrency)',
            DkQuotationDate: '@nameof(QuotationItemVM.DkQuotationDate)',
            DkUnitPriceOriginalCurrency: '@nameof(QuotationItemVM.DkUnitPriceOriginalCurrency)',
            IsRecommendedNo: '@nameof(QuotationItemVM.IsRecommendedNo)',
            IsFilterByCustomerApprovedPartText: '@nameof(QuotationItemVM.IsFilterByCustomerApprovedPartText)'
        };

        // 目前載入的料項清單（用於儲存內部料號）
        var currentItems = [];

        // ── 工具函式 ──────────────────────────────────────────────────────────
        function showSysError() {
            Swal.fire({ icon: 'error', title: '系統錯誤', text: '操作失敗，請稍後再試。' });
        }

        function fmtPrice(val) {
            if (val === null || val === undefined || val === '') return '<span class="text-muted">—</span>';
            return '<span class="font-monospace">' + parseFloat(val) + '</span>';
        }

        function fmtNum(val) {
            if (val === null || val === undefined || val === '') return '<span class="text-muted">—</span>';
            return Number(val).toLocaleString();
        }

        function fmtDate(val) {
            if (!val) return '<span class="text-muted">—</span>';
            return escapeHtml(val);
        }

        function fmtCurrency(val) {
            if (!val) return '<span class="text-muted">—</span>';
            return '<span class="badge bg-light text-dark border">' + escapeHtml(val) + '</span>';
        }

        function fmtScenarioText(val) {
            if (!val) return '<span class="text-muted">—</span>';
            return '<span class="badge bg-secondary">' + escapeHtml(val) + '</span>';
        }

        function fmtYesNo(val) {
            if (!val) return '<span class="text-muted">—</span>';
            return val === '是'
                ? '<span class="badge bg-success">是</span>'
                : '<span class="badge bg-secondary">否</span>';
        }

        function fmtMatchCategory(val) {
            if (!val) return '<span class="text-muted">—</span>';
            if (val === '完全命中') return '<span class="badge bg-success">' + escapeHtml(val) + '</span>';
            if (val === '建議料號') return '<span class="badge bg-warning text-dark">' + escapeHtml(val) + '</span>';
            if (val === '未命中') return '<span class="badge bg-secondary">' + escapeHtml(val) + '</span>';
            return '<span class="badge bg-light text-dark">' + escapeHtml(val) + '</span>';
        }

        function applyDecisionLogVisibility(show) {
            if (show) {
                $('#itemTable').removeClass('hide-decision-log');
            } else {
                $('#itemTable').addClass('hide-decision-log');
            }
        }

        // ── 內部料號選取器 ─────────────────────────────────────────────────────
        function openItemPicker(itemId) {
            SanderModuleItemPicker['@(ui.PartialSmip.ViewId)'].open(function (no) {
                $('.procurement-model-input[data-id="' + itemId + '"]').val(no);
            });
        }

        // ── 載入詳細資料 ──────────────────────────────────────────────────────
        function loadDetail() {
            if (!currentFileId) return;
            showLoader();
            $.ajax({
                url: pageUrls.GetById,
                type: 'GET',
                data: { id: currentFileId },
                success: function (res) {
                    if (!res.Success || !res.Data) { showSysError(); return; }
                    fillHeader(res.Data);
                    renderItems(res.Data[FH.Items] || []);
                    applyDecisionLogVisibility(res.Data[FH.IsAIDecisionProcessDisplay] !== false);
                },
                error: function () { showSysError(); },
                complete: function () { hideLoader(); }
            });
        }

        function fillHeader(d) {
            $('#e_Id').val(d[FH.Id]);
            $('#e_FileName').val(d[FH.FileName]);
            $('#e_CustomerCode').val(d[FH.CustomerCode]);
            $('#e_CustomerName').val(d[FH.CustomerName]);
            $('#e_ProdNo').val(d[FH.ProdNo]);
            $('#e_QuotationQty').val(d[FH.QuotationQty]);
            $('#e_CreatedAtText').val(d[FH.CreatedAtText]);
            $('#e_UpdatedAtText').val(d[FH.UpdatedAtText]);
        }

        function renderItems(items) {
            currentItems = items;
            var $body = $('#item-table-body');
            $body.empty();
            $('#itemCountBadge').text(items.length + ' 筆料項');

            if (!items.length) {
                $body.append('<tr><td colspan="32" class="text-center text-muted py-4">無料項資料</td></tr>');
                return;
            }

            items.forEach(function (r, idx) {
                $body.append(buildItemRow(r, idx + 1));
            });

            // 同步全選 checkbox 狀態
            syncCheckAllState();
        }

        function buildItemRow(r, no) {
            var itemId = r[FI.Id];
            var isRecommended = r[FI.IsRecommendedNo] === true;
            var currentModel = escapeHtml(r[FI.No] || '');
            var rowClass = '';
            var checked = isRecommended ? ' checked' : '';

            return `<tr data-id="${itemId}"${rowClass}>
                <td class="text-center">
                    <div class="form-check">
                        <input class="form-check-input item-check" type="checkbox" value="${itemId}"
                            data-recommended="${isRecommended}"${checked}>
                    </div>
                </td>
                <td class="text-center p-1 decision-log-col">
                    <button type="button" class="btn btn-sm btn-outline-info btn-view-decision-log"
                            data-id="${itemId}" title="查看決策歷程">
                        <i class="ri-history-line"></i>
                    </button>
                </td>
                <td class="text-center text-muted">${escapeHtml(no)}</td>
                <td><code class="fs-6">${escapeHtml(r[FI.ManufacturerPartNumber] || '')}</code></td>
                <td class="text-muted">${escapeHtml(r[FI.Manufacturer] || '')}</td>
                <td><span title="${escapeHtml(r[FI.Description])}">${escapeHtml(r[FI.Description])}</span></td>
                <td><span title="${escapeHtml(r[FI.ComponentPart])}">${escapeHtml(r[FI.ComponentPart] || '')}</span></td>
                <td><span title="${escapeHtml(r[FI.DisplayPart])}">${escapeHtml(r[FI.DisplayPart] || '')}</span></td>
                <td class="text-center">${fmtNum(r[FI.Qty])}</td>
                <td class="p-1${isRecommended ? ' bg-warning-subtle' : ''}">
                    <div class="input-group">
                        <input type="text" class="form-control font-monospace procurement-model-input"
                            data-id="${itemId}" value="${currentModel}" readonly placeholder="—" />
                        <button class="btn btn-outline-secondary" type="button" onclick="openItemPicker('${itemId}')">
                            <i class="ri-search-line"></i>
                        </button>
                    </div>
                </td>
                <td>${fmtMatchCategory(r[FI.MatchCategoryText])}</td>
                <td>${escapeHtml(r[FI.MatchField] || '')}</td>
                <td>${fmtDate(r[FI.InternalPurchaseOrderDate])}</td>
                <td>${fmtPrice(r[FI.InternalUnitPriceOriginalCurrency])}</td>
                <td>${fmtPrice(r[FI.InternalUnitPriceTwd])}</td>
                <td>${fmtNum(r[FI.InternalQuantity])}</td>
                <td>${fmtCurrency(r[FI.InternalCurrency])}</td>
                <td>${escapeHtml((r[FI.InternalSupplierName] || '') + (r[FI.InternalSupplierCode] ? ' (' + r[FI.InternalSupplierCode] + ')' : ''))}</td>
                <td>${escapeHtml(r[FI.InternalItemDescription2] != null ? String(r[FI.InternalItemDescription2]) : '')}</td>
                <td class="text-center">${fmtYesNo(r[FI.IsFilterByCustomerApprovedPartText])}</td>
                <td>${fmtDate(r[FI.ExternalQuotationDate])}</td>
                <td>${fmtPrice(r[FI.ExternalUnitPriceOriginalCurrency])}</td>
                <td>${fmtPrice(r[FI.ExternalUnitPriceTwd])}</td>
                <td>${fmtNum(r[FI.ExternalMoq])}</td>
                <td>${fmtCurrency(r[FI.ExternalCurrency])}</td>
                <td>${escapeHtml(r[FI.ExternalSupplierName] != null ? String(r[FI.ExternalSupplierName]) : '')}</td>
                <td>${fmtNum(r[FI.ExternalStock])}</td>
                <td>${fmtScenarioText(r[FI.ExternalScenarioText])}</td>
                <td>${fmtDate(r[FI.MouserQuotationDate])}</td>
                <td>${fmtPrice(r[FI.MouserUnitPriceOriginalCurrency])}</td>
                <td>${fmtDate(r[FI.DkQuotationDate])}</td>
                <td>${fmtPrice(r[FI.DkUnitPriceOriginalCurrency])}</td>
            </tr>`;
        }

        // ── 全選 / 取消全選（料項 checkbox） ─────────────────────────────────
        function syncCheckAllState() {
            var total = $('.item-check').length;
            var checked = $('.item-check:checked').length;
            $('#checkAllItems').prop('indeterminate', checked > 0 && checked < total);
            $('#checkAllItems').prop('checked', total > 0 && checked === total);
        }

        $('#checkAllItems').on('change', function () {
            $('.item-check').prop('checked', $(this).is(':checked'));
        });

        $(document).on('change', '.item-check', function () {
            syncCheckAllState();
        });

        // ── 切換建議內部料號的勾選狀態 ────────────────────────────────────────
        $('#btnToggleRecommended').on('click', function () {
            var $rec = $('.item-check[data-recommended="true"]');
            var allChecked = $rec.length > 0 && $rec.filter(':checked').length === $rec.length;
            $rec.prop('checked', !allChecked);
            syncCheckAllState();
        });

        // ── 取得勾選的料項 ─────────────────────────────────────────────
        function getCheckedItems() {
            var items = [];
            $('.item-check:checked').each(function () {
                var itemId = $(this).val();
                var no = $('.procurement-model-input[data-id="' + itemId + '"]').val() || '';
                items.push({ BomFileContentId: itemId, No: no });
            });
            return items;
        }

        // ── 內部重新查價 ───────────────────────────────────────────────────
        $('#btnReInternalQuotation').on('click', function () {
            var checkedItems = getCheckedItems();
            if (!checkedItems.length) {
                Swal.fire({ icon: 'warning', title: '請先勾選料項', confirmButtonText: '確定' });
                return;
            }

            showLoader();

            var tasks = checkedItems.map(function (item) {
                return $.ajax({
                    url: pageUrls.ReInternalQuotation,
                    type: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify({ BomFileContentId: item.BomFileContentId, No: item.No })
                }).then(function (res) {
                    if (!res.Success) return Promise.reject(res.Message);
                });
            });

            Promise.all(tasks)
                .then(function () {
                    Swal.fire({ icon: 'success', title: '內部查價完成', timer: 1200, showConfirmButton: false })
                        .then(function () { loadDetail(); });
                })
                .catch(function (msg) {
                    Swal.fire({ icon: 'error', title: '查價失敗', text: typeof msg === 'string' ? msg : '', confirmButtonText: '確定' });
                })
                .finally(function () { hideLoader(); });
        });

        // ── 外部重新查價 ───────────────────────────────────────────────────
        $('#btnReExternalQuotation').on('click', function () {
            var checkedItems = getCheckedItems();
            if (!checkedItems.length) {
                Swal.fire({ icon: 'warning', title: '請先勾選料項', confirmButtonText: '確定' });
                return;
            }

            showLoader();

            // 依序執行，避免同時呼叫 Nexar token endpoint 觸發 429 (Too Many Requests)
            checkedItems.reduce(function (chain, item) {
                return chain.then(function () {
                    return $.ajax({
                        url: pageUrls.ReExternalQuotation,
                        type: 'POST',
                        contentType: 'application/json',
                        data: JSON.stringify({ BomFileContentId: item.BomFileContentId })
                    }).then(function (res) {
                        if (!res.Success) return Promise.reject(res.Message);
                    });
                });
            }, Promise.resolve())
                .then(function () {
                    Swal.fire({ icon: 'success', title: '外部查價完成', timer: 1200, showConfirmButton: false })
                        .then(function () { loadDetail(); });
                })
                .catch(function (msg) {
                    Swal.fire({ icon: 'error', title: '查價失敗', text: typeof msg === 'string' ? msg : '', confirmButtonText: '確定' });
                })
                .finally(function () { hideLoader(); });
        });
        // ── 查看決策歷程 ───────────────────────────────────────────────────
        $(document).on('click', '.btn-view-decision-log', function () {
            var itemId = $(this).data('id');
            ModalDecisionLog['@(ui.PartialMdl.ViewId)'].open(itemId);
        });

        // ── 查詢現貨優惠價 ───────────────────────────────────────────────
        $('#btnCheckInStockPrice').on('click', function () {
            var checkedItems = getCheckedItems();
            if (!checkedItems.length) {
                Swal.fire({ icon: 'warning', title: '請先勾選料項', confirmButtonText: '確定' });
                return;
            }

            showLoader();

            var tasks = checkedItems.map(function (item) {
                return $.ajax({
                    url: pageUrls.CheckInStockPrice,
                    type: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify({ BomFileContentId: item.BomFileContentId })
                }).then(function (res) {
                    if (!res.Success) return Promise.reject(res.Message);
                });
            });

            Promise.all(tasks)
                .then(function () {
                    Swal.fire({ icon: 'success', title: '現貨優惠價查詢完成', timer: 1200, showConfirmButton: false })
                        .then(function () { loadDetail(); });
                })
                .catch(function (msg) {
                    Swal.fire({ icon: 'error', title: '查詢失敗', text: typeof msg === 'string' ? msg : '', confirmButtonText: '確定' });
                })
                .finally(function () { hideLoader(); });
        });
    </script>
}
