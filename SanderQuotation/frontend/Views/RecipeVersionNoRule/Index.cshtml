@{
    // Layout = "~/Views/Shared/_LayoutDemo.cshtml";
    ViewBag.Title = "版號規則管理";
    ViewBag.pTitle = "版號規則管理";
    ViewBag.pageTitle = "配方管理";
}

<div class="row">
    <div class="col-lg-12">
        <div class="card" id="ruleListCard">
            <div class="card-header border-0">
                <div class="d-flex align-items-center">
                    <h5 class="card-title mb-0 flex-grow-1"></h5>
                    <div class="flex-shrink-0">
                        <button id="btnAddRule" class="btn btn-success add-btn" onclick="openAddModal()">
                            <i class="ri-add-line align-bottom me-1"></i>新增
                        </button>
                    </div>
                </div>
            </div>

            <div class="card-body border border-dashed border-end-0 border-start-0">
                <form>
                    <div class="row g-3">
                        <div class="col-xxl-3 col-sm-12">
                            <div class="search-box">
                                <input type="text" id="globalSearchInput"
                                       class="form-control search bg-light border-light" placeholder="搜尋表格內容">
                                <i class="ri-search-line search-icon"></i>
                            </div>
                        </div>
                        <div class="col-xxl-3 col-sm-12">
                            <div class="search-box">
                                <input type="text" id="keywordInput" class="form-control search bg-light border-light"
                                       placeholder="輸入關鍵字">
                                <i class="ri-search-line search-icon"></i>
                            </div>
                        </div>
                        <div class="col-xxl-1 col-sm-4">
                            <button type="button" class="btn btn-primary w-100" onclick="loadList()">
                                <i class="ri-equalizer-fill me-1 align-bottom"></i>篩選
                            </button>
                        </div>
                    </div>
                </form>
            </div>

            <div class="card-body">
                <div class="table-responsive table-card mb-4">
                    <table class="table align-middle table-nowrap mb-0" id="dataTable">
                        <thead>
                            <tr>
                                <th style="width:100px;">Action</th>
                                <th style="width:40px;">項次</th>
                                <th>規則名稱</th>
                                <th>建立日期</th>
                                <th>最後更新</th>
                            </tr>
                        </thead>
                        <tbody id="rule-list-data"></tbody>
                    </table>
                    <div class="noresult" style="display:none;">
                        <div class="text-center">
                            <lord-icon src="https://cdn.lordicon.com/msoeawqm.json" trigger="loop"
                                       colors="primary:#121331,secondary:#08a88a" style="width:75px;height:75px"></lord-icon>
                            <h5 class="mt-2">查無資料</h5>
                        </div>
                    </div>
                </div>

                @* 刪除確認 Modal *@
                <div class="modal fade flip" id="deleteModal" tabindex="-1" aria-hidden="true">
                    <div class="modal-dialog modal-dialog-centered">
                        <div class="modal-content">
                            <div class="modal-body p-5 text-center">
                                <lord-icon src="https://cdn.lordicon.com/gsqxdxog.json" trigger="loop"
                                           colors="primary:#405189,secondary:#f06548"
                                           style="width:90px;height:90px"></lord-icon>
                                <div class="mt-4 text-center">
                                    <h4>確定要刪除此版號規則？</h4>
                                    <p class="text-muted"><small>刪除後將無法復原。</small></p>
                                    <div class="hstack gap-2 justify-content-center">
                                        <button class="btn btn-link link-success fw-medium text-decoration-none"
                                                data-bs-dismiss="modal">
                                            <i class="ri-close-line me-1 align-middle"></i>取消
                                        </button>
                                        <button class="btn btn-danger" id="btnConfirmDelete">確定刪除</button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@* ═══ Modal：新增 / 編輯版號規則（含區段設計器）═══ *@
<div class="modal fade" id="ruleModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content border-0">
            <div class="modal-header p-3 bg-info-subtle">
                <h5 class="modal-title" id="ruleModalTitle">新增版號規則</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <form class="needs-validation" novalidate id="ruleForm">
                <div class="modal-body">
                    <input type="hidden" id="f_Id" value="0" />

                    @* 基本資訊 *@
                    <div class="row g-3 mb-4">
                        <div class="col-lg-4">
                            <label for="f_RuleName" class="col-form-label pt-0 required">規則名稱</label>
                            <input type="text" id="f_RuleName" name="RuleName" class="form-control" maxlength="100"
                                   placeholder="例：CVD 語意化版號規則" required />
                        </div>
                        @*<div class="col-lg-4">
                                <label for="f_Status" class="col-form-label pt-0">狀態</label>
                                <select id="f_Status" class="form-select">
                                    <option value="1">啟用</option>
                                    <option value="2">停用</option>
                                    <option value="0">草稿</option>
                                </select>
                            </div>*@
                    </div>

                    @* 區段設計器 Partial View *@
                    @await Html.PartialAsync("_SegmentDesigner")

                </div><!-- /modal-body -->

                <div class="modal-footer">
                    <button type="button" class="btn btn-light" data-bs-dismiss="modal">取消</button>
                    <button type="submit" class="btn btn-success" id="btnSaveRule">
                        <i class="ri-save-line align-bottom me-1"></i>確認
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section scripts {
    <script>
        $(document).ready(function () {
            var pTitle    = '@(Html.Raw(ViewBag.pTitle))';
            var pageTitle = '@(Html.Raw(ViewBag.pageTitle))';
            $('#header-pTitle').text(pTitle);
            var bElList = [];
            if (pageTitle) bElList.push('<li class="breadcrumb-item"><a href="javascript: void(0);">' + pageTitle + '</a></li>');
            bElList.push('<li class="breadcrumb-item active">' + pTitle + '</li>');
            $('#_page_title_row .breadcrumb').html(bElList.join(''));
        });
    </script>
    @await Html.PartialAsync("_CrudCommonScripts")
    <script>
        // ── API URL 設定 –––––––––––––––––––––––––––––––––––––––––––––––––
        var apiUrls = {
            GetList: '@(Configuration["BackendURL"])/api/RecipeVersionNoRule/GetList',
            GetById: '@(Configuration["BackendURL"])/api/RecipeVersionNoRule/GetById',
            Save: '@(Configuration["BackendURL"])/api/RecipeVersionNoRule/Save',
            Delete: '@(Configuration["BackendURL"])/api/RecipeVersionNoRule/Delete',
            GeneratePreview: '@(Configuration["BackendURL"])/api/RecipeVersionNoRule/GeneratePreview',
        };

        // ── Segment Designer API URL 設定 ––––––––––––––––––––––––––––––
        window._previewApiUrl = apiUrls.GeneratePreview;

        /** 刪除的 ID */
        var deleteId = 0;

        // ── 橋接 _CrudCommonScripts –––––––––––––––––––––––––––––––––––––––––
        function loadDatas() { loadList(); }

        // ── 清單載入 ––––––––––––––––––––––––––––––––––––––––––––––––––––––
        function loadList() {
            showLoader();
            $.ajax({
                url: apiUrls.GetList,
                type: 'GET',
                data: { keyword: $('#keywordInput').val().trim() },
                success: function (res) {
                    if (!res.Success) { showSysError(); return; }
                    var list = res.Data || [];
                    var globalKw = $('#globalSearchInput').val().trim().toLowerCase();
                    if (globalKw) {
                        list = list.filter(function (r) {
                            return [r.RuleName, r.PreviewVersion, r.CreateTime, r.UpdateTime]
                                .some(function (v) { return (v || '').toLowerCase().includes(globalKw); });
                        });
                    }
                    renderList(list);
                },
                error: function () { showSysError(); },
                complete: function () { hideLoader(); },
            });
        }

        /** 渲染列表 */
        function renderList(list) {
            var tbody = $('#rule-list-data');
            tbody.empty();
            if (!list.length) {
                $('.noresult').show();
                return;
            }
            $('.noresult').hide();
            list.forEach(function (r, idx) {
                tbody.append(buildRow(r, idx + 1));
            });
        }

        /** 建立單列的 HTML */
        function buildRow(r, no) {
            // <td><code class="text-primary">${escapeHtml(r.PreviewVersion) || ''}</code></td>
            return `<tr data-id="${r.Id}">

                    <td>
                        <div class="dropdown">
                            <button class="btn btn-soft-secondary btn-sm" type="button"
                                    data-bs-toggle="dropdown" aria-expanded="false">
                                <i class="ri-more-fill align-middle"></i>
                            </button>
                            <ul class="dropdown-menu dropdown-menu-end">
                                <li><a class="dropdown-item" href="javascript:void(0)"
                                       onclick="openEditModal(${r.Id})">
                                    <i class="ri-pencil-fill align-bottom me-2 text-muted"></i>編輯</a></li>
                                <li><a class="dropdown-item delete-btn" href="javascript:void(0)"
                                       data-id="${r.Id}">
                                    <i class="ri-delete-bin-fill align-bottom me-2 text-muted"></i>刪除</a></li>
                            </ul>
                        </div>
                    </td>
                    <td>${no}</td>
                    <td class="fw-semibold">${escapeHtml(r.RuleName)}</td>
                    <td>${escapeHtml(r.CreateTime)}</td>
                    <td>${escapeHtml(r.UpdateTime)}</td>
                </tr>`;
        }

        // ── Modal 操作 ––––––––––––––––––––––––––––––––––––––––––––––––––––––

        /** 開啟新增 Modal */
        function openAddModal() {
            $('#ruleModalTitle').text('新增規則');
            $('#ruleForm').removeClass('was-validated').trigger('reset');
            $('#f_Id').val('0');
            $('#f_Status').val('1');
            SD.reset();
            var modal = new bootstrap.Modal(document.getElementById('ruleModal'));
            modal.show();
        }

        /** 開啟編輯 Modal */
        function openEditModal(id) {
            showLoader();
            $.ajax({
                url: apiUrls.GetById + '?id=' + id,
                type: 'GET',
                success: function (res) {
                    if (!res.Success) { showSysError(); return; }
                    var d = res.Data;
                    $('#ruleModalTitle').text('編輯規則');
                    $('#ruleForm').removeClass('was-validated');
                    $('#f_Id').val(d.Id);
                    $('#f_RuleName').val(d.RuleName);
                    $('#f_Status').val(d.StatusCode);
                    SD.loadRuleSetting(d.RuleSetting);
                    var modal = new bootstrap.Modal(document.getElementById('ruleModal'));
                    modal.show();
                },
                error: function () { showSysError(); },
                complete: function () { hideLoader(); },
            });
        }

        // ── 儲存 –––––––––––––––––––––––––––––––––––––––––––––––––––––––––––

        $('#ruleForm').on('submit', function (e) {
            e.preventDefault();
            if (!this.checkValidity()) { $(this).addClass('was-validated'); return; }

            var ruleSettingJson = SD.collectRuleSetting();
            if (!ruleSettingJson) {
                Swal.fire({ icon: 'warning', title: '請填寫完整的規則設定', confirmButtonText: '確定' });
                return;
            }

            var payload = {
                Id: parseInt($('#f_Id').val()) || 0,
                RuleName: $('#f_RuleName').val().trim(),
                StatusCode: parseInt($('#f_Status').val()) || 1,
                RuleSetting: ruleSettingJson,
            };

            showLoader();
            $.ajax({
                url: apiUrls.Save,
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify(payload),
                success: function (res) {
                    if (res.Success && res.Data && res.Data.IsSuccess === 'Y') {
                        bootstrap.Modal.getInstance(document.getElementById('ruleModal')).hide();
                        Swal.fire({
                            icon: 'success',
                            title: res.Data.ReturnCode,
                            timer: 1200,
                            showConfirmButton: false,
                        });
                        loadList();
                    } else {
                        Swal.fire({ icon: 'error', title: res.Data?.ReturnMsg || '儲存失敗', confirmButtonText: '確定' });
                    }
                },
                error: function () { showSysError(); },
                complete: function () { hideLoader(); },
            });
        });

        // ── 刪除 –––––––––––––––––––––––––––––––––––––––––––––––––––––––––––

        $(document).on('click', '.delete-btn', function () {
            deleteId = $(this).data('id');
            new bootstrap.Modal(document.getElementById('deleteModal')).show();
        });

        $('#btnConfirmDelete').on('click', function () {
            if (!deleteId) return;
            showLoader();
            $.ajax({
                url: apiUrls.Delete + '?id=' + deleteId,
                type: 'DELETE',
                success: function (res) {
                    bootstrap.Modal.getInstance(document.getElementById('deleteModal')).hide();
                    if (res.Success && res.Data?.IsSuccess === 'Y') {
                        Swal.fire({ icon: 'success', title: '刪除成功', timer: 1000, showConfirmButton: false });
                        loadList();
                    } else {
                        Swal.fire({ icon: 'error', title: res.Data?.ReturnMsg || '刪除失敗', confirmButtonText: '確定' });
                    }
                },
                error: function () { showSysError(); },
                complete: function () { hideLoader(); },
            });
        });

        // ── 工具函式 –––––––––––––––––––––––––––––––––––––––––––––––––––––

        /** HTML 轉義，防止 XSS 攻擊 */
        function escapeHtml(value) {
            return $('<div>').text(value ?? '').html();
        }

        /** 顯示系統錯誤 */
        function showSysError() {
            Swal.fire({ icon: 'error', title: pageConfig.messages.systemError, confirmButtonText: pageConfig.messages.confirm });
        }
    </script>
}
